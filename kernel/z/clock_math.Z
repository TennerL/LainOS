int clock_is_leap_year(uint32_t year) {
    uint32_t q;

    q = year / 4;
    if (q * 4 != year) {
        return 0;
    }
    q = year / 100;
    if (q * 100 != year) {
        return 1;
    }
    q = year / 400;
    if (q * 400 == year) {
        return 1;
    }
    return 0;
}

uint32_t clock_days_before_year(uint32_t year) {
    uint32_t days;

    if (year == 0) {
        return 0;
    }

    days = year * 365;
    days += (year - 1) / 4;
    days -= (year - 1) / 100;
    days += (year - 1) / 400;
    days += 1;
    return days;
}

uint32_t clock_days_before_month(uint32_t year, uint32_t month) {
    uint32_t days;

    if (month == 0 || month > 12) {
        return 0;
    }

    days = 0;
    if (month > 1) {
        days += 31;
    }
    if (month > 2) {
        days += 28;
    }
    if (month > 3) {
        days += 31;
    }
    if (month > 4) {
        days += 30;
    }
    if (month > 5) {
        days += 31;
    }
    if (month > 6) {
        days += 30;
    }
    if (month > 7) {
        days += 31;
    }
    if (month > 8) {
        days += 31;
    }
    if (month > 9) {
        days += 30;
    }
    if (month > 10) {
        days += 31;
    }
    if (month > 11) {
        days += 30;
    }

    if (month > 2 && clock_is_leap_year(year)) {
        days += 1;
    }
    return days;
}

export uint32_t clock_days_since_year0(uint32_t year, uint32_t month, uint32_t day) {
    if (month < 1 || month > 12 || day < 1 || day > 31) {
        return 0;
    }
    return clock_days_before_year(year) + clock_days_before_month(year, month) + day - 1;
}

export uint32_t clock_seconds_since_midnight(uint32_t hour, uint32_t minute, uint32_t second) {
    if (hour > 23 || minute > 59 || second > 60) {
        return 0;
    }
    return hour * 3600 + minute * 60 + second;
}

export int clock_rtc_time_valid(uint32_t *time) {
    uint32_t year;
    uint32_t month;
    uint32_t day;
    uint32_t hour;
    uint32_t minute;
    uint32_t second;
    uint32_t max_day;

    if (time == 0) {
        return 0;
    }

    year = time[0];
    month = time[1];
    day = time[2];
    hour = time[3];
    minute = time[4];
    second = time[5];

    if (year < 1970 || year > 9999 ||
        month < 1 || month > 12 ||
        hour > 23 || minute > 59 || second > 60) {
        return 0;
    }

    max_day = 31;
    if (month == 2) {
        max_day = 28;
        if (clock_is_leap_year(year)) {
            max_day += 1;
        }
    } else if (month == 4 || month == 6 ||
               month == 9 || month == 11) {
        max_day = 30;
    }

    if (day < 1 || day > max_day) {
        return 0;
    }
    return 1;
}

export uint64_t clock_unix_time_from_rtc(uint32_t *time) {
    uint32_t year;
    uint32_t month;
    uint32_t day;
    uint32_t hour;
    uint32_t minute;
    uint32_t second;
    uint32_t days;
    uint32_t second_of_day;

    if (time == 0 || clock_rtc_time_valid(time) == 0) {
        return 0;
    }

    year = time[0];
    month = time[1];
    day = time[2];
    hour = time[3];
    minute = time[4];
    second = time[5];

    days = clock_days_since_year0(year, month, day);
    if (days < 719528) {
        return 0;
    }

    second_of_day = clock_seconds_since_midnight(hour, minute, second);
    return ((uint64_t)(days - 719528) * 86400) + second_of_day;
}
