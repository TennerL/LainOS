struct ZLinkProbe {
    int magic;
    int version;
};

struct ZLinkProbe zlink_make_probe(int version) {
    struct ZLinkProbe probe;
    probe.magic = 0x5A;
    probe.version = version;
    return probe;
}

export int z_kernel_z_probe(void) {
    struct ZLinkProbe probe;
    probe = zlink_make_probe(1);
    return probe.magic + probe.version;
}

export uint64_t status_busy_percent_from_ticks(uint64_t delta_ticks, uint64_t delta_idle_ticks) {
    uint64_t busy_ticks;

    if (delta_ticks == 0) {
        return 0;
    }

    if (delta_idle_ticks > delta_ticks) {
        delta_idle_ticks = delta_ticks;
    }

    busy_ticks = delta_ticks - delta_idle_ticks;
    return (busy_ticks * 100 + (delta_ticks / 2)) / delta_ticks;
}
