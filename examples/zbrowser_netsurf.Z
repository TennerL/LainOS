#define ZBROWSER_NS_URL_CAPACITY 1024
#define ZBROWSER_NS_FETCH_CAPACITY 1048576
#define ZBROWSER_NS_STATUS_CAPACITY 256
#define KEY_CHAR 1
#define KEY_ENTER 2
#define KEY_BACKSPACE 3
#define KEY_ESC 5
#define KEY_UP 8
#define KEY_DOWN 9

extern uint32_t gfx_width(void);
extern uint32_t gfx_height(void);
extern void gfx_fill_rect(uint32_t x, uint32_t y, uint32_t width, uint32_t height, uint32_t color);
extern void gfx_draw_rect(uint32_t x, uint32_t y, uint32_t width, uint32_t height, uint32_t color);
extern void draw_text_at_pixel(uint32_t x, uint32_t y, const uint8_t *text, uint32_t fg, uint32_t bg);
extern int os_strlen(const uint8_t *text);
extern int os_http_get_ex(const uint8_t *url, uint8_t *buffer, uint32_t capacity, struct NetHttpInfo *info);
extern uint8_t *kmalloc(uint32_t size);
extern void kfree(uint8_t *ptr);
extern int zbrowser_engine_init(void);
extern uint8_t *zbrowser_engine_status(void);
extern int zbrowser_engine_prepare(const uint8_t *url, const uint8_t *html, uint32_t size);
extern int zbrowser_engine_draw(const uint8_t *html,
                                uint32_t size,
                                uint32_t scroll_line,
                                uint32_t viewport_width,
                                uint32_t viewport_height);

struct NetHttpInfo {
    uint32_t status_code;
    uint32_t content_length;
    uint32_t body_size;
    uint32_t header_size;
    uint32_t flags;
    int32_t error;
    uint32_t tls_error;
    uint8_t content_type[64];
    uint8_t location[1024];
};

global uint64_t zbrowser_ns_buffer_addr;
global uint32_t zbrowser_ns_doc_size;
global uint32_t zbrowser_ns_scroll_line;
global uint32_t zbrowser_ns_loaded;
global uint32_t zbrowser_ns_edit_pos;
global int32_t zbrowser_ns_engine_result;
global int32_t zbrowser_ns_draw_result;
global uint8_t zbrowser_ns_url[1024];
global uint8_t zbrowser_ns_status[256];
global uint8_t zbrowser_ns_empty[1];
global struct NetHttpInfo zbrowser_ns_http_info;

uint8_t *zbrowser_ns_buffer(void) {
    return (uint8_t *)zbrowser_ns_buffer_addr;
}

void zbrowser_ns_copy(uint8_t *dst, uint32_t capacity, const uint8_t *src) {
    uint32_t i;

    if (capacity == 0) {
        return;
    }
    i = 0;
    while (src[i] != 0 && i + 1 < capacity) {
        dst[i] = src[i];
        i = i + 1;
    }
    dst[i] = 0;
}

void zbrowser_ns_append(uint8_t *dst, uint32_t capacity, const uint8_t *src) {
    uint32_t i;
    uint32_t len;

    len = (uint32_t)os_strlen(dst);
    i = 0;
    while (src[i] != 0 && len + 1 < capacity) {
        dst[len] = src[i];
        len = len + 1;
        i = i + 1;
    }
    dst[len] = 0;
}

void zbrowser_ns_append_dec(uint8_t *dst, uint32_t capacity, uint32_t value) {
    uint8_t digits[16];
    uint32_t count;
    uint32_t len;

    len = (uint32_t)os_strlen(dst);
    if (len + 1 >= capacity) {
        return;
    }
    if (value == 0) {
        dst[len] = 48;
        dst[len + 1] = 0;
        return;
    }

    count = 0;
    while (value != 0 && count < 16) {
        digits[count] = (uint8_t)(48 + (value % 10));
        count = count + 1;
        value = value / 10;
    }
    while (count != 0 && len + 1 < capacity) {
        count = count - 1;
        dst[len] = digits[count];
        len = len + 1;
    }
    dst[len] = 0;
}

void zbrowser_ns_set_status_ready(void) {
    zbrowser_ns_copy(zbrowser_ns_status, ZBROWSER_NS_STATUS_CAPACITY, zbrowser_engine_status());
}

void zbrowser_ns_fetch(void) {
    int rc;
    uint8_t *buffer;

    buffer = zbrowser_ns_buffer();
    if (buffer == 0) {
        zbrowser_ns_copy(zbrowser_ns_status, ZBROWSER_NS_STATUS_CAPACITY, "fetch failed: no buffer");
        return;
    }

    zbrowser_ns_copy(zbrowser_ns_status, ZBROWSER_NS_STATUS_CAPACITY, "fetching ");
    zbrowser_ns_append(zbrowser_ns_status, ZBROWSER_NS_STATUS_CAPACITY, zbrowser_ns_url);
    rc = os_http_get_ex(zbrowser_ns_url, buffer, ZBROWSER_NS_FETCH_CAPACITY, &zbrowser_ns_http_info);
    if (rc < 0) {
        zbrowser_ns_doc_size = 0;
        zbrowser_ns_loaded = 0;
        zbrowser_ns_copy(zbrowser_ns_status, ZBROWSER_NS_STATUS_CAPACITY, "fetch failed");
        return;
    }

    zbrowser_ns_doc_size = (uint32_t)rc;
    zbrowser_ns_loaded = 1;
    zbrowser_ns_scroll_line = 0;
    zbrowser_ns_engine_result = zbrowser_engine_prepare(zbrowser_ns_url, buffer, zbrowser_ns_doc_size);
    zbrowser_ns_copy(zbrowser_ns_status, ZBROWSER_NS_STATUS_CAPACITY, "fetched ");
    zbrowser_ns_append_dec(zbrowser_ns_status, ZBROWSER_NS_STATUS_CAPACITY, zbrowser_ns_doc_size);
    zbrowser_ns_append(zbrowser_ns_status, ZBROWSER_NS_STATUS_CAPACITY, " bytes; ");
    zbrowser_ns_append(zbrowser_ns_status, ZBROWSER_NS_STATUS_CAPACITY, zbrowser_engine_status());
}

void zbrowser_ns_draw_header(uint32_t width) {
    gfx_fill_rect(0, 0, width, 58, 0x151c22);
    gfx_draw_rect(0, 0, width, 58, 0x3a4a54);
    draw_text_at_pixel(10, 9, "zbrowser_netsurf standalone", 0xf7d154, 0x151c22);
    draw_text_at_pixel(10, 31, zbrowser_ns_url, 0xe7edf1, 0x101820);
}

void zbrowser_ns_draw_document(uint32_t width, uint32_t height) {
    uint8_t *buffer;

    buffer = zbrowser_ns_buffer();
    if (buffer == 0 || zbrowser_ns_loaded == 0) {
        zbrowser_ns_draw_result = zbrowser_engine_draw(zbrowser_ns_empty, 0, zbrowser_ns_scroll_line, width, height);
    } else {
        zbrowser_ns_draw_result = zbrowser_engine_draw(buffer, zbrowser_ns_doc_size, zbrowser_ns_scroll_line, width, height);
    }
    if (width == 0) {
        return;
    }
}

export void zmodule_redraw(void) {
    uint32_t width;
    uint32_t height;

    width = gfx_width();
    height = gfx_height();
    gfx_fill_rect(0, 0, width, height, 0x101820);
    zbrowser_ns_draw_header(width);
    zbrowser_ns_draw_document(width, height);
    draw_text_at_pixel(10, height - 22, zbrowser_ns_status, 0x9fb3c1, 0x101820);
}

export void zmodule_tick(void) {
    zmodule_redraw();
}

export void zmodule_key(uint32_t key_type, uint32_t ch) {
    if (key_type == KEY_CHAR && ch >= 32 && ch < 127 && zbrowser_ns_edit_pos + 1 < ZBROWSER_NS_URL_CAPACITY) {
        zbrowser_ns_url[zbrowser_ns_edit_pos] = (uint8_t)ch;
        zbrowser_ns_edit_pos = zbrowser_ns_edit_pos + 1;
        zbrowser_ns_url[zbrowser_ns_edit_pos] = 0;
    } else if (key_type == KEY_BACKSPACE && zbrowser_ns_edit_pos != 0) {
        zbrowser_ns_edit_pos = zbrowser_ns_edit_pos - 1;
        zbrowser_ns_url[zbrowser_ns_edit_pos] = 0;
    } else if (key_type == KEY_ENTER) {
        zbrowser_ns_fetch();
    } else if (key_type == KEY_ESC) {
        zbrowser_ns_copy(zbrowser_ns_url, ZBROWSER_NS_URL_CAPACITY, "http://example.com/");
        zbrowser_ns_edit_pos = (uint32_t)os_strlen(zbrowser_ns_url);
    } else if (key_type == KEY_DOWN) {
        zbrowser_ns_scroll_line = zbrowser_ns_scroll_line + 1;
    } else if (key_type == KEY_UP && zbrowser_ns_scroll_line != 0) {
        zbrowser_ns_scroll_line = zbrowser_ns_scroll_line - 1;
    }
    zmodule_redraw();
}

export void zmodule_mouse(uint32_t x, uint32_t y, uint32_t buttons, int32_t wheel) {
    if (x == 0 && y == 0 && buttons == 0) {
        x = 0;
    }
    if (wheel < 0) {
        zbrowser_ns_scroll_line = zbrowser_ns_scroll_line + 3;
    } else if (wheel > 0) {
        if (zbrowser_ns_scroll_line > 3) {
            zbrowser_ns_scroll_line = zbrowser_ns_scroll_line - 3;
        } else {
            zbrowser_ns_scroll_line = 0;
        }
    }
    zmodule_redraw();
}

export void zmodule_unload(void) {
    if (zbrowser_ns_buffer_addr != 0) {
        kfree((uint8_t *)zbrowser_ns_buffer_addr);
        zbrowser_ns_buffer_addr = 0;
    }
}

zbrowser_ns_buffer_addr = (uint64_t)kmalloc(ZBROWSER_NS_FETCH_CAPACITY);
zbrowser_engine_init();
zbrowser_ns_copy(zbrowser_ns_url, ZBROWSER_NS_URL_CAPACITY, "http://example.com/");
zbrowser_ns_edit_pos = (uint32_t)os_strlen(zbrowser_ns_url);
zbrowser_ns_set_status_ready();
if (zbrowser_ns_buffer_addr == 0) {
    zbrowser_ns_copy(zbrowser_ns_status, ZBROWSER_NS_STATUS_CAPACITY, "buffer allocation failed");
}
print("zbrowser_netsurf standalone module loaded\n");
