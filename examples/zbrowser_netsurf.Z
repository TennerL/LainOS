extern int os_http_get_ex(const uint8_t *url, uint8_t *buffer, uint32_t capacity, struct NetHttpInfo *info);
extern uint8_t *kmalloc(uint32_t size);
extern void kfree(uint8_t *ptr);
extern uint32_t kernel_task_submit_named(void (*fn)(uint8_t *arg), uint8_t *arg, const uint8_t *name);
extern uint32_t kernel_task_submit_async_named(void (*fn)(uint8_t *arg), uint8_t *arg, const uint8_t *name);
