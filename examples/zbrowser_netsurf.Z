    debug_puts("zbrowser doc-probe ");
    debug_puts(phase);
    debug_puts(" bytes ");
    if (zbrowser_ns_doc_size < 0) {
        debug_puts("0");
    } else {
        debug_put_dec64((uint64_t)(uint32_t)zbrowser_ns_doc_size);
    }
    debug_puts(" html ");
    debug_put_dec64((uint64_t)zbrowser_ns_count_doc_token("<html"));
    debug_puts(" body ");
    debug_put_dec64((uint64_t)zbrowser_ns_count_doc_token("<body"));
    debug_puts(" title ");
    debug_put_dec64((uint64_t)zbrowser_ns_count_doc_token("<title"));
    debug_puts(" form ");
    debug_put_dec64((uint64_t)zbrowser_ns_count_doc_token("<form"));
    debug_puts(" input ");
    debug_put_dec64((uint64_t)zbrowser_ns_count_doc_token("<input"));
    debug_puts(" textarea ");
    debug_put_dec64((uint64_t)zbrowser_ns_count_doc_token("<textarea"));
    debug_puts(" select ");
    debug_put_dec64((uint64_t)zbrowser_ns_count_doc_token("<select"));
    debug_puts(" script ");
    debug_put_dec64((uint64_t)zbrowser_ns_count_doc_token("<script"));
    debug_puts(" noscript ");
    debug_put_dec64((uint64_t)zbrowser_ns_count_doc_token("<noscript"));
    debug_puts(" link ");
    debug_put_dec64((uint64_t)zbrowser_ns_count_doc_token("<a "));
    debug_puts(" result ");
    debug_put_dec64((uint64_t)zbrowser_ns_count_doc_token("result"));
    debug_puts(" search ");
    debug_put_dec64((uint64_t)zbrowser_ns_count_doc_token("search"));
    debug_puts("\n");
}

