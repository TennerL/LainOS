#define ZBROWSER_NS_HTTP_CAPACITY 8388608
#define ZBROWSER_NS_URL_CAPACITY 1024
#define ZBROWSER_NS_STATUS_CAPACITY 384
#define ZBROWSER_NS_LINE_CAPACITY 512
#define ZBROWSER_NS_HISTORY_LIMIT 24
#define ZBROWSER_NS_HISTORY_BYTES 24576
#define KEY_CHAR 1
#define KEY_ENTER 2
#define KEY_BACKSPACE 3
#define KEY_TAB 4
#define KEY_ESC 5
#define KEY_LEFT 6
#define KEY_RIGHT 7
#define KEY_UP 8
#define KEY_DOWN 9
#define MOUSE_LEFT 1
#define NS_KEY_DELETE_LEFT 8
#define NS_KEY_TAB 9
#define NS_KEY_CR 13
#define NS_KEY_ESCAPE 27
#define NS_KEY_LEFT 28
#define NS_KEY_RIGHT 29
#define NS_KEY_UP 30
#define NS_KEY_DOWN 31
#define NS_MOUSE_HOVER 0
#define NS_MOUSE_PRESS_1 1
#define NS_MOUSE_CLICK_1 32
#define NS_MOUSE_DRAG_1 4096
#define NS_MOUSE_DRAG_ON 16384
#define NS_MOUSE_HOLDING_1 32768
#define NS_MOUSE_LEAVE 2097152

extern uint64_t ticks(void);
extern uint32_t gfx_width(void);
extern uint32_t gfx_height(void);
