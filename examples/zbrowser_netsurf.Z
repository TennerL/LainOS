uint8_t *zbrowser_ns_doc_buffer(void) {
    return (uint8_t *)zbrowser_ns_doc_addr;
}

int zbrowser_ns_ascii_eq_ci(uint8_t a, uint8_t b) {
    if (a >= 65 && a <= 90) {
        a = (uint8_t)(a + 32);
    }
    if (b >= 65 && b <= 90) {
        b = (uint8_t)(b + 32);
    }
    if (a == b) {
        return 1;
    }
    return 0;
}

uint32_t zbrowser_ns_count_doc_token(const uint8_t *needle) {
    uint8_t *doc;
    uint32_t needle_len;
    uint32_t count;
    uint32_t i;
    uint32_t j;
    int match;

    doc = zbrowser_ns_doc_buffer();
    needle_len = (uint32_t)os_strlen(needle);
    if (doc == 0 || needle_len == 0 || zbrowser_ns_doc_size <= 0) {
        return 0;
    }
    if ((uint32_t)zbrowser_ns_doc_size < needle_len) {
        return 0;
    }

    count = 0;
    i = 0;
    while (i + needle_len <= (uint32_t)zbrowser_ns_doc_size) {
        match = 1;
        j = 0;
        while (j < needle_len) {
            if (zbrowser_ns_ascii_eq_ci(doc[i + j], needle[j]) == 0) {
                match = 0;
                break;
            }
            j = j + 1;
        }
        if (match != 0) {
            count = count + 1;
            i = i + needle_len;
        } else {
            i = i + 1;
        }
    }
    return count;
}

uint8_t *zbrowser_ns_history_slot(uint32_t index) {
    return (uint8_t *)zbrowser_ns_history_addr + index * ZBROWSER_NS_URL_CAPACITY;
}

void zbrowser_ns_copy(uint8_t *dst, uint32_t capacity, const uint8_t *src) {
    uint32_t i;

    i = 0;
    if (capacity == 0) {
        return;
    }
    while (src[i] != 0 && i + 1 < capacity) {
        dst[i] = src[i];
        i = i + 1;
    }
    dst[i] = 0;
}

void zbrowser_ns_append(uint8_t *dst, uint32_t capacity, const uint8_t *src) {
    uint32_t i;
    uint32_t len;

    len = (uint32_t)os_strlen(dst);
    i = 0;
    while (src[i] != 0 && len + 1 < capacity) {
        dst[len] = src[i];
        len = len + 1;
        i = i + 1;
    }
    dst[len] = 0;
}

void zbrowser_ns_append_dec(uint8_t *dst, uint32_t capacity, uint32_t value) {
    uint8_t digits[16];
    uint32_t count;
    uint32_t i;
    uint32_t len;

    len = (uint32_t)os_strlen(dst);
    if (len + 1 >= capacity) {
        return;
    }
    if (value == 0) {
        dst[len] = 48;
        dst[len + 1] = 0;
        return;
    }

    count = 0;
    while (value != 0 && count < 16) {
        digits[count] = (uint8_t)(48 + (value % 10));
        count = count + 1;
        value = value / 10;
    }
    i = 0;
    while (i < count && len + 1 < capacity) {
        dst[len] = digits[(count - 1) - i];
        len = len + 1;
        i = i + 1;
    }
    dst[len] = 0;
}

void zbrowser_ns_copy_visible_url(uint8_t *dst, uint32_t capacity, uint32_t field_w) {
    uint32_t len;
    uint32_t chars;
    uint32_t start;
    uint32_t i;

    if (capacity == 0) {
        return;
    }
    dst[0] = 0;
    if (field_w > 20) {
        chars = (field_w - 14) / 8;
    } else {
        chars = 1;
    }
    if (chars + 1 > capacity) {
        chars = capacity - 1;
    }
    len = (uint32_t)os_strlen(zbrowser_ns_url);
    start = 0;
    if (len > chars && chars > 3) {
        dst[0] = 46;
        dst[1] = 46;
        dst[2] = 46;
        start = len - (chars - 3);
        i = 3;
    } else {
        i = 0;
    }
    while (start < len && i + 1 < capacity && i < chars) {
        dst[i] = zbrowser_ns_url[start];
        i = i + 1;
        start = start + 1;
    }
    dst[i] = 0;
}

int zbrowser_ns_starts_http(const uint8_t *url) {
    if (url[0] == 104 && url[1] == 116 && url[2] == 116 && url[3] == 112) {
        return 1;
    }
    if (url[0] == 72 && url[1] == 84 && url[2] == 84 && url[3] == 80) {
        return 1;
    }
    return 0;
}

int zbrowser_ns_starts_file_root(const uint8_t *url) {
    if (url[0] == 102 && url[1] == 105 && url[2] == 108 && url[3] == 101 &&
        url[4] == 58 && url[5] == 47 && url[6] == 47 && url[7] == 47) {
        return 1;
    }
    return 0;
}

void zbrowser_ns_strip_file_root(uint8_t *url) {
    uint32_t read_pos;
    uint32_t write_pos;

    if (zbrowser_ns_starts_file_root(url) == 0) {
        return;
    }
    read_pos = 8;
    write_pos = 0;
    while (url[read_pos] != 0) {
        url[write_pos] = url[read_pos];
        write_pos = write_pos + 1;
        read_pos = read_pos + 1;
    }
    url[write_pos] = 0;
}

void zbrowser_ns_copy_local_path(uint8_t *dst, uint32_t capacity, const uint8_t *url) {
    uint32_t i;

    if (capacity == 0) {
        return;
    }
    i = 0;
    while (url[i] != 0 && url[i] != 63 && url[i] != 35 && i + 1 < capacity) {
        dst[i] = url[i];
        i = i + 1;
    }
    dst[i] = 0;
}

void zbrowser_ns_trim_text_end(uint8_t *text) {
    uint32_t len;

    len = (uint32_t)os_strlen(text);
    while (len > 0) {
        if (text[len - 1] != 10 && text[len - 1] != 13 && text[len - 1] != 32 && text[len - 1] != 9) {
            return;
        }
        text[len - 1] = 0;
        len = len - 1;
    }
}

void zbrowser_ns_load_browser_url(void) {
    int size;

    size = os_read_file("browser.url", zbrowser_ns_url, ZBROWSER_NS_URL_CAPACITY - 1);
    if (size <= 0) {
        return;
    }
    zbrowser_ns_url[size] = 0;
    zbrowser_ns_trim_text_end(zbrowser_ns_url);
    if (zbrowser_ns_url[0] == 0) {
        zbrowser_ns_copy(zbrowser_ns_url, ZBROWSER_NS_URL_CAPACITY, "https://de.wikipedia.org");
    }
}

void zbrowser_ns_log_renderer_status(const uint8_t *phase) {
    uint8_t *status;

    status = netsurf_browser_status();
    if (status == 0) {
        return;
    }
    if (os_strcmp(zbrowser_ns_last_renderer_status, status) == 0) {
        return;
    }
    zbrowser_ns_copy(zbrowser_ns_last_renderer_status, ZBROWSER_NS_LINE_CAPACITY, status);
    debug_puts("zbrowser renderer-status\n");
    debug_puts("phase ");
    debug_puts(phase);
    debug_puts("\nstatus ");
    debug_puts(status);
    debug_puts("\nzbrowser redraw-counters full ");
    debug_put_dec64(zbrowser_ns_full_redraw_count);
    debug_puts("\nzbrowser redraw-counters chrome ");
    debug_put_dec64(zbrowser_ns_chrome_redraw_count);
    debug_puts("\nzbrowser redraw-counters page ");
    debug_put_dec64(zbrowser_ns_page_redraw_count);
    debug_puts("\nzbrowser redraw-counters poll-full ");
    debug_put_dec64(zbrowser_ns_poll_full_redraw_count);
    debug_puts("\nzbrowser redraw-counters poll-chrome ");
    debug_put_dec64(zbrowser_ns_poll_chrome_redraw_count);
    debug_puts("\nzbrowser redraw-counters poll-suppressed-full ");
    debug_put_dec64(zbrowser_ns_poll_suppressed_full_count);
    debug_puts("\nzbrowser redraw-counters poll-suppressed-chrome ");
    debug_put_dec64(zbrowser_ns_poll_suppressed_chrome_count);
    debug_puts("\nzbrowser redraw-counters render-fail ");
    debug_put_dec64(zbrowser_ns_render_fail_count);
    debug_puts("\n");
}

