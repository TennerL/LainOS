#define ZBROWSER_ENGINE_LINE_CAPACITY 160
#define ZBROWSER_ENGINE_VISIBLE_LINES 28

extern void draw_text_at_pixel(uint32_t x, uint32_t y, const uint8_t *text, uint32_t fg, uint32_t bg);

global uint8_t zbrowser_engine_line[160];
global uint8_t zbrowser_engine_status_text[128];

void zbrowser_engine_copy(uint8_t *dst, uint32_t capacity, const uint8_t *src) {
    uint32_t i;

    if (capacity == 0) {
        return;
    }
    i = 0;
    while (src[i] != 0 && i + 1 < capacity) {
        dst[i] = src[i];
        i = i + 1;
    }
    dst[i] = 0;
}

uint32_t zbrowser_engine_next_line(const uint8_t *text, uint32_t size, uint32_t pos) {
    while (pos < size && text[pos] != 10) {
        pos = pos + 1;
    }
    if (pos < size && text[pos] == 10) {
        pos = pos + 1;
    }
    return pos;
}

uint32_t zbrowser_engine_pos_for_line(const uint8_t *text, uint32_t size, uint32_t line) {
    uint32_t pos;
    uint32_t n;

    pos = 0;
    n = 0;
    while (n < line && pos < size) {
        pos = zbrowser_engine_next_line(text, size, pos);
        n = n + 1;
    }
    return pos;
}

void zbrowser_engine_copy_line(uint8_t *dst, uint32_t capacity, const uint8_t *text, uint32_t size, uint32_t *pos_ptr) {
    uint32_t pos;
    uint32_t out;
    uint8_t ch;

    if (capacity == 0 || pos_ptr == 0) {
        return;
    }
    pos = *pos_ptr;
    out = 0;
    while (pos < size && out + 1 < capacity) {
        ch = text[pos];
        if (ch == 10 || ch == 13) {
            break;
        }
        if (ch == 9) {
            ch = 32;
        }
        if (ch < 32) {
            ch = 32;
        }
        dst[out] = ch;
        out = out + 1;
        pos = pos + 1;
    }
    dst[out] = 0;
    *pos_ptr = zbrowser_engine_next_line(text, size, pos);
}

export int zbrowser_engine_init(void) {
    zbrowser_engine_copy(zbrowser_engine_status_text,
                         128,
                         "module engine boundary active; C NetSurf object not linked yet");
    return 0;
}

export uint8_t *zbrowser_engine_status(void) {
    return zbrowser_engine_status_text;
}

export int zbrowser_engine_prepare(const uint8_t *url, const uint8_t *html, uint32_t size) {
    if (url == 0 || html == 0 || size == 0) {
        zbrowser_engine_copy(zbrowser_engine_status_text, 128, "engine has no document");
        return -1;
    }
    zbrowser_engine_copy(zbrowser_engine_status_text, 128, "raw document renderer active");
    return 0;
}

export int zbrowser_engine_draw(const uint8_t *html,
                                uint32_t size,
                                uint32_t scroll_line,
                                uint32_t viewport_width,
                                uint32_t viewport_height) {
    uint32_t pos;
    uint32_t line;
    uint32_t y;

    if (html == 0 || size == 0) {
        draw_text_at_pixel(10, 76, "Enter a URL and press Enter. NetSurf will live behind this module engine ABI.", 0xd8e1e8, 0x101820);
        draw_text_at_pixel(10, 98, "Current engine object renders raw fetched bytes and imports no NetSurf kernel APIs.", 0x9fb3c1, 0x101820);
        return 0;
    }

    pos = zbrowser_engine_pos_for_line(html, size, scroll_line);
    line = 0;
    y = 70;
    while (line < ZBROWSER_ENGINE_VISIBLE_LINES && y + 16 < viewport_height && pos < size) {
        zbrowser_engine_copy_line(zbrowser_engine_line, ZBROWSER_ENGINE_LINE_CAPACITY, html, size, &pos);
        draw_text_at_pixel(10, y, zbrowser_engine_line, 0xd8e1e8, 0x101820);
        y = y + 17;
        line = line + 1;
    }
    if (viewport_width == 0) {
        return -1;
    }
    return 0;
}
