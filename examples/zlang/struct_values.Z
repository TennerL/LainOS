struct Point {
    int x;
    int y;
};

struct Box {
    struct Point origin;
    struct Point size;
};

int area(struct Point size) {
    return size.x * size.y;
}

int shifted_x(struct Box box) {
    return box.origin.x + box.size.x;
}

struct Point a;
struct Point b;
struct Box first;
struct Box second;

a.x = 3;
a.y = 4;
b = a;
b.x = b.x + 2;

first.origin = a;
first.size = b;
second = first;
second.origin.x = 7;

return area(b) + shifted_x(second) + first.origin.x;
