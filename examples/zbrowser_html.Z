export int zb_starts_with(const uint8_t *text, const uint8_t *prefix) {
    uint32_t i;

    i = 0;
    while (prefix[i] != 0) {
        if (text[i] != prefix[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

export uint8_t zb_lower_char(uint8_t ch) {
    if (ch >= 65 && ch <= 90) {
        return ch + 32;
    }
    return ch;
}

export int zb_tag_name_is(const uint8_t *html, uint32_t pos, const uint8_t *name) {
    uint32_t i;
    uint8_t ch;

    if (html[pos] != 60) {
        return 0;
    }
    pos = pos + 1;
    if (html[pos] == 47) {
        pos = pos + 1;
    }

    i = 0;
    while (name[i] != 0) {
        if (zb_lower_char(html[pos + i]) != zb_lower_char(name[i])) {
            return 0;
        }
        i = i + 1;
    }

    ch = html[pos + i];
    if (ch == 0 || ch == 9 || ch == 10 || ch == 13 || ch == 32 || ch == 47 || ch == 62) {
        return 1;
    }
    return 0;
}

export int zb_is_closing_tag(const uint8_t *html, uint32_t pos) {
    if (html[pos] == 60 && html[pos + 1] == 47) {
        return 1;
    }
    return 0;
}

export uint32_t zb_skip_tag(const uint8_t *html, uint32_t pos) {
    while (html[pos] != 0 && html[pos] != 62) {
        pos = pos + 1;
    }
    if (html[pos] == 62) {
        pos = pos + 1;
    }
    return pos;
}

export uint32_t zb_skip_until_close_tag(const uint8_t *html, uint32_t pos, const uint8_t *name) {
    while (html[pos] != 0) {
        if (html[pos] == 60 && html[pos + 1] == 47 && zb_tag_name_is(html, pos, name)) {
            return zb_skip_tag(html, pos);
        }
        pos = pos + 1;
    }
    return pos;
}

export uint32_t zb_skip_comment(const uint8_t *html, uint32_t pos) {
    while (html[pos] != 0) {
        if (html[pos] == 45 && html[pos + 1] == 45 && html[pos + 2] == 62) {
            return pos + 3;
        }
        pos = pos + 1;
    }
    return pos;
}

export uint8_t zb_entity_char(const uint8_t *html, uint32_t pos, uint32_t *advance) {
    uint32_t value;
    uint32_t i;
    int digit;

    if (zb_starts_with(html + pos, "&lt;")) {
        *advance = 4;
        return 60;
    }
    if (zb_starts_with(html + pos, "&gt;")) {
        *advance = 4;
        return 62;
    }
    if (zb_starts_with(html + pos, "&amp;")) {
        *advance = 5;
        return 38;
    }
    if (zb_starts_with(html + pos, "&nbsp;")) {
        *advance = 6;
        return 32;
    }
    if (zb_starts_with(html + pos, "&quot;")) {
        *advance = 6;
        return 34;
    }
    if (zb_starts_with(html + pos, "&#39;")) {
        *advance = 5;
        return 39;
    }
    if (html[pos] == 38 && html[pos + 1] == 35) {
        value = 0;
        i = pos + 2;
        if (html[i] == 120 || html[i] == 88) {
            i = i + 1;
            while (html[i] != 0 && html[i] != 59) {
                digit = -1;
                if (html[i] >= 48 && html[i] <= 57) {
                    digit = html[i] - 48;
                } else if (html[i] >= 65 && html[i] <= 70) {
                    digit = html[i] - 55;
                } else if (html[i] >= 97 && html[i] <= 102) {
                    digit = html[i] - 87;
                }
                if (digit < 0) {
                    break;
                }
                value = value * 16 + (uint32_t)digit;
                i = i + 1;
            }
        } else {
            while (html[i] >= 48 && html[i] <= 57) {
                value = value * 10 + (uint32_t)(html[i] - 48);
                i = i + 1;
            }
        }
        if (html[i] == 59 && value != 0) {
            *advance = i - pos + 1;
            if (value == 160) {
                return 32;
            }
            if (value < 128) {
                return (uint8_t)value;
            }
            return 63;
        }
    }
    *advance = 1;
    return 38;
}

uint32_t zb_skip_spaces(const uint8_t *html, uint32_t pos) {
    while (html[pos] == 9 || html[pos] == 10 || html[pos] == 13 || html[pos] == 32) {
        pos = pos + 1;
    }
    return pos;
}

int zb_attr_name_matches(const uint8_t *html, uint32_t pos, const uint8_t *name, uint32_t *after_name) {
    uint32_t i;
    uint8_t ch;

    i = 0;
    while (name[i] != 0) {
        if (zb_lower_char(html[pos + i]) != zb_lower_char(name[i])) {
            return 0;
        }
        i = i + 1;
    }

    ch = html[pos + i];
    if (ch == 0 || ch == 9 || ch == 10 || ch == 13 || ch == 32 || ch == 47 || ch == 61 || ch == 62) {
        *after_name = pos + i;
        return 1;
    }
    return 0;
}

export int zb_attr_value(const uint8_t *html,
                         uint32_t pos,
                         const uint8_t *name,
                         uint8_t *out,
                         uint32_t capacity) {
    uint32_t after_name;
    uint32_t out_pos;
    uint8_t quote;

    if (capacity == 0) {
        return 0;
    }
    out[0] = 0;
    if (html[pos] != 60) {
        return 0;
    }

    pos = pos + 1;
    if (html[pos] == 47) {
        return 0;
    }
    while (html[pos] != 0 &&
           html[pos] != 62 &&
           html[pos] != 9 &&
           html[pos] != 10 &&
           html[pos] != 13 &&
           html[pos] != 32 &&
           html[pos] != 47) {
        pos = pos + 1;
    }

    while (html[pos] != 0 && html[pos] != 62) {
        pos = zb_skip_spaces(html, pos);
        if (html[pos] == 47) {
            pos = pos + 1;
            continue;
        }
        if (html[pos] == 0 || html[pos] == 62) {
            break;
        }

        if (zb_attr_name_matches(html, pos, name, &after_name) != 0) {
            pos = zb_skip_spaces(html, after_name);
            if (html[pos] != 61) {
                return 0;
            }
            pos = zb_skip_spaces(html, pos + 1);
            quote = 0;
            if (html[pos] == 34 || html[pos] == 39) {
                quote = html[pos];
                pos = pos + 1;
            }

            out_pos = 0;
            while (html[pos] != 0 &&
                   ((quote != 0 && html[pos] != quote) ||
                    (quote == 0 && html[pos] != 9 && html[pos] != 10 && html[pos] != 13 && html[pos] != 32 && html[pos] != 62)) &&
                   out_pos + 1 < capacity) {
                if (html[pos] == 38) {
                    uint32_t advance;
                    out[out_pos] = zb_entity_char(html, pos, &advance);
                    pos = pos + advance;
                } else {
                    out[out_pos] = html[pos];
                    pos = pos + 1;
                }
                out_pos = out_pos + 1;
            }
            out[out_pos] = 0;
            return 1;
        }

        while (html[pos] != 0 &&
               html[pos] != 62 &&
               html[pos] != 9 &&
               html[pos] != 10 &&
               html[pos] != 13 &&
               html[pos] != 32) {
            if (html[pos] == 34 || html[pos] == 39) {
                quote = html[pos];
                pos = pos + 1;
                while (html[pos] != 0 && html[pos] != quote) {
                    pos = pos + 1;
                }
                if (html[pos] == quote) {
                    pos = pos + 1;
                }
            } else {
                pos = pos + 1;
            }
        }
    }
    return 0;
}

return 0;
