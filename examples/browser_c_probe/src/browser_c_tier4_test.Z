uint64_t str_len(uint8_t *s) {
    uint64_t len;
    len = 0;
    while (s[len] != 0) {
        len = len + 1;
    }
    return len;
}
uint8_t str_eq(uint8_t *a, uint8_t *b) {
    uint64_t i;
    i = 0;
    while (a[i] != 0 || b[i] != 0) {
        if (a[i] != b[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}
uint8_t *hm_clone_string(uint8_t *key) {
    uint64_t len;
    uint64_t i;
    uint8_t *copy;
    len = str_len(key) + 1;
    copy = malloc(len);
    if (copy == 0) {
        return (uint8_t *)0;
    }
    i = 0;
    while (i < len) {
        copy[i] = key[i];
        i = i + 1;
    }
    return copy;
}
uint32_t hm_hash_string(uint8_t *key) {
    uint32_t hash;
    uint64_t i;
    hash = 2166136261;
    i = 0;
    while (key[i] != 0) {
        hash = hash * 16777619;
        hash = hash ^ key[i];
        i = i + 1;
    }
    return hash;
}
uint8_t hm_eq_string(uint8_t *a, uint8_t *b) {
    return str_eq(a, b);
}
void hm_destroy_string(uint8_t *s) {
    free(s);
}
uint8_t *hm_alloc_value(uint8_t *key) {
    return hm_clone_string(key);
}
void hm_destroy_value(uint8_t *value) {
    free(value);
}
uint8_t hm_iter_count(uint8_t *key, uint8_t *value, uint8_t *ctx) {
    if (str_eq(key, value) != 1) {
        ctx[1] = 1;
    }
    ctx[0] = ctx[0] + 1;
    return 0;
}
uint8_t hm_iter_stop(uint8_t *key, uint8_t *value, uint8_t *ctx) {
    ctx[0] = ctx[0] + 1;
    if (str_eq(key, value) != 1) {
        ctx[1] = 1;
    }
    return 1;
}
void http_test_item_free(uint8_t *base) {
    http_generic_destroy_count = http_generic_destroy_count + 1;
    free(base);
}
struct http_test_item *http_test_item_create(uint8_t tag) {
    struct http_test_item *item;
    item = (struct http_test_item *)malloc(sizeof(struct http_test_item));
    if (item == 0) {
        return (struct http_test_item *)0;
    }
    item->base.next = (struct http__item *)0;
    item->base.destroy = http_test_item_free;
    item->tag = tag;
    return item;
}
int http_test_parse_item(const uint8_t **input, struct http__item **item) {
    const uint8_t *pos;
    struct http_test_item *parsed;
    pos = *input;
    if (pos[0] != 98 && pos[0] != 99) {
        return 4;
    }
    parsed = http_test_item_create(pos[0]);
    if (parsed == 0) {
        return 2;
    }
    *item = (struct http__item *)parsed;
    *input = pos + 1;
    return 0;
}
uint8_t str_contains(uint8_t *haystack, uint8_t *needle) {
    uint64_t i;
    uint64_t j;
    if (haystack == 0 || needle == 0) {
        return 0;
    }
    if (needle[0] == 0) {
        return 1;
    }
    i = 0;
    while (haystack[i] != 0) {
        j = 0;
        while (needle[j] != 0 && haystack[i + j] == needle[j]) {
            j = j + 1;
        }
        if (needle[j] == 0) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
