#pragma once

struct JpgImage {
    uint32_t width;
    uint32_t height;
    uint32_t components;
    uint32_t stride;
};

extern int jpg_probe(const uint8_t *data, uint32_t size, struct JpgImage *out_image);
extern int jpg_decode_rgb24(const uint8_t *data,
                            uint32_t size,
                            uint8_t *rgb,
                            uint32_t rgb_capacity,
                            struct JpgImage *out_image);
extern int jpg_decode_to_screen(const uint8_t *data,
                                uint32_t size,
                                uint32_t origin_x,
                                uint32_t origin_y,
                                struct JpgImage *out_image);
extern uint32_t jpg_entropy_error_detail(void);
extern uint32_t jpg_entropy_error_block(void);
extern uint32_t jpg_huffman_code_count(uint32_t slot, uint32_t length);
extern uint32_t jpg_huffman_value(uint32_t slot, uint32_t index);
extern int jpg_entropy_probe_first(const uint8_t *data, uint32_t size);
extern int jpg_decode_first_block_probe(const uint8_t *data, uint32_t size);
extern int jpg_decode_two_block_probe(const uint8_t *data, uint32_t size);
extern int jpg_decode_first_ac_probe(const uint8_t *data, uint32_t size);
extern uint32_t jpg_debug_scan_offset(void);
extern uint32_t jpg_debug_stream_pos(void);
extern uint32_t jpg_debug_bits_left(void);
extern uint32_t jpg_debug_zigzag(uint32_t index);
extern uint32_t jpg_debug_byte_at(const uint8_t *data, uint32_t pos);
extern int jpg_debug_first_entropy_bits(const uint8_t *data, uint32_t size);
