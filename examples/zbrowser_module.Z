        if (y + 14 < h - 18 && w > 24 && flow_box_w() > 16) {
            gfx_fill_rect(flow_box_x() + 4, y, flow_box_w() - 8, 14, 0xf8f9fa);
        }
    }
}

void submit_focused_form(void) {
    uint32_t i;
    uint32_t first;
    uint8_t *name;
    uint8_t *value;

    if (zbrowser_input_count == 0) {
        return;
    }
    if (zbrowser_form_action[0] == 0) {
        copy_text(zbrowser_url_tmp, ZBROWSER_URL_CAPACITY, zbrowser_url);
    } else {
        make_absolute_url(zbrowser_url, zbrowser_form_action, zbrowser_url_tmp, ZBROWSER_URL_CAPACITY);
    }

    first = 1;
    i = 0;
    while (i < zbrowser_input_count) {
        name = input_name_slot(i);
        value = input_value_slot(i);
        if (name[0] != 0) {
            if (first != 0) {
                if (text_contains_ci(zbrowser_url_tmp, "?") != 0) {
                    append_char_limited(zbrowser_url_tmp, ZBROWSER_URL_CAPACITY, 38);
                } else {
                    append_char_limited(zbrowser_url_tmp, ZBROWSER_URL_CAPACITY, 63);
                }
                first = 0;
            } else {
                append_char_limited(zbrowser_url_tmp, ZBROWSER_URL_CAPACITY, 38);
            }
            url_append_encoded(zbrowser_url_tmp, ZBROWSER_URL_CAPACITY, name);
            append_char_limited(zbrowser_url_tmp, ZBROWSER_URL_CAPACITY, 61);
            url_append_encoded(zbrowser_url_tmp, ZBROWSER_URL_CAPACITY, value);
        }
        i = i + 1;
    }
    navigate_to(zbrowser_url_tmp);
}

void blank_line(void) {
    uint32_t draw_y;
    uint32_t line_h;

    flush_line();
    remember_blank_line_cache(zbrowser_line_no);
    if (zbrowser_line_no >= zbrowser_scroll && zbrowser_should_draw_line(zbrowser_line_no) != 0) {
        line_h = zbrowser_line_height();
        draw_y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
        if (zbrowser_bg_band_active != 0 && draw_y + line_h < gfx_height()) {
            draw_line_background_band(draw_y, line_h, text_bg_for_draw());
        }
    }
    zbrowser_line_no = zbrowser_line_no + 1;
    zbrowser_last_space = 0;
}

void emit_char(uint8_t ch) {
    uint32_t max_cols;
    uint32_t indent;
    uint32_t i;
    uint32_t preserve_space;

    preserve_space = 0;
    if (zbrowser_white_space == WEB_STYLE_WHITE_SPACE_PRE ||
        zbrowser_white_space == WEB_STYLE_WHITE_SPACE_PRE_WRAP) {
        preserve_space = 1;
    }
    if (ch == 9) {
        ch = 32;
    }
    if (ch == 10 || ch == 13) {
        if (zbrowser_white_space == WEB_STYLE_WHITE_SPACE_PRE ||
            zbrowser_white_space == WEB_STYLE_WHITE_SPACE_PRE_WRAP ||
            zbrowser_white_space == WEB_STYLE_WHITE_SPACE_PRE_LINE) {
            flush_line();
            return;
        }
        ch = 32;
    }
    if (ch == 32) {
        if (preserve_space == 0 && (zbrowser_line_len == 0 || zbrowser_last_space != 0)) {
            return;
        }
        zbrowser_last_space = 1;
    } else {
        zbrowser_last_space = 0;
    }

    if (ch < 32) {
        return;
    }

    ch = transform_text_char(ch);
    max_cols = zbrowser_line_max_cols();
    if (zbrowser_line_len == 0 && ch != 32) {
        indent = current_indent_cols();
        i = 0;
        while (i < indent && zbrowser_line_len + 1 < max_cols) {
            zbrowser_line[zbrowser_line_len] = 32;
            zbrowser_line_fg[zbrowser_line_len] = zbrowser_text_fg;
            zbrowser_line_len = zbrowser_line_len + 1;
            i = i + 1;
        }
    }
    if (zbrowser_line_len + 1 >= max_cols) {
        flush_line();
        if (ch != 32) {
            indent = current_indent_cols();
            i = 0;
            while (i < indent && zbrowser_line_len + 1 < max_cols) {
                zbrowser_line[zbrowser_line_len] = 32;
                zbrowser_line_fg[zbrowser_line_len] = zbrowser_text_fg;
                zbrowser_line_len = zbrowser_line_len + 1;
                i = i + 1;
            }
        }
    }
    if (!(ch == 32 && zbrowser_line_len == 0)) {
        zbrowser_line[zbrowser_line_len] = ch;
        zbrowser_line_fg[zbrowser_line_len] = zbrowser_text_fg;
        zbrowser_line_len = zbrowser_line_len + 1;
        if (zbrowser_active_link < zbrowser_link_count) {
            zbrowser_link_end_lines[zbrowser_active_link] = zbrowser_line_no;
            zbrowser_link_end_cols[zbrowser_active_link] = zbrowser_line_len;
        }
    }
}

uint32_t utf8_advance(const uint8_t *text, uint32_t pos) {
    uint8_t ch;

    ch = text[pos];
    if (ch < 128) {
        return 1;
    }
    if (ch >= 240 && text[pos + 1] != 0 && text[pos + 2] != 0 && text[pos + 3] != 0) {
        return 4;
    }
    if (ch >= 224 && text[pos + 1] != 0 && text[pos + 2] != 0) {
        return 3;
    }
    if (ch >= 192 && text[pos + 1] != 0) {
        return 2;
    }
    return 1;
}

void emit_text(const uint8_t *text) {
    uint32_t i;
    uint8_t ch;

    i = 0;
    while (text[i] != 0) {
        ch = text[i];
        if (ch >= 128) {
            emit_char(63);
            i = i + utf8_advance(text, i);
        } else {
            emit_char(ch);
            i = i + 1;
        }
    }
}

void emit_uint_value(uint32_t value) {
    uint8_t digits[12];
    uint32_t count;

    count = 0;
    if (value == 0) {
        emit_char(48);
        return;
    }
    while (value != 0 && count < 11) {
        digits[count] = (uint8_t)(48 + (value % 10));
        value = value / 10;
        count = count + 1;
    }
    while (count > 0) {
        count = count - 1;
        emit_char(digits[count]);
    }
}

void emit_list_prefix(const uint8_t *html, uint32_t pos) {
    uint32_t i;
    uint32_t max_indent;
    uint32_t depth;
    uint32_t marker;

    i = 0;
    max_indent = zbrowser_list_depth;
    if (load_web_style(html, pos) != 0 &&
        zbrowser_web_list_style_position == WEB_STYLE_LIST_POSITION_INSIDE) {
        max_indent = 0;
    }
    if (max_indent > 5) {
        max_indent = 5;
    }
    while (i < max_indent) {
        emit_text("  ");
        i = i + 1;
    }
    marker = WEB_STYLE_LIST_DISC;
    if (load_web_style(html, pos) != 0) {
        marker = zbrowser_web_list_style_type;
    }
    if (marker == WEB_STYLE_LIST_NONE) {
        return;
    }
    depth = zbrowser_list_depth;
    if (depth > 0 && zbrowser_list_ordered[depth - 1] != 0) {
        zbrowser_list_counter[depth - 1] = zbrowser_list_counter[depth - 1] + 1;
        emit_uint_value(zbrowser_list_counter[depth - 1]);
        emit_text(". ");
        return;
    }
    if (marker == WEB_STYLE_LIST_CIRCLE) {
        emit_text("o ");
    } else if (marker == WEB_STYLE_LIST_SQUARE) {
        emit_text("* ");
    } else {
        emit_text("- ");
    }
}

uint32_t render_inline_until_close_tag(const uint8_t *html, uint32_t pos, const uint8_t *name) {
    uint32_t advance;
    uint8_t ch;

    while (html[pos] != 0) {
        ch = html[pos];
        if (ch == 60) {
            if (zb_is_closing_tag(html, pos) != 0 && zb_tag_name_is(html, pos, name) != 0) {
                return zb_skip_tag(html, pos);
            }
            pos = zb_skip_tag(html, pos);
        } else if (ch == 38) {
            ch = zb_entity_char(html, pos, &advance);
            emit_char(ch);
            pos = pos + advance;
        } else if (ch >= 128) {
            emit_char(63);
            pos = pos + utf8_advance(html, pos);
        } else {
            emit_char(ch);
            pos = pos + 1;
        }
    }
    return pos;
}

void render_page_background_image(void) {
    uint32_t slot;
    uint32_t h;
    uint32_t bg_y;
    uint32_t bg_h;

    if (zbrowser_page_bg_has_img == 0 || zbrowser_page_bg_url[0] == 0 ||
        zbrowser_image_buffer_addr == 0) {
        return;
    }
    h = gfx_height();
    if (h <= 64) {
        return;
    }
    bg_y = 42;
    bg_h = h - 62;
    slot = find_cached_image_slot(zbrowser_page_bg_url);
    if (slot == 9999) {
        remember_deferred_image_fetch(zbrowser_page_bg_url);
        return;
    }
    zbrowser_image_draw_result = image_decode_to_screen_tiled(image_buffer_slot(slot),
                                                              (uint32_t)zbrowser_cached_image_sizes[slot],
                                                              0,
                                                              bg_y,
                                                              gfx_width(),
                                                              bg_h);
}

int anchor_next_is_image(const uint8_t *html, uint32_t pos) {
    uint32_t next;

    next = zb_skip_tag(html, pos);
    while (html[next] == 32 || html[next] == 9 || html[next] == 10 || html[next] == 13) {
        next = next + 1;
    }
    if (html[next] == 60 &&
        (zb_tag_name_is(html, next, "img") != 0 ||
         image_source_for_tag(html, next, zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0)) {
        return 1;
    }
    return 0;
}

int dom_stack_has_tag(uint32_t tag) {
    uint32_t match;

    if (tag == 0) {
        return 0;
    }
    match = zbrowser_dom_stack_depth;
    while (match > 0) {
        if (zbrowser_dom_stack_tags[match - 1] == tag) {
            return 1;
        }
        match = match - 1;
    }
    return 0;
}

int tag_has_css_identity(const uint8_t *html, uint32_t pos) {
    if (zb_attr_value(html, pos, "style", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 ||
        zb_attr_value(html, pos, "class", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 ||
        zb_attr_value(html, pos, "id", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
        return 1;
    }
    return 0;
}

int computed_style_affects_text_scope(const uint8_t *html, uint32_t pos) {
    uint32_t layout_bits;

    if (zb_is_closing_tag(html, pos) != 0 ||
        zb_tag_is_void(html, pos) != 0 ||
        zb_tag_self_closes(html, pos) != 0 ||
        load_web_style(html, pos) == 0) {
        return 0;
    }
    if (zbrowser_web_style_display != WEB_STYLE_DISPLAY_INLINE ||
        zbrowser_web_style_float != WEB_STYLE_FLOAT_NONE ||
        zbrowser_web_style_position != WEB_STYLE_POS_STATIC) {
        return 1;
    }
    layout_bits = zbrowser_web_style_flags &
        (WEB_STYLE_FLAG_HAS_TEXT_ALIGN +
         WEB_STYLE_FLAG_HAS_BG_COLOR +
         WEB_STYLE_FLAG_HAS_MARGIN +
         WEB_STYLE_FLAG_HAS_PADDING +
         WEB_STYLE_FLAG_HAS_BORDER +
         WEB_STYLE_FLAG_BORDER_COLOR +
         WEB_STYLE_FLAG_FONT_BOLD +
         WEB_STYLE_FLAG_FONT_ITALIC +
         WEB_STYLE_FLAG_TEXT_UNDERLINE +
         WEB_STYLE_FLAG_HAS_WIDTH +
         WEB_STYLE_FLAG_HAS_HEIGHT +
         WEB_STYLE_FLAG_HAS_MIN_WIDTH +
         WEB_STYLE_FLAG_HAS_MAX_WIDTH +
         WEB_STYLE_FLAG_HAS_MIN_HEIGHT +
         WEB_STYLE_FLAG_HAS_MAX_HEIGHT);
    if (layout_bits != 0) {
        return 1;
    }
    if (tag_has_css_identity(html, pos) != 0 &&
        web_style_has_flag(WEB_STYLE_FLAG_HAS_COLOR) != 0 &&
        zbrowser_web_style_color != zbrowser_text_fg) {
        return 1;
    }
    if (zbrowser_web_font_size != 16 ||
        zbrowser_web_line_height != 19 ||
        zbrowser_web_text_transform != WEB_STYLE_TEXT_TRANSFORM_NONE ||
        zbrowser_web_white_space != WEB_STYLE_WHITE_SPACE_NORMAL ||
        zbrowser_web_list_style_type != WEB_STYLE_LIST_DISC ||
        zbrowser_web_list_style_position != WEB_STYLE_LIST_POSITION_OUTSIDE ||
        zbrowser_web_direction != WEB_STYLE_DIRECTION_LTR ||
        zbrowser_web_opacity != 255 ||
        zbrowser_web_letter_spacing != 0 ||
        zbrowser_web_word_spacing != 0) {
        return 1;
    }
    return 0;
}

int tag_affects_text_style(const uint8_t *html, uint32_t pos) {
    if (zb_is_closing_tag(html, pos) != 0) {
        return dom_stack_has_tag(dom_tag_id(html, pos));
    }
    if (zb_tag_is_void(html, pos) != 0 || zb_tag_self_closes(html, pos) != 0) {
        return 0;
    }
    if (zb_tag_name_is(html, pos, "div") ||
        zb_tag_name_is(html, pos, "span") ||
        zb_tag_name_is(html, pos, "section") ||
        zb_tag_name_is(html, pos, "article") ||
        zb_tag_name_is(html, pos, "main") ||
        zb_tag_name_is(html, pos, "nav") ||
        zb_tag_name_is(html, pos, "center") ||
        zb_tag_name_is(html, pos, "header") ||
        zb_tag_name_is(html, pos, "footer") ||
        zb_tag_name_is(html, pos, "aside") ||
        zb_tag_name_is(html, pos, "form") ||
        zb_tag_name_is(html, pos, "a") ||
        zb_tag_name_is(html, pos, "font") ||
        zb_tag_name_is(html, pos, "b") ||
        zb_tag_name_is(html, pos, "strong") ||
        zb_tag_name_is(html, pos, "i") ||
        zb_tag_name_is(html, pos, "em") ||
        zb_tag_name_is(html, pos, "small") ||
        zb_tag_name_is(html, pos, "blockquote") ||
        zb_tag_name_is(html, pos, "th") ||
        zb_tag_name_is(html, pos, "td") ||
        zb_tag_name_is(html, pos, "mark") ||
        zb_tag_name_is(html, pos, "code") ||
        zb_tag_name_is(html, pos, "pre") ||
        zb_tag_name_is(html, pos, "p") ||
        zb_tag_name_is(html, pos, "table") ||
        zb_tag_name_is(html, pos, "tr") ||
        zb_tag_name_is(html, pos, "ul") ||
        zb_tag_name_is(html, pos, "ol") ||
        zb_tag_name_is(html, pos, "li") ||
        zb_tag_name_is(html, pos, "dt") ||
        zb_tag_name_is(html, pos, "dd") ||
        zb_tag_name_is(html, pos, "figcaption") ||
        zb_tag_name_is(html, pos, "caption") ||
        tag_is_native_heading(html, pos) != 0 ||
        tag_has_heading_role(html, pos) != 0) {
        return 1;
    }
    if (computed_style_affects_text_scope(html, pos) != 0) {
        return 1;
    }
    return 0;
}

int tag_is_block_flow(const uint8_t *html, uint32_t pos) {
    if (zb_is_closing_tag(html, pos) != 0) {
        if (dom_stack_has_tag(dom_tag_id(html, pos)) != 0 &&
            zbrowser_css_scope_block_flow != 0) {
            return 1;
        }
    }
    if (load_web_style(html, pos) != 0) {
        if (zbrowser_web_style_display == WEB_STYLE_DISPLAY_INLINE) {
            return 0;
        }
        if (zbrowser_web_style_display == WEB_STYLE_DISPLAY_BLOCK ||
            zbrowser_web_style_display == WEB_STYLE_DISPLAY_LIST_ITEM ||
            zbrowser_web_style_display == WEB_STYLE_DISPLAY_FLEX ||
            zbrowser_web_style_display == WEB_STYLE_DISPLAY_TABLE ||
            zbrowser_web_style_display == WEB_STYLE_DISPLAY_TABLE_ROW) {
            return 1;
        }
    }
    if (style_property_has(html, pos, "display", "inline") != 0) {
        return 0;
    }
    if (zb_tag_name_is(html, pos, "address") ||
        zb_tag_name_is(html, pos, "article") ||
        zb_tag_name_is(html, pos, "aside") ||
        zb_tag_name_is(html, pos, "blockquote") ||
        zb_tag_name_is(html, pos, "dd") ||
        zb_tag_name_is(html, pos, "details") ||
        zb_tag_name_is(html, pos, "div") ||
        zb_tag_name_is(html, pos, "dl") ||
        zb_tag_name_is(html, pos, "dt") ||
        zb_tag_name_is(html, pos, "fieldset") ||
        zb_tag_name_is(html, pos, "figcaption") ||
        zb_tag_name_is(html, pos, "figure") ||
        zb_tag_name_is(html, pos, "footer") ||
        zb_tag_name_is(html, pos, "form") ||
        tag_is_native_heading(html, pos) != 0 ||
        tag_has_heading_role(html, pos) != 0 ||
        zb_tag_name_is(html, pos, "header") ||
        zb_tag_name_is(html, pos, "hr") ||
        zb_tag_name_is(html, pos, "li") ||
        zb_tag_name_is(html, pos, "main") ||
        zb_tag_name_is(html, pos, "nav") ||
        zb_tag_name_is(html, pos, "ol") ||
        zb_tag_name_is(html, pos, "p") ||
        zb_tag_name_is(html, pos, "pre") ||
        zb_tag_name_is(html, pos, "section") ||
        zb_tag_name_is(html, pos, "summary") ||
        zb_tag_name_is(html, pos, "table") ||
        zb_tag_name_is(html, pos, "tr") ||
        zb_tag_name_is(html, pos, "ul")) {
        return 1;
    }
    return 0;
}

uint32_t dom_generic_tag_id(const uint8_t *html, uint32_t pos) {
    uint32_t name_pos;
    uint32_t hash;
    uint32_t count;
    uint8_t ch;

    if (html[pos] != 60) {
        return 0;
    }
    name_pos = pos + 1;
    if (html[name_pos] == 47) {
        name_pos = name_pos + 1;
    }
    while (css_space_char(html[name_pos]) != 0) {
        name_pos = name_pos + 1;
    }
    hash = 5381;
    count = 0;
    while (selector_name_char(html[name_pos]) != 0) {
        ch = zb_lower_char(html[name_pos]);
        hash = (hash * 33 + (uint32_t)ch) % 1000000;
        count = count + 1;
        name_pos = name_pos + 1;
    }
    if (count == 0) {
        return 0;
    }
    return ZBROWSER_DOM_TAG_GENERIC_BASE + hash;
}

uint32_t dom_tag_id(const uint8_t *html, uint32_t pos) {
    if (zb_tag_name_is(html, pos, "p")) {
        return ZBROWSER_DOM_TAG_P;
    }
    if (zb_tag_name_is(html, pos, "li")) {
        return ZBROWSER_DOM_TAG_LI;
    }
    if (zb_tag_name_is(html, pos, "dt")) {
        return ZBROWSER_DOM_TAG_DT;
    }
    if (zb_tag_name_is(html, pos, "dd")) {
        return ZBROWSER_DOM_TAG_DD;
    }
    if (zb_tag_name_is(html, pos, "tr")) {
        return ZBROWSER_DOM_TAG_TR;
    }
    if (zb_tag_name_is(html, pos, "td")) {
        return ZBROWSER_DOM_TAG_TD;
    }
    if (zb_tag_name_is(html, pos, "th")) {
        return ZBROWSER_DOM_TAG_TH;
    }
    if (zb_tag_name_is(html, pos, "table")) {
        return ZBROWSER_DOM_TAG_TABLE;
    }
    if (zb_tag_name_is(html, pos, "ul")) {
        return ZBROWSER_DOM_TAG_UL;
    }
    if (zb_tag_name_is(html, pos, "ol")) {
        return ZBROWSER_DOM_TAG_OL;
    }
    if (zb_tag_name_is(html, pos, "div")) {
        return ZBROWSER_DOM_TAG_DIV;
    }
    if (zb_tag_name_is(html, pos, "section")) {
        return ZBROWSER_DOM_TAG_SECTION;
    }
    if (zb_tag_name_is(html, pos, "article")) {
        return ZBROWSER_DOM_TAG_ARTICLE;
    }
    if (zb_tag_name_is(html, pos, "main")) {
        return ZBROWSER_DOM_TAG_MAIN;
    }
    if (zb_tag_name_is(html, pos, "nav")) {
        return ZBROWSER_DOM_TAG_NAV;
    }
    if (zb_tag_name_is(html, pos, "header")) {
        return ZBROWSER_DOM_TAG_HEADER;
    }
    if (zb_tag_name_is(html, pos, "footer")) {
        return ZBROWSER_DOM_TAG_FOOTER;
    }
    if (zb_tag_name_is(html, pos, "aside")) {
        return ZBROWSER_DOM_TAG_ASIDE;
    }
    if (zb_tag_name_is(html, pos, "form")) {
        return ZBROWSER_DOM_TAG_FORM;
    }
    if (zb_tag_name_is(html, pos, "a")) {
        return ZBROWSER_DOM_TAG_A;
    }
    if (zb_tag_name_is(html, pos, "span")) {
        return ZBROWSER_DOM_TAG_SPAN;
    }
    if (zb_tag_name_is(html, pos, "h1")) {
        return ZBROWSER_DOM_TAG_H1;
    }
    if (zb_tag_name_is(html, pos, "h2")) {
        return ZBROWSER_DOM_TAG_H2;
    }
    if (zb_tag_name_is(html, pos, "h3")) {
        return ZBROWSER_DOM_TAG_H3;
    }
    if (zb_tag_name_is(html, pos, "h4")) {
        return ZBROWSER_DOM_TAG_H4;
    }
    if (zb_tag_name_is(html, pos, "h5")) {
        return ZBROWSER_DOM_TAG_H5;
    }
    if (zb_tag_name_is(html, pos, "h6")) {
        return ZBROWSER_DOM_TAG_H6;
    }
    if (zb_tag_name_is(html, pos, "blockquote")) {
        return ZBROWSER_DOM_TAG_BLOCKQUOTE;
    }
    if (zb_tag_name_is(html, pos, "pre")) {
        return ZBROWSER_DOM_TAG_PRE;
    }
    if (zb_tag_name_is(html, pos, "b")) {
        return ZBROWSER_DOM_TAG_B;
    }
    if (zb_tag_name_is(html, pos, "strong")) {
        return ZBROWSER_DOM_TAG_STRONG;
    }
    if (zb_tag_name_is(html, pos, "i")) {
        return ZBROWSER_DOM_TAG_I;
    }
    if (zb_tag_name_is(html, pos, "em")) {
        return ZBROWSER_DOM_TAG_EM;
    }
    if (zb_tag_name_is(html, pos, "small")) {
        return ZBROWSER_DOM_TAG_SMALL;
    }
    if (zb_tag_name_is(html, pos, "mark")) {
        return ZBROWSER_DOM_TAG_MARK;
    }
    if (zb_tag_name_is(html, pos, "code")) {
        return ZBROWSER_DOM_TAG_CODE;
    }
    if (zb_tag_name_is(html, pos, "center")) {
        return ZBROWSER_DOM_TAG_CENTER;
    }
    if (zb_tag_name_is(html, pos, "font")) {
        return ZBROWSER_DOM_TAG_FONT;
    }
    if (zb_tag_name_is(html, pos, "figcaption")) {
        return ZBROWSER_DOM_TAG_FIGCAPTION;
    }
    if (zb_tag_name_is(html, pos, "caption")) {
        return ZBROWSER_DOM_TAG_CAPTION;
    }
    return dom_generic_tag_id(html, pos);
}

int dom_new_tag_closes_p(const uint8_t *html, uint32_t pos) {
    if (zb_tag_name_is(html, pos, "address") ||
        zb_tag_name_is(html, pos, "article") ||
        zb_tag_name_is(html, pos, "aside") ||
        zb_tag_name_is(html, pos, "blockquote") ||
        zb_tag_name_is(html, pos, "details") ||
        zb_tag_name_is(html, pos, "div") ||
        zb_tag_name_is(html, pos, "dl") ||
        zb_tag_name_is(html, pos, "fieldset") ||
        zb_tag_name_is(html, pos, "figcaption") ||
        zb_tag_name_is(html, pos, "figure") ||
        zb_tag_name_is(html, pos, "footer") ||
        zb_tag_name_is(html, pos, "form") ||
        tag_is_native_heading(html, pos) != 0 ||
        tag_has_heading_role(html, pos) != 0 ||
        zb_tag_name_is(html, pos, "header") ||
        zb_tag_name_is(html, pos, "hr") ||
        zb_tag_name_is(html, pos, "main") ||
        zb_tag_name_is(html, pos, "nav") ||
        zb_tag_name_is(html, pos, "ol") ||
        zb_tag_name_is(html, pos, "p") ||
        zb_tag_name_is(html, pos, "pre") ||
        zb_tag_name_is(html, pos, "section") ||
        zb_tag_name_is(html, pos, "table") ||
        zb_tag_name_is(html, pos, "ul")) {
        return 1;
    }
    return 0;
}

int dom_open_closes_top(uint32_t top, uint32_t new_tag, const uint8_t *html, uint32_t pos) {
    if (top == ZBROWSER_DOM_TAG_P && dom_new_tag_closes_p(html, pos) != 0) {
        return 1;
    }
    if (top == ZBROWSER_DOM_TAG_LI && new_tag == ZBROWSER_DOM_TAG_LI) {
        return 1;
    }
    if ((top == ZBROWSER_DOM_TAG_DT || top == ZBROWSER_DOM_TAG_DD) &&
        (new_tag == ZBROWSER_DOM_TAG_DT || new_tag == ZBROWSER_DOM_TAG_DD)) {
        return 1;
    }
    if ((top == ZBROWSER_DOM_TAG_TD || top == ZBROWSER_DOM_TAG_TH) &&
        (new_tag == ZBROWSER_DOM_TAG_TD ||
         new_tag == ZBROWSER_DOM_TAG_TH ||
         new_tag == ZBROWSER_DOM_TAG_TR)) {
        return 1;
    }
    if (top == ZBROWSER_DOM_TAG_TR && new_tag == ZBROWSER_DOM_TAG_TR) {
        return 1;
    }
    return 0;
}

void apply_css_scope_end_spacing(void) {
    if (zbrowser_css_bottom_space >= 2) {
        blank_line();
    } else if (zbrowser_css_bottom_space == 1) {
        flush_line();
    }
}

void dom_pop_implicit(void) {
    uint32_t top;

    if (zbrowser_dom_stack_depth == 0) {
        return;
    }
    top = zbrowser_dom_stack_tags[zbrowser_dom_stack_depth - 1];
    if (top == ZBROWSER_DOM_TAG_TD || top == ZBROWSER_DOM_TAG_TH) {
        finish_table_cell(0);
    } else if (top == ZBROWSER_DOM_TAG_TR) {
        finish_table_row();
    } else {
        flush_line();
    }
    apply_css_scope_end_spacing();
    pop_text_style();
    zbrowser_dom_stack_depth = zbrowser_dom_stack_depth - 1;
}

void apply_implicit_dom_closes(const uint8_t *html, uint32_t pos) {
    uint32_t new_tag;
    uint32_t top;

    if (zb_is_closing_tag(html, pos) != 0) {
        return;
    }
    new_tag = dom_tag_id(html, pos);
    while (zbrowser_dom_stack_depth > 0) {
        top = zbrowser_dom_stack_tags[zbrowser_dom_stack_depth - 1];
        if (dom_open_closes_top(top, new_tag, html, pos) == 0) {
            return;
        }
        dom_pop_implicit();
    }
}

void dom_push_tag(const uint8_t *html, uint32_t pos) {
    uint32_t tag;

    tag = dom_tag_id(html, pos);
    if (tag == 0 || zbrowser_dom_stack_depth >= ZBROWSER_STYLE_STACK_MAX) {
        return;
    }
    zbrowser_dom_stack_tags[zbrowser_dom_stack_depth] = tag;
    zbrowser_dom_stack_depth = zbrowser_dom_stack_depth + 1;
}

void dom_close_tag(const uint8_t *html, uint32_t pos) {
    uint32_t tag;
    uint32_t match;

    tag = dom_tag_id(html, pos);
    if (tag == 0) {
        return;
    }
    match = zbrowser_dom_stack_depth;
    while (match > 0) {
        if (zbrowser_dom_stack_tags[match - 1] == tag) {
            while (zbrowser_dom_stack_depth >= match) {
                apply_css_scope_end_spacing();
                pop_text_style();
                zbrowser_dom_stack_depth = zbrowser_dom_stack_depth - 1;
            }
            return;
        }
        match = match - 1;
    }
}

int tag_open_implicitly_closes_name(const uint8_t *html, uint32_t pos, const uint8_t *name) {
    if (zb_is_closing_tag(html, pos) != 0) {
        return 0;
    }
    if (text_equal_ci(name, "p") != 0 && dom_new_tag_closes_p(html, pos) != 0) {
        return 1;
    }
    if (text_equal_ci(name, "li") != 0 && zb_tag_name_is(html, pos, "li") != 0) {
        return 1;
    }
    if ((text_equal_ci(name, "dt") != 0 || text_equal_ci(name, "dd") != 0) &&
        (zb_tag_name_is(html, pos, "dt") != 0 || zb_tag_name_is(html, pos, "dd") != 0)) {
        return 1;
    }
    if ((text_equal_ci(name, "td") != 0 || text_equal_ci(name, "th") != 0) &&
        (zb_tag_name_is(html, pos, "td") != 0 ||
         zb_tag_name_is(html, pos, "th") != 0 ||
         zb_tag_name_is(html, pos, "tr") != 0)) {
        return 1;
    }
    if (text_equal_ci(name, "tr") != 0 && zb_tag_name_is(html, pos, "tr") != 0) {
        return 1;
    }
    return 0;
}

uint32_t skip_raw_text_element(const uint8_t *html, uint32_t pos) {
    if (zb_is_closing_tag(html, pos) != 0) {
        return 0;
    }
    if (zb_tag_name_is(html, pos, "script") != 0) {
        return zb_skip_until_close_tag(html, zb_skip_tag(html, pos), "script");
    }
    if (zb_tag_name_is(html, pos, "style") != 0) {
        return zb_skip_until_close_tag(html, zb_skip_tag(html, pos), "style");
    }
    if (zb_tag_name_is(html, pos, "title") != 0) {
        return zb_skip_until_close_tag(html, zb_skip_tag(html, pos), "title");
    }
    if (zb_tag_name_is(html, pos, "textarea") != 0) {
        return zb_skip_until_close_tag(html, zb_skip_tag(html, pos), "textarea");
    }
    return 0;
}

uint32_t skip_element_contents_by_name(const uint8_t *html, uint32_t pos, const uint8_t *name) {
    uint32_t depth;
    uint32_t raw_end;

    depth = 1;
    while (html[pos] != 0) {
        if (zb_starts_with(html + pos, "<!--") != 0) {
            pos = zb_skip_comment(html, pos + 4);
            continue;
        }
        if (html[pos] == 60) {
            if (depth == 1 && tag_open_implicitly_closes_name(html, pos, name) != 0) {
                return pos;
            }
            if (zb_tag_name_is(html, pos, name) != 0) {
                if (zb_is_closing_tag(html, pos) != 0) {
                    if (depth <= 1) {
                        return zb_skip_tag(html, pos);
                    }
                    depth = depth - 1;
                } else if (zb_tag_self_closes(html, pos) == 0 && zb_tag_is_void(html, pos) == 0) {
                    depth = depth + 1;
                }
                pos = zb_skip_tag(html, pos);
                continue;
            }
            raw_end = skip_raw_text_element(html, pos);
            if (raw_end != 0) {
                pos = raw_end;
                continue;
            }
            pos = zb_skip_tag(html, pos);
            continue;
        }
        pos = pos + 1;
    }
    return pos;
}

uint32_t skip_current_element_content(const uint8_t *html, uint32_t pos) {
    uint32_t after_tag;
    uint32_t name_pos;
    uint32_t out;

    if (html[pos] != 60 || zb_is_closing_tag(html, pos) != 0) {
        return 0;
    }
    after_tag = zb_skip_tag(html, pos);
    if (zb_tag_is_void(html, pos) != 0 || zb_tag_self_closes(html, pos) != 0) {
        return after_tag;
    }
    name_pos = pos + 1;
    while (css_space_char(html[name_pos]) != 0) {
        name_pos = name_pos + 1;
    }
    out = 0;
    while (selector_name_char(html[name_pos]) != 0 && out + 1 < ZBROWSER_TAG_NAME_CAPACITY) {
        zbrowser_skip_tag_name[out] = html[name_pos];
        out = out + 1;
        name_pos = name_pos + 1;
    }
    zbrowser_skip_tag_name[out] = 0;
    if (out == 0) {
        return 0;
    }
    return skip_element_contents_by_name(html, after_tag, zbrowser_skip_tag_name);
}

void render_html(const uint8_t *html) {
    uint32_t pos;
    uint32_t advance;
    uint32_t input_index;
    uint32_t line_limit;
    uint32_t skip_pos;
    uint32_t transient_style;
    uint8_t *input_value;
    uint8_t ch;

    zbrowser_layout_region = ZBROWSER_REGION_ARTICLE;
    zbrowser_y = 52;
    prepare_web_styles_for_render(html);
    prepare_page_style(html);
    if (zbrowser_scroll_band_render == 0) {
        draw_shell();
    }
    zbrowser_deferred_image_url[0] = 0;
    if (zbrowser_scroll_band_render == 0) {
        render_page_background_image();
    }
    zbrowser_line_len = 0;
    zbrowser_line[0] = 0;
    zbrowser_line_segment[0] = 0;
    zbrowser_line_fg[0] = zbrowser_page_text_fg;
    zbrowser_last_space = 0;
    zbrowser_line_no = 0;
    zbrowser_article_line_no = 0;
    zbrowser_left_line_no = 0;
    zbrowser_right_line_no = 0;
    if (zbrowser_scroll_band_render == 0) {
        zbrowser_link_count = 0;
        zbrowser_image_record_count = 0;
    }
    zbrowser_images_loaded = 0;
    if (zbrowser_scroll_band_render == 0) {
        zbrowser_input_count = 0;
        zbrowser_submit_count = 0;
        zbrowser_inline_control_count = 0;
    }
    zbrowser_table_depth = 0;
    zbrowser_table_row_active = 0;
    zbrowser_table_col = 0;
    zbrowser_table_cell_open = 0;
    zbrowser_table_cell_line = 0;
    zbrowser_tbl_box_start_col = 0;
    zbrowser_tbl_cell_start_col = 0;
    zbrowser_tbl_target_cols = 0;
    zbrowser_tbl_cell_align = WEB_STYLE_ALIGN_LEFT;
    zbrowser_tbl_cell_pad_cols = 0;
    zbrowser_tbl_default_pad_cols = 0;
    zbrowser_tbl_cell_gap_cols = 1;
    zbrowser_tbl_fixed_cell_cols = 0;
    zbrowser_table_has_border = 0;
    zbrowser_table_border_color = 0xa2a9b1;
    zbrowser_table_bg_color = 0xffffffff;
    zbrowser_table_box_count = 0;
    zbrowser_form_action[0] = 0;
    zbrowser_image_candidates = 0;
    zbrowser_text_fg = zbrowser_page_text_fg;
    zbrowser_text_bg = zbrowser_page_bg_color;
    zbrowser_bg_band_active = 0;
    zbrowser_link_text = zbrowser_page_link_fg;
    zbrowser_text_align = zbrowser_page_text_align;
    zbrowser_style_stack_depth = 0;
    zbrowser_dom_stack_depth = 0;
    zbrowser_column_mode = 0;
    zbrowser_column_start_line = 0;
    zbrowser_list_depth = 0;
    zbrowser_content_indent_cols = 0;
    zbrowser_line_stride = 1;
    zbrowser_font_scale = 1;
    zbrowser_text_transform = WEB_STYLE_TEXT_TRANSFORM_NONE;
    zbrowser_white_space = WEB_STYLE_WHITE_SPACE_NORMAL;
    zbrowser_css_bottom_space = 0;
    zbrowser_css_scope_block_flow = 0;
    clear_flow_box();
    zbrowser_active_link = 9999;
    reset_css_position_box();
    clear_web_style_cache();
    line_limit = zbrowser_render_line_limit();
    pos = find_primary_content_start(html);
    restore_render_checkpoint(&pos);

    while (html[pos] != 0) {
        if (zbrowser_line_no > line_limit) {
            break;
        }
        remember_render_checkpoint(pos);
        ch = html[pos];
        if (ch == 60) {
            transient_style = 0;
            if (zb_starts_with(html + pos, "<!--")) {
                pos = zb_skip_comment(html, pos + 4);
                continue;
            }
            if ((tag_hidden_from_style(html, pos) != 0 ||
                 tag_should_skip_content(html, pos) != 0) &&
                zb_is_closing_tag(html, pos) == 0) {
                skip_pos = skip_current_element_content(html, pos);
                if (skip_pos != 0) {
                    pos = skip_pos;
                    continue;
                }
            }
            if (zb_is_closing_tag(html, pos) == 0) {
                apply_implicit_dom_closes(html, pos);
            }
            if (zb_is_closing_tag(html, pos) != 0 &&
                tag_is_block_flow(html, pos) != 0) {
                flush_line();
            }
            if (zb_is_closing_tag(html, pos) == 0 &&
                tag_is_block_flow(html, pos) != 0) {
                flush_line();
            }
            if (zb_is_closing_tag(html, pos) != 0 &&
                tag_affects_text_style(html, pos) != 0) {
                dom_close_tag(html, pos);
                reset_layout(html, pos);
                close_css_position_box(html, pos);
            }
            if (zb_is_closing_tag(html, pos) == 0 &&
                tag_affects_text_style(html, pos) != 0) {
                push_text_style();
                dom_push_tag(html, pos);
            }
            if (zb_is_closing_tag(html, pos) == 0 &&
                tag_affects_text_style(html, pos) == 0 &&
                (zb_tag_is_void(html, pos) != 0 ||
                 zb_tag_self_closes(html, pos) != 0) &&
                zbrowser_style_stack_depth < ZBROWSER_STYLE_STACK_MAX) {
                push_text_style();
                transient_style = 1;
            }
            if (zb_is_closing_tag(html, pos) == 0) {
                apply_layout(html, pos);
                zbrowser_text_align = style_text_align(html, pos, zbrowser_text_align);
                apply_css_position_box(html, pos);
            }
            if (zb_is_closing_tag(html, pos) == 0) {
                zbrowser_text_fg = style_text_color(html, pos, zbrowser_text_fg);
                zbrowser_text_bg = style_background_color(html, pos, zbrowser_text_bg);
                apply_css_flow_box(html, pos);
                apply_css_background_band(html, pos);
                apply_semantic_tag_style(html, pos);
                apply_css_block_spacing(html, pos);
                if (style_background_image_url(html, pos, zbrowser_style_image_url, ZBROWSER_URL_CAPACITY) != 0 &&
                    should_try_inline_image(zbrowser_style_image_url) != 0 &&
                    tag_is_page_root(html, pos) == 0) {
                    zbrowser_image_candidates = zbrowser_image_candidates + 1;
                    render_background_image(zbrowser_style_image_url);
                }
                if (tag_may_draw_style_block(html, pos) != 0) {
                    draw_style_block_start(html, pos);
                }
            }
            if (zb_is_closing_tag(html, pos) == 0) {
                draw_semantic_block_start(html, pos);
            }
            if (zb_tag_name_is(html, pos, "script")) {
                if (transient_style != 0) {
                    pop_text_style();
                }
                pos = zb_skip_until_close_tag(html, zb_skip_tag(html, pos), "script");
                continue;
            }
            if (zb_tag_name_is(html, pos, "style")) {
                if (transient_style != 0) {
                    pop_text_style();
                }
                pos = zb_skip_until_close_tag(html, zb_skip_tag(html, pos), "style");
                continue;
            }
            if (zb_tag_name_is(html, pos, "title")) {
                if (transient_style != 0) {
                    pop_text_style();
                }
                pos = zb_skip_until_close_tag(html, zb_skip_tag(html, pos), "title");
                continue;
            }
            if (zb_tag_name_is(html, pos, "noscript")) {
                if (transient_style != 0) {
                    pop_text_style();
                }
                pos = zb_skip_until_close_tag(html, zb_skip_tag(html, pos), "noscript");
                continue;
            }
            if (zb_tag_name_is(html, pos, "br")) {
                flush_line();
            } else if (zb_tag_name_is(html, pos, "hr")) {
                draw_rule_line(0xa2a9b1);
            } else if (zb_tag_name_is(html, pos, "table")) {
                if (!zb_is_closing_tag(html, pos)) {
                    start_table_layout(html, pos);
                } else {
                    finish_table_layout();
                }
            } else if (zb_tag_name_is(html, pos, "p") ||
                       zb_tag_name_is(html, pos, "section") ||
                       zb_tag_name_is(html, pos, "article") ||
                       zb_tag_name_is(html, pos, "nav") ||
                       zb_tag_name_is(html, pos, "header") ||
                       zb_tag_name_is(html, pos, "footer") ||
                       zb_tag_name_is(html, pos, "aside")) {
                if (!zb_is_closing_tag(html, pos)) {
                    flush_line();
                }
            } else if (zb_tag_name_is(html, pos, "figcaption") ||
                       zb_tag_name_is(html, pos, "caption")) {
                if (!zb_is_closing_tag(html, pos)) {
                    flush_line();
                    zbrowser_text_fg = 0x54595d;
                    zbrowser_text_bg = 0xf8f9fa;
                    zbrowser_text_align = 1;
                    activate_background_band();
                } else {
                    blank_line();
                }
            } else if (zb_tag_name_is(html, pos, "blockquote")) {
                if (!zb_is_closing_tag(html, pos)) {
                    draw_quote_bar();
                    emit_text("> ");
                } else {
                    blank_line();
                }
            } else if (zb_tag_name_is(html, pos, "pre")) {
                if (!zb_is_closing_tag(html, pos)) {
                    draw_page_band(0xf8f9fa, 0xa2a9b1);
                }
            } else if (zb_tag_name_is(html, pos, "td") ||
                       zb_tag_name_is(html, pos, "th")) {
                if (!zb_is_closing_tag(html, pos)) {
                    start_table_cell(html, pos);
                }
            } else if (zb_tag_name_is(html, pos, "tr")) {
                if (!zb_is_closing_tag(html, pos)) {
                    start_table_row();
                } else {
                    finish_table_row();
                }
            } else if (zb_tag_name_is(html, pos, "ul") ||
                       zb_tag_name_is(html, pos, "ol")) {
                if (!zb_is_closing_tag(html, pos)) {
                    if (zbrowser_list_depth < ZBROWSER_STYLE_STACK_MAX) {
                        zbrowser_list_ordered[zbrowser_list_depth] = 0;
                        if (zb_tag_name_is(html, pos, "ol")) {
                            zbrowser_list_ordered[zbrowser_list_depth] = 1;
                        }
                        zbrowser_list_counter[zbrowser_list_depth] = 0;
                        zbrowser_list_depth = zbrowser_list_depth + 1;
                    }
                    flush_line();
                } else {
                    flush_line();
                    if (zbrowser_list_depth > 0) {
                        zbrowser_list_depth = zbrowser_list_depth - 1;
                    }
                }
            } else if (zb_tag_name_is(html, pos, "dt")) {
                if (!zb_is_closing_tag(html, pos)) {
                    flush_line();
                    zbrowser_text_fg = 0x202122;
                }
            } else if (zb_tag_name_is(html, pos, "dd")) {
                if (!zb_is_closing_tag(html, pos)) {
                    flush_line();
                    emit_text("  - ");
                }
            } else if (tag_is_prominent_heading(html, pos) != 0) {
                blank_line();
                if (!zb_is_closing_tag(html, pos)) {
                    zbrowser_text_fg = 0x000000;
                    zbrowser_text_bg = 0xffffff;
                    zbrowser_text_align = style_text_align(html, pos, 0);
                    if (zb_tag_name_is(html, pos, "h1")) {
                        draw_heading_band(1);
                    } else {
                        draw_heading_band(0);
                    }
                }
            } else if (zb_tag_name_is(html, pos, "li") ||
                       (zb_is_closing_tag(html, pos) == 0 &&
                        load_web_style(html, pos) != 0 &&
                        zbrowser_web_style_display == WEB_STYLE_DISPLAY_LIST_ITEM)) {
                if (!zb_is_closing_tag(html, pos)) {
                    flush_line();
                    emit_list_prefix(html, pos);
                }
            } else if (zb_tag_name_is(html, pos, "sup")) {
                if (!zb_is_closing_tag(html, pos)) {
                    emit_text("^");
                }
            } else if (zb_tag_name_is(html, pos, "sub")) {
                if (!zb_is_closing_tag(html, pos)) {
                    emit_text("_");
                }
            } else if (zb_tag_name_is(html, pos, "a")) {
                if (!zb_is_closing_tag(html, pos) && zb_attr_value(html, pos, "href", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
                    zbrowser_active_link = register_link(zbrowser_attr);
                } else if (zb_is_closing_tag(html, pos) != 0) {
                    zbrowser_active_link = 9999;
                }
            } else if (zb_tag_name_is(html, pos, "form")) {
                if (!zb_is_closing_tag(html, pos)) {
                    if (zb_attr_value(html, pos, "action", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
                        copy_text(zbrowser_form_action, ZBROWSER_URL_CAPACITY, zbrowser_attr);
                    } else {
                        copy_text(zbrowser_form_action, ZBROWSER_URL_CAPACITY, zbrowser_url);
                    }
                    flush_line();
                }
            } else if (zb_tag_name_is(html, pos, "img")) {
                zbrowser_image_candidates = zbrowser_image_candidates + 1;
                if (image_source_for_tag(html, pos, zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
                    render_inline_image(html, pos, zbrowser_attr) != 0) {
                    if (transient_style != 0) {
                        pop_text_style();
                    }
                    pos = zb_skip_tag(html, pos);
                    continue;
                }
                if (zb_attr_value(html, pos, "alt", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 && zbrowser_attr[0] != 0) {
                    emit_text(zbrowser_attr);
                }
            } else if (image_source_for_tag(html, pos, zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
                       should_try_inline_image(zbrowser_attr) != 0) {
                zbrowser_image_candidates = zbrowser_image_candidates + 1;
                if (render_inline_image(html, pos, zbrowser_attr) != 0) {
                    if (transient_style != 0) {
                        pop_text_style();
                    }
                    pos = zb_skip_tag(html, pos);
                    continue;
                }
            } else if (zb_tag_name_is(html, pos, "input")) {
                if (zb_attr_value(html, pos, "type", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
                    (text_contains_ci(zbrowser_attr, "hidden") != 0 ||
                     text_contains_ci(zbrowser_attr, "submit") != 0 ||
                     text_contains_ci(zbrowser_attr, "button") != 0)) {
                    if (text_contains_ci(zbrowser_attr, "submit") != 0 ||
                        text_contains_ci(zbrowser_attr, "button") != 0) {
                        zbrowser_url_tmp[0] = 0;
                        if (zb_attr_value(html, pos, "value", zbrowser_url_tmp, ZBROWSER_URL_CAPACITY) == 0 ||
                            zbrowser_url_tmp[0] == 0) {
                            copy_text(zbrowser_url_tmp, ZBROWSER_URL_CAPACITY, "Submit");
                        }
                        draw_inline_button_control(zbrowser_url_tmp);
                    }
                } else {
                    if (zb_attr_value(html, pos, "name", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) == 0) {
                        copy_text(zbrowser_attr, ZBROWSER_ATTR_CAPACITY, "q");
                    }
                    zbrowser_url_tmp[0] = 0;
                    zb_attr_value(html, pos, "value", zbrowser_url_tmp, ZBROWSER_URL_CAPACITY);
                    input_index = register_input(zbrowser_attr, zbrowser_url_tmp);
                    if (input_index != 9999) {
                        input_value = input_value_slot(input_index);
                        draw_inline_input_control(html, pos, input_index, input_value);
                    } else {
                        emit_text("[input]");
                    }
                }
            } else if (zb_tag_name_is(html, pos, "button")) {
                if (!zb_is_closing_tag(html, pos)) {
                    zbrowser_url_tmp[0] = 0;
                    zb_attr_value(html, pos, "value", zbrowser_url_tmp, ZBROWSER_URL_CAPACITY);
                    if (zbrowser_url_tmp[0] == 0) {
                        copy_plain_until_close_tag(html, zb_skip_tag(html, pos), "button", zbrowser_url_tmp, ZBROWSER_URL_CAPACITY);
                    }
                    if (zbrowser_url_tmp[0] == 0) {
                        copy_text(zbrowser_url_tmp, ZBROWSER_URL_CAPACITY, "Submit");
                    }
                    draw_inline_button_control(zbrowser_url_tmp);
                    if (transient_style != 0) {
                        pop_text_style();
                    }
                    pos = zb_skip_until_close_tag(html, zb_skip_tag(html, pos), "button");
                    continue;
                }
            } else if (zb_tag_name_is(html, pos, "textarea")) {
                if (!zb_is_closing_tag(html, pos)) {
                    if (zb_attr_value(html, pos, "name", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) == 0) {
                        copy_text(zbrowser_attr, ZBROWSER_ATTR_CAPACITY, "text");
                    }
                    copy_plain_until_close_tag(html, zb_skip_tag(html, pos), "textarea", zbrowser_url_tmp, ZBROWSER_URL_CAPACITY);
                    input_index = register_input(zbrowser_attr, zbrowser_url_tmp);
                    if (input_index != 9999) {
                        input_value = input_value_slot(input_index);
                        flush_line();
                        draw_input_control(input_index, input_value);
                    }
                    if (transient_style != 0) {
                        pop_text_style();
                    }
                    pos = zb_skip_until_close_tag(html, zb_skip_tag(html, pos), "textarea");
                    continue;
                }
            } else if (zb_tag_name_is(html, pos, "select")) {
                if (!zb_is_closing_tag(html, pos)) {
                    if (copy_first_option_label(html, zb_skip_tag(html, pos), zbrowser_url_tmp, ZBROWSER_URL_CAPACITY) == 0 ||
                        zbrowser_url_tmp[0] == 0) {
                        copy_text(zbrowser_url_tmp, ZBROWSER_URL_CAPACITY, "Select");
                    }
                    draw_inline_select_control(zbrowser_url_tmp);
                    if (transient_style != 0) {
                        pop_text_style();
                    }
                    pos = zb_skip_until_close_tag(html, zb_skip_tag(html, pos), "select");
                    continue;
                }
            }
            if (transient_style != 0) {
                pop_text_style();
            }
            pos = zb_skip_tag(html, pos);
        } else if (ch == 38) {
            ch = zb_entity_char(html, pos, &advance);
            emit_char(ch);
            pos = pos + advance;
        } else if (ch >= 128) {
            emit_char(63);
            pos = pos + utf8_advance(html, pos);
        } else {
            emit_char(ch);
            pos = pos + 1;
        }
    }
    flush_line();
    copy_text(zbrowser_status, 96, "links ");
    append_uint_limited(zbrowser_status, 96, zbrowser_link_count);
    append_text_limited(zbrowser_status, 96, " imgs ");
    append_uint_limited(zbrowser_status, 96, zbrowser_image_candidates);
    append_text_limited(zbrowser_status, 96, "/");
    append_uint_limited(zbrowser_status, 96, zbrowser_images_loaded);
    append_text_limited(zbrowser_status, 96, " inputs ");
    append_uint_limited(zbrowser_status, 96, zbrowser_input_count);
    if (zbrowser_js_executed != 0 || zbrowser_js_writes != 0) {
        append_text_limited(zbrowser_status, 96, " js ");
        append_uint_limited(zbrowser_status, 96, zbrowser_js_executed);
        append_text_limited(zbrowser_status, 96, "/");
        append_uint_limited(zbrowser_status, 96, zbrowser_js_writes);
    }
    if (zbrowser_netsurf_dom_used != 0) {
        append_text_limited(zbrowser_status, 96, " dom");
    }
    if (zbrowser_doc_truncated != 0) {
        append_text_limited(zbrowser_status, 96, " truncated");
    }
    if (zbrowser_http_status_code != 0) {
        append_text_limited(zbrowser_status, 96, " http ");
        append_uint_limited(zbrowser_status, 96, zbrowser_http_status_code);
    }
    if (zbrowser_http_body_size != 0) {
        append_text_limited(zbrowser_status, 96, " body ");
        append_uint_limited(zbrowser_status, 96, zbrowser_http_body_size);
    }
    if (zbrowser_tls_error != 0) {
        append_text_limited(zbrowser_status, 96, " tls ");
        append_uint_limited(zbrowser_status, 96, zbrowser_tls_error);
    }
    if (cached_image_count() == 0 &&
        (zbrowser_image_fetch_result < 0 || zbrowser_image_probe_result != 0)) {
        append_text_limited(zbrowser_status, 96, " imgerr ");
        append_int_limited(zbrowser_status, 96, zbrowser_image_fetch_result);
        append_text_limited(zbrowser_status, 96, "/");
        append_int_limited(zbrowser_status, 96, zbrowser_image_probe_result);
    }
    schedule_deferred_image_fetch();
    draw_text_at_pixel(8, gfx_height() - 18, zbrowser_status, 0x54595d, 0xeaecf0);
}

int render_image_if_supported(const uint8_t *data, uint32_t size) {
    struct ImageInfo image;
    int rc;
    uint32_t w;
    uint32_t h;
    uint32_t max_w;
    uint32_t max_h;
    uint32_t draw_x;
    uint32_t draw_y;

    rc = image_probe(data, size, &image);
    if (rc != 0) {
        return 0;
    }

    draw_shell();
    w = gfx_width();
    h = gfx_height();
    max_w = w - 32;
    if (max_w > 720) {
        max_w = 720;
    }
    max_h = h - 96;
    if (max_h > 420) {
        max_h = 420;
    }
    draw_x = 16;
    draw_y = 64;
    rc = image_decode_to_screen_scaled(data, size, draw_x, draw_y, max_w, max_h);
    zbrowser_image_draw_result = rc;
    if (rc != 0) {
        draw_text_at_pixel(16, 72, "image decode failed", 0x202122, 0xffffff);
        copy_text(zbrowser_status, 96, "image decode failed");
    } else {
        copy_text(zbrowser_status, 96, "image rendered");
    }
    draw_text_at_pixel(8, h - 18, zbrowser_status, 0x54595d, 0xeaecf0);
    return 1;
}

int should_try_inline_image(const uint8_t *src) {
    if (src[0] == 0) {
        return 0;
    }
    if (zb_starts_with(src, "data:")) {
        return 0;
    }
    if (zb_starts_with(src, "about:")) {
        return 0;
    }
    if (zb_starts_with(src, "javascript:")) {
        return 0;
    }
    if (source_unsupported_image(src) != 0) {
        return 0;
    }
    return 1;
}

void first_srcset_url(const uint8_t *srcset, uint8_t *out, uint32_t capacity) {
    uint32_t i;

    out[0] = 0;
    if (capacity == 0) {
        return;
    }
    i = 0;
    while (srcset[i] == 32 || srcset[i] == 9 || srcset[i] == 10 || srcset[i] == 13) {
        i = i + 1;
    }
    while (srcset[i] != 0 &&
           srcset[i] != 32 &&
           srcset[i] != 9 &&
           srcset[i] != 10 &&
           srcset[i] != 13 &&
           srcset[i] != 44) {
        append_char_limited(out, capacity, srcset[i]);
        i = i + 1;
    }
}

int image_source_for_tag(const uint8_t *html, uint32_t pos, uint8_t *out, uint32_t capacity) {
    out[0] = 0;
    if (zb_attr_value(html, pos, "src", out, capacity) != 0 && out[0] != 0) {
        return 1;
    }
    if (zb_attr_value(html, pos, "srcset", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 && zbrowser_attr[0] != 0) {
        first_srcset_url(zbrowser_attr, out, capacity);
        if (out[0] != 0) {
            return 1;
        }
    }
    if (zb_attr_value(html, pos, "data-src", out, capacity) != 0 && out[0] != 0) {
        return 1;
    }
    if (zb_attr_value(html, pos, "data-lazy-src", out, capacity) != 0 && out[0] != 0) {
        return 1;
    }
    if (zb_attr_value(html, pos, "data-data-file-original-src", out, capacity) != 0 && out[0] != 0) {
        return 1;
    }
    if (zb_attr_value(html, pos, "content", out, capacity) != 0 &&
        out[0] != 0 &&
        (zb_starts_with(out, "http://") != 0 || zb_starts_with(out, "https://") != 0) &&
        source_looks_like_image(out) != 0) {
        return 1;
    }
    return 0;
}

int fetch_image_into_slot(uint32_t slot, const uint8_t *url) {
    uint8_t *slot_buffer;
    uint8_t *slot_url;
    int size;
    struct ImageInfo image;
    struct NetHttpInfo http_info;

    if (heavy_page_for_images() != 0) {
        zbrowser_image_fetch_result = -30;
        return 0;
    }

    slot_buffer = (uint8_t *)zbrowser_image_buffer_addr + slot * ZBROWSER_IMAGE_CAPACITY;
    copy_text(zbrowser_status, 96, "fetching image");
    zbrowser_image_probe_result = 0;
    zbrowser_image_draw_result = 0;
    size = os_http_get_ex(url, slot_buffer, ZBROWSER_IMAGE_CAPACITY, &http_info);
    zbrowser_image_fetch_result = size;
    if (size <= 0) {
        slot_url = image_url_slot(slot);
        copy_text(slot_url, ZBROWSER_LINK_CAPACITY, url);
        zbrowser_cached_image_sizes[slot] = 0;
        zbrowser_cached_image_valids[slot] = 2;
        return 0;
    }
    zbrowser_image_probe_result = image_probe(slot_buffer, (uint32_t)size, &image);
    if (zbrowser_image_probe_result != 0) {
        slot_url = image_url_slot(slot);
        copy_text(slot_url, ZBROWSER_LINK_CAPACITY, url);
        zbrowser_cached_image_sizes[slot] = size;
        zbrowser_cached_image_valids[slot] = 2;
        return 0;
    }
    slot_url = image_url_slot(slot);
    copy_text(slot_url, ZBROWSER_LINK_CAPACITY, url);
    zbrowser_cached_image_sizes[slot] = size;
    zbrowser_cached_image_valids[slot] = 1;
    copy_text(zbrowser_status, 96, "loaded page image");
    return 1;
}

void zbrowser_image_worker(uint8_t *arg) {
    fetch_image_into_slot(zbrowser_image_task_slot, zbrowser_image_task_url);
    zbrowser_image_load_in_progress = 0;
    request_asset_redraw(8);
}

void zbrowser_poll_image_task(void) {
    if (zbrowser_image_task_id != 0 && kernel_task_done(zbrowser_image_task_id) != 0) {
        kernel_task_release(zbrowser_image_task_id);
        zbrowser_image_task_id = 0;
        zbrowser_image_load_in_progress = 0;
        request_asset_redraw(6);
    }
}

int schedule_image_fetch(uint32_t slot, const uint8_t *url) {
    if (zbrowser_reload_pending != 0) {
        return 0;
    }
    if (zbrowser_image_load_in_progress != 0 || zbrowser_image_task_id != 0) {
        return 0;
    }
    if (zbrowser_css_load_in_progress != 0 || zbrowser_css_task_id != 0) {
        return 0;
    }
    if (zbrowser_css_load_done == 0 && zbrowser_css_url[0] != 0) {
        return 0;
    }
    if (kernel_task_async_supported() == 0) {
        return 0;
    }
    copy_text(zbrowser_image_task_url, ZBROWSER_URL_CAPACITY, url);
    zbrowser_image_task_slot = slot;
    zbrowser_image_load_in_progress = 1;
    copy_text(zbrowser_status, 96, "loading image in background");
    zbrowser_image_task_id = kernel_task_submit_async_named(zbrowser_image_worker, (uint8_t *)0, "zbrowser-image");
    if (zbrowser_image_task_id == 0) {
        zbrowser_image_load_in_progress = 0;
        copy_text(zbrowser_status, 96, "image task failed");
        return 0;
    }
    return 1;
}

void cache_first_inline_image(const uint8_t *html) {
    uint32_t pos;
    uint32_t attempts;
    uint32_t slot;
    int try_image;

    zbrowser_image_fetch_result = 0;
    zbrowser_image_probe_result = 0;
    zbrowser_image_draw_result = 0;
    clear_image_cache();
    if (zbrowser_image_buffer_addr == 0) {
        return;
    }

    pos = 0;
    attempts = 0;
    slot = 0;
    while (html[pos] != 0 && attempts < 18 && slot < 3) {
        if (html[pos] == 60) {
            zbrowser_attr[0] = 0;
            try_image = image_source_for_tag(html, pos, zbrowser_attr, ZBROWSER_ATTR_CAPACITY);
            make_absolute_url(zbrowser_url, zbrowser_attr, zbrowser_url_tmp, ZBROWSER_URL_CAPACITY);
            if (zbrowser_url_tmp[0] != 0) {
                if (try_image != 0) {
                    if (image_url_already_cached(zbrowser_url_tmp, slot) == 0) {
                        attempts = attempts + 1;
                        if (fetch_image_into_slot(slot, zbrowser_url_tmp) != 0) {
                            slot = slot + 1;
                        }
                    }
                }
            }
        }
        pos = pos + 1;
    }
}

int render_background_image(const uint8_t *src) {
    struct ImageInfo image;
    uint32_t h;
    uint32_t draw_y;
    uint32_t band_x;
    uint32_t band_w;
    uint32_t band_h;
    uint32_t slot;
    uint32_t line_count;
    uint32_t drawn_w;
    uint32_t drawn_h;
    uint32_t decoded_slot;
    uint32_t image_drawn;

    if (zbrowser_image_buffer_addr == 0 || zbrowser_images_loaded >= ZBROWSER_MAX_IMAGES) {
        return 0;
    }
    if (should_try_inline_image(src) == 0) {
        return 0;
    }
    if (zbrowser_line_no < zbrowser_scroll) {
        return 0;
    }

    flush_line();
    make_absolute_url(zbrowser_url, src, zbrowser_url_tmp, ZBROWSER_URL_CAPACITY);
    if (zbrowser_url_tmp[0] == 0) {
        return 0;
    }
    if (find_cached_image_slot(zbrowser_url_tmp) == 9999 &&
        image_url_already_cached(zbrowser_url_tmp, ZBROWSER_IMAGE_SLOT_COUNT) == 0) {
        slot = find_empty_image_slot();
        if (slot != 9999) {
            schedule_image_fetch(slot, zbrowser_url_tmp);
        }
    }

    h = gfx_height();
    draw_y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
    band_x = flow_box_x();
    band_w = flow_box_w();
    band_h = 128;
    if (draw_y + band_h >= h - 18) {
        if (h > draw_y + 38) {
            band_h = h - draw_y - 28;
        } else {
            return 0;
        }
    }

    gfx_fill_rect(band_x, draw_y, band_w, band_h, zbrowser_text_bg);
    slot = 0;
    while (slot < ZBROWSER_IMAGE_SLOT_COUNT) {
        if (zbrowser_cached_image_valids[slot] == 1 &&
            text_equal(zbrowser_url_tmp, image_url_slot(slot)) != 0 &&
            image_probe(image_buffer_slot(slot), (uint32_t)zbrowser_cached_image_sizes[slot], &image) == 0) {
            drawn_w = image.width;
            drawn_h = image.height;
            if (drawn_w > band_w) {
                drawn_h = (uint32_t)(((uint64_t)drawn_h * band_w) / drawn_w);
                drawn_w = band_w;
            }
            if (drawn_h > band_h) {
                drawn_w = (uint32_t)(((uint64_t)drawn_w * band_h) / drawn_h);
                drawn_h = band_h;
            }
            if (drawn_w == 0) {
                drawn_w = 1;
            }
            if (drawn_h == 0) {
                drawn_h = 1;
            }
            image_drawn = 0;
            decoded_slot = find_decoded_image_slot(slot, drawn_w, drawn_h, zbrowser_text_bg);
            if (decoded_slot != 9999 &&
                draw_decoded_image_slot(decoded_slot, band_x, draw_y, drawn_w, drawn_h, 0) != 0) {
                image_drawn = 1;
            }
            if (image_drawn == 0) {
                if (zbrowser_image_decode_budget != 0) {
                    zbrowser_image_decode_budget = zbrowser_image_decode_budget - 1;
                    decoded_slot = ensure_decoded_image_slot(slot, drawn_w, drawn_h, zbrowser_text_bg);
                    if (decoded_slot != 9999 &&
                        draw_decoded_image_slot(decoded_slot, band_x, draw_y, drawn_w, drawn_h, 0) != 0) {
                        image_drawn = 1;
                    } else {
                        zbrowser_image_draw_result = image_decode_to_screen_scaled(image_buffer_slot(slot),
                                                                                   (uint32_t)zbrowser_cached_image_sizes[slot],
                                                                                   band_x,
                                                                                   draw_y,
                                                                                   band_w,
                                                                                   band_h);
                    }
                }
            }
            line_count = (band_h / 12) + 1;
            if (decoded_slot != 9999 && image_drawn != 0) {
                remember_image_line_cache(zbrowser_line_no, line_count);
                remember_rendered_image_record(zbrowser_line_no,
                                               band_x,
                                               drawn_w,
                                               drawn_h,
                                               slot,
                                               9999);
            }
            zbrowser_line_no = zbrowser_line_no + line_count;
            zbrowser_images_loaded = zbrowser_images_loaded + 1;
            return 1;
        }
        slot = slot + 1;
    }

    line_count = (band_h / 12) + 1;
    zbrowser_line_no = zbrowser_line_no + line_count;
    zbrowser_images_loaded = zbrowser_images_loaded + 1;
    return 1;
}

int render_inline_image(const uint8_t *html, uint32_t tag_pos, const uint8_t *src) {
    struct ImageInfo image;
    uint32_t h;
    uint32_t draw_y;
    uint32_t draw_x;
    uint32_t line_count;
    uint32_t max_w;
    uint32_t max_h;
    uint32_t drawn_w;
    uint32_t drawn_h;
    uint32_t styled_w;
    uint32_t styled_h;
    uint32_t styled_max_w;
    uint32_t styled_max_h;
    uint32_t slot;
    uint32_t link_index;
    uint32_t is_positioned;
    uint32_t image_drawn;
    uint32_t link_h;
    uint32_t should_decode;
    uint32_t decoded_slot;

    if (zbrowser_image_buffer_addr == 0 || zbrowser_images_loaded >= ZBROWSER_MAX_IMAGES) {
        return 0;
    }
    if (heavy_page_for_images() != 0) {
        draw_image_placeholder(src, "image skipped");
        zbrowser_images_loaded = zbrowser_images_loaded + 1;
        return 1;
    }
    if (should_try_inline_image(src) == 0) {
        if (zbrowser_box_positioned != 0) {
            zbrowser_images_loaded = zbrowser_images_loaded + 1;
            return 1;
        }
        return 0;
    }
    is_positioned = zbrowser_box_positioned;
    if (is_positioned == 0 && zbrowser_line_no < zbrowser_scroll) {
        return 0;
    }

    flush_line();
    make_absolute_url(zbrowser_url, src, zbrowser_url_tmp, ZBROWSER_URL_CAPACITY);
    if (zbrowser_url_tmp[0] == 0) {
        return 0;
    }
    if (find_cached_image_slot(zbrowser_url_tmp) == 9999 &&
        image_url_already_cached(zbrowser_url_tmp, ZBROWSER_IMAGE_SLOT_COUNT) == 0) {
        if (is_positioned != 0) {
            remember_deferred_image_fetch(zbrowser_url_tmp);
            zbrowser_images_loaded = zbrowser_images_loaded + 1;
            return 1;
        }
        slot = find_empty_image_slot();
        if (slot != 9999) {
            schedule_image_fetch(slot, zbrowser_url_tmp);
        }
    }
    slot = 0;
    while (slot < ZBROWSER_IMAGE_SLOT_COUNT) {
        if (zbrowser_cached_image_valids[slot] == 1 &&
            text_equal(zbrowser_url_tmp, image_url_slot(slot)) != 0 &&
            image_probe(image_buffer_slot(slot), (uint32_t)zbrowser_cached_image_sizes[slot], &image) == 0) {
            h = gfx_height();
            if (is_positioned != 0) {
                draw_y = zbrowser_y;
            } else {
                draw_y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
            }
            max_w = 1;
            if (flow_content_w() > 0) {
                max_w = flow_content_w();
            }
            if (max_w > 720) {
                max_w = 720;
            }
            max_h = 720;
            if (h > zbrowser_y + 96 && max_h > h - zbrowser_y - 96) {
                max_h = h - zbrowser_y - 96;
                if (max_h < 180) {
                    max_h = 180;
                }
            }
            if (is_positioned != 0) {
                max_w = gfx_width();
                if (max_w > 8) {
                    max_w = max_w - 8;
                }
                if (h > zbrowser_y + 24) {
                    max_h = h - zbrowser_y - 24;
                } else {
                    max_h = 0;
                }
                if (max_h > 720) {
                    max_h = 720;
                }
            }
            if (max_w > 0 && max_h > 0) {
                drawn_w = image.width;
                drawn_h = image.height;
                styled_w = image_style_length(html, tag_pos, "width", max_w);
                styled_h = image_style_length(html, tag_pos, "height", max_h);
                styled_max_w = image_style_length(html, tag_pos, "max-width", max_w);
                styled_max_h = image_style_length(html, tag_pos, "max-height", max_h);
                if (styled_max_w != 0 && max_w > styled_max_w) {
                    max_w = styled_max_w;
                }
                if (styled_max_h != 0 && max_h > styled_max_h) {
                    max_h = styled_max_h;
                }
                if (styled_w != 0) {
                    drawn_w = styled_w;
                    if (styled_h == 0 && image.width != 0) {
                        drawn_h = (uint32_t)(((uint64_t)image.height * drawn_w) / image.width);
                    }
                }
                if (styled_h != 0) {
                    drawn_h = styled_h;
                    if (styled_w == 0 && image.height != 0) {
                        drawn_w = (uint32_t)(((uint64_t)image.width * drawn_h) / image.height);
                    }
                }
                if (drawn_w > max_w) {
                    drawn_h = (uint32_t)(((uint64_t)drawn_h * max_w) / drawn_w);
                    drawn_w = max_w;
                }
                if (drawn_h > max_h) {
                    drawn_w = (uint32_t)(((uint64_t)drawn_w * max_h) / drawn_h);
                    drawn_h = max_h;
                }
                if (drawn_h == 0) {
                    drawn_h = 1;
                }
                if (drawn_w == 0) {
                    drawn_w = 1;
                }
                draw_x = flow_content_x();
                if ((zbrowser_text_align == 1 || image_should_center(html, tag_pos) != 0) &&
                    flow_content_w() > drawn_w) {
                    draw_x = flow_content_x() + (flow_content_w() - drawn_w) / 2;
                } else if (zbrowser_text_align == 2 && flow_content_w() > drawn_w) {
                    draw_x = flow_content_x() + flow_content_w() - drawn_w;
                }
                if (is_positioned != 0) {
                    if (zbrowser_box_center_x != 0 && gfx_width() > drawn_w) {
                        draw_x = (gfx_width() - drawn_w) / 2;
                    } else if (zbrowser_box_has_right != 0 && gfx_width() > zbrowser_box_right_px + drawn_w) {
                        draw_x = gfx_width() - zbrowser_box_right_px - drawn_w;
                    } else if (zbrowser_box_has_left != 0) {
                        draw_x = zbrowser_box_left_px;
                    }
                    if (draw_x + drawn_w > gfx_width()) {
                        if (gfx_width() > drawn_w) {
                            draw_x = gfx_width() - drawn_w;
                        } else {
                            draw_x = 0;
                        }
                    }
                    if (zbrowser_box_has_bottom != 0 && h > zbrowser_box_bottom_px + drawn_h + 18) {
                        draw_y = h - 18 - zbrowser_box_bottom_px - drawn_h;
                    }
                    if (zbrowser_box_has_top != 0) {
                        draw_y = zbrowser_y + zbrowser_box_top_px;
                    }
                    if (draw_y + drawn_h > h - 18) {
                        if (h > drawn_h + 18) {
                            draw_y = h - 18 - drawn_h;
                        } else {
                            draw_y = zbrowser_y;
                        }
                    }
                }
                if (zbrowser_active_link != 9999) {
                    link_index = zbrowser_active_link;
                } else {
                    link_index = register_link(src);
                }
                if (zbrowser_page_bg_has_img == 0 || zbrowser_text_bg != zbrowser_page_bg_color) {
                    gfx_fill_rect(draw_x, draw_y, drawn_w, drawn_h, zbrowser_text_bg);
                }
                zbrowser_image_draw_result = 0;
                image_drawn = 0;
                decoded_slot = find_decoded_image_slot(slot, drawn_w, drawn_h, zbrowser_text_bg);
                if (decoded_slot != 9999 &&
                    draw_decoded_image_slot(decoded_slot, draw_x, draw_y, drawn_w, drawn_h, 0) != 0) {
                    image_drawn = 1;
                } else {
                    should_decode = 0;
                    if (is_positioned == 0) {
                        should_decode = 1;
                        if (zbrowser_image_decode_budget != 0) {
                            zbrowser_image_decode_budget = zbrowser_image_decode_budget - 1;
                        }
                    } else if (zbrowser_image_decode_budget != 0) {
                        should_decode = 1;
                        zbrowser_image_decode_budget = zbrowser_image_decode_budget - 1;
                    }
                    if (should_decode != 0) {
                        decoded_slot = ensure_decoded_image_slot(slot, drawn_w, drawn_h, zbrowser_text_bg);
                        if (decoded_slot != 9999 &&
                            draw_decoded_image_slot(decoded_slot, draw_x, draw_y, drawn_w, drawn_h, 0) != 0) {
                            image_drawn = 1;
                        } else {
                            zbrowser_image_draw_result = image_decode_to_screen_scaled(image_buffer_slot(slot),
                                                                                       (uint32_t)zbrowser_cached_image_sizes[slot],
                                                                                       draw_x,
                                                                                       draw_y,
                                                                                       drawn_w,
                                                                                       drawn_h);
                            if (zbrowser_image_draw_result == 0) {
                                image_drawn = 1;
                            }
                        }
                    }
                }
                line_count = ((drawn_h + 6) / 12) + 1;
                if (line_count == 0) {
                    line_count = 1;
                }
                if (image_drawn != 0 && is_positioned == 0 && decoded_slot != 9999) {
                    remember_image_line_cache(zbrowser_line_no, line_count);
                    remember_rendered_image_record(zbrowser_line_no,
                                                   draw_x,
                                                   drawn_w,
                                                   drawn_h,
                                                   slot,
                                                   link_index);
                }
                if (link_index != 9999) {
                    link_h = drawn_h;
                    zbrowser_link_end_lines[link_index] = zbrowser_line_no + line_count - 1;
                    set_link_rect(link_index, draw_x, draw_y, drawn_w, link_h);
                }
                if (is_positioned != 0) {
                    zbrowser_images_loaded = zbrowser_images_loaded + 1;
                    return 1;
                }
                zbrowser_line_no = zbrowser_line_no + line_count;
                zbrowser_images_loaded = zbrowser_images_loaded + 1;
                return 1;
            }
        }
        slot = slot + 1;
    }

    if (is_positioned != 0) {
        zbrowser_images_loaded = zbrowser_images_loaded + 1;
        return 1;
    }
    if (image_url_already_cached(zbrowser_url_tmp, ZBROWSER_IMAGE_SLOT_COUNT) != 0) {
        draw_image_placeholder(src, "image unavailable");
    } else {
        draw_image_placeholder(src, "image loading");
    }
    zbrowser_images_loaded = zbrowser_images_loaded + 1;
    return 1;
}

void render_help(void) {
    draw_shell();
    draw_text_at_pixel(article_x() + 10, 64, "No page loaded.", 0x202122, 0xffffff);
    if (zb_starts_with(zbrowser_status, "https")) {
        draw_text_at_pixel(article_x() + 10, 80, zbrowser_status, 0x202122, 0xffffff);
        draw_text_at_pixel(article_x() + 10, 96, "Try a plain http:// URL.", 0x54595d, 0xffffff);
    } else if (zbrowser_status[0] != 0) {
        draw_text_at_pixel(article_x() + 10, 80, zbrowser_status, 0x202122, 0xffffff);
        draw_text_at_pixel(article_x() + 10, 96, "Use browser.url with http:// or https://", 0x54595d, 0xffffff);
    } else {
        draw_text_at_pixel(article_x() + 10, 80, "Use browser.url with http:// or https://", 0x202122, 0xffffff);
        draw_text_at_pixel(article_x() + 10, 96, "or save a local index.html file.", 0x54595d, 0xffffff);
    }
}

void request_asset_redraw(uint32_t delay) {
    zbrowser_asset_redraw_pending = 1;
    zbrowser_asset_redraw_delay = delay;
    zbrowser_chrome_dirty = 1;
}

uint8_t *document_buffer(void) {
    if (zbrowser_doc_buffer_addr != 0) {
        return (uint8_t *)zbrowser_doc_buffer_addr;
    }
    return os_file_buffer();
}

void zbrowser_css_worker(uint8_t *arg) {
    uint8_t *css_buffer;
    struct NetHttpInfo info;

    if (zbrowser_css_buffer_addr == 0 || zbrowser_css_url[0] == 0) {
        zbrowser_css_fetch_size = 0;
        zbrowser_css_fetch_result = -1;
        zbrowser_css_load_in_progress = 0;
        request_asset_redraw(2);
        return;
    }

    css_buffer = (uint8_t *)zbrowser_css_buffer_addr;
    copy_text(zbrowser_status, 96, "fetching css");
    zbrowser_css_fetch_size = http_get_page_with_retry(zbrowser_css_url,
                                                       css_buffer,
                                                       ZBROWSER_CSS_CAPACITY - 1,
                                                       &info);
    zbrowser_css_fetch_result = zbrowser_css_fetch_size;
    if (zbrowser_css_fetch_size > 0) {
        css_buffer[zbrowser_css_fetch_size] = 0;
    }
    zbrowser_css_load_in_progress = 0;
    request_asset_redraw(2);
}

int schedule_css_fetch(void) {
    if (zbrowser_reload_pending != 0) {
        return 0;
    }
    if (zbrowser_loaded == 0 || zbrowser_load_in_progress != 0 || zbrowser_has_document == 0) {
        return 0;
    }
    if (zbrowser_css_load_done != 0 || zbrowser_css_load_in_progress != 0 || zbrowser_css_task_id != 0) {
        return 0;
    }
    if (zbrowser_css_url[0] == 0 || zbrowser_css_buffer_addr == 0) {
        zbrowser_css_load_done = 1;
        return 0;
    }
    if (zbrowser_image_load_in_progress != 0 || zbrowser_image_task_id != 0) {
        return 0;
    }
    if (kernel_task_async_supported() == 0) {
        zbrowser_css_load_done = 1;
        return 0;
    }

    zbrowser_css_load_in_progress = 1;
    copy_text(zbrowser_status, 96, "loading css in background");
    zbrowser_css_task_id = kernel_task_submit_async_named(zbrowser_css_worker, (uint8_t *)0, "zbrowser-css");
    if (zbrowser_css_task_id == 0) {
        zbrowser_css_load_in_progress = 0;
        zbrowser_css_load_done = 1;
        copy_text(zbrowser_status, 96, "css task failed");
        return 0;
    }
    return 1;
}

void zbrowser_poll_css_task(void) {
    uint8_t *buffer;
    uint8_t *css_buffer;
    uint32_t next_pos;

    if (zbrowser_css_task_id != 0 && kernel_task_done(zbrowser_css_task_id) != 0) {
        kernel_task_release(zbrowser_css_task_id);
        zbrowser_css_task_id = 0;
        zbrowser_css_load_in_progress = 0;
        zbrowser_css_links_loaded = zbrowser_css_links_loaded + 1;
        if (zbrowser_has_document != 0 && zbrowser_doc_buffer_addr != 0) {
            buffer = document_buffer();
            if (zbrowser_css_fetch_size > 0) {
                css_buffer = (uint8_t *)zbrowser_css_buffer_addr;
                zbrowser_size = append_text_to_document(buffer, zbrowser_size, "\n<style>\n");
                zbrowser_size = append_buffer_to_document(buffer, zbrowser_size, css_buffer, zbrowser_css_fetch_size);
                zbrowser_size = append_text_to_document(buffer, zbrowser_size, "\n</style>\n");
                if ((uint32_t)zbrowser_size >= ZBROWSER_HTTP_CAPACITY - 1) {
                    zbrowser_doc_truncated = 1;
                }
                build_css_rule_cache(buffer);
                invalidate_prepared_web_styles();
                copy_text(zbrowser_status, 96, "css applied");
            }
            if (zbrowser_css_links_loaded < ZBROWSER_MAX_EXTERNAL_CSS &&
                next_external_stylesheet_url(buffer,
                                             zbrowser_css_scan_pos,
                                             zbrowser_css_url,
                                             ZBROWSER_URL_CAPACITY,
                                             &next_pos) != 0) {
                zbrowser_css_scan_pos = next_pos;
                zbrowser_css_load_done = 0;
            } else {
                zbrowser_css_url[0] = 0;
                zbrowser_css_load_done = 1;
            }
        } else {
            zbrowser_css_url[0] = 0;
            zbrowser_css_load_done = 1;
        }
        zbrowser_css_fetch_size = 0;
        request_asset_redraw(1);
    }
    schedule_css_fetch();
}

void zbrowser_wait_css_task(void) {
    if (zbrowser_css_task_id != 0) {
        kernel_task_wait(zbrowser_css_task_id);
        kernel_task_release(zbrowser_css_task_id);
        zbrowser_css_task_id = 0;
        zbrowser_css_load_in_progress = 0;
        zbrowser_css_load_done = 1;
    }
}

int zbrowser_normalize_with_netsurf(uint8_t *buffer, int size) {
    int rewritten;

    if (size <= 0) {
        return size;
    }
    copy_text(zbrowser_status, 96, "parsing dom");
    rewritten = netsurf_port_rewrite_html(buffer,
                                          (uint32_t)size,
                                          buffer,
                                          ZBROWSER_HTTP_CAPACITY + 1);
    zbrowser_netsurf_dom_status = netsurf_port_dom_status();
    if (rewritten > 0) {
        zbrowser_netsurf_dom_used = 1;
        buffer[rewritten] = 0;
        return rewritten;
    }
    zbrowser_netsurf_dom_used = 0;
    return size;
}

int zbrowser_prepare_render_dom_with_netsurf(uint8_t *buffer, int size) {
    int rewritten;

    if (size <= 0) {
        return size;
    }
    copy_text(zbrowser_status, 96, "building dom view");
    rewritten = netsurf_port_rewrite_render_html(buffer,
                                                 (uint32_t)size,
                                                 buffer,
                                                 ZBROWSER_HTTP_CAPACITY + 1);
    zbrowser_netsurf_dom_status = netsurf_port_dom_status();
    if (rewritten > 0) {
        zbrowser_netsurf_dom_used = 1;
        buffer[rewritten] = 0;
        return rewritten;
    }
    return size;
}

void load_document(void) {
    uint8_t *buffer;
    int size;
    uint32_t tried_browser_url;
    uint32_t auto_https;
    struct NetHttpInfo http_info;

    buffer = document_buffer();
    invalidate_prepared_web_styles();
    zbrowser_has_document = 0;
    zbrowser_size = 0;
    zbrowser_doc_truncated = 0;
    clear_css_rule_cache();
    zbrowser_css_url[0] = 0;
    zbrowser_css_load_in_progress = 0;
    zbrowser_css_load_done = 0;
    zbrowser_css_scan_pos = 0;
    zbrowser_css_links_loaded = 0;
    zbrowser_css_fetch_size = 0;
    zbrowser_css_fetch_result = 0;
    zbrowser_js_executed = 0;
    zbrowser_js_writes = 0;
    zbrowser_netsurf_dom_used = 0;
    zbrowser_netsurf_dom_status = 0;
    zbrowser_clear_http_diag();
    reset_page_style();
    tried_browser_url = 0;
    auto_https = 0;

    if (zbrowser_url[0] == 0) {
        size = os_read_file("browser.url", zbrowser_url, ZBROWSER_URL_CAPACITY - 1);
        if (size > 0) {
            zbrowser_url[size] = 0;
            trim_text_end(zbrowser_url);
            tried_browser_url = 1;
        } else {
            copy_text(zbrowser_url, ZBROWSER_URL_CAPACITY, "https://de.wikipedia.org/");
        }
    }

    if (has_scheme(zbrowser_url) == 0 && zbrowser_url[0] != 0) {
        size = os_read_file(zbrowser_url, buffer, ZBROWSER_HTTP_CAPACITY - 1);
        if (size > 0) {
            buffer[size] = 0;
            size = zbrowser_normalize_with_netsurf(buffer, size);
            size = zbrowser_process_inline_scripts(buffer, size);
            size = zbrowser_prepare_render_dom_with_netsurf(buffer, size);
            prepare_external_css_queue(buffer);
            build_css_rule_cache(buffer);
            zbrowser_size = size;
            prepare_web_styles_for_loaded_document(buffer);
            if ((uint32_t)size >= ZBROWSER_HTTP_CAPACITY - 1) {
                zbrowser_doc_truncated = 1;
            }
            zbrowser_has_document = 1;
            clear_image_cache();
            copy_text(zbrowser_status, 96, "loaded local file");
            zbrowser_loaded = 1;
            return;
        }
    }

    if (has_scheme(zbrowser_url) == 0 && zbrowser_url[0] != 0 && looks_like_host(zbrowser_url) != 0) {
        copy_text(zbrowser_url_tmp, ZBROWSER_URL_CAPACITY, "https://");
        append_text_limited(zbrowser_url_tmp, ZBROWSER_URL_CAPACITY, zbrowser_url);
        copy_text(zbrowser_url, ZBROWSER_URL_CAPACITY, zbrowser_url_tmp);
        auto_https = 1;
    } else if (has_scheme(zbrowser_url) == 0 && zbrowser_url[0] != 0) {
        make_search_url(zbrowser_url, zbrowser_url_tmp, ZBROWSER_URL_CAPACITY);
        copy_text(zbrowser_url, ZBROWSER_URL_CAPACITY, zbrowser_url_tmp);
    }

    copy_text(zbrowser_status, 96, "loading");
    zbrowser_scroll = 0;

    if (zb_starts_with(zbrowser_url, "http://") || zb_starts_with(zbrowser_url, "https://")) {
        if (zb_starts_with(zbrowser_url, "https://")) {
            copy_text(zbrowser_status, 96, "fetching https");
        } else {
            copy_text(zbrowser_status, 96, "fetching http");
        }
        size = http_get_page_with_retry(zbrowser_url, buffer, ZBROWSER_HTTP_CAPACITY, &http_info);
        zbrowser_capture_http_diag(size, &http_info);
        if (size < 0 && auto_https != 0 && zb_starts_with(zbrowser_url, "https://") != 0) {
            copy_text(zbrowser_status, 96, "retrying http");
            copy_text(zbrowser_url_tmp, ZBROWSER_URL_CAPACITY, "http://");
            append_text_limited(zbrowser_url_tmp, ZBROWSER_URL_CAPACITY, zbrowser_url + 8);
            copy_text(zbrowser_url, ZBROWSER_URL_CAPACITY, zbrowser_url_tmp);
            size = http_get_page_with_retry(zbrowser_url, buffer, ZBROWSER_HTTP_CAPACITY, &http_info);
            zbrowser_capture_http_diag(size, &http_info);
        }
        if (size >= 0) {
            buffer[size] = 0;
            size = zbrowser_normalize_with_netsurf(buffer, size);
            size = zbrowser_process_inline_scripts(buffer, size);
            size = zbrowser_prepare_render_dom_with_netsurf(buffer, size);
            prepare_external_css_queue(buffer);
            build_css_rule_cache(buffer);
            zbrowser_size = size;
            prepare_web_styles_for_loaded_document(buffer);
            if ((uint32_t)size >= ZBROWSER_HTTP_CAPACITY) {
                zbrowser_doc_truncated = 1;
            }
            zbrowser_has_document = 1;
            clear_image_cache();
            if (zb_starts_with(zbrowser_url, "https://")) {
                copy_text(zbrowser_status, 96, "loaded https");
            } else {
                copy_text(zbrowser_status, 96, "loaded http");
            }
            zbrowser_loaded = 1;
            return;
        }
        if (zb_starts_with(zbrowser_url, "https://")) {
            set_http_error_status("https", size, &http_info);
        } else {
            set_http_error_status("http", size, &http_info);
        }
        zbrowser_css_load_done = 1;
        zbrowser_loaded = 1;
        return;
    }

    size = os_read_file(zbrowser_url, buffer, ZBROWSER_HTTP_CAPACITY - 1);
    if (size >= 0) {
        buffer[size] = 0;
        size = zbrowser_normalize_with_netsurf(buffer, size);
        size = zbrowser_process_inline_scripts(buffer, size);
        size = zbrowser_prepare_render_dom_with_netsurf(buffer, size);
        prepare_external_css_queue(buffer);
        build_css_rule_cache(buffer);
        zbrowser_size = size;
        prepare_web_styles_for_loaded_document(buffer);
        if ((uint32_t)size >= ZBROWSER_HTTP_CAPACITY - 1) {
            zbrowser_doc_truncated = 1;
        }
        zbrowser_has_document = 1;
        copy_text(zbrowser_status, 96, "loaded local file");
    } else {
        if (tried_browser_url != 0) {
            copy_text(zbrowser_status, 96, "browser.url target not found");
        } else {
            copy_text(zbrowser_status, 96, "showing help");
        }
        zbrowser_css_load_done = 1;
    }
    zbrowser_loaded = 1;
}

void zbrowser_load_worker(uint8_t *arg) {
    load_document();
    zbrowser_load_in_progress = 0;
    zbrowser_render_after_load = 1;
    zbrowser_needs_redraw = 1;
}

void zbrowser_poll_load_task(void) {
    if (zbrowser_load_task_id != 0 && kernel_task_done(zbrowser_load_task_id) != 0) {
        kernel_task_release(zbrowser_load_task_id);
        zbrowser_load_task_id = 0;
        zbrowser_load_in_progress = 0;
        zbrowser_render_after_load = 1;
        zbrowser_needs_redraw = 1;
    }
}

void zbrowser_wait_image_task(void) {
    if (zbrowser_image_task_id != 0) {
        kernel_task_wait(zbrowser_image_task_id);
        kernel_task_release(zbrowser_image_task_id);
        zbrowser_image_task_id = 0;
        zbrowser_image_load_in_progress = 0;
    }
}

int zbrowser_background_task_active(void) {
    if (zbrowser_load_in_progress != 0 || zbrowser_load_task_id != 0) {
        return 1;
    }
    if (zbrowser_css_load_in_progress != 0 || zbrowser_css_task_id != 0) {
        return 1;
    }
    if (zbrowser_image_load_in_progress != 0 || zbrowser_image_task_id != 0) {
        return 1;
    }
    return 0;
}

void start_load_document_task(void) {
    if (zbrowser_load_in_progress != 0) {
        return;
    }
    zbrowser_has_document = 0;
    zbrowser_loaded = 0;
    zbrowser_render_after_load = 0;
    zbrowser_style_prepare_w = gfx_width();
    zbrowser_style_prepare_h = gfx_height();
    if (kernel_task_async_supported() == 0) {
        zbrowser_loaded = 1;
        zbrowser_load_in_progress = 0;
        copy_text(zbrowser_status, 96, "background tasks unavailable");
        zbrowser_needs_redraw = 1;
        return;
    }
    zbrowser_load_in_progress = 1;
    copy_text(zbrowser_status, 96, "loading in background");
    zbrowser_load_task_id = kernel_task_submit_async_named(zbrowser_load_worker, (uint8_t *)0, "zbrowser-load");
    if (zbrowser_load_task_id == 0) {
        copy_text(zbrowser_status, 96, "background task failed");
        zbrowser_loaded = 1;
        zbrowser_load_in_progress = 0;
        zbrowser_render_after_load = 0;
    }
}

void zbrowser_reload(void) {
    if (zbrowser_background_task_active() != 0) {
        zbrowser_reload_pending = 1;
        zbrowser_chrome_dirty = 1;
        zbrowser_needs_redraw = 1;
        copy_text(zbrowser_status, 96, "reload queued");
        return;
    }
    zbrowser_wait_css_task();
    zbrowser_wait_image_task();
    invalidate_prepared_web_styles();
    zbrowser_doc_redraw_defer = 0;
    zbrowser_scroll_light_redraw = 0;
    zbrowser_asset_redraw_pending = 0;
    zbrowser_asset_redraw_delay = 0;
    zbrowser_loaded = 0;
    zbrowser_render_after_load = 0;
    zbrowser_focused_input = 9999;
    zbrowser_chrome_dirty = 0;
    zbrowser_needs_redraw = 1;
    zbrowser_reload_pending = 0;
}

void defer_doc_redraw_editing(void) {
    if (zbrowser_editing != 0 && zbrowser_needs_redraw != 0) {
        zbrowser_needs_redraw = 0;
        zbrowser_doc_redraw_defer = 1;
        zbrowser_chrome_dirty = 1;
    }
}

void finish_url_editing(void) {
    zbrowser_editing = 0;
    zbrowser_chrome_dirty = 1;
    if (zbrowser_doc_redraw_defer != 0) {
        zbrowser_doc_redraw_defer = 0;
        zbrowser_needs_redraw = 1;
    }
}

int draw_cached_image_records(uint32_t first_line, uint32_t last_line) {
    uint32_t index;
    uint32_t line;
    uint32_t record_end;
    uint32_t cache_slot;
    uint32_t draw_y;
    uint32_t draw_h;
    uint32_t y_offset;
    uint32_t bottom;
    uint32_t link_index;
    uint32_t missed;

    missed = 0;
    index = 0;
    while (index < zbrowser_image_record_count) {
        line = zbrowser_image_record_lines[index];
        record_end = line + ((zbrowser_image_record_h[index] + 11) / 12) + 1;
        if (record_end >= first_line && line <= last_line) {
            cache_slot = find_decoded_image_slot(zbrowser_image_record_raw_slots[index],
                                                 zbrowser_image_record_w[index],
                                                 zbrowser_image_record_h[index],
                                                 zbrowser_image_record_bgs[index]);
            if (cache_slot == 9999) {
                missed = 1;
            } else {
                y_offset = 0;
                draw_h = zbrowser_image_record_h[index];
                if (line < zbrowser_scroll) {
                    y_offset = (zbrowser_scroll - line) * 12;
                    if (y_offset >= draw_h) {
                        index = index + 1;
                        continue;
                    }
                    draw_h = draw_h - y_offset;
                    draw_y = zbrowser_y;
                } else {
                    draw_y = zbrowser_y + (line - zbrowser_scroll) * 12;
                }
                bottom = gfx_height();
                if (bottom > 18) {
                    bottom = bottom - 18;
                }
                if (draw_y < bottom) {
                    if (draw_y + draw_h > bottom) {
                        draw_h = bottom - draw_y;
                    }
                    if (draw_h != 0) {
                        if (draw_decoded_image_slot(cache_slot,
                                                    zbrowser_image_record_x[index],
                                                    draw_y,
                                                    zbrowser_image_record_w[index],
                                                    draw_h,
                                                    y_offset) == 0) {
                            missed = 1;
                        } else {
                            link_index = zbrowser_image_record_links[index];
                            if (link_index != 9999) {
                                set_link_rect_exact(link_index,
                                                    zbrowser_image_record_x[index],
                                                    draw_y,
                                                    zbrowser_image_record_w[index],
                                                    draw_h);
                            }
                        }
                    }
                }
            }
        }
        index = index + 1;
    }
    if (missed != 0) {
        return 0;
    }
    return 1;
}

int zbrowser_draw_cached_viewport(void) {
    uint32_t w;
    uint32_t h;
    uint32_t body_h;
    uint32_t visible_lines;
    uint32_t line;
    uint32_t end_line;
    uint32_t missed;

    if (zbrowser_line_cache_addr == 0 ||
        zbrowser_line_cache_fg_addr == 0 ||
        zbrowser_loaded == 0 ||
        zbrowser_load_in_progress != 0 ||
        zbrowser_has_document == 0) {
        return 0;
    }

    w = gfx_width();
    h = gfx_height();
    if (w == 0 || h <= zbrowser_y + 20) {
        return 0;
    }

    body_h = h - zbrowser_y - 20;
    visible_lines = (body_h + 11) / 12;
    if (visible_lines == 0) {
        return 0;
    }

    gfx_fill_rect(0, zbrowser_y, w, body_h, zbrowser_page_bg_color);
    line = zbrowser_scroll;
    end_line = zbrowser_scroll + visible_lines + 2;
    missed = 0;
    if (draw_cached_image_records(line, end_line) == 0) {
        missed = 1;
    }
    while (line <= end_line) {
        if (draw_cached_line(line) == 0) {
            missed = 1;
        }
        if (line == end_line) {
            break;
        }
        line = line + 1;
    }
    if (missed != 0) {
        return 2;
    }
    return 1;
}

void zbrowser_scroll_by(int delta) {
    uint32_t amount;
    uint32_t old_scroll;
    uint32_t cache_result;

    old_scroll = zbrowser_scroll;
    if (delta < 0) {
        amount = (uint32_t)(0 - delta);
        if (amount > zbrowser_scroll) {
            zbrowser_scroll = 0;
        } else {
            zbrowser_scroll = zbrowser_scroll - amount;
        }
    } else {
        zbrowser_scroll = zbrowser_scroll + (uint32_t)delta;
    }
    if (zbrowser_scroll == old_scroll) {
        return;
    }
    zbrowser_scroll_light_redraw = 1;
    cache_result = zbrowser_draw_cached_viewport();
    if (cache_result != 0) {
        zbrowser_scroll_cooldown = 8;
        zbrowser_chrome_dirty = 0;
        if (cache_result == 1) {
            zbrowser_needs_redraw = 0;
        } else {
            zbrowser_needs_redraw = 1;
        }
    } else {
        zbrowser_scroll_cooldown = 3;
        zbrowser_chrome_dirty = 1;
        zbrowser_needs_redraw = 1;
    }
}

export void zmodule_redraw(void) {
    if (zbrowser_enabled == 0) {
        return;
    }
    if (gfx_viewport_active() == 0) {
        return;
    }
    if (zbrowser_scroll_cooldown != 0 || zbrowser_scroll_light_redraw != 0) {
        zbrowser_image_decode_budget = 0;
    } else {
        zbrowser_image_decode_budget = 2;
    }
    zbrowser_poll_load_task();
    zbrowser_poll_css_task();
    zbrowser_poll_image_task();
    if (zbrowser_loaded == 0) {
        start_load_document_task();
        draw_shell();
        return;
    }
    if (zbrowser_load_in_progress != 0) {
        draw_shell();
        return;
    }
    if (zbrowser_has_document != 0) {
        if (render_image_if_supported(document_buffer(), (uint32_t)zbrowser_size) == 0) {
            render_html(document_buffer());
        }
    } else {
        render_help();
    }
    zbrowser_scroll_light_redraw = 0;
}

export void zmodule_tick(void) {
    uint32_t scroll_settling;

    scroll_settling = 0;
    zbrowser_poll_load_task();
    zbrowser_poll_css_task();
    zbrowser_poll_image_task();
    if (zbrowser_reload_pending != 0 && zbrowser_background_task_active() == 0) {
        zbrowser_reload_pending = 0;
        zbrowser_reload();
        return;
    }
    if (zbrowser_asset_redraw_pending != 0 &&
        zbrowser_scroll_cooldown == 0 &&
        zbrowser_load_in_progress == 0) {
        if (zbrowser_asset_redraw_delay != 0) {
            zbrowser_asset_redraw_delay = zbrowser_asset_redraw_delay - 1;
        } else {
            zbrowser_asset_redraw_pending = 0;
            zbrowser_needs_redraw = 1;
        }
    }
    if (zbrowser_scroll_cooldown != 0) {
        zbrowser_scroll_cooldown = zbrowser_scroll_cooldown - 1;
        if (zbrowser_scroll_cooldown == 0) {
            zbrowser_scroll_light_redraw = 0;
        } else {
            scroll_settling = 1;
        }
    }
    defer_doc_redraw_editing();
    if (zbrowser_chrome_dirty != 0 && gfx_viewport_active() != 0) {
        zbrowser_chrome_dirty = 0;
        draw_chrome_only();
        return;
    }
    if (scroll_settling != 0 && zbrowser_needs_redraw != 0) {
        return;
    }
    if (zbrowser_needs_redraw != 0 && gfx_viewport_active() != 0) {
        zbrowser_needs_redraw = 0;
        zmodule_redraw();
    }
}

void navigate_to(const uint8_t *url) {
    copy_text(zbrowser_url, ZBROWSER_URL_CAPACITY, url);
    trim_text_end(zbrowser_url);
    zbrowser_editing = 0;
    zbrowser_focused_input = 9999;
    zbrowser_reload();
}

void activate_link_at_line(uint32_t line) {
    uint32_t i;

    i = 0;
    while (i < zbrowser_input_count) {
        if (zbrowser_input_lines[i] == line) {
            zbrowser_focused_input = i;
            zbrowser_editing = 0;
            zbrowser_doc_redraw_defer = 0;
            zbrowser_needs_redraw = 1;
            return;
        }
        i = i + 1;
    }
}

int activate_link_at_point(uint32_t x, uint32_t y) {
    uint32_t i;

    i = 0;
    while (i < zbrowser_input_count) {
        if (zbrowser_input_w[i] != 0 &&
            x >= zbrowser_input_x[i] &&
            x < zbrowser_input_x[i] + zbrowser_input_w[i] &&
            y >= zbrowser_input_y[i] &&
            y < zbrowser_input_y[i] + zbrowser_input_h[i]) {
            zbrowser_focused_input = i;
            zbrowser_editing = 0;
            zbrowser_doc_redraw_defer = 0;
            zbrowser_needs_redraw = 1;
            return 1;
        }
        i = i + 1;
    }

    i = 0;
    while (i < zbrowser_submit_count) {
        if (zbrowser_submit_w[i] != 0 &&
            x >= zbrowser_submit_x[i] &&
            x < zbrowser_submit_x[i] + zbrowser_submit_w[i] &&
            y >= zbrowser_submit_y[i] &&
            y < zbrowser_submit_y[i] + zbrowser_submit_h[i]) {
            submit_focused_form();
            return 1;
        }
        i = i + 1;
    }

    i = 0;
    while (i < zbrowser_link_count) {
        if (zbrowser_link_w[i] != 0 &&
            x >= zbrowser_link_x[i] &&
            x < zbrowser_link_x[i] + zbrowser_link_w[i] &&
            y >= zbrowser_link_y[i] &&
            y < zbrowser_link_y[i] + zbrowser_link_h[i]) {
            navigate_to((uint8_t *)zbrowser_links_addr + i * ZBROWSER_LINK_CAPACITY);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

export void zmodule_key(uint32_t key_type, uint32_t ch) {
    if (zbrowser_enabled == 0) {
        return;
    }

    if (zbrowser_editing != 0) {
        if (key_type == KEY_ENTER) {
            navigate_to(zbrowser_url);
            return;
        }
        if (key_type == KEY_ESC) {
            finish_url_editing();
            return;
        }
        if (key_type == KEY_BACKSPACE) {
            backspace_url();
            zbrowser_chrome_dirty = 1;
            return;
        }
        if (key_type == KEY_CHAR) {
            append_url_char((uint8_t)ch);
            zbrowser_chrome_dirty = 1;
            return;
        }
    }

    if (zbrowser_focused_input < zbrowser_input_count) {
        uint8_t *value;
        uint32_t len;

        value = input_value_slot(zbrowser_focused_input);
        if (key_type == KEY_ENTER) {
            submit_focused_form();
            return;
        }
        if (key_type == KEY_ESC) {
            zbrowser_focused_input = 9999;
            zbrowser_needs_redraw = 1;
            return;
        }
        if (key_type == KEY_BACKSPACE) {
            len = os_strlen(value);
            if (len > 0) {
                value[len - 1] = 0;
            }
            zbrowser_needs_redraw = 1;
            return;
        }
        if (key_type == KEY_CHAR) {
            append_text_limited(value, ZBROWSER_INPUT_VALUE_CAPACITY, "");
            len = os_strlen(value);
            if (len + 1 < ZBROWSER_INPUT_VALUE_CAPACITY) {
                value[len] = (uint8_t)ch;
                value[len + 1] = 0;
            }
            zbrowser_needs_redraw = 1;
            return;
        }
        if (key_type == KEY_TAB) {
            zbrowser_focused_input = zbrowser_focused_input + 1;
            if (zbrowser_focused_input >= zbrowser_input_count) {
                zbrowser_focused_input = 0;
            }
            zbrowser_needs_redraw = 1;
            return;
        }
    }

    if (key_type == KEY_TAB && zbrowser_input_count != 0) {
        zbrowser_focused_input = 0;
        zbrowser_editing = 0;
        zbrowser_doc_redraw_defer = 0;
        zbrowser_needs_redraw = 1;
        return;
    }

    if (key_type == KEY_CHAR && (ch == 108 || ch == 76)) {
        zbrowser_editing = 1;
        zbrowser_chrome_dirty = 1;
        return;
    }
    if (key_type == KEY_CHAR && (ch == 114 || ch == 82)) {
        zbrowser_reload();
        return;
    }
    if (key_type == KEY_CHAR && ch >= 48 && ch <= 57) {
        uint32_t index;
        index = (uint32_t)(ch - 48);
        if (index < zbrowser_link_count) {
            navigate_to((uint8_t *)zbrowser_links_addr + index * ZBROWSER_LINK_CAPACITY);
        }
        return;
    }
    if (key_type == KEY_UP) {
        zbrowser_scroll_by(-3);
        return;
    }
    if (key_type == KEY_DOWN) {
        zbrowser_scroll_by(3);
        return;
    }
}

export void zmodule_mouse(uint32_t x, uint32_t y, uint32_t buttons, int32_t wheel) {
    uint32_t line;

    if (zbrowser_enabled == 0) {
        return;
    }

    if (wheel != 0) {
        zbrowser_scroll_by(0 - wheel * 3);
        return;
    }

    if (buttons != 0) {
        if (zbrowser_scroll_cooldown != 0) {
            zbrowser_scroll_cooldown = 0;
            zbrowser_scroll_light_redraw = 0;
            zbrowser_needs_redraw = 0;
        }
        if (y < 42) {
            zbrowser_editing = 1;
            zbrowser_chrome_dirty = 1;
            return;
        }
        if (y >= zbrowser_y) {
            if (activate_link_at_point(x, y) != 0) {
                return;
            }
            line = zbrowser_scroll + ((y - zbrowser_y) / 12);
            activate_link_at_line(line);
        }
    }
}

export void zmodule_unload(void) {
    zbrowser_enabled = 0;
    zbrowser_wait_css_task();
    zbrowser_wait_image_task();
    if (zbrowser_load_task_id != 0) {
        kernel_task_wait(zbrowser_load_task_id);
        kernel_task_release(zbrowser_load_task_id);
        zbrowser_load_task_id = 0;
        zbrowser_load_in_progress = 0;
    }
    if (zbrowser_doc_buffer_addr != 0) {
        kfree((uint8_t *)zbrowser_doc_buffer_addr);
        zbrowser_doc_buffer_addr = 0;
    }
    if (zbrowser_css_buffer_addr != 0) {
        kfree((uint8_t *)zbrowser_css_buffer_addr);
        zbrowser_css_buffer_addr = 0;
    }
    if (zbrowser_css_sel_addr != 0) {
        kfree((uint8_t *)zbrowser_css_sel_addr);
        zbrowser_css_sel_addr = 0;
    }
    if (zbrowser_css_decl_addr != 0) {
        kfree((uint8_t *)zbrowser_css_decl_addr);
        zbrowser_css_decl_addr = 0;
    }
    if (zbrowser_image_buffer_addr != 0) {
        kfree((uint8_t *)zbrowser_image_buffer_addr);
        zbrowser_image_buffer_addr = 0;
    }
    if (zbrowser_decoded_image_buffer_addr != 0) {
        kfree((uint8_t *)zbrowser_decoded_image_buffer_addr);
        zbrowser_decoded_image_buffer_addr = 0;
    }
    if (zbrowser_links_addr != 0) {
        kfree((uint8_t *)zbrowser_links_addr);
        zbrowser_links_addr = 0;
    }
    if (zbrowser_line_cache_addr != 0) {
        kfree((uint8_t *)zbrowser_line_cache_addr);
        zbrowser_line_cache_addr = 0;
    }
    if (zbrowser_line_cache_fg_addr != 0) {
        kfree((uint8_t *)zbrowser_line_cache_fg_addr);
        zbrowser_line_cache_fg_addr = 0;
    }
}

zbrowser_enabled = 0;
zbrowser_doc_buffer_addr = (uint64_t)kmalloc(ZBROWSER_HTTP_CAPACITY + 1);
zbrowser_css_buffer_addr = (uint64_t)kmalloc(ZBROWSER_CSS_CAPACITY);
zbrowser_css_sel_addr = (uint64_t)kmalloc(ZBROWSER_CSS_SELECTOR_BYTES);
zbrowser_css_decl_addr = (uint64_t)kmalloc(ZBROWSER_CSS_DECL_BYTES);
