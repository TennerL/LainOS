    draw_y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
    if (draw_y + 22 >= h - 18) {
        zbrowser_line_no = zbrowser_line_no + 2;
        return;
    }

    box_w = 96;
    if (os_strlen(label) * 8 + 28 > box_w) {
        box_w = os_strlen(label) * 8 + 28;
    }
    if (article_w() > 32 && box_w > article_w() - 24) {
        box_w = article_w() - 24;
    }
    gfx_fill_rect(article_x() + 8, draw_y, box_w, 20, 0xeaecf0);
    gfx_draw_rect(article_x() + 8, draw_y, box_w, 20, 0xa2a9b1);
    draw_text_at_pixel(article_x() + 18, draw_y + 6, label, 0x202122, 0xeaecf0);
    zbrowser_line_no = zbrowser_line_no + 2;
}

