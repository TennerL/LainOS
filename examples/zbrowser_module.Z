void copy_text(uint8_t *dst, uint32_t capacity, const uint8_t *src) {
    uint32_t i;

    i = 0;
    if (capacity == 0) {
        return;
    }
    while (src[i] != 0 && i + 1 < capacity) {
        dst[i] = src[i];
        i = i + 1;
    }
    dst[i] = 0;
}

void append_text_limited(uint8_t *dst, uint32_t capacity, const uint8_t *src) {
    uint32_t len;
    uint32_t i;

    if (capacity == 0) {
        return;
    }
    len = os_strlen(dst);
    i = 0;
    while (src[i] != 0 && len + 1 < capacity) {
        dst[len] = src[i];
        len = len + 1;
        i = i + 1;
    }
    dst[len] = 0;
}

void append_char_limited(uint8_t *dst, uint32_t capacity, uint8_t ch) {
    uint32_t len;

    if (capacity == 0) {
        return;
    }
    len = os_strlen(dst);
    if (len + 1 >= capacity) {
        return;
    }
    dst[len] = ch;
    dst[len + 1] = 0;
}

void append_uint_limited(uint8_t *dst, uint32_t capacity, uint32_t value) {
    uint8_t digits[12];
    uint32_t count;

    count = 0;
    if (value == 0) {
        append_char_limited(dst, capacity, 48);
        return;
    }
    while (value != 0 && count < 11) {
        digits[count] = (uint8_t)(48 + (value % 10));
        value = value / 10;
        count = count + 1;
    }
    while (count > 0) {
        count = count - 1;
        append_char_limited(dst, capacity, digits[count]);
    }
}

void append_int_limited(uint8_t *dst, uint32_t capacity, int value) {
    if (value < 0) {
        append_char_limited(dst, capacity, 45);
        value = 0 - value;
    }
    append_uint_limited(dst, capacity, (uint32_t)value);
}

void append_text_from_limited(uint8_t *dst, uint32_t capacity, const uint8_t *src, uint32_t start) {
    uint32_t i;

    i = start;
    while (src[i] != 0) {
        append_char_limited(dst, capacity, src[i]);
        i = i + 1;
    }
}

uint8_t *input_name_slot(uint32_t index) {
    return zbrowser_input_names + index * ZBROWSER_INPUT_NAME_CAPACITY;
}

uint8_t *input_value_slot(uint32_t index) {
    return zbrowser_input_values + index * ZBROWSER_INPUT_VALUE_CAPACITY;
}

uint8_t *inline_control_label_slot(uint32_t index) {
    return zbrowser_inline_control_labels + index * ZBROWSER_INLINE_LABEL_CAPACITY;
}

uint8_t *image_url_slot(uint32_t index) {
    return zbrowser_cached_image_urls + index * ZBROWSER_LINK_CAPACITY;
}

uint8_t *image_buffer_slot(uint32_t index) {
    return (uint8_t *)zbrowser_image_buffer_addr + index * ZBROWSER_IMAGE_CAPACITY;
}

uint8_t *decoded_image_pixels(uint32_t slot) {
    return (uint8_t *)zbrowser_decoded_image_buffer_addr + zbrowser_decoded_image_offsets[slot] * 4;
}

uint32_t decoded_image_pixel_count(uint32_t width, uint32_t height) {
    if (width == 0 || height == 0) {
        return 0;
    }
    if (width > ZBROWSER_DECODED_IMAGE_PIXELS / height) {
        return 0;
    }
    return width * height;
}

void clear_decoded_image_cache(void) {
    uint32_t slot;

    slot = 0;
    while (slot < ZBROWSER_DECODED_IMAGE_SLOT_COUNT) {
        zbrowser_decoded_image_valids[slot] = 0;
        zbrowser_decoded_image_raw_slots[slot] = 9999;
        zbrowser_decoded_image_widths[slot] = 0;
        zbrowser_decoded_image_heights[slot] = 0;
        zbrowser_decoded_image_bgs[slot] = 0;
        zbrowser_decoded_image_offsets[slot] = 0;
        zbrowser_decoded_image_pixel_counts[slot] = 0;
        slot = slot + 1;
    }
    zbrowser_decoded_image_next_pixel = 0;
}

uint32_t find_decoded_image_slot(uint32_t raw_slot,
                                 uint32_t width,
                                 uint32_t height,
                                 uint32_t bg) {
    uint32_t slot;

    slot = 0;
    while (slot < ZBROWSER_DECODED_IMAGE_SLOT_COUNT) {
        if (zbrowser_decoded_image_valids[slot] != 0 &&
            zbrowser_decoded_image_raw_slots[slot] == raw_slot &&
            zbrowser_decoded_image_widths[slot] == width &&
            zbrowser_decoded_image_heights[slot] == height &&
            zbrowser_decoded_image_bgs[slot] == bg) {
            return slot;
        }
        slot = slot + 1;
    }
    return 9999;
}

uint32_t alloc_decoded_image_slot(uint32_t raw_slot,
                                  uint32_t width,
                                  uint32_t height,
                                  uint32_t bg,
                                  uint32_t pixels) {
    uint32_t slot;

    if (zbrowser_decoded_image_buffer_addr == 0 || pixels == 0 || pixels > ZBROWSER_DECODED_IMAGE_PIXELS) {
        return 9999;
    }
    if (zbrowser_decoded_image_next_pixel + pixels > ZBROWSER_DECODED_IMAGE_PIXELS) {
        clear_decoded_image_cache();
    }
    slot = 0;
    while (slot < ZBROWSER_DECODED_IMAGE_SLOT_COUNT) {
        if (zbrowser_decoded_image_valids[slot] == 0) {
            zbrowser_decoded_image_valids[slot] = 1;
            zbrowser_decoded_image_raw_slots[slot] = raw_slot;
            zbrowser_decoded_image_widths[slot] = width;
            zbrowser_decoded_image_heights[slot] = height;
            zbrowser_decoded_image_bgs[slot] = bg;
            zbrowser_decoded_image_offsets[slot] = zbrowser_decoded_image_next_pixel;
            zbrowser_decoded_image_pixel_counts[slot] = pixels;
            zbrowser_decoded_image_next_pixel = zbrowser_decoded_image_next_pixel + pixels;
            return slot;
        }
        slot = slot + 1;
    }

    clear_decoded_image_cache();
    zbrowser_decoded_image_valids[0] = 1;
    zbrowser_decoded_image_raw_slots[0] = raw_slot;
    zbrowser_decoded_image_widths[0] = width;
    zbrowser_decoded_image_heights[0] = height;
    zbrowser_decoded_image_bgs[0] = bg;
    zbrowser_decoded_image_offsets[0] = 0;
    zbrowser_decoded_image_pixel_counts[0] = pixels;
    zbrowser_decoded_image_next_pixel = pixels;
    return 0;
}

uint32_t ensure_decoded_image_slot(uint32_t raw_slot,
                                   uint32_t width,
                                   uint32_t height,
                                   uint32_t bg) {
    uint32_t slot;
    uint32_t pixels;

    slot = find_decoded_image_slot(raw_slot, width, height, bg);
    if (slot != 9999) {
        return slot;
    }
    if (raw_slot >= ZBROWSER_IMAGE_SLOT_COUNT ||
        zbrowser_cached_image_valids[raw_slot] != 1 ||
        zbrowser_cached_image_sizes[raw_slot] <= 0) {
        return 9999;
    }
    pixels = decoded_image_pixel_count(width, height);
    slot = alloc_decoded_image_slot(raw_slot, width, height, bg, pixels);
    if (slot == 9999) {
        return 9999;
    }
    zbrowser_image_draw_result = image_decode_scaled_to_packed(image_buffer_slot(raw_slot),
                                                               (uint32_t)zbrowser_cached_image_sizes[raw_slot],
                                                               width,
                                                               height,
                                                               bg,
                                                               decoded_image_pixels(slot));
    if (zbrowser_image_draw_result != 0) {
        zbrowser_decoded_image_valids[slot] = 0;
        return 9999;
    }
    return slot;
}

int draw_decoded_image_slot(uint32_t slot,
                            uint32_t x,
                            uint32_t y,
                            uint32_t width,
                            uint32_t height,
                            uint32_t y_offset) {
    uint8_t *pixels;
    uint32_t pixel_count;

    if (slot >= ZBROWSER_DECODED_IMAGE_SLOT_COUNT ||
        zbrowser_decoded_image_valids[slot] == 0 ||
        width == 0 ||
        height == 0 ||
        y_offset >= zbrowser_decoded_image_heights[slot]) {
        return 0;
    }
    pixel_count = decoded_image_pixel_count(width, height);
    if (pixel_count == 0) {
        return 0;
    }
    pixels = decoded_image_pixels(slot) + y_offset * zbrowser_decoded_image_widths[slot] * 4;
    if (gfx_draw_rect_packed(x, y, width, height, pixels, pixel_count) == 0) {
        return 1;
    }
    return 0;
}

void remember_image_line_cache(uint32_t start_line, uint32_t line_count) {
    uint32_t line;
    uint32_t end_line;

    line = start_line;
    end_line = start_line + line_count;
    while (line < end_line && line < ZBROWSER_LINE_CACHE_LINES) {
        remember_blank_line_cache(line);
        line = line + 1;
    }
}

void remember_rendered_image_record(uint32_t line,
                                    uint32_t x,
                                    uint32_t width,
                                    uint32_t height,
                                    uint32_t raw_slot,
                                    uint32_t link_index) {
    uint32_t index;

    if (width == 0 || height == 0 || raw_slot >= ZBROWSER_IMAGE_SLOT_COUNT) {
        return;
    }
    index = 0;
    while (index < zbrowser_image_record_count) {
        if (zbrowser_image_record_lines[index] == line &&
            zbrowser_image_record_x[index] == x &&
            zbrowser_image_record_w[index] == width &&
            zbrowser_image_record_h[index] == height &&
            zbrowser_image_record_raw_slots[index] == raw_slot &&
            zbrowser_image_record_bgs[index] == zbrowser_text_bg) {
            zbrowser_image_record_links[index] = link_index;
            return;
        }
        index = index + 1;
    }
    if (zbrowser_image_record_count >= ZBROWSER_IMAGE_RECORD_COUNT) {
        return;
    }
    index = zbrowser_image_record_count;
    zbrowser_image_record_lines[index] = line;
    zbrowser_image_record_x[index] = x;
    zbrowser_image_record_w[index] = width;
    zbrowser_image_record_h[index] = height;
    zbrowser_image_record_raw_slots[index] = raw_slot;
    zbrowser_image_record_bgs[index] = zbrowser_text_bg;
    zbrowser_image_record_links[index] = link_index;
    zbrowser_image_record_count = index + 1;
}

