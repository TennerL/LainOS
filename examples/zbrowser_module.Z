#define ZBROWSER_URL_CAPACITY 160
#define ZBROWSER_LINE_CAPACITY 160
#define ZBROWSER_HTTP_CAPACITY 262144
#define ZBROWSER_IMAGE_CAPACITY 524288
#define ZBROWSER_MAX_LINKS 64
#define ZBROWSER_LINK_CAPACITY 160
#define ZBROWSER_MAX_IMAGES 6
#define KEY_CHAR 1
#define KEY_ENTER 2
#define KEY_BACKSPACE 3
#define KEY_ESC 5
#define KEY_UP 8
#define KEY_DOWN 9
#define MOUSE_LEFT 1

#include "zbrowser_html_api.Z"

extern uint32_t gfx_width(void);
extern uint32_t gfx_height(void);
extern void gfx_fill_rect(uint32_t x, uint32_t y, uint32_t width, uint32_t height, uint32_t color);
extern void draw_text_at_pixel(uint32_t x, uint32_t y, const uint8_t *text, uint32_t fg, uint32_t bg);
extern int os_read_file(const uint8_t *path, uint8_t *buffer, uint32_t capacity);
extern int os_load_file_shared(const uint8_t *path);
extern uint8_t *os_file_buffer(void);
extern int os_http_get(const uint8_t *url, uint8_t *buffer, uint32_t capacity);
extern int os_strlen(const uint8_t *text);
extern uint8_t *kmalloc(uint32_t size);
extern void kfree(uint8_t *ptr);

struct ImageInfo {
    uint32_t width;
    uint32_t height;
    uint32_t components;
    uint32_t stride;
};

extern int image_probe(const uint8_t *data, uint32_t size, struct ImageInfo *out_image);
extern int image_decode_to_screen(const uint8_t *data,
                                  uint32_t size,
                                  uint32_t origin_x,
                                  uint32_t origin_y,
                                  struct ImageInfo *out_image);

global uint32_t zbrowser_enabled;
global uint32_t zbrowser_loaded;
global int zbrowser_size;
global uint32_t zbrowser_has_document;
global uint8_t zbrowser_url[160];
global uint8_t zbrowser_status[96];
global uint8_t zbrowser_line[160];
global uint32_t zbrowser_line_len;
global uint32_t zbrowser_y;
global uint32_t zbrowser_last_space;
global uint32_t zbrowser_line_no;
global uint32_t zbrowser_scroll;
global uint32_t zbrowser_editing;
global uint32_t zbrowser_needs_redraw;
global uint8_t zbrowser_attr[160];
global uint8_t zbrowser_url_tmp[160];
global uint64_t zbrowser_doc_buffer_addr;
global uint64_t zbrowser_image_buffer_addr;
global uint64_t zbrowser_links_addr;
global uint32_t zbrowser_link_lines[64];
global uint32_t zbrowser_link_count;
global uint32_t zbrowser_images_loaded;

void copy_text(uint8_t *dst, uint32_t capacity, const uint8_t *src) {
    uint32_t i;

    i = 0;
    if (capacity == 0) {
        return;
    }
    while (src[i] != 0 && i + 1 < capacity) {
        dst[i] = src[i];
        i = i + 1;
    }
    dst[i] = 0;
}

void append_text_limited(uint8_t *dst, uint32_t capacity, const uint8_t *src) {
    uint32_t len;
    uint32_t i;

    if (capacity == 0) {
        return;
    }
    len = os_strlen(dst);
    i = 0;
    while (src[i] != 0 && len + 1 < capacity) {
        dst[len] = src[i];
        len = len + 1;
        i = i + 1;
    }
    dst[len] = 0;
}

void append_char_limited(uint8_t *dst, uint32_t capacity, uint8_t ch) {
    uint32_t len;

    if (capacity == 0) {
        return;
    }
    len = os_strlen(dst);
    if (len + 1 >= capacity) {
        return;
    }
    dst[len] = ch;
    dst[len + 1] = 0;
}

int has_scheme(const uint8_t *url) {
    if (zb_starts_with(url, "http://") || zb_starts_with(url, "https://")) {
        return 1;
    }
    return 0;
}

int is_ignored_href(const uint8_t *href) {
    if (href[0] == 0 || href[0] == 35) {
        return 1;
    }
    if (zb_starts_with(href, "javascript:") || zb_starts_with(href, "mailto:")) {
        return 1;
    }
    return 0;
}

void make_wikipedia_search_url(const uint8_t *query, uint8_t *out, uint32_t capacity) {
    uint32_t i;
    uint8_t ch;

    copy_text(out, capacity, "https://en.wikipedia.org/wiki/Special:Search?search=");
    i = 0;
    while (query[i] != 0) {
        ch = query[i];
        if (ch == 32) {
            append_char_limited(out, capacity, 43);
        } else {
            append_char_limited(out, capacity, ch);
        }
        i = i + 1;
    }
}

void make_absolute_url(const uint8_t *base, const uint8_t *href, uint8_t *out, uint32_t capacity) {
    uint32_t i;
    uint32_t last_slash;
    uint32_t scheme_len;

    if (capacity == 0) {
        return;
    }
    out[0] = 0;
    if (href[0] == 0) {
        return;
    }
    if (has_scheme(href) != 0) {
        copy_text(out, capacity, href);
        return;
    }
    if (zb_starts_with(href, "//")) {
        if (zb_starts_with(base, "https://")) {
            copy_text(out, capacity, "https:");
        } else {
            copy_text(out, capacity, "http:");
        }
        append_text_limited(out, capacity, href);
        return;
    }

    scheme_len = 0;
    if (zb_starts_with(base, "https://")) {
        scheme_len = 8;
    } else if (zb_starts_with(base, "http://")) {
        scheme_len = 7;
    } else {
        copy_text(out, capacity, href);
        return;
    }

    i = scheme_len;
    while (base[i] != 0 && base[i] != 47) {
        i = i + 1;
    }

    if (href[0] == 47) {
        last_slash = i;
    } else {
        last_slash = i;
        while (base[i] != 0) {
            if (base[i] == 47) {
                last_slash = i + 1;
            }
            i = i + 1;
        }
    }

    i = 0;
    while (base[i] != 0 && i < last_slash && i + 1 < capacity) {
        out[i] = base[i];
        i = i + 1;
    }
    out[i] = 0;
    if (href[0] == 47) {
        append_text_limited(out, capacity, href);
    } else {
        if (last_slash == scheme_len || base[last_slash - 1] != 47) {
            append_char_limited(out, capacity, 47);
        }
        append_text_limited(out, capacity, href);
    }
}

void trim_text_end(uint8_t *text) {
    uint32_t len;

    len = os_strlen(text);
    while (len > 0 &&
           (text[len - 1] == 9 ||
            text[len - 1] == 10 ||
            text[len - 1] == 13 ||
            text[len - 1] == 32)) {
        len = len - 1;
        text[len] = 0;
    }
}

void append_url_char(uint8_t ch) {
    uint32_t len;

    len = os_strlen(zbrowser_url);
    if (len + 1 >= ZBROWSER_URL_CAPACITY) {
        return;
    }
    zbrowser_url[len] = ch;
    zbrowser_url[len + 1] = 0;
}

void backspace_url(void) {
    uint32_t len;

    len = os_strlen(zbrowser_url);
    if (len == 0) {
        return;
    }
    zbrowser_url[len - 1] = 0;
}

void draw_shell(void) {
    uint32_t w;
    uint32_t h;
    uint32_t address_bg;
    uint32_t address_w;
    uint32_t caret_x;

    w = gfx_width();
    h = gfx_height();
    address_bg = 0x202b33;
    if (zbrowser_editing != 0) {
        address_bg = 0x2f3d48;
    }
    gfx_fill_rect(0, 0, w, h, 0x0d1117);
    gfx_fill_rect(0, 0, w, 42, 0x151c22);
    gfx_fill_rect(0, 40, w, 2, 0xe05f4f);
    draw_text_at_pixel(8, 8, "Z Browser", 0xf7d154, 0x151c22);
    address_w = 32;
    if (w > 108) {
        address_w = w - 104;
    }
    gfx_fill_rect(88, 6, address_w, 24, address_bg);
    draw_text_at_pixel(96, 13, zbrowser_url, 0xf5fbf7, address_bg);
    if (zbrowser_editing != 0) {
        caret_x = 100;
        if (w > 20) {
            caret_x = w - 20;
        }
        draw_text_at_pixel(caret_x, 13, "_", 0xf7d154, address_bg);
    }
    if (h > 18) {
        draw_text_at_pixel(8, h - 18, zbrowser_status, 0xbdd7d0, 0x0d1117);
    }
}

void flush_line(void) {
    uint32_t h;
    uint32_t draw_y;

    h = gfx_height();
    if (zbrowser_line_len == 0) {
        return;
    }
    zbrowser_line[zbrowser_line_len] = 0;
    if (zbrowser_line_no >= zbrowser_scroll) {
        draw_y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
        if (draw_y + 12 < h) {
            draw_text_at_pixel(8, draw_y, zbrowser_line, 0xe8dccd, 0x0d1117);
        }
    }
    zbrowser_line_len = 0;
    zbrowser_line[0] = 0;
    zbrowser_last_space = 0;
    zbrowser_line_no = zbrowser_line_no + 1;
}

void register_link(const uint8_t *href) {
    uint8_t *slot;

    if (zbrowser_links_addr == 0 || zbrowser_link_count >= ZBROWSER_MAX_LINKS) {
        return;
    }
    if (is_ignored_href(href) != 0) {
        return;
    }
    slot = (uint8_t *)zbrowser_links_addr + zbrowser_link_count * ZBROWSER_LINK_CAPACITY;
    make_absolute_url(zbrowser_url, href, slot, ZBROWSER_LINK_CAPACITY);
    if (slot[0] == 0) {
        return;
    }
    zbrowser_link_lines[zbrowser_link_count] = zbrowser_line_no;
    zbrowser_link_count = zbrowser_link_count + 1;
}

void blank_line(void) {
    flush_line();
    zbrowser_line_no = zbrowser_line_no + 1;
    zbrowser_last_space = 0;
}

void emit_char(uint8_t ch) {
    uint32_t w;
    uint32_t max_cols;

    if (ch == 9 || ch == 10 || ch == 13 || ch == 32) {
        ch = 32;
    }
    if (ch == 32) {
        if (zbrowser_line_len == 0 || zbrowser_last_space != 0) {
            return;
        }
        zbrowser_last_space = 1;
    } else {
        zbrowser_last_space = 0;
    }

    if (ch < 32) {
        return;
    }

    w = gfx_width();
    max_cols = 18;
    if (w > 24) {
        max_cols = (w - 16) / 8;
    }
    if (max_cols >= ZBROWSER_LINE_CAPACITY) {
        max_cols = ZBROWSER_LINE_CAPACITY - 1;
    }
    if (zbrowser_line_len + 1 >= max_cols) {
        flush_line();
    }
    if (!(ch == 32 && zbrowser_line_len == 0)) {
        zbrowser_line[zbrowser_line_len] = ch;
        zbrowser_line_len = zbrowser_line_len + 1;
    }
}

void emit_text(const uint8_t *text) {
    uint32_t i;

    i = 0;
    while (text[i] != 0) {
        emit_char(text[i]);
        i = i + 1;
    }
}

void emit_link_index(uint32_t index) {
    uint32_t digit;

    emit_text("[");
    if (index >= 10) {
        digit = 48 + (index / 10);
        emit_char((uint8_t)digit);
    }
    digit = 48 + (index % 10);
    emit_char((uint8_t)digit);
    emit_text("] ");
}

uint32_t render_inline_until_close_tag(const uint8_t *html, uint32_t pos, const uint8_t *name) {
    uint32_t advance;
    uint8_t ch;

    while (html[pos] != 0) {
        ch = html[pos];
        if (ch == 60) {
            if (zb_is_closing_tag(html, pos) != 0 && zb_tag_name_is(html, pos, name) != 0) {
                return zb_skip_tag(html, pos);
            }
            pos = zb_skip_tag(html, pos);
        } else if (ch == 38) {
            ch = zb_entity_char(html, pos, &advance);
            emit_char(ch);
            pos = pos + advance;
        } else {
            emit_char(ch);
            pos = pos + 1;
        }
    }
    return pos;
}

void render_html(const uint8_t *html) {
    uint32_t pos;
    uint32_t advance;
    uint8_t ch;

    draw_shell();
    zbrowser_y = 52;
    zbrowser_line_len = 0;
    zbrowser_line[0] = 0;
    zbrowser_last_space = 0;
    zbrowser_line_no = 0;
    zbrowser_link_count = 0;
    zbrowser_images_loaded = 0;
    pos = 0;

    while (html[pos] != 0) {
        ch = html[pos];
        if (ch == 60) {
            if (zb_starts_with(html + pos, "<!--")) {
                pos = zb_skip_comment(html, pos + 4);
                continue;
            }
            if (zb_tag_name_is(html, pos, "script")) {
                pos = zb_skip_until_close_tag(html, zb_skip_tag(html, pos), "script");
                continue;
            }
            if (zb_tag_name_is(html, pos, "style")) {
                pos = zb_skip_until_close_tag(html, zb_skip_tag(html, pos), "style");
                continue;
            }
            if (zb_tag_name_is(html, pos, "title")) {
                blank_line();
                emit_text("Title: ");
                pos = render_inline_until_close_tag(html, zb_skip_tag(html, pos), "title");
                blank_line();
                continue;
            }
            if (zb_tag_name_is(html, pos, "br")) {
                flush_line();
            } else if (zb_tag_name_is(html, pos, "p") ||
                       zb_tag_name_is(html, pos, "div") ||
                       zb_tag_name_is(html, pos, "section") ||
                       zb_tag_name_is(html, pos, "article") ||
                       zb_tag_name_is(html, pos, "tr")) {
                if (!zb_is_closing_tag(html, pos)) {
                    blank_line();
                }
            } else if (zb_tag_name_is(html, pos, "h1") ||
                       zb_tag_name_is(html, pos, "h2") ||
                       zb_tag_name_is(html, pos, "h3")) {
                blank_line();
                if (!zb_is_closing_tag(html, pos)) {
                    emit_text("# ");
                }
            } else if (zb_tag_name_is(html, pos, "li")) {
                if (!zb_is_closing_tag(html, pos)) {
                    flush_line();
                    emit_text("- ");
                }
            } else if (zb_tag_name_is(html, pos, "a")) {
                if (!zb_is_closing_tag(html, pos) && zb_attr_value(html, pos, "href", zbrowser_attr, 160) != 0) {
                    register_link(zbrowser_attr);
                    if (zbrowser_link_count != 0) {
                        emit_link_index(zbrowser_link_count - 1);
                    }
                }
            } else if (zb_tag_name_is(html, pos, "img")) {
                if (zb_attr_value(html, pos, "src", zbrowser_attr, 160) != 0 &&
                    render_inline_image(zbrowser_attr) != 0) {
                    pos = zb_skip_tag(html, pos);
                    continue;
                }
                if (zb_attr_value(html, pos, "alt", zbrowser_attr, 160) != 0 && zbrowser_attr[0] != 0) {
                    emit_text("[image: ");
                    emit_text(zbrowser_attr);
                    emit_text("]");
                } else if (zb_attr_value(html, pos, "src", zbrowser_attr, 160) != 0 && zbrowser_attr[0] != 0) {
                    emit_text("[image: ");
                    emit_text(zbrowser_attr);
                    emit_text("]");
                } else {
                    emit_text("[image]");
                }
            } else if (zb_tag_name_is(html, pos, "input")) {
                emit_text("[input]");
            } else if (zb_tag_name_is(html, pos, "button")) {
                if (!zb_is_closing_tag(html, pos)) {
                    emit_text("[button] ");
                }
            }
            pos = zb_skip_tag(html, pos);
        } else if (ch == 38) {
            ch = zb_entity_char(html, pos, &advance);
            emit_char(ch);
            pos = pos + advance;
        } else {
            emit_char(ch);
            pos = pos + 1;
        }
    }
    flush_line();
}

int render_image_if_supported(const uint8_t *data, uint32_t size) {
    struct ImageInfo image;
    int rc;
    uint32_t w;
    uint32_t h;
    uint32_t x;
    uint32_t y;
    uint32_t image_area_h;

    rc = image_probe(data, size, &image);
    if (rc != 0) {
        return 0;
    }

    draw_shell();
    w = gfx_width();
    h = gfx_height();
    x = 0;
    y = 40;
    image_area_h = 0;
    if (h > 62) {
        image_area_h = h - 62;
    }
    if (w > image.width) {
        x = (w - image.width) / 2;
    }
    if (image_area_h > image.height) {
        y = 38 + (image_area_h - image.height) / 2;
    }

    rc = image_decode_to_screen(data, size, x, y, &image);
    if (rc == 0) {
        copy_text(zbrowser_status, 96, "loaded image");
    } else {
        copy_text(zbrowser_status, 96, "image decode failed");
    }
    draw_text_at_pixel(8, h - 18, zbrowser_status, 0xbdd7d0, 0x0d1117);
    return 1;
}

int should_try_inline_image(const uint8_t *src) {
    if (src[0] == 0) {
        return 0;
    }
    if (zb_starts_with(src, "data:")) {
        return 0;
    }
    if (zb_starts_with(src, "about:")) {
        return 0;
    }
    if (zb_starts_with(src, "javascript:")) {
        return 0;
    }
    return 1;
}

int render_inline_image(const uint8_t *src) {
    struct ImageInfo image;
    int size;
    int rc;
    uint32_t h;
    uint32_t draw_y;
    uint32_t x;

    if (zbrowser_image_buffer_addr == 0 || zbrowser_images_loaded >= ZBROWSER_MAX_IMAGES) {
        return 0;
    }
    if (should_try_inline_image(src) == 0) {
        return 0;
    }
    if (zbrowser_line_no < zbrowser_scroll) {
        return 0;
    }

    make_absolute_url(zbrowser_url, src, zbrowser_url_tmp, 160);
    if (zbrowser_url_tmp[0] == 0 || has_scheme(zbrowser_url_tmp) == 0) {
        return 0;
    }

    size = os_http_get(zbrowser_url_tmp, (uint8_t *)zbrowser_image_buffer_addr, ZBROWSER_IMAGE_CAPACITY);
    if (size <= 0) {
        return 0;
    }
    rc = image_probe((uint8_t *)zbrowser_image_buffer_addr, (uint32_t)size, &image);
    if (rc != 0) {
        return 0;
    }
    if (image.width > gfx_width() - 16 || image.height > 180) {
        return 0;
    }

    flush_line();
    h = gfx_height();
    if (zbrowser_line_no >= zbrowser_scroll) {
        draw_y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
        if (draw_y + image.height < h - 18) {
            x = 8;
            rc = image_decode_to_screen((uint8_t *)zbrowser_image_buffer_addr, (uint32_t)size, x, draw_y, &image);
            if (rc == 0) {
                zbrowser_line_no = zbrowser_line_no + (image.height / 12) + 1;
                zbrowser_images_loaded = zbrowser_images_loaded + 1;
                return 1;
            }
        }
    } else {
        zbrowser_line_no = zbrowser_line_no + (image.height / 12) + 1;
        zbrowser_images_loaded = zbrowser_images_loaded + 1;
        return 1;
    }
    return 0;
}

void render_help(void) {
    draw_shell();
    draw_text_at_pixel(8, 48, "No page loaded.", 0xe8dccd, 0x0d1117);
    if (zb_starts_with(zbrowser_status, "https")) {
        draw_text_at_pixel(8, 64, zbrowser_status, 0xe8dccd, 0x0d1117);
        draw_text_at_pixel(8, 80, "Try a plain http:// URL.", 0xe8dccd, 0x0d1117);
    } else {
        draw_text_at_pixel(8, 64, "Use browser.url with http:// or https://", 0xe8dccd, 0x0d1117);
        draw_text_at_pixel(8, 80, "or save a local index.html file.", 0xe8dccd, 0x0d1117);
    }
}

uint8_t *document_buffer(void) {
    if (zbrowser_doc_buffer_addr != 0) {
        return (uint8_t *)zbrowser_doc_buffer_addr;
    }
    return os_file_buffer();
}

void load_document(void) {
    uint8_t *buffer;
    int size;
    uint32_t tried_browser_url;

    buffer = document_buffer();
    zbrowser_has_document = 0;
    zbrowser_size = 0;
    tried_browser_url = 0;

    if (zbrowser_url[0] == 0) {
        size = os_read_file("browser.url", zbrowser_url, ZBROWSER_URL_CAPACITY - 1);
        if (size > 0) {
            zbrowser_url[size] = 0;
            trim_text_end(zbrowser_url);
            tried_browser_url = 1;
        } else {
            copy_text(zbrowser_url, ZBROWSER_URL_CAPACITY, "https://en.wikipedia.org/wiki/Main_Page");
        }
    }

    if (has_scheme(zbrowser_url) == 0 && zbrowser_url[0] != 0) {
        make_wikipedia_search_url(zbrowser_url, zbrowser_url_tmp, 160);
        copy_text(zbrowser_url, ZBROWSER_URL_CAPACITY, zbrowser_url_tmp);
    }

    copy_text(zbrowser_status, 96, "loading");
    zbrowser_scroll = 0;
    draw_shell();

    if (zb_starts_with(zbrowser_url, "http://") || zb_starts_with(zbrowser_url, "https://")) {
        if (zb_starts_with(zbrowser_url, "https://")) {
            copy_text(zbrowser_status, 96, "fetching https");
        } else {
            copy_text(zbrowser_status, 96, "fetching http");
        }
        draw_shell();
        size = os_http_get(zbrowser_url, buffer, ZBROWSER_HTTP_CAPACITY);
        if (size >= 0) {
            buffer[size] = 0;
            zbrowser_size = size;
            zbrowser_has_document = 1;
            if (zb_starts_with(zbrowser_url, "https://")) {
                copy_text(zbrowser_status, 96, "loaded https");
            } else {
                copy_text(zbrowser_status, 96, "loaded http");
            }
            zbrowser_loaded = 1;
            return;
        }
        if (zb_starts_with(zbrowser_url, "https://")) {
            copy_text(zbrowser_status, 96, "https failed");
        } else {
            copy_text(zbrowser_status, 96, "http failed");
        }
        zbrowser_loaded = 1;
        return;
    }

    size = os_read_file(zbrowser_url, buffer, ZBROWSER_HTTP_CAPACITY - 1);
    if (size >= 0) {
        buffer[size] = 0;
        zbrowser_size = size;
        zbrowser_has_document = 1;
        copy_text(zbrowser_status, 96, "loaded local file");
    } else {
        if (tried_browser_url != 0) {
            copy_text(zbrowser_status, 96, "browser.url target not found");
        } else {
            copy_text(zbrowser_status, 96, "showing help");
        }
    }
    zbrowser_loaded = 1;
}

void zbrowser_reload(void) {
    zbrowser_loaded = 0;
    zbrowser_needs_redraw = 1;
}

void zbrowser_scroll_by(int delta) {
    if (delta < 0) {
        uint32_t amount;
        amount = (uint32_t)(0 - delta);
        if (amount > zbrowser_scroll) {
            zbrowser_scroll = 0;
        } else {
            zbrowser_scroll = zbrowser_scroll - amount;
        }
    } else {
        zbrowser_scroll = zbrowser_scroll + (uint32_t)delta;
    }
    zbrowser_needs_redraw = 1;
}

export void zmodule_redraw(void) {
    if (zbrowser_enabled == 0) {
        return;
    }
    if (zbrowser_loaded == 0) {
        load_document();
    }
    if (zbrowser_has_document != 0) {
        if (render_image_if_supported(document_buffer(), (uint32_t)zbrowser_size) == 0) {
            render_html(document_buffer());
        }
    } else {
        render_help();
    }
}

export void zmodule_tick(void) {
    if (zbrowser_needs_redraw != 0) {
        zbrowser_needs_redraw = 0;
        zmodule_redraw();
    }
}

void navigate_to(const uint8_t *url) {
    copy_text(zbrowser_url, ZBROWSER_URL_CAPACITY, url);
    trim_text_end(zbrowser_url);
    zbrowser_editing = 0;
    zbrowser_reload();
}

void activate_link_at_line(uint32_t line) {
    uint32_t i;

    i = 0;
    while (i < zbrowser_link_count) {
        if (zbrowser_link_lines[i] == line) {
            navigate_to((uint8_t *)zbrowser_links_addr + i * ZBROWSER_LINK_CAPACITY);
            return;
        }
        i = i + 1;
    }
}

export void zmodule_key(uint32_t key_type, uint32_t ch) {
    if (zbrowser_enabled == 0) {
        return;
    }

    if (zbrowser_editing != 0) {
        if (key_type == KEY_ENTER) {
            navigate_to(zbrowser_url);
            return;
        }
        if (key_type == KEY_ESC) {
            zbrowser_editing = 0;
            zbrowser_needs_redraw = 1;
            return;
        }
        if (key_type == KEY_BACKSPACE) {
            backspace_url();
            zbrowser_needs_redraw = 1;
            return;
        }
        if (key_type == KEY_CHAR) {
            append_url_char((uint8_t)ch);
            zbrowser_needs_redraw = 1;
            return;
        }
    }

    if (key_type == KEY_CHAR && (ch == 108 || ch == 76)) {
        zbrowser_editing = 1;
        zbrowser_needs_redraw = 1;
        return;
    }
    if (key_type == KEY_CHAR && (ch == 114 || ch == 82)) {
        zbrowser_reload();
        return;
    }
    if (key_type == KEY_CHAR && ch >= 48 && ch <= 57) {
        uint32_t index;
        index = (uint32_t)(ch - 48);
        if (index < zbrowser_link_count) {
            navigate_to((uint8_t *)zbrowser_links_addr + index * ZBROWSER_LINK_CAPACITY);
        }
        return;
    }
    if (key_type == KEY_UP) {
        zbrowser_scroll_by(-3);
        return;
    }
    if (key_type == KEY_DOWN) {
        zbrowser_scroll_by(3);
        return;
    }
}

export void zmodule_mouse(uint32_t x, uint32_t y, uint32_t buttons, int32_t wheel) {
    uint32_t line;

    if (zbrowser_enabled == 0) {
        return;
    }

    if (wheel != 0) {
        zbrowser_scroll_by(0 - wheel * 3);
        return;
    }

    if (buttons != 0) {
        if (y < 42) {
            zbrowser_editing = 1;
            zbrowser_needs_redraw = 1;
            return;
        }
        if (y >= zbrowser_y) {
            line = zbrowser_scroll + ((y - zbrowser_y) / 12);
            activate_link_at_line(line);
        }
    }
}

export void zmodule_unload(void) {
    zbrowser_enabled = 0;
    if (zbrowser_doc_buffer_addr != 0) {
        kfree((uint8_t *)zbrowser_doc_buffer_addr);
        zbrowser_doc_buffer_addr = 0;
    }
    if (zbrowser_image_buffer_addr != 0) {
        kfree((uint8_t *)zbrowser_image_buffer_addr);
        zbrowser_image_buffer_addr = 0;
    }
    if (zbrowser_links_addr != 0) {
        kfree((uint8_t *)zbrowser_links_addr);
        zbrowser_links_addr = 0;
    }
}

zbrowser_enabled = 1;
zbrowser_doc_buffer_addr = (uint64_t)kmalloc(ZBROWSER_HTTP_CAPACITY + 1);
zbrowser_image_buffer_addr = (uint64_t)kmalloc(ZBROWSER_IMAGE_CAPACITY);
zbrowser_links_addr = (uint64_t)kmalloc(ZBROWSER_MAX_LINKS * ZBROWSER_LINK_CAPACITY);
zbrowser_loaded = 0;
zbrowser_size = 0;
zbrowser_has_document = 0;
zbrowser_scroll = 0;
zbrowser_editing = 0;
zbrowser_needs_redraw = 0;
zbrowser_link_count = 0;
zbrowser_images_loaded = 0;
copy_text(zbrowser_url, ZBROWSER_URL_CAPACITY, "");
copy_text(zbrowser_status, 96, "ready");
if (zbrowser_doc_buffer_addr == 0 || zbrowser_image_buffer_addr == 0 || zbrowser_links_addr == 0) {
    copy_text(zbrowser_status, 96, "buffer alloc failed");
}
print("zbrowser module loaded\n");
return 0;
