void render_google_homepage(void) {
    uint32_t w;
    uint32_t h;
    uint32_t input_index;
    uint8_t *value;

    w = gfx_width();
    h = gfx_height();
    draw_shell();
    gfx_fill_rect(0, 42, w, h - 62, 0xffffff);
    if (w > 280) {
        draw_text_at_pixel(w - 156, 58, "Gmail", 0x3c4043, 0xffffff);
        draw_text_at_pixel(w - 100, 58, "Images", 0x3c4043, 0xffffff);
    }
    if (h > 300) {
        draw_google_logo(w / 2, 128);
    } else {
        draw_google_logo(w / 2, 82);
    }
    zbrowser_y = 52;
    zbrowser_line_no = 0;
    zbrowser_link_count = 0;
    zbrowser_input_count = 0;
    make_google_search_action(zbrowser_form_action, 160);
    input_index = register_input("q", "");
    if (input_index != 9999) {
        value = input_value_slot(input_index);
        google_query_from_url(zbrowser_url_tmp, 160);
        if (zbrowser_url_tmp[0] != 0 && zbrowser_focused_input != input_index) {
            copy_text(value, ZBROWSER_INPUT_VALUE_CAPACITY, zbrowser_url_tmp);
        }
        if (h < 360) {
            zbrowser_input_lines[input_index] = 7;
        } else {
            zbrowser_input_lines[input_index] = 11;
        }
        draw_google_search_box(input_index, value);
    }
    copy_text(zbrowser_status, 96, "google start page");
    draw_text_at_pixel(8, h - 18, zbrowser_status, 0x54595d, 0xeaecf0);
}

void copy_plain_until_close_tag(const uint8_t *html,
                                uint32_t start,
                                const uint8_t *tag,
                                uint8_t *dst,
                                uint32_t capacity) {
    uint32_t pos;
    uint32_t advance;
    uint8_t ch;

    pos = start;
    dst[0] = 0;
    while (html[pos] != 0) {
        if (html[pos] == 60) {
            if (zb_is_closing_tag(html, pos) != 0 && zb_tag_name_is(html, pos, tag) != 0) {
                return;
            }
            pos = zb_skip_tag(html, pos);
        } else if (html[pos] == 38) {
            ch = zb_entity_char(html, pos, &advance);
            append_char_limited(dst, capacity, ch);
            pos = pos + advance;
        } else {
            append_char_limited(dst, capacity, html[pos]);
            pos = pos + 1;
        }
    }
}

int copy_first_option_label(const uint8_t *html, uint32_t start, uint8_t *dst, uint32_t capacity) {
    uint32_t pos;

    pos = start;
    dst[0] = 0;
    while (html[pos] != 0) {
        if (html[pos] == 60) {
            if (zb_is_closing_tag(html, pos) != 0 && zb_tag_name_is(html, pos, "select") != 0) {
                return 0;
            }
            if (zb_is_closing_tag(html, pos) == 0 && zb_tag_name_is(html, pos, "option") != 0) {
                copy_plain_until_close_tag(html, zb_skip_tag(html, pos), "option", dst, capacity);
                return 1;
            }
            pos = zb_skip_tag(html, pos);
        } else {
            pos = pos + 1;
        }
    }
    return 0;
}

void draw_image_placeholder(const uint8_t *src, const uint8_t *label) {
    uint32_t h;
    uint32_t w;
    uint32_t draw_y;
    uint32_t box_w;
    uint32_t before_links;

    flush_line();
    h = gfx_height();
    w = gfx_width();
    if (zbrowser_line_no < zbrowser_scroll) {
        zbrowser_line_no = zbrowser_line_no + 5;
        return;
    }
    draw_y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
    if (draw_y + 58 >= h - 18) {
        zbrowser_line_no = zbrowser_line_no + 5;
        return;
    }

    box_w = 144;
    if (article_w() > 24) {
        box_w = article_w() - 16;
    }
    if (box_w > 420) {
        box_w = 420;
    }

    before_links = zbrowser_link_count;
    register_link(src);
    gfx_fill_rect(article_x() + 8, draw_y, box_w, 52, 0xf8f9fa);
    gfx_draw_rect(article_x() + 8, draw_y, box_w, 52, 0xa2a9b1);
    draw_text_at_pixel(article_x() + 16, draw_y + 8, label, 0x202122, 0xf8f9fa);
    if (zbrowser_link_count != before_links) {
        draw_text_at_pixel(article_x() + 16, draw_y + 24, "click image slot to open source", 0x3366cc, 0xf8f9fa);
    } else {
        draw_text_at_pixel(article_x() + 16, draw_y + 24, "image source unavailable", 0x54595d, 0xf8f9fa);
    }
    zbrowser_line_no = zbrowser_line_no + 5;
}

