struct ImageInfo {
    uint32_t width;
    uint32_t height;
    uint32_t components;
    uint32_t stride;
};

struct NetHttpInfo {
    uint32_t status_code;
    uint32_t content_length;
    uint32_t body_size;
    uint32_t header_size;
    uint32_t flags;
    int32_t error;
    uint32_t tls_error;
    uint8_t content_type[64];
    uint8_t location[160];
};

struct WebStyle {
    uint32_t flags;
    uint32_t text_align;
    uint32_t position;
    uint32_t left;
    uint32_t right;
    uint32_t top;
    uint32_t bottom;
    uint32_t width;
    uint32_t height;
    uint32_t color;
};

struct WebStyleRules {
    uint64_t selectors;
    uint64_t selector_stride;
    uint64_t decls;
    uint64_t decl_stride;
    uint64_t rule_count;
};

