    zbrowser_web_style_width = 0;
    zbrowser_web_style_height = 0;
    zbrowser_web_style_min_width = 0;
    zbrowser_web_style_max_width = 0;
    zbrowser_web_style_min_height = 0;
    zbrowser_web_style_max_height = 0;
    zbrowser_web_style_color = 0;
    zbrowser_web_style_bg_color = 0;
    zbrowser_web_margin_l = 0;
    zbrowser_web_margin_r = 0;
    zbrowser_web_margin_t = 0;
    zbrowser_web_margin_b = 0;
    zbrowser_web_padding_l = 0;
    zbrowser_web_padding_r = 0;
    zbrowser_web_padding_t = 0;
    zbrowser_web_padding_b = 0;
    zbrowser_web_border_l = 0;
    zbrowser_web_border_r = 0;
    zbrowser_web_border_t = 0;
    zbrowser_web_border_b = 0;
    zbrowser_web_border_color = 0;
    zbrowser_web_font_size = 16;
    zbrowser_web_line_height = 19;
    zbrowser_web_text_transform = WEB_STYLE_TEXT_TRANSFORM_NONE;
    zbrowser_web_white_space = WEB_STYLE_WHITE_SPACE_NORMAL;
    zbrowser_web_list_style_type = WEB_STYLE_LIST_DISC;
    zbrowser_web_overflow_x = WEB_STYLE_OVERFLOW_VISIBLE;
    zbrowser_web_overflow_y = WEB_STYLE_OVERFLOW_VISIBLE;
    zbrowser_web_box_sizing = WEB_STYLE_BOX_CONTENT_BOX;
    zbrowser_web_border_collapse = WEB_STYLE_BORDER_SEPARATE;
    zbrowser_web_border_spacing_h = 2;
    zbrowser_web_border_spacing_v = 2;
    zbrowser_web_text_indent = 0;
    zbrowser_web_clear_side = WEB_STYLE_CLEAR_NONE;
    zbrowser_web_vertical_align = WEB_STYLE_VERTICAL_BASELINE;
    zbrowser_web_list_style_position = WEB_STYLE_LIST_POSITION_OUTSIDE;
    zbrowser_web_caption_side = WEB_STYLE_CAPTION_TOP;
    zbrowser_web_direction = WEB_STYLE_DIRECTION_LTR;
    zbrowser_web_table_layout = WEB_STYLE_TABLE_LAYOUT_AUTO;
    zbrowser_web_empty_cells = WEB_STYLE_EMPTY_CELLS_SHOW;
    zbrowser_web_opacity = 255;
    zbrowser_web_z_index = 0;
    zbrowser_web_letter_spacing = 0;
    zbrowser_web_word_spacing = 0;
    zbrowser_web_background_repeat = WEB_STYLE_BG_REPEAT;
    zbrowser_web_background_position_x = 0;
    zbrowser_web_background_position_y = 0;
}

void reset_line_cache(void) {
    uint32_t i;

    i = 0;
    while (i < ZBROWSER_LINE_CACHE_LINES) {
        zbrowser_line_cache_valid[i] = 0;
        zbrowser_line_cache_len[i] = 0;
        zbrowser_line_cache_box_flags[i] = 0;
        i = i + 1;
    }
}

void invalidate_prepared_web_styles(void) {
    zbrowser_style_doc_addr = 0;
    zbrowser_style_doc_size = 0;
    zbrowser_style_doc_w = 0;
    zbrowser_style_doc_h = 0;
    zbrowser_render_checkpoint_count = 0;
    reset_line_cache();
    clear_web_style_cache();
}

void prepare_web_styles_for_render(const uint8_t *html) {
    uint64_t doc_addr;
    uint32_t w;
    uint32_t h;

    doc_addr = (uint64_t)html;
    w = gfx_width();
    h = gfx_height();
    if (zbrowser_style_doc_addr == doc_addr &&
        zbrowser_style_doc_size == zbrowser_size &&
        zbrowser_style_doc_w == w &&
        zbrowser_style_doc_h == h) {
        clear_web_style_cache();
        return;
    }
    clear_web_style_cache();
    reset_line_cache();
    web_style_prepare_document(html, w, h);
    zbrowser_style_doc_addr = doc_addr;
    zbrowser_style_doc_size = zbrowser_size;
    zbrowser_style_doc_w = w;
    zbrowser_style_doc_h = h;
}

void prepare_web_styles_for_loaded_document(const uint8_t *html) {
    uint64_t doc_addr;
    uint32_t w;
    uint32_t h;

    doc_addr = (uint64_t)html;
    w = zbrowser_style_prepare_w;
    h = zbrowser_style_prepare_h;
    if (w == 0 || h == 0) {
        return;
    }

    clear_web_style_cache();
    copy_text(zbrowser_status, 96, "preparing styles");
    web_style_prepare_document(html, w, h);
    zbrowser_style_doc_addr = doc_addr;
    zbrowser_style_doc_size = zbrowser_size;
    zbrowser_style_doc_w = w;
    zbrowser_style_doc_h = h;
}

void remember_web_style(uint32_t pos, struct WebStyle *style) {
    zbrowser_web_style_cache_pos = pos;
    zbrowser_web_style_flags = style->flags;
    zbrowser_web_style_text_align = style->text_align;
    zbrowser_web_style_position = style->position;
    zbrowser_web_style_display = style->display;
    zbrowser_web_style_float = style->float_side;
    zbrowser_web_style_font_weight = style->font_weight;
    zbrowser_web_style_font_style = style->font_style;
    zbrowser_web_style_left = style->left;
    zbrowser_web_style_right = style->right;
    zbrowser_web_style_top = style->top;
    zbrowser_web_style_bottom = style->bottom;
    zbrowser_web_style_width = style->width;
    zbrowser_web_style_height = style->height;
    zbrowser_web_style_min_width = style->min_width;
    zbrowser_web_style_max_width = style->max_width;
    zbrowser_web_style_min_height = style->min_height;
    zbrowser_web_style_max_height = style->max_height;
    zbrowser_web_style_color = style->color;
    zbrowser_web_style_bg_color = style->background_color;
    zbrowser_web_margin_l = style->margin_left;
    zbrowser_web_margin_r = style->margin_right;
    zbrowser_web_margin_t = style->margin_top;
    zbrowser_web_margin_b = style->margin_bottom;
    zbrowser_web_padding_l = style->padding_left;
    zbrowser_web_padding_r = style->padding_right;
    zbrowser_web_padding_t = style->padding_top;
    zbrowser_web_padding_b = style->padding_bottom;
    zbrowser_web_border_l = style->border_left;
    zbrowser_web_border_r = style->border_right;
    zbrowser_web_border_t = style->border_top;
    zbrowser_web_border_b = style->border_bottom;
    zbrowser_web_border_color = style->border_color;
    zbrowser_web_font_size = style->font_size;
    zbrowser_web_line_height = style->line_height;
    zbrowser_web_text_transform = style->text_transform;
    zbrowser_web_white_space = style->white_space;
    zbrowser_web_list_style_type = style->list_style_type;
    zbrowser_web_overflow_x = style->overflow_x;
    zbrowser_web_overflow_y = style->overflow_y;
    zbrowser_web_box_sizing = style->box_sizing;
    zbrowser_web_border_collapse = style->border_collapse;
    zbrowser_web_border_spacing_h = style->border_spacing_h;
    zbrowser_web_border_spacing_v = style->border_spacing_v;
    zbrowser_web_text_indent = style->text_indent;
    zbrowser_web_clear_side = style->clear_side;
    zbrowser_web_vertical_align = style->vertical_align;
    zbrowser_web_list_style_position = style->list_style_position;
    zbrowser_web_caption_side = style->caption_side;
    zbrowser_web_direction = style->direction;
    zbrowser_web_table_layout = style->table_layout;
    zbrowser_web_empty_cells = style->empty_cells;
    zbrowser_web_opacity = style->opacity;
    zbrowser_web_z_index = style->z_index;
    zbrowser_web_letter_spacing = style->letter_spacing;
    zbrowser_web_word_spacing = style->word_spacing;
    zbrowser_web_background_repeat = style->background_repeat;
    zbrowser_web_background_position_x = style->background_position_x;
    zbrowser_web_background_position_y = style->background_position_y;
    zbrowser_web_style_cache_valid = 1;
}

int load_web_style(const uint8_t *html, uint32_t pos) {
    int result;
    struct WebStyle style;

    if (zbrowser_web_style_cache_valid != 0 && zbrowser_web_style_cache_pos == pos) {
        return 1;
    }
    zbrowser_web_style_cache_valid = 0;
    result = web_style_for_tag(html, pos, gfx_width(), gfx_height(), &style);
    if (result != 0) {
        return 0;
    }
    remember_web_style(pos, &style);
    return 1;
}

int web_style_has_flag(uint32_t flag) {
    uint32_t bits;

    bits = zbrowser_web_style_flags & flag;
    if (bits != 0) {
        return 1;
    }
    return 0;
}

uint32_t cached_image_count(void) {
    uint32_t count;
    uint32_t slot;

    count = 0;
    slot = 0;
    while (slot < ZBROWSER_IMAGE_SLOT_COUNT) {
        if (zbrowser_cached_image_valids[slot] == 1) {
            count = count + 1;
        }
        slot = slot + 1;
    }
    return count;
}

void clear_image_cache(void) {
    uint32_t slot;
    uint8_t *slot_url;

    clear_decoded_image_cache();
    zbrowser_image_record_count = 0;
    zbrowser_image_fetch_result = 0;
    zbrowser_image_probe_result = 0;
    zbrowser_image_draw_result = 0;
    slot = 0;
    while (slot < ZBROWSER_IMAGE_SLOT_COUNT) {
        zbrowser_cached_image_valids[slot] = 0;
        zbrowser_cached_image_sizes[slot] = 0;
        slot_url = image_url_slot(slot);
        slot_url[0] = 0;
        slot = slot + 1;
    }
}

uint32_t find_empty_image_slot(void) {
    uint32_t slot;

    slot = 0;
    while (slot < ZBROWSER_IMAGE_SLOT_COUNT) {
        if (zbrowser_cached_image_valids[slot] == 0) {
            return slot;
        }
        slot = slot + 1;
    }
    return 9999;
}

uint32_t find_cached_image_slot(const uint8_t *url) {
    uint32_t slot;
    uint8_t *cached_url;

    slot = 0;
    while (slot < ZBROWSER_IMAGE_SLOT_COUNT) {
        cached_url = image_url_slot(slot);
        if (zbrowser_cached_image_valids[slot] == 1 &&
            cached_url[0] != 0 &&
            text_equal(url, cached_url) != 0) {
            return slot;
        }
        slot = slot + 1;
    }
    return 9999;
}

int image_url_already_cached(const uint8_t *url, uint32_t max_slot) {
    uint32_t slot;
    uint8_t *cached_url;

    slot = 0;
    while (slot < max_slot && slot < ZBROWSER_IMAGE_SLOT_COUNT) {
        cached_url = image_url_slot(slot);
        if (cached_url[0] != 0) {
            if (text_equal(url, cached_url) != 0) {
                return 1;
            }
        }
        slot = slot + 1;
    }
    return 0;
}

void remember_deferred_image_fetch(const uint8_t *url) {
    if (url[0] == 0) {
        return;
    }
    if (image_url_already_cached(url, ZBROWSER_IMAGE_SLOT_COUNT) != 0) {
        return;
    }
    if (zbrowser_deferred_image_url[0] == 0) {
        copy_text(zbrowser_deferred_image_url, ZBROWSER_URL_CAPACITY, url);
    }
}

int schedule_deferred_image_fetch(void) {
    uint32_t slot;

    if (zbrowser_deferred_image_url[0] == 0) {
        return 0;
    }
    if (image_url_already_cached(zbrowser_deferred_image_url, ZBROWSER_IMAGE_SLOT_COUNT) != 0) {
        zbrowser_deferred_image_url[0] = 0;
        return 0;
    }
    slot = find_empty_image_slot();
    if (slot == 9999) {
        return 0;
    }
    if (schedule_image_fetch(slot, zbrowser_deferred_image_url) != 0) {
        zbrowser_deferred_image_url[0] = 0;
        return 1;
    }
    return 0;
}

int text_contains_ci(const uint8_t *text, const uint8_t *needle) {
    uint32_t i;
    uint32_t j;

    i = 0;
    if (needle[0] == 0) {
        return 1;
    }
    while (text[i] != 0) {
        j = 0;
        while (needle[j] != 0 && zb_lower_char(text[i + j]) == zb_lower_char(needle[j])) {
            j = j + 1;
        }
        if (needle[j] == 0) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

int heavy_page_for_images(void) {
    if (zbrowser_size > 420000) {
        return 1;
    }
    return 0;
}

int text_equal(const uint8_t *a, const uint8_t *b) {
    uint32_t i;

    i = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) {
            return 0;
        }
        i = i + 1;
    }
    if (a[i] == 0 && b[i] == 0) {
        return 1;
    }
    return 0;
}

int text_equal_ci(const uint8_t *a, const uint8_t *b) {
    uint32_t i;

    i = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (zb_lower_char(a[i]) != zb_lower_char(b[i])) {
            return 0;
        }
        i = i + 1;
    }
    if (a[i] == 0 && b[i] == 0) {
        return 1;
    }
    return 0;
}

int text_ends_with_ci(const uint8_t *text, const uint8_t *suffix) {
    uint32_t text_len;
    uint32_t suffix_len;
    uint32_t i;

    text_len = os_strlen(text);
    suffix_len = os_strlen(suffix);
    if (suffix_len > text_len) {
        return 0;
    }
    i = 0;
    while (i < suffix_len) {
        if (zb_lower_char(text[text_len - suffix_len + i]) != zb_lower_char(suffix[i])) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

int source_looks_like_image(const uint8_t *src) {
    uint32_t i;
    uint8_t clean[256];

    i = 0;
    while (src[i] != 0 && src[i] != 63 && src[i] != 35 && i + 1 < ZBROWSER_URL_CAPACITY) {
        clean[i] = src[i];
        i = i + 1;
    }
    clean[i] = 0;
    if (text_ends_with_ci(clean, ".jpg") != 0 ||
        text_ends_with_ci(clean, ".jpeg") != 0 ||
        text_ends_with_ci(clean, ".png") != 0 ||
        text_ends_with_ci(clean, ".gif") != 0 ||
        text_ends_with_ci(clean, ".bmp") != 0 ||
        text_ends_with_ci(clean, ".svg") != 0 ||
        text_ends_with_ci(clean, ".tga") != 0 ||
        text_ends_with_ci(clean, ".ppm") != 0 ||
        text_ends_with_ci(clean, ".pgm") != 0 ||
        text_ends_with_ci(clean, ".pnm") != 0 ||
        text_ends_with_ci(clean, ".webp") != 0) {
        return 1;
    }
    if (text_contains_ci(src, "/thumb/") != 0 &&
        (text_contains_ci(src, ".jpg") != 0 ||
         text_contains_ci(src, ".jpeg") != 0 ||
         text_contains_ci(src, ".png") != 0 ||
         text_contains_ci(src, ".gif") != 0 ||
         text_contains_ci(src, ".svg") != 0 ||
         text_contains_ci(src, ".webp") != 0)) {
        return 1;
    }
    return 0;
}

int source_unsupported_image(const uint8_t *src) {
    uint32_t i;
    uint8_t clean[256];

    i = 0;
    while (src[i] != 0 && src[i] != 63 && src[i] != 35 && i + 1 < ZBROWSER_URL_CAPACITY) {
        clean[i] = src[i];
        i = i + 1;
    }
    clean[i] = 0;
    if (text_ends_with_ci(clean, ".svg") != 0 ||
        text_ends_with_ci(clean, ".webp") != 0) {
        return 1;
    }
    return 0;
}

int hex_value(uint8_t ch) {
    if (ch >= 48 && ch <= 57) {
        return ch - 48;
    }
    if (ch >= 65 && ch <= 70) {
        return ch - 55;
    }
    if (ch >= 97 && ch <= 102) {
        return ch - 87;
    }
    return -1;
}

int parse_css_hex_color_at(const uint8_t *text, uint32_t pos, uint32_t *out_color) {
    int a;
    int b;
    int c;
    int d;
    int e;
    int f;

    if (text[pos] != 35) {
        return 0;
    }
    a = hex_value(text[pos + 1]);
    b = hex_value(text[pos + 2]);
    c = hex_value(text[pos + 3]);
    if (a < 0 || b < 0 || c < 0) {
        return 0;
    }
    d = hex_value(text[pos + 4]);
    e = hex_value(text[pos + 5]);
    f = hex_value(text[pos + 6]);
    if (d >= 0 && e >= 0 && f >= 0) {
        *out_color = (uint32_t)((a * 16 + b) * 65536 + (c * 16 + d) * 256 + (e * 16 + f));
        return 1;
    }
    *out_color = (uint32_t)((a * 17) * 65536 + (b * 17) * 256 + (c * 17));
    return 1;
}

int css_named_color(const uint8_t *style, const uint8_t *name, uint32_t color, uint32_t *out_color) {
    if (text_contains_ci(style, name) != 0) {
        *out_color = color;
        return 1;
    }
    return 0;
}

int css_property_can_start_at(const uint8_t *style, uint32_t pos) {
    if (pos == 0) {
        return 1;
    }
    if (style[pos - 1] == 59 ||
        style[pos - 1] == 123 ||
        style[pos - 1] == 32 ||
        style[pos - 1] == 9 ||
        style[pos - 1] == 10 ||
        style[pos - 1] == 13) {
        return 1;
    }
    return 0;
}

int css_color_after_property(const uint8_t *style, const uint8_t *property, uint32_t *out_color) {
    uint32_t i;
    uint32_t j;

    i = 0;
    while (style[i] != 0) {
        j = 0;
        while (property[j] != 0 && zb_lower_char(style[i + j]) == zb_lower_char(property[j])) {
            j = j + 1;
        }
        if (property[j] == 0 && css_property_can_start_at(style, i) != 0) {
            i = i + j;
            while (style[i] == 32 || style[i] == 9 || style[i] == 58) {
                i = i + 1;
            }
            if (parse_css_hex_color_at(style, i, out_color) != 0) {
                return 1;
            }
            if (css_named_color(style + i, "white", 0xffffff, out_color) != 0 ||
                css_named_color(style + i, "black", 0x000000, out_color) != 0 ||
                css_named_color(style + i, "red", 0xff4040, out_color) != 0 ||
                css_named_color(style + i, "green", 0x40cc60, out_color) != 0 ||
                css_named_color(style + i, "blue", 0x4488ff, out_color) != 0 ||
                css_named_color(style + i, "gray", 0x888888, out_color) != 0 ||
                css_named_color(style + i, "grey", 0x888888, out_color) != 0) {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

int css_color_value(const uint8_t *value, uint32_t *out_color) {
    uint32_t i;

    i = 0;
    while (value[i] == 32 || value[i] == 9 || value[i] == 10 || value[i] == 13) {
        i = i + 1;
    }
    if (parse_css_hex_color_at(value, i, out_color) != 0) {
        return 1;
    }
    if (css_named_color(value + i, "white", 0xffffff, out_color) != 0 ||
        css_named_color(value + i, "black", 0x000000, out_color) != 0 ||
        css_named_color(value + i, "red", 0xff4040, out_color) != 0 ||
        css_named_color(value + i, "green", 0x40cc60, out_color) != 0 ||
        css_named_color(value + i, "blue", 0x4488ff, out_color) != 0 ||
        css_named_color(value + i, "gray", 0x888888, out_color) != 0 ||
        css_named_color(value + i, "grey", 0x888888, out_color) != 0) {
        return 1;
    }
    return 0;
}

int css_property_contains(const uint8_t *style, const uint8_t *property, const uint8_t *value) {
    uint32_t i;
    uint32_t j;

    i = 0;
    while (style[i] != 0) {
        j = 0;
        while (property[j] != 0 && zb_lower_char(style[i + j]) == zb_lower_char(property[j])) {
            j = j + 1;
        }
        if (property[j] == 0 && css_property_can_start_at(style, i) != 0) {
            while (style[i] != 0 && style[i] != 59) {
                if (starts_with_at(style, i, value) != 0) {
                    return 1;
                }
                i = i + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

int css_text_property_value(const uint8_t *style,
                            const uint8_t *property,
                            uint8_t *out,
                            uint32_t capacity) {
    uint32_t i;
    uint32_t j;
    uint32_t value_start;
    uint32_t value_end;

    if (capacity == 0) {
        return 0;
    }
    out[0] = 0;
    i = 0;
    while (style[i] != 0) {
        j = 0;
        while (property[j] != 0 && zb_lower_char(style[i + j]) == zb_lower_char(property[j])) {
            j = j + 1;
        }
        if (property[j] == 0 && css_property_can_start_at(style, i) != 0) {
            i = i + j;
            while (style[i] == 32 || style[i] == 9 || style[i] == 10 || style[i] == 13) {
                i = i + 1;
            }
            if (style[i] == 58) {
                i = i + 1;
                while (style[i] == 32 || style[i] == 9 || style[i] == 10 || style[i] == 13) {
                    i = i + 1;
                }
                value_start = i;
                while (style[i] != 0 && style[i] != 59) {
                    i = i + 1;
                }
                value_end = i;
                copy_range_trimmed(out, capacity, style, value_start, value_end);
                if (out[0] != 0) {
                    return 1;
                }
                return 0;
            }
        }
        while (style[i] != 0 && style[i] != 59) {
            i = i + 1;
        }
        if (style[i] == 59) {
            i = i + 1;
        }
    }
    return 0;
}

void copy_range_trimmed(uint8_t *out, uint32_t capacity, const uint8_t *text, uint32_t start, uint32_t end) {
    uint32_t out_pos;

    if (capacity == 0) {
        return;
    }
    while (start < end &&
           (text[start] == 32 || text[start] == 9 || text[start] == 10 || text[start] == 13)) {
        start = start + 1;
    }
    while (end > start &&
           (text[end - 1] == 32 || text[end - 1] == 9 || text[end - 1] == 10 || text[end - 1] == 13)) {
        end = end - 1;
    }
    out_pos = 0;
    while (start < end && out_pos + 1 < capacity) {
        out[out_pos] = text[start];
        out_pos = out_pos + 1;
        start = start + 1;
    }
    out[out_pos] = 0;
}

int selector_name_char(uint8_t ch) {
    if ((ch >= 48 && ch <= 57) ||
        (ch >= 65 && ch <= 90) ||
        (ch >= 97 && ch <= 122) ||
        ch == 45 ||
        ch == 95) {
        return 1;
    }
    return 0;
}

int css_space_char(uint8_t ch) {
    if (ch == 32 || ch == 9 || ch == 10 || ch == 13 || ch == 12) {
        return 1;
    }
    return 0;
}

int attr_class_has_token_ci(const uint8_t *classes, const uint8_t *name) {
    uint32_t pos;
    uint32_t token_start;
    uint32_t j;

    if (name[0] == 0) {
        return 0;
    }
    pos = 0;
    while (classes[pos] != 0) {
        while (css_space_char(classes[pos]) != 0) {
            pos = pos + 1;
        }
        token_start = pos;
        while (classes[pos] != 0 && css_space_char(classes[pos]) == 0) {
            pos = pos + 1;
        }
        if (token_start < pos) {
            j = 0;
            while (token_start + j < pos &&
                   name[j] != 0 &&
                   zb_lower_char(classes[token_start + j]) == zb_lower_char(name[j])) {
                j = j + 1;
            }
            if (token_start + j == pos && name[j] == 0) {
                return 1;
            }
        }
    }
    return 0;
}

int selector_tag_id_equals_ci(const uint8_t *html, uint32_t pos, const uint8_t *name) {
    if (zb_attr_value(html, pos, "id", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        text_equal_ci(zbrowser_attr, name) != 0) {
        return 1;
    }
    return 0;
}

int selector_tag_class_has_token_ci(const uint8_t *html, uint32_t pos, const uint8_t *name) {
    if (zb_attr_value(html, pos, "class", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        attr_class_has_token_ci(zbrowser_attr, name) != 0) {
        return 1;
    }
    return 0;
}

int selector_part_matches(const uint8_t *html, uint32_t tag_pos, const uint8_t *selector) {
    uint32_t i;
    uint32_t j;
    uint32_t part_start;
    uint32_t saw_matchable;
    uint32_t depth;
    uint8_t marker;

    i = 0;
    part_start = 0;
    while (selector[i] != 0) {
        if (selector[i] == 32 || selector[i] == 9 || selector[i] == 10 || selector[i] == 13 ||
            selector[i] == 62 || selector[i] == 43 || selector[i] == 126) {
            part_start = i + 1;
        }
        i = i + 1;
    }
    i = part_start;
    while (css_space_char(selector[i]) != 0) {
        i = i + 1;
    }
    saw_matchable = 0;
    if (selector[i] == 42) {
        saw_matchable = 1;
        i = i + 1;
    } else if (selector_name_char(selector[i]) != 0) {
        j = 0;
        while ((selector_name_char(selector[i]) != 0 || selector[i] == 124) && j + 1 < 64) {
            if (selector[i] == 124) {
                j = 0;
            } else {
                zbrowser_css_selector[j] = selector[i];
                j = j + 1;
            }
            i = i + 1;
        }
        zbrowser_css_selector[j] = 0;
        if (zbrowser_css_selector[0] == 0 || text_equal(zbrowser_css_selector, "*") != 0) {
            saw_matchable = 1;
        } else if (zb_tag_name_is(html, tag_pos, zbrowser_css_selector) != 0) {
            saw_matchable = 1;
        } else {
            return 0;
        }
    }
    while (selector[i] != 0) {
        if (css_space_char(selector[i]) != 0) {
            i = i + 1;
        } else if (selector[i] == 46 || selector[i] == 35) {
            marker = selector[i];
            i = i + 1;
            j = 0;
            while (selector_name_char(selector[i]) != 0 && j + 1 < 64) {
                zbrowser_css_selector[j] = selector[i];
                j = j + 1;
                i = i + 1;
            }
            zbrowser_css_selector[j] = 0;
            if (zbrowser_css_selector[0] == 0) {
                return 0;
            }
            if (marker == 46 && selector_tag_class_has_token_ci(html, tag_pos, zbrowser_css_selector) == 0) {
                return 0;
            }
            if (marker == 35 && selector_tag_id_equals_ci(html, tag_pos, zbrowser_css_selector) == 0) {
                return 0;
            }
            saw_matchable = 1;
        } else if (selector[i] == 91) {
            while (selector[i] != 0 && selector[i] != 93) {
                i = i + 1;
            }
            if (selector[i] == 93) {
                i = i + 1;
            }
        } else if (selector[i] == 58) {
            if (selector[i + 1] == 58) {
                return 0;
            }
            i = i + 1;
            while (selector_name_char(selector[i]) != 0) {
                i = i + 1;
            }
            if (selector[i] == 40) {
                depth = 1;
                i = i + 1;
                while (selector[i] != 0 && depth > 0) {
                    if (selector[i] == 40) {
                        depth = depth + 1;
                    } else if (selector[i] == 41) {
                        depth = depth - 1;
                    }
                    i = i + 1;
                }
            }
        } else {
            i = i + 1;
        }
    }
    if (saw_matchable != 0) {
        return 1;
    }
    return 0;
}

int selector_list_matches(const uint8_t *html, uint32_t tag_pos, const uint8_t *selector_list) {
    uint32_t start;
    uint32_t pos;

    start = 0;
    pos = 0;
    while (selector_list[pos] != 0) {
        if (selector_list[pos] == 44) {
            copy_range_trimmed(zbrowser_css_selector, 64, selector_list, start, pos);
            if (selector_part_matches(html, tag_pos, zbrowser_css_selector) != 0) {
                return 1;
            }
            start = pos + 1;
        }
        pos = pos + 1;
    }
    copy_range_trimmed(zbrowser_css_selector, 64, selector_list, start, pos);
    if (selector_part_matches(html, tag_pos, zbrowser_css_selector) != 0) {
        return 1;
    }
    return 0;
}

uint32_t skip_css_comment(const uint8_t *css, uint32_t pos) {
    if (css[pos] == 47 && css[pos + 1] == 42) {
        pos = pos + 2;
        while (css[pos] != 0) {
            if (css[pos] == 42 && css[pos + 1] == 47) {
                return pos + 2;
            }
            pos = pos + 1;
        }
    }
    return pos;
}

void clear_css_rule_cache(void) {
    uint8_t *selectors;
    uint8_t *decls;

    zbrowser_css_rule_count = 0;
    zbrowser_css_cache_ready = 0;
    if (zbrowser_css_sel_addr != 0) {
        selectors = (uint8_t *)zbrowser_css_sel_addr;
        selectors[0] = 0;
    }
    if (zbrowser_css_decl_addr != 0) {
        decls = (uint8_t *)zbrowser_css_decl_addr;
        decls[0] = 0;
    }
}

void add_css_rule_to_cache(const uint8_t *html,
                           uint32_t selector_start,
                           uint32_t selector_end,
                           uint32_t block_start,
                           uint32_t block_end) {
    uint8_t *selector;
    uint8_t *decl;

    if (zbrowser_css_sel_addr == 0 || zbrowser_css_decl_addr == 0 ||
        zbrowser_css_rule_count >= ZBROWSER_MAX_CSS_RULES) {
        return;
    }
    selector = css_rule_selector_slot(zbrowser_css_rule_count);
    decl = css_rule_decl_slot(zbrowser_css_rule_count);
    copy_range_trimmed(selector, ZBROWSER_CSS_SELECTOR_CAPACITY, html, selector_start, selector_end);
    copy_range_trimmed(decl, ZBROWSER_CSS_DECL_CAPACITY, html, block_start, block_end);
    if (selector[0] == 0 || decl[0] == 0) {
        return;
    }
    zbrowser_css_rule_count = zbrowser_css_rule_count + 1;
}

int range_starts_with_ci(const uint8_t *text,
                         uint32_t start,
                         uint32_t end,
                         const uint8_t *needle) {
    uint32_t i;

    i = 0;
    while (needle[i] != 0) {
        if (start + i >= end ||
            zb_lower_char(text[start + i]) != zb_lower_char(needle[i])) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

int range_contains_ci(const uint8_t *text,
                      uint32_t start,
                      uint32_t end,
                      const uint8_t *needle) {
    uint32_t pos;
    uint32_t j;

    if (needle[0] == 0) {
        return 1;
    }
    pos = start;
    while (pos < end) {
        j = 0;
        while (needle[j] != 0 &&
               pos + j < end &&
               zb_lower_char(text[pos + j]) == zb_lower_char(needle[j])) {
            j = j + 1;
        }
        if (needle[j] == 0) {
            return 1;
        }
        pos = pos + 1;
    }
    return 0;
}

uint32_t css_trim_start_range(const uint8_t *text, uint32_t start, uint32_t end) {
    while (start < end && css_space_char(text[start]) != 0) {
        start = start + 1;
    }
    return start;
}

uint32_t css_trim_end_range(const uint8_t *text, uint32_t start, uint32_t end) {
    while (end > start && css_space_char(text[end - 1]) != 0) {
        end = end - 1;
    }
    return end;
}

uint32_t css_find_block_end(const uint8_t *css, uint32_t block_start, uint32_t end) {
    uint32_t pos;
    uint32_t depth;
    uint8_t quote;

    pos = block_start;
    depth = 1;
    quote = 0;
    while (pos < end) {
        pos = skip_css_comment(css, pos);
        if (pos >= end) {
            break;
        }
        if (quote != 0) {
            if (css[pos] == quote) {
                quote = 0;
            }
        } else if (css[pos] == 34 || css[pos] == 39) {
            quote = css[pos];
        } else if (css[pos] == 123) {
            depth = depth + 1;
        } else if (css[pos] == 125) {
            depth = depth - 1;
            if (depth == 0) {
                return pos;
            }
        }
        pos = pos + 1;
    }
    return end;
}

int css_at_rule_should_descend(const uint8_t *css, uint32_t start, uint32_t end) {
    start = css_trim_start_range(css, start, end);
    end = css_trim_end_range(css, start, end);
    if (start >= end || css[start] != 64) {
        return 0;
    }
    if (range_starts_with_ci(css, start, end, "@media") != 0) {
        if (range_contains_ci(css, start, end, "print") != 0 &&
            range_contains_ci(css, start, end, "screen") == 0) {
            return 0;
        }
        return 1;
    }
    if (range_starts_with_ci(css, start, end, "@supports") != 0 ||
        range_starts_with_ci(css, start, end, "@layer") != 0 ||
        range_starts_with_ci(css, start, end, "@container") != 0) {
        return 1;
    }
    return 0;
}

void build_css_rule_cache_range(const uint8_t *css,
                                uint32_t start,
                                uint32_t end,
                                uint32_t depth) {
    uint32_t pos;
    uint32_t selector_start;
    uint32_t selector_end;
    uint32_t selector_clean_start;
    uint32_t block_start;
    uint32_t block_end;
    uint32_t paren_depth;
    uint32_t bracket_depth;
    uint8_t quote;

    if (depth > 4) {
        return;
    }
    pos = start;
    while (pos < end && zbrowser_css_rule_count < ZBROWSER_MAX_CSS_RULES) {
        pos = skip_css_comment(css, pos);
        while (pos < end && css_space_char(css[pos]) != 0) {
            pos = pos + 1;
        }
        if (pos >= end) {
            break;
        }
        selector_start = pos;
        quote = 0;
        paren_depth = 0;
        bracket_depth = 0;
        while (pos < end) {
            if (quote != 0) {
                if (css[pos] == quote) {
                    quote = 0;
                }
            } else if (css[pos] == 34 || css[pos] == 39) {
                quote = css[pos];
            } else if (css[pos] == 40) {
                paren_depth = paren_depth + 1;
            } else if (css[pos] == 41 && paren_depth > 0) {
                paren_depth = paren_depth - 1;
            } else if (css[pos] == 91) {
                bracket_depth = bracket_depth + 1;
            } else if (css[pos] == 93 && bracket_depth > 0) {
                bracket_depth = bracket_depth - 1;
            } else if (css[pos] == 123 && paren_depth == 0 && bracket_depth == 0) {
                break;
            } else if (css[pos] == 59 && paren_depth == 0 && bracket_depth == 0 &&
                       css[selector_start] == 64) {
                break;
            }
            pos = pos + 1;
        }
        if (pos >= end || css[pos] != 123) {
            pos = pos + 1;
            continue;
        }
        selector_end = css_trim_end_range(css, selector_start, pos);
        selector_clean_start = css_trim_start_range(css, selector_start, selector_end);
        block_start = pos + 1;
        block_end = css_find_block_end(css, block_start, end);
        if (selector_clean_start < selector_end && css[selector_clean_start] == 64) {
            if (css_at_rule_should_descend(css, selector_clean_start, selector_end) != 0) {
                build_css_rule_cache_range(css, block_start, block_end, depth + 1);
            }
        } else {
            add_css_rule_to_cache(css, selector_clean_start, selector_end, block_start, block_end);
        }
        pos = block_end;
        if (pos < end && css[pos] == 125) {
            pos = pos + 1;
        }
    }
}

void build_css_rule_cache(const uint8_t *html) {
    uint32_t pos;
    uint32_t block_start;
    uint32_t block_end;

    clear_css_rule_cache();
    if (zbrowser_css_sel_addr == 0 || zbrowser_css_decl_addr == 0) {
        return;
    }
    pos = 0;
    while (html[pos] != 0 && zbrowser_css_rule_count < ZBROWSER_MAX_CSS_RULES) {
        if (html[pos] == 60 && zb_tag_name_is(html, pos, "style") != 0 && zb_is_closing_tag(html, pos) == 0) {
            block_start = zb_skip_tag(html, pos);
            block_end = block_start;
            while (html[block_end] != 0 &&
                   !(html[block_end] == 60 &&
                     zb_is_closing_tag(html, block_end) != 0 &&
                     zb_tag_name_is(html, block_end, "style") != 0)) {
                block_end = block_end + 1;
            }
            build_css_rule_cache_range(html, block_start, block_end, 0);
            pos = block_end;
        } else {
            pos = pos + 1;
        }
    }
    zbrowser_css_cache_ready = 1;
}

int stylesheet_property_for_tag(const uint8_t *html,
                                uint32_t tag_pos,
                                const uint8_t *property,
                                uint8_t *out,
                                uint32_t capacity) {
    uint32_t pos;
    uint32_t selector_start;
    uint32_t block_start;
    uint32_t block_end;
    uint32_t rule;

    if (capacity == 0) {
        return 0;
    }
    out[0] = 0;
    if (zbrowser_css_cache_ready != 0) {
        rule = zbrowser_css_rule_count;
        while (rule > 0) {
            rule = rule - 1;
            if (selector_list_matches(html, tag_pos, css_rule_selector_slot(rule)) != 0 &&
                css_text_property_value(css_rule_decl_slot(rule), property, out, capacity) != 0) {
                return 1;
            }
        }
        return 0;
    }
    pos = 0;
    while (html[pos] != 0) {
        if (html[pos] == 60 && zb_tag_name_is(html, pos, "style") != 0 && zb_is_closing_tag(html, pos) == 0) {
            pos = zb_skip_tag(html, pos);
            while (html[pos] != 0) {
                if (html[pos] == 60 && zb_is_closing_tag(html, pos) != 0 && zb_tag_name_is(html, pos, "style") != 0) {
                    break;
                }
                pos = skip_css_comment(html, pos);
                selector_start = pos;
                while (html[pos] != 0 && html[pos] != 123 &&
                       !(html[pos] == 60 && zb_is_closing_tag(html, pos) != 0 && zb_tag_name_is(html, pos, "style") != 0)) {
                    pos = pos + 1;
                }
                if (html[pos] != 123) {
                    break;
                }
                copy_range_trimmed(zbrowser_css_selector, 64, html, selector_start, pos);
                block_start = pos + 1;
                block_end = block_start;
                while (html[block_end] != 0 && html[block_end] != 125) {
                    block_end = block_end + 1;
                }
                if (selector_list_matches(html, tag_pos, zbrowser_css_selector) != 0) {
                    copy_range_trimmed(zbrowser_css_property, ZBROWSER_ATTR_CAPACITY, html, block_start, block_end);
                    if (css_text_property_value(zbrowser_css_property, property, out, capacity) != 0) {
                        return 1;
                    }
                }
                pos = block_end;
                if (html[pos] == 125) {
                    pos = pos + 1;
                }
            }
        } else {
            pos = pos + 1;
        }
    }
    return 0;
}

int css_url_after_property(const uint8_t *style, const uint8_t *property, uint8_t *out, uint32_t capacity) {
    uint32_t i;
    uint32_t j;

    if (capacity == 0) {
        return 0;
    }
    out[0] = 0;
    i = 0;
    while (style[i] != 0) {
        j = 0;
        while (property[j] != 0 && zb_lower_char(style[i + j]) == zb_lower_char(property[j])) {
            j = j + 1;
        }
        if (property[j] == 0 && css_property_can_start_at(style, i) != 0) {
            i = i + j;
            while (style[i] == 32 || style[i] == 9 || style[i] == 58) {
                i = i + 1;
            }
            if (css_url_value(style + i, out, capacity) != 0) {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

int css_url_value(const uint8_t *value, uint8_t *out, uint32_t capacity) {
    uint32_t i;
    uint32_t out_pos;
    uint8_t quote;

    if (capacity == 0) {
        return 0;
    }
    out[0] = 0;
    i = 0;
    while (value[i] != 0 && value[i] != 59) {
        if (zb_lower_char(value[i]) == 117 &&
            zb_lower_char(value[i + 1]) == 114 &&
            zb_lower_char(value[i + 2]) == 108 &&
            value[i + 3] == 40) {
            i = i + 4;
            while (value[i] == 32 || value[i] == 9 || value[i] == 10 || value[i] == 13) {
                i = i + 1;
            }
            quote = 0;
            if (value[i] == 34 || value[i] == 39) {
                quote = value[i];
                i = i + 1;
            }
            out_pos = 0;
            while (value[i] != 0 &&
                   ((quote != 0 && value[i] != quote) ||
                    (quote == 0 && value[i] != 41)) &&
                   out_pos + 1 < capacity) {
                out[out_pos] = value[i];
                out_pos = out_pos + 1;
                i = i + 1;
            }
            out[out_pos] = 0;
            if (out[0] != 0) {
                return 1;
            }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

int style_background_image_url(const uint8_t *html, uint32_t pos, uint8_t *out, uint32_t capacity) {
    if (zb_attr_value(html, pos, "background", out, capacity) != 0) {
        return 1;
    }
    if (zb_attr_value(html, pos, "style", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
        if (css_url_after_property(zbrowser_attr, "background-image", out, capacity) != 0) {
            return 1;
        }
        if (css_url_after_property(zbrowser_attr, "background", out, capacity) != 0) {
            return 1;
        }
    }
    if (stylesheet_property_for_tag(html, pos, "background-image", zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_url_value(zbrowser_css_property, out, capacity) != 0) {
        return 1;
    }
    if (stylesheet_property_for_tag(html, pos, "background", zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_url_value(zbrowser_css_property, out, capacity) != 0) {
        return 1;
    }
    return 0;
}

uint32_t style_text_color(const uint8_t *html, uint32_t pos, uint32_t fallback) {
    uint32_t color;

    if (load_web_style(html, pos) != 0 &&
        web_style_has_flag(WEB_STYLE_FLAG_HAS_COLOR) != 0) {
        return zbrowser_web_style_color;
    }
    if (zb_attr_value(html, pos, "style", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_color_after_property(zbrowser_attr, "color", &color) != 0) {
        return color;
    }
    if (zb_attr_value(html, pos, "color", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_color_value(zbrowser_attr, &color) != 0) {
        return color;
    }
    if (stylesheet_property_for_tag(html, pos, "color", zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_color_value(zbrowser_css_property, &color) != 0) {
        return color;
    }
    return fallback;
}

int style_has_text_color(const uint8_t *html, uint32_t pos) {
    uint32_t color;

    if (load_web_style(html, pos) != 0 &&
        web_style_has_flag(WEB_STYLE_FLAG_HAS_COLOR) != 0) {
        return 1;
    }
    if (zb_attr_value(html, pos, "style", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_color_after_property(zbrowser_attr, "color", &color) != 0) {
        return 1;
    }
    if (zb_attr_value(html, pos, "color", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_color_value(zbrowser_attr, &color) != 0) {
        return 1;
    }
    if (stylesheet_property_for_tag(html, pos, "color", zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_color_value(zbrowser_css_property, &color) != 0) {
        return 1;
    }
    return 0;
}

uint32_t style_background_color(const uint8_t *html, uint32_t pos, uint32_t fallback) {
    uint32_t color;

    if (load_web_style(html, pos) != 0 &&
        web_style_has_flag(WEB_STYLE_FLAG_HAS_BG_COLOR) != 0) {
        return zbrowser_web_style_bg_color;
    }
    if (zb_attr_value(html, pos, "style", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        (css_color_after_property(zbrowser_attr, "background-color", &color) != 0 ||
         css_color_after_property(zbrowser_attr, "background", &color) != 0)) {
        return color;
    }
    if (zb_attr_value(html, pos, "bgcolor", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_color_value(zbrowser_attr, &color) != 0) {
        return color;
    }
    if (stylesheet_property_for_tag(html, pos, "background-color", zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_color_value(zbrowser_css_property, &color) != 0) {
        return color;
    }
    if (stylesheet_property_for_tag(html, pos, "background", zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_color_value(zbrowser_css_property, &color) != 0) {
        return color;
    }
    return fallback;
}

int tag_class_contains(const uint8_t *html, uint32_t pos, const uint8_t *name) {
    if (zb_attr_value(html, pos, "class", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        text_contains_ci(zbrowser_attr, name) != 0) {
        return 1;
    }
    return 0;
}

int tag_id_contains(const uint8_t *html, uint32_t pos, const uint8_t *name) {
    if (zb_attr_value(html, pos, "id", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        text_contains_ci(zbrowser_attr, name) != 0) {
        return 1;
    }
    return 0;
}

uint32_t style_text_align(const uint8_t *html, uint32_t pos, uint32_t fallback) {
    if (load_web_style(html, pos) != 0 &&
        web_style_has_flag(WEB_STYLE_FLAG_HAS_TEXT_ALIGN) != 0) {
        return zbrowser_web_style_text_align;
    }
    if (zb_attr_value(html, pos, "align", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
        if (text_contains_ci(zbrowser_attr, "center") != 0) {
            return 1;
        }
        if (text_contains_ci(zbrowser_attr, "right") != 0) {
            return 2;
        }
    }
    if (zb_attr_value(html, pos, "style", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
        if (css_property_contains(zbrowser_attr, "text-align", "center") != 0) {
            return 1;
        }
        if (css_property_contains(zbrowser_attr, "text-align", "right") != 0) {
            return 2;
        }
    }
    if (stylesheet_property_for_tag(html, pos, "text-align", zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0) {
        if (text_contains_ci(zbrowser_css_property, "center") != 0) {
            return 1;
        }
        if (text_contains_ci(zbrowser_css_property, "right") != 0) {
            return 2;
        }
    }
    return fallback;
}

int style_property_value(const uint8_t *html,
                         uint32_t pos,
                         const uint8_t *property,
                         uint8_t *out,
                         uint32_t capacity) {
    if (capacity == 0) {
        return 0;
    }
    out[0] = 0;
    if (zb_attr_value(html, pos, "style", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_text_property_value(zbrowser_attr, property, out, capacity) != 0) {
        return 1;
    }
    if (stylesheet_property_for_tag(html, pos, property, out, capacity) != 0) {
        return 1;
    }
    return 0;
}

int style_property_has(const uint8_t *html,
                       uint32_t pos,
                       const uint8_t *property,
                       const uint8_t *needle) {
    if (style_property_value(html, pos, property, zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0 &&
        text_contains_ci(zbrowser_css_property, needle) != 0) {
        return 1;
    }
    return 0;
}

uint32_t css_length_value_px(const uint8_t *value, uint32_t base, uint32_t fallback) {
    uint32_t pos;
    uint32_t number;
    uint32_t saw_digit;

    pos = 0;
    while (value[pos] == 32 || value[pos] == 9 || value[pos] == 10 || value[pos] == 13) {
        pos = pos + 1;
    }
    number = 0;
    saw_digit = 0;
    while (value[pos] >= 48 && value[pos] <= 57) {
        saw_digit = 1;
        if (number < 100000) {
            number = number * 10 + (uint32_t)(value[pos] - 48);
        }
        pos = pos + 1;
    }
    if (saw_digit == 0) {
        return fallback;
    }
    while (value[pos] == 32 || value[pos] == 9 || value[pos] == 10 || value[pos] == 13) {
        pos = pos + 1;
    }
    if (value[pos] == 37) {
        return (uint32_t)(((uint64_t)base * number) / 100);
    }
    return number;
}

int css_length_px_parse(const uint8_t *value, uint32_t base, uint32_t *out_value) {
    uint32_t pos;
    uint32_t number;
    uint32_t saw_digit;

    pos = 0;
    while (value[pos] == 32 || value[pos] == 9 || value[pos] == 10 || value[pos] == 13) {
        pos = pos + 1;
    }
    number = 0;
    saw_digit = 0;
    while (value[pos] >= 48 && value[pos] <= 57) {
        saw_digit = 1;
        if (number < 100000) {
            number = number * 10 + (uint32_t)(value[pos] - 48);
        }
        pos = pos + 1;
    }
    if (saw_digit == 0) {
        return 0;
    }
    while (value[pos] == 32 || value[pos] == 9 || value[pos] == 10 || value[pos] == 13) {
        pos = pos + 1;
    }
    if (value[pos] == 37) {
        *out_value = (uint32_t)(((uint64_t)base * number) / 100);
        return 1;
    }
    *out_value = number;
    return 1;
}

int style_length_px_prop(const uint8_t *html,
                         uint32_t pos,
                         const uint8_t *property,
                         uint32_t base,
                         uint32_t *out_value) {
    if (load_web_style(html, pos) != 0) {
        if (text_equal(property, "width") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_WIDTH) != 0) {
            *out_value = zbrowser_web_style_width;
            return 1;
        }
        if (text_equal(property, "height") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_HEIGHT) != 0) {
            *out_value = zbrowser_web_style_height;
            return 1;
        }
        if (text_equal(property, "min-width") != 0 &&
            zbrowser_web_style_min_width != 0) {
            *out_value = zbrowser_web_style_min_width;
            return 1;
        }
        if (text_equal(property, "max-width") != 0 &&
            zbrowser_web_style_max_width != 0) {
            *out_value = zbrowser_web_style_max_width;
            return 1;
        }
        if (text_equal(property, "min-height") != 0 &&
            zbrowser_web_style_min_height != 0) {
            *out_value = zbrowser_web_style_min_height;
            return 1;
        }
        if (text_equal(property, "max-height") != 0 &&
            zbrowser_web_style_max_height != 0) {
            *out_value = zbrowser_web_style_max_height;
            return 1;
        }
        if (text_equal(property, "left") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_LEFT) != 0) {
            *out_value = zbrowser_web_style_left;
            return 1;
        }
        if (text_equal(property, "right") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_RIGHT) != 0) {
            *out_value = zbrowser_web_style_right;
            return 1;
        }
        if (text_equal(property, "top") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_TOP) != 0) {
            *out_value = zbrowser_web_style_top;
            return 1;
        }
        if (text_equal(property, "bottom") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_BOTTOM) != 0) {
            *out_value = zbrowser_web_style_bottom;
            return 1;
        }
        if ((text_equal(property, "margin-left") != 0 ||
             text_equal(property, "margin") != 0) &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_MARGIN) != 0 &&
            zbrowser_web_margin_l != 0) {
            *out_value = zbrowser_web_margin_l;
            return 1;
        }
        if (text_equal(property, "margin-right") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_MARGIN) != 0 &&
            zbrowser_web_margin_r != 0) {
            *out_value = zbrowser_web_margin_r;
            return 1;
        }
        if (text_equal(property, "margin-top") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_MARGIN) != 0 &&
            zbrowser_web_margin_t != 0) {
            *out_value = zbrowser_web_margin_t;
            return 1;
        }
        if (text_equal(property, "margin-bottom") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_MARGIN) != 0 &&
            zbrowser_web_margin_b != 0) {
            *out_value = zbrowser_web_margin_b;
            return 1;
        }
        if ((text_equal(property, "padding-left") != 0 ||
             text_equal(property, "padding") != 0) &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_PADDING) != 0 &&
            zbrowser_web_padding_l != 0) {
            *out_value = zbrowser_web_padding_l;
            return 1;
        }
        if (text_equal(property, "padding-right") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_PADDING) != 0 &&
            zbrowser_web_padding_r != 0) {
            *out_value = zbrowser_web_padding_r;
            return 1;
        }
        if (text_equal(property, "padding-top") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_PADDING) != 0 &&
            zbrowser_web_padding_t != 0) {
            *out_value = zbrowser_web_padding_t;
            return 1;
        }
        if (text_equal(property, "padding-bottom") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_PADDING) != 0 &&
            zbrowser_web_padding_b != 0) {
            *out_value = zbrowser_web_padding_b;
            return 1;
        }
        if ((text_equal(property, "border-left-width") != 0 ||
             text_equal(property, "border-width") != 0 ||
             text_equal(property, "border") != 0) &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_BORDER) != 0 &&
            zbrowser_web_border_l != 0) {
            *out_value = zbrowser_web_border_l;
            return 1;
        }
        if (text_equal(property, "border-right-width") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_BORDER) != 0 &&
            zbrowser_web_border_r != 0) {
            *out_value = zbrowser_web_border_r;
            return 1;
        }
        if (text_equal(property, "border-top-width") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_BORDER) != 0 &&
            zbrowser_web_border_t != 0) {
            *out_value = zbrowser_web_border_t;
            return 1;
        }
        if (text_equal(property, "border-bottom-width") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_BORDER) != 0 &&
            zbrowser_web_border_b != 0) {
            *out_value = zbrowser_web_border_b;
            return 1;
        }
    }
    if (style_property_value(html, pos, property, zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_length_px_parse(zbrowser_css_property, base, out_value) != 0) {
        return 1;
    }
    return 0;
}

uint32_t image_style_length(const uint8_t *html,
                            uint32_t pos,
                            const uint8_t *property,
                            uint32_t base) {
    uint32_t value;

    if (load_web_style(html, pos) != 0) {
        if (text_equal(property, "width") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_WIDTH) != 0) {
            return zbrowser_web_style_width;
        }
        if (text_equal(property, "height") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_HEIGHT) != 0) {
            return zbrowser_web_style_height;
        }
        if (text_equal(property, "max-width") != 0 &&
            zbrowser_web_style_max_width != 0) {
            return zbrowser_web_style_max_width;
        }
        if (text_equal(property, "max-height") != 0 &&
            zbrowser_web_style_max_height != 0) {
            return zbrowser_web_style_max_height;
        }
    }
    if (zb_attr_value(html, pos, property, zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
        value = css_length_value_px(zbrowser_attr, base, 0);
        if (value != 0) {
            return value;
        }
    }
    if (zb_attr_value(html, pos, "style", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_text_property_value(zbrowser_attr, property, zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0) {
        value = css_length_value_px(zbrowser_css_property, base, 0);
        if (value != 0) {
            return value;
        }
    }
    if (stylesheet_property_for_tag(html, pos, property, zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0) {
        value = css_length_value_px(zbrowser_css_property, base, 0);
        if (value != 0) {
            return value;
        }
    }
    return 0;
}

void reset_css_position_box(void) {
    zbrowser_box_positioned = 0;
    zbrowser_box_from_anchor = 0;
    zbrowser_box_has_left = 0;
    zbrowser_box_left_px = 0;
    zbrowser_box_has_right = 0;
    zbrowser_box_right_px = 0;
    zbrowser_box_has_top = 0;
    zbrowser_box_top_px = 0;
    zbrowser_box_has_bottom = 0;
    zbrowser_box_bottom_px = 0;
    zbrowser_box_center_x = 0;
}

int tag_may_start_css_box(const uint8_t *html, uint32_t pos) {
    if (zb_tag_name_is(html, pos, "div") ||
        zb_tag_name_is(html, pos, "section") ||
        zb_tag_name_is(html, pos, "article") ||
        zb_tag_name_is(html, pos, "header") ||
        zb_tag_name_is(html, pos, "footer") ||
        zb_tag_name_is(html, pos, "aside") ||
        zb_tag_name_is(html, pos, "main") ||
        zb_tag_name_is(html, pos, "form") ||
        zb_tag_name_is(html, pos, "p") ||
        zb_tag_name_is(html, pos, "span") ||
        zb_tag_name_is(html, pos, "a")) {
        return 1;
    }
    return 0;
}

void apply_css_position_box(const uint8_t *html, uint32_t pos) {
    uint32_t value;

    if (tag_may_start_css_box(html, pos) == 0) {
        return;
    }
    if (load_web_style(html, pos) != 0 &&
        web_style_has_flag(WEB_STYLE_FLAG_HAS_POSITION) != 0 &&
        (zbrowser_web_style_position == WEB_STYLE_POS_ABSOLUTE ||
         zbrowser_web_style_position == WEB_STYLE_POS_FIXED)) {
        reset_css_position_box();
        zbrowser_box_positioned = 1;
        if (zb_tag_name_is(html, pos, "a") != 0) {
            zbrowser_box_from_anchor = 1;
        }
        if (web_style_has_flag(WEB_STYLE_FLAG_HAS_LEFT) != 0) {
            zbrowser_box_has_left = 1;
            zbrowser_box_left_px = zbrowser_web_style_left;
        }
        if (web_style_has_flag(WEB_STYLE_FLAG_HAS_RIGHT) != 0) {
            zbrowser_box_has_right = 1;
            zbrowser_box_right_px = zbrowser_web_style_right;
        }
        if (web_style_has_flag(WEB_STYLE_FLAG_HAS_TOP) != 0) {
            zbrowser_box_has_top = 1;
            zbrowser_box_top_px = zbrowser_web_style_top;
        }
        if (web_style_has_flag(WEB_STYLE_FLAG_HAS_BOTTOM) != 0) {
            zbrowser_box_has_bottom = 1;
            zbrowser_box_bottom_px = zbrowser_web_style_bottom;
        }
        if (web_style_has_flag(WEB_STYLE_FLAG_CENTER_X) != 0 ||
            (web_style_has_flag(WEB_STYLE_FLAG_HAS_LEFT) != 0 &&
             zbrowser_web_style_left > gfx_width() / 3 &&
             zbrowser_web_style_left < (gfx_width() * 2) / 3)) {
            zbrowser_box_center_x = 1;
        }
        return;
    }
    if (style_property_has(html, pos, "position", "absolute") == 0 &&
        style_property_has(html, pos, "position", "fixed") == 0) {
        return;
    }

    reset_css_position_box();
    zbrowser_box_positioned = 1;
    if (zb_tag_name_is(html, pos, "a") != 0) {
        zbrowser_box_from_anchor = 1;
    }
    if (style_length_px_prop(html, pos, "left", gfx_width(), &value) != 0) {
        zbrowser_box_has_left = 1;
        zbrowser_box_left_px = value;
    }
    if (style_length_px_prop(html, pos, "right", gfx_width(), &value) != 0) {
        zbrowser_box_has_right = 1;
        zbrowser_box_right_px = value;
    }
    if (style_length_px_prop(html, pos, "top", gfx_height(), &value) != 0) {
        zbrowser_box_has_top = 1;
        zbrowser_box_top_px = value;
    }
    if (style_length_px_prop(html, pos, "bottom", gfx_height(), &value) != 0) {
        zbrowser_box_has_bottom = 1;
        zbrowser_box_bottom_px = value;
    }
    if ((zbrowser_box_has_left != 0 && zbrowser_box_left_px > gfx_width() / 3 &&
         zbrowser_box_left_px < (gfx_width() * 2) / 3 &&
         style_property_has(html, pos, "transform", "translatex") != 0 &&
         style_property_has(html, pos, "transform", "-50") != 0) ||
        style_property_has(html, pos, "justify-content", "center") != 0) {
        zbrowser_box_center_x = 1;
    }
}

void close_css_position_box(const uint8_t *html, uint32_t pos) {
    if (zbrowser_box_positioned == 0) {
        return;
    }
    if (zbrowser_box_from_anchor != 0 && zb_tag_name_is(html, pos, "a") != 0) {
        reset_css_position_box();
        return;
    }
    if (zb_tag_name_is(html, pos, "div") ||
        zb_tag_name_is(html, pos, "section") ||
        zb_tag_name_is(html, pos, "article") ||
        zb_tag_name_is(html, pos, "header") ||
        zb_tag_name_is(html, pos, "footer") ||
        zb_tag_name_is(html, pos, "aside") ||
        zb_tag_name_is(html, pos, "main") ||
        zb_tag_name_is(html, pos, "form")) {
        reset_css_position_box();
    }
}

int image_should_center(const uint8_t *html, uint32_t pos) {
    if (load_web_style(html, pos) != 0 &&
        (web_style_has_flag(WEB_STYLE_FLAG_MARGIN_AUTO_X) != 0 ||
         web_style_has_flag(WEB_STYLE_FLAG_CENTER_X) != 0)) {
        return 1;
    }
    if (style_property_has(html, pos, "margin", "auto") != 0 ||
        style_property_has(html, pos, "margin-left", "auto") != 0 ||
        style_property_has(html, pos, "margin-right", "auto") != 0) {
        return 1;
    }
    return 0;
}

int tag_is_page_root(const uint8_t *html, uint32_t pos) {
    if (zb_tag_name_is(html, pos, "html") ||
        zb_tag_name_is(html, pos, "body")) {
        return 1;
    }
    return 0;
}

void reset_page_style(void) {
    zbrowser_page_bg_color = 0xffffff;
    zbrowser_page_text_fg = 0x202122;
    zbrowser_page_link_fg = 0x3366cc;
    zbrowser_page_text_align = 0;
    zbrowser_page_bg_has_img = 0;
    zbrowser_page_bg_url[0] = 0;
}

void prepare_page_style(const uint8_t *html) {
    uint32_t pos;
    uint32_t saw_body;
    uint32_t color;

    reset_page_style();
    pos = 0;
    saw_body = 0;
    while (html[pos] != 0) {
        if (html[pos] == 60 &&
            zb_is_closing_tag(html, pos) == 0 &&
            tag_is_page_root(html, pos) != 0) {
            zbrowser_page_text_fg = style_text_color(html, pos, zbrowser_page_text_fg);
            zbrowser_page_bg_color = style_background_color(html, pos, zbrowser_page_bg_color);
            zbrowser_page_text_align = style_text_align(html, pos, zbrowser_page_text_align);
            if (zb_tag_name_is(html, pos, "body")) {
                if (zb_attr_value(html, pos, "text", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
                    css_color_value(zbrowser_attr, &color) != 0) {
                    zbrowser_page_text_fg = color;
                }
                if (zb_attr_value(html, pos, "link", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
                    css_color_value(zbrowser_attr, &color) != 0) {
                    zbrowser_page_link_fg = color;
                }
            }
            if (style_background_image_url(html, pos, zbrowser_style_image_url, ZBROWSER_URL_CAPACITY) != 0 &&
                should_try_inline_image(zbrowser_style_image_url) != 0) {
                make_absolute_url(zbrowser_url, zbrowser_style_image_url, zbrowser_page_bg_url, ZBROWSER_URL_CAPACITY);
                if (zbrowser_page_bg_url[0] != 0) {
                    zbrowser_page_bg_has_img = 1;
                }
            }
            if (zb_tag_name_is(html, pos, "body")) {
                saw_body = 1;
            }
            if (saw_body != 0) {
                break;
            }
        }
        pos = pos + 1;
    }
    if (zbrowser_page_bg_has_img != 0 &&
        zbrowser_page_bg_color == 0xffffff &&
        zbrowser_page_text_fg == 0xffffff) {
        zbrowser_page_bg_color = 0x000000;
    }
}

uint32_t text_bg_for_draw(void) {
    if (zbrowser_page_bg_has_img != 0 &&
        zbrowser_text_bg == zbrowser_page_bg_color) {
        return 0xffffffff;
    }
    return zbrowser_text_bg;
}

int color_is_page_background(uint32_t color) {
    if (color == zbrowser_page_bg_color) {
        return 1;
    }
    if (color == 0xffffff && zbrowser_page_bg_color == 0xffffffff) {
        return 1;
    }
    if (color == 0xffffffff && zbrowser_page_bg_color == 0xffffff) {
        return 1;
    }
    return 0;
}

void draw_line_background_band(uint32_t y, uint32_t line_h, uint32_t bg) {
    uint32_t border_bits;

    border_bits = zbrowser_flow_box_flags & ZBROWSER_FLOW_BOX_BORDER;
    if (color_is_page_background(bg) != 0 &&
        border_bits == 0) {
        return;
    }
    if (flow_box_w() <= 4 || line_h == 0) {
        return;
    }
    draw_current_flow_decoration(y, line_h, bg);
}

void activate_background_band(void) {
    if (color_is_page_background(text_bg_for_draw()) == 0) {
        zbrowser_bg_band_active = 1;
    }
}

uint8_t zb_upper_char(uint8_t ch) {
    if (ch >= 97 && ch <= 122) {
        return ch - 32;
    }
    return ch;
}

uint8_t transform_text_char(uint8_t ch) {
    if (zbrowser_text_transform == WEB_STYLE_TEXT_TRANSFORM_UPPERCASE) {
        return zb_upper_char(ch);
    }
    if (zbrowser_text_transform == WEB_STYLE_TEXT_TRANSFORM_LOWERCASE) {
        return zb_lower_char(ch);
    }
    if (zbrowser_text_transform == WEB_STYLE_TEXT_TRANSFORM_CAPITALIZE &&
        (zbrowser_line_len == 0 || zbrowser_last_space != 0)) {
        return zb_upper_char(ch);
    }
    return ch;
}

uint32_t current_indent_cols(void) {
    uint32_t cols;

    cols = zbrowser_content_indent_cols;
    if (cols > 18) {
        cols = 18;
    }
    if (zbrowser_line_max_cols() <= cols + 8) {
        if (zbrowser_line_max_cols() > 8) {
            cols = zbrowser_line_max_cols() - 8;
        } else {
            cols = 0;
        }
    }
    return cols;
}

int line_has_table_box(uint32_t line) {
    uint32_t i;

    i = 0;
    while (i < zbrowser_table_box_count) {
        if (zbrowser_table_box_lines[i] == line) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

void push_text_style(void) {
    uint32_t depth;

    depth = zbrowser_style_stack_depth;
    if (depth >= ZBROWSER_STYLE_STACK_MAX) {
        return;
    }
    zbrowser_style_stack_fg[depth] = zbrowser_text_fg;
    zbrowser_style_stack_bg[depth] = zbrowser_text_bg;
    zbrowser_style_stack_bg_band[depth] = zbrowser_bg_band_active;
    zbrowser_style_stack_align[depth] = zbrowser_text_align;
    zbrowser_style_stack_region[depth] = zbrowser_layout_region;
    zbrowser_style_stack_col_mode[depth] = zbrowser_column_mode;
    zbrowser_style_stack_col_start[depth] = zbrowser_column_start_line;
    zbrowser_style_stack_indent[depth] = zbrowser_content_indent_cols;
    zbrowser_style_stack_line_stride[depth] = zbrowser_line_stride;
    zbrowser_style_stack_font_scale[depth] = zbrowser_font_scale;
    zbrowser_style_stack_transform[depth] = zbrowser_text_transform;
    zbrowser_style_stack_white_space[depth] = zbrowser_white_space;
    zbrowser_style_stack_bottom_space[depth] = zbrowser_css_bottom_space;
    zbrowser_style_stack_block_flow[depth] = zbrowser_css_scope_block_flow;
    zbrowser_style_stack_flow_x[depth] = zbrowser_flow_x_px;
    zbrowser_style_stack_flow_w[depth] = zbrowser_flow_w_px;
    zbrowser_style_stack_flow_box_x[depth] = zbrowser_flow_box_x_px;
    zbrowser_style_stack_flow_box_w[depth] = zbrowser_flow_box_w_px;
    zbrowser_style_stack_flow_box_flags[depth] = zbrowser_flow_box_flags;
    zbrowser_style_stack_flow_box_border[depth] = zbrowser_flow_box_border;
    zbrowser_style_stack_depth = depth + 1;
}

void pop_text_style(void) {
    uint32_t depth;
    uint32_t old_column_mode;

    if (zbrowser_style_stack_depth == 0) {
        zbrowser_text_fg = zbrowser_page_text_fg;
        zbrowser_text_bg = zbrowser_page_bg_color;
        zbrowser_bg_band_active = 0;
        zbrowser_text_align = zbrowser_page_text_align;
        set_region(ZBROWSER_REGION_ARTICLE);
        zbrowser_column_mode = 0;
        zbrowser_column_start_line = 0;
        zbrowser_content_indent_cols = 0;
        zbrowser_line_stride = 1;
        zbrowser_font_scale = 1;
        zbrowser_text_transform = WEB_STYLE_TEXT_TRANSFORM_NONE;
        zbrowser_white_space = WEB_STYLE_WHITE_SPACE_NORMAL;
        zbrowser_css_bottom_space = 0;
        zbrowser_css_scope_block_flow = 0;
        clear_flow_box();
        return;
    }
    depth = zbrowser_style_stack_depth - 1;
    old_column_mode = zbrowser_column_mode;
    if (old_column_mode != 0 && zbrowser_style_stack_col_mode[depth] == 0) {
        set_region(ZBROWSER_REGION_ARTICLE);
    }
    zbrowser_style_stack_depth = depth;
    zbrowser_text_fg = zbrowser_style_stack_fg[depth];
    zbrowser_text_bg = zbrowser_style_stack_bg[depth];
    zbrowser_bg_band_active = zbrowser_style_stack_bg_band[depth];
    zbrowser_text_align = zbrowser_style_stack_align[depth];
    zbrowser_column_mode = zbrowser_style_stack_col_mode[depth];
    zbrowser_column_start_line = zbrowser_style_stack_col_start[depth];
    zbrowser_content_indent_cols = zbrowser_style_stack_indent[depth];
    zbrowser_line_stride = zbrowser_style_stack_line_stride[depth];
    zbrowser_font_scale = zbrowser_style_stack_font_scale[depth];
    zbrowser_text_transform = zbrowser_style_stack_transform[depth];
    zbrowser_white_space = zbrowser_style_stack_white_space[depth];
    zbrowser_css_bottom_space = zbrowser_style_stack_bottom_space[depth];
    zbrowser_css_scope_block_flow = zbrowser_style_stack_block_flow[depth];
    zbrowser_flow_x_px = zbrowser_style_stack_flow_x[depth];
    zbrowser_flow_w_px = zbrowser_style_stack_flow_w[depth];
    zbrowser_flow_box_x_px = zbrowser_style_stack_flow_box_x[depth];
    zbrowser_flow_box_w_px = zbrowser_style_stack_flow_box_w[depth];
    zbrowser_flow_box_flags = zbrowser_style_stack_flow_box_flags[depth];
    zbrowser_flow_box_border = zbrowser_style_stack_flow_box_border[depth];
    set_region(zbrowser_style_stack_region[depth]);
}

int netsurf_tag_hint(const uint8_t *html,
                     uint32_t pos,
                     uint32_t *out_display,
                     uint32_t *out_role,
                     uint32_t *out_flags) {
    if (netsurf_port_style_hint_for_tag(html, pos, out_display, out_role, out_flags) != 0) {
        return 1;
    }
    return 0;
}

int netsurf_tag_role_is(const uint8_t *html, uint32_t pos, uint32_t role) {
    uint32_t display;
    uint32_t hint_role;
    uint32_t flags;

    display = NETSURF_PORT_HINT_DISPLAY_UNKNOWN;
    hint_role = NETSURF_PORT_HINT_ROLE_NONE;
    flags = 0;
    if (netsurf_tag_hint(html, pos, &display, &hint_role, &flags) != 0 &&
        hint_role == role) {
        return 1;
    }
    return 0;
}

int netsurf_tag_has_flags(const uint8_t *html, uint32_t pos, uint32_t wanted_flags) {
    uint32_t display;
    uint32_t role;
    uint32_t flags;
    uint32_t bits;

    display = NETSURF_PORT_HINT_DISPLAY_UNKNOWN;
    role = NETSURF_PORT_HINT_ROLE_NONE;
    flags = 0;
    bits = 0;
    if (netsurf_tag_hint(html, pos, &display, &role, &flags) != 0) {
        bits = flags & wanted_flags;
        if (bits != 0) {
            return 1;
        }
    }
    return 0;
}

int tag_is_native_heading(const uint8_t *html, uint32_t pos) {
    if (zb_tag_name_is(html, pos, "h1") ||
        zb_tag_name_is(html, pos, "h2") ||
        zb_tag_name_is(html, pos, "h3") ||
        zb_tag_name_is(html, pos, "h4") ||
        zb_tag_name_is(html, pos, "h5") ||
        zb_tag_name_is(html, pos, "h6")) {
        return 1;
    }
    return 0;
}

int tag_has_heading_role(const uint8_t *html, uint32_t pos) {
    if (netsurf_tag_role_is(html, pos, NETSURF_PORT_HINT_ROLE_HEADING) != 0) {
        return 1;
    }
    return 0;
}

int tag_is_prominent_heading(const uint8_t *html, uint32_t pos) {
    if (zb_tag_name_is(html, pos, "h1") ||
        zb_tag_name_is(html, pos, "h2") ||
        zb_tag_name_is(html, pos, "h3")) {
        return 1;
    }
    if (tag_is_native_heading(html, pos) == 0 &&
        tag_has_heading_role(html, pos) != 0) {
        return 1;
    }
    return 0;
}

int tag_is_site_chrome(const uint8_t *html, uint32_t pos) {
    if (netsurf_tag_role_is(html, pos, NETSURF_PORT_HINT_ROLE_CHROME) != 0) {
        return 1;
    }
    if (zb_tag_name_is(html, pos, "nav") ||
        zb_tag_name_is(html, pos, "header") ||
        zb_tag_name_is(html, pos, "footer") ||
        zb_tag_name_is(html, pos, "search") ||
        zb_tag_name_is(html, pos, "aside")) {
        return 1;
    }
    if (tag_class_contains(html, pos, "site-header") ||
        tag_class_contains(html, pos, "site-footer") ||
        tag_class_contains(html, pos, "navbar") ||
        tag_class_contains(html, pos, "navigation") ||
        tag_id_contains(html, pos, "footer")) {
        return 1;
    }
    return 0;
}

int tag_is_right(const uint8_t *html, uint32_t pos) {
    if (tag_class_contains(html, pos, "infobox") ||
        tag_class_contains(html, pos, "sidebar") ||
        tag_class_contains(html, pos, "thumb") ||
        tag_class_contains(html, pos, "gallery")) {
        return 1;
    }
    return 0;
}

void apply_semantic_tag_style(const uint8_t *html, uint32_t pos) {
    if (load_web_style(html, pos) != 0) {
        zbrowser_text_transform = zbrowser_web_text_transform;
        zbrowser_white_space = zbrowser_web_white_space;
        if (zbrowser_web_line_height >= 28 || zbrowser_web_font_size >= 28) {
            zbrowser_line_stride = 3;
        } else if (zbrowser_web_line_height >= 22 || zbrowser_web_font_size >= 22) {
            zbrowser_line_stride = 2;
        } else {
            zbrowser_line_stride = 1;
        }
        zbrowser_font_scale = 1;
        if (zbrowser_web_font_size >= 36 || zbrowser_web_line_height >= 40) {
            zbrowser_font_scale = 3;
        } else if (zbrowser_web_font_size >= 22 || zbrowser_web_line_height >= 28) {
            zbrowser_font_scale = 2;
        }
        if (zbrowser_line_stride < zbrowser_font_scale) {
            zbrowser_line_stride = zbrowser_font_scale;
        }
        if (zbrowser_web_font_size >= 22) {
            zbrowser_text_fg = 0x000000;
        } else if (zbrowser_web_font_size > 0 && zbrowser_web_font_size <= 13) {
            zbrowser_text_fg = 0x54595d;
        }
        if (zbrowser_web_direction == WEB_STYLE_DIRECTION_RTL &&
            zbrowser_text_align == WEB_STYLE_ALIGN_LEFT) {
            zbrowser_text_align = WEB_STYLE_ALIGN_RIGHT;
        }
        if (zbrowser_web_opacity < 128) {
            zbrowser_text_fg = 0x72777d;
        }
    }
    if (zb_tag_name_is(html, pos, "center")) {
        zbrowser_text_align = 1;
        return;
    }
    if (zb_tag_name_is(html, pos, "a")) {
        if (style_has_text_color(html, pos) == 0) {
            zbrowser_text_fg = zbrowser_link_text;
        }
        return;
    }
    if (load_web_style(html, pos) != 0) {
        if (zbrowser_web_style_font_weight == WEB_STYLE_FONT_BOLD) {
            zbrowser_text_fg = 0x000000;
        }
        if (zbrowser_web_style_font_style == WEB_STYLE_FONT_STYLE_ITALIC) {
            zbrowser_text_fg = 0x54595d;
        }
    }
    if (zb_tag_name_is(html, pos, "b") ||
        zb_tag_name_is(html, pos, "strong")) {
        zbrowser_text_fg = 0x000000;
        return;
    }
    if (zb_tag_name_is(html, pos, "i") ||
        zb_tag_name_is(html, pos, "em")) {
        zbrowser_text_fg = 0x54595d;
        return;
    }
    if (zb_tag_name_is(html, pos, "small")) {
        zbrowser_text_fg = 0x9aa7b2;
        return;
    }
    if (zb_tag_name_is(html, pos, "mark") ||
        tag_class_contains(html, pos, "highlight")) {
        zbrowser_text_fg = 0x202122;
        zbrowser_text_bg = 0xfff3cd;
        return;
    }
    if (zb_tag_name_is(html, pos, "code") ||
        zb_tag_name_is(html, pos, "pre")) {
        zbrowser_text_fg = 0x202122;
        zbrowser_text_bg = 0xf8f9fa;
        if (zb_tag_name_is(html, pos, "pre")) {
            activate_background_band();
        }
        return;
    }
    if (zb_tag_name_is(html, pos, "blockquote") ||
        tag_class_contains(html, pos, "quotebox")) {
        zbrowser_text_fg = 0x202122;
        zbrowser_text_bg = 0xf8f9fa;
        activate_background_band();
        return;
    }
    if (tag_is_native_heading(html, pos) == 0 &&
        tag_has_heading_role(html, pos) != 0) {
        zbrowser_text_fg = 0x000000;
        if (zbrowser_font_scale < 2) {
            zbrowser_font_scale = 2;
        }
        if (zbrowser_line_stride < zbrowser_font_scale) {
            zbrowser_line_stride = zbrowser_font_scale;
        }
        return;
    }
    if (zb_tag_name_is(html, pos, "th")) {
        zbrowser_text_fg = 0x202122;
        zbrowser_text_bg = 0xeaecf0;
        activate_background_band();
        return;
    }
    if (zb_attr_value(html, pos, "style", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
        if (css_property_contains(zbrowser_attr, "font-weight", "bold") != 0 ||
            css_property_contains(zbrowser_attr, "font-weight", "700") != 0) {
            zbrowser_text_fg = 0x000000;
        }
        if (css_property_contains(zbrowser_attr, "font-style", "italic") != 0) {
            zbrowser_text_fg = 0x54595d;
        }
    }
    if (tag_class_contains(html, pos, "hatnote") ||
        tag_class_contains(html, pos, "shortdescription") ||
        tag_class_contains(html, pos, "metadata")) {
        zbrowser_text_fg = 0x54595d;
        zbrowser_text_bg = 0xf8f9fa;
        activate_background_band();
        return;
    }
    if (tag_class_contains(html, pos, "ambox") ||
        tag_class_contains(html, pos, "notice") ||
        tag_class_contains(html, pos, "warning")) {
        zbrowser_text_fg = 0x202122;
        zbrowser_text_bg = 0xfff3cd;
        activate_background_band();
        return;
    }
    if (tag_class_contains(html, pos, "infobox-title") ||
        tag_class_contains(html, pos, "infobox-above")) {
        zbrowser_text_fg = 0x202122;
        zbrowser_text_bg = 0xeaecf0;
        zbrowser_text_align = 1;
        activate_background_band();
        return;
    }
    if (tag_class_contains(html, pos, "infobox-caption") ||
        tag_class_contains(html, pos, "thumbcaption")) {
        zbrowser_text_fg = 0x54595d;
        zbrowser_text_bg = 0xf8f9fa;
        zbrowser_text_align = 1;
        activate_background_band();
        return;
    }
    if (tag_class_contains(html, pos, "infobox") ||
        tag_class_contains(html, pos, "toc") ||
        tag_class_contains(html, pos, "thumb") ||
        tag_class_contains(html, pos, "navbox") ||
        tag_class_contains(html, pos, "sidebar")) {
        zbrowser_text_fg = 0x202122;
        zbrowser_text_bg = 0xf8f9fa;
        activate_background_band();
        return;
    }
    if (tag_is_site_chrome(html, pos) != 0) {
        zbrowser_text_fg = 0x54595d;
        zbrowser_text_bg = 0xf8f9fa;
        activate_background_band();
    }
}

void apply_css_background_band(const uint8_t *html, uint32_t pos) {
    if (load_web_style(html, pos) != 0 &&
        web_style_has_flag(WEB_STYLE_FLAG_HAS_BG_COLOR) != 0 &&
        tag_is_block_flow(html, pos) != 0 &&
        color_is_page_background(text_bg_for_draw()) == 0) {
        zbrowser_bg_band_active = 1;
    }
}

void apply_css_block_spacing(const uint8_t *html, uint32_t pos) {
    uint32_t add_cols;
    uint32_t px;

    zbrowser_css_bottom_space = 0;
    zbrowser_css_scope_block_flow = 0;
    if (load_web_style(html, pos) == 0) {
        return;
    }
    if (tag_is_block_flow(html, pos) == 0 &&
        zbrowser_web_style_display != WEB_STYLE_DISPLAY_LIST_ITEM &&
        zbrowser_web_style_float == WEB_STYLE_FLOAT_NONE) {
        return;
    }
    zbrowser_css_scope_block_flow = 1;
    if (zbrowser_web_clear_side != WEB_STYLE_CLEAR_NONE) {
        blank_line();
    }
    if (zbrowser_web_margin_t >= 18 || zbrowser_web_padding_t >= 18) {
        blank_line();
    } else if (zbrowser_web_margin_t >= 8 || zbrowser_web_padding_t >= 8) {
        flush_line();
    }
    if (zbrowser_web_margin_b >= 18 || zbrowser_web_padding_b >= 18) {
        zbrowser_css_bottom_space = 2;
    } else if (zbrowser_web_margin_b >= 8 || zbrowser_web_padding_b >= 8) {
        zbrowser_css_bottom_space = 1;
    }
    add_cols = 0;
    px = zbrowser_web_margin_l + zbrowser_web_padding_l + zbrowser_web_border_l + zbrowser_web_text_indent;
    if (px >= 8) {
        add_cols = px / 8;
    }
    if (zbrowser_web_style_display == WEB_STYLE_DISPLAY_LIST_ITEM &&
        zbrowser_web_list_style_position == WEB_STYLE_LIST_POSITION_OUTSIDE &&
        add_cols < 2) {
        add_cols = 2;
    }
    if (add_cols > 12) {
        add_cols = 12;
    }
    if (add_cols != 0) {
        zbrowser_content_indent_cols = zbrowser_content_indent_cols + add_cols;
        if (zbrowser_content_indent_cols > 18) {
            zbrowser_content_indent_cols = 18;
        }
    }
}

uint32_t visible_border_color(void) {
    if (web_style_has_flag(WEB_STYLE_FLAG_BORDER_COLOR) != 0) {
        return zbrowser_web_border_color;
    }
    if (web_style_has_flag(WEB_STYLE_FLAG_HAS_COLOR) != 0) {
        return zbrowser_web_style_color;
    }
    return 0xa2a9b1;
}

int current_style_has_visible_border(void) {
    if (web_style_has_flag(WEB_STYLE_FLAG_HAS_BORDER) != 0 &&
        (zbrowser_web_border_l != 0 ||
         zbrowser_web_border_r != 0 ||
         zbrowser_web_border_t != 0 ||
         zbrowser_web_border_b != 0)) {
        return 1;
    }
    return 0;
}

void apply_css_flow_box(const uint8_t *html, uint32_t pos) {
    uint32_t parent_x;
    uint32_t parent_w;
    uint32_t margin_l;
    uint32_t margin_r;
    uint32_t padding_l;
    uint32_t padding_r;
    uint32_t border_l;
    uint32_t border_r;
    uint32_t border_x;
    uint32_t border_w;
    uint32_t content_x;
    uint32_t content_w;
    uint32_t wanted_w;
    uint32_t flags;

    if (load_web_style(html, pos) == 0) {
        return;
    }
    if (tag_is_block_flow(html, pos) == 0 &&
        zbrowser_web_style_display != WEB_STYLE_DISPLAY_LIST_ITEM &&
        zbrowser_web_style_float == WEB_STYLE_FLOAT_NONE) {
        return;
    }

    parent_x = flow_content_x();
    parent_w = flow_content_w();
    if (parent_w < 16) {
        return;
    }

    margin_l = zbrowser_web_margin_l;
    margin_r = zbrowser_web_margin_r;
    padding_l = zbrowser_web_padding_l;
    padding_r = zbrowser_web_padding_r;
    border_l = zbrowser_web_border_l;
    border_r = zbrowser_web_border_r;
    if (border_l > 8) {
        border_l = 8;
    }
    if (border_r > 8) {
        border_r = 8;
    }
    if (padding_l > parent_w / 3) {
        padding_l = parent_w / 3;
    }
    if (padding_r > parent_w / 3) {
        padding_r = parent_w / 3;
    }
    if (margin_l > parent_w / 2) {
        margin_l = parent_w / 2;
    }
    if (margin_r > parent_w / 2) {
        margin_r = parent_w / 2;
    }

    border_x = parent_x + margin_l;
    if (parent_w > margin_l + margin_r) {
        border_w = parent_w - margin_l - margin_r;
    } else {
        border_w = parent_w;
        border_x = parent_x;
    }
    if (web_style_has_flag(WEB_STYLE_FLAG_HAS_WIDTH) != 0 &&
        zbrowser_web_style_width != 0) {
        wanted_w = zbrowser_web_style_width;
        if (zbrowser_web_box_sizing == WEB_STYLE_BOX_CONTENT_BOX) {
            wanted_w = wanted_w + padding_l + padding_r + border_l + border_r;
        }
        border_w = clamp_flow_width(wanted_w, border_w);
    }
    if (web_style_has_flag(WEB_STYLE_FLAG_HAS_MAX_WIDTH) != 0 &&
        zbrowser_web_style_max_width != 0 &&
        zbrowser_web_style_max_width < border_w) {
        border_w = zbrowser_web_style_max_width;
    }
    if (web_style_has_flag(WEB_STYLE_FLAG_HAS_MIN_WIDTH) != 0 &&
        zbrowser_web_style_min_width > border_w &&
        zbrowser_web_style_min_width < parent_w) {
        border_w = zbrowser_web_style_min_width;
    }
    border_w = clamp_flow_width(border_w, parent_w);
    if ((web_style_has_flag(WEB_STYLE_FLAG_MARGIN_AUTO_X) != 0 ||
         web_style_has_flag(WEB_STYLE_FLAG_CENTER_X) != 0) &&
        parent_w > border_w) {
        border_x = parent_x + (parent_w - border_w) / 2;
    } else if (zbrowser_web_style_float == WEB_STYLE_FLOAT_RIGHT &&
               parent_w > border_w + margin_r) {
        border_x = parent_x + parent_w - border_w - margin_r;
    }
    if (border_x < parent_x) {
        border_x = parent_x;
    }
    if (border_x + border_w > parent_x + parent_w) {
        if (parent_x + parent_w > border_w) {
            border_x = parent_x + parent_w - border_w;
        } else {
            border_x = parent_x;
            border_w = parent_w;
        }
    }

    content_x = border_x + border_l + padding_l;
    if (border_w > border_l + border_r + padding_l + padding_r) {
        content_w = border_w - border_l - border_r - padding_l - padding_r;
    } else {
        content_w = border_w;
        content_x = border_x;
    }
    content_w = clamp_flow_width(content_w, border_w);

    zbrowser_flow_box_x_px = border_x;
    zbrowser_flow_box_w_px = border_w;
    zbrowser_flow_x_px = content_x;
    zbrowser_flow_w_px = content_w;
    zbrowser_flow_box_border = visible_border_color();
    flags = 0;
    if (web_style_has_flag(WEB_STYLE_FLAG_HAS_BG_COLOR) != 0 &&
        color_is_page_background(zbrowser_web_style_bg_color) == 0) {
        flags = flags + ZBROWSER_FLOW_BOX_BG;
    }
    if (current_style_has_visible_border() != 0) {
        flags = flags + ZBROWSER_FLOW_BOX_BORDER;
    }
    zbrowser_flow_box_flags = flags;
    if (flags != 0) {
        zbrowser_bg_band_active = 1;
    }
}

int tag_hidden_from_style(const uint8_t *html, uint32_t pos) {
    if (zb_attr_value(html, pos, "hidden", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
        return 1;
    }
    if (zb_attr_value(html, pos, "aria-hidden", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        text_contains_ci(zbrowser_attr, "true") != 0) {
        return 1;
    }
    if (load_web_style(html, pos) != 0 &&
        (web_style_has_flag(WEB_STYLE_FLAG_DISPLAY_NONE) != 0 ||
         web_style_has_flag(WEB_STYLE_FLAG_VIS_HIDDEN) != 0 ||
         zbrowser_web_opacity == 0)) {
        return 1;
    }
    if (zb_attr_value(html, pos, "style", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        (text_contains_ci(zbrowser_attr, "display:none") != 0 ||
         text_contains_ci(zbrowser_attr, "display: none") != 0 ||
         text_contains_ci(zbrowser_attr, "visibility:hidden") != 0 ||
         text_contains_ci(zbrowser_attr, "visibility: hidden") != 0)) {
        return 1;
    }
    if (stylesheet_property_for_tag(html, pos, "display", zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0 &&
        text_contains_ci(zbrowser_css_property, "none") != 0) {
        return 1;
    }
    if (stylesheet_property_for_tag(html, pos, "visibility", zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0 &&
        text_contains_ci(zbrowser_css_property, "hidden") != 0) {
        return 1;
    }
    return 0;
}

int tag_should_skip_content(const uint8_t *html, uint32_t pos) {
    if (html[pos] == 0) {
        return 0;
    }
    if (netsurf_tag_has_flags(html,
                              pos,
                              NETSURF_PORT_HINT_FLAG_SKIP | NETSURF_PORT_HINT_FLAG_HIDDEN) != 0) {
        return 1;
    }
    if (tag_class_contains(html, pos, "printfooter") ||
        tag_class_contains(html, pos, "metadata") ||
        tag_class_contains(html, pos, "noprint") ||
        tag_class_contains(html, pos, "visually-hidden") ||
        tag_class_contains(html, pos, "sr-only") ||
        tag_class_contains(html, pos, "mw-editsection") ||
        tag_id_contains(html, pos, "catlinks")) {
        return 1;
    }
    return 0;
}

uint32_t find_primary_content_start(const uint8_t *html) {
    uint32_t pos;
    uint32_t main_pos;
    uint32_t article_pos;
    uint32_t body_pos;

    pos = 0;
    main_pos = 0;
    article_pos = 0;
    body_pos = 0;
    while (html[pos] != 0) {
        if (html[pos] == 60) {
            if (zb_is_closing_tag(html, pos) == 0) {
                if ((zb_tag_name_is(html, pos, "div") ||
                     zb_tag_name_is(html, pos, "main") ||
                     zb_tag_name_is(html, pos, "article") ||
                     zb_tag_name_is(html, pos, "section")) &&
                    zb_attr_value(html, pos, "data-zbrowser-primary", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
                    text_contains_ci(zbrowser_attr, "1") != 0) {
                    return pos;
                }
                if ((zb_tag_name_is(html, pos, "div") ||
                     zb_tag_name_is(html, pos, "main") ||
                     zb_tag_name_is(html, pos, "article") ||
                     zb_tag_name_is(html, pos, "section")) &&
                    (tag_id_contains(html, pos, "mw-content-text") != 0 ||
                     tag_class_contains(html, pos, "mw-body-content") != 0 ||
                     tag_class_contains(html, pos, "mw-parser-output") != 0 ||
                     tag_id_contains(html, pos, "article") != 0)) {
                    return pos;
                }
                if (main_pos == 0 &&
                    (zb_tag_name_is(html, pos, "main") ||
                     tag_id_contains(html, pos, "content") != 0 ||
                     tag_class_contains(html, pos, "main-content") != 0)) {
                    main_pos = pos;
                }
                if (article_pos == 0 &&
                    (zb_tag_name_is(html, pos, "article") ||
                     tag_class_contains(html, pos, "article") != 0 ||
                     tag_class_contains(html, pos, "post") != 0 ||
                     tag_class_contains(html, pos, "entry-content") != 0)) {
                    article_pos = pos;
                }
                if (body_pos == 0 && zb_tag_name_is(html, pos, "body") != 0) {
                    body_pos = pos;
                }
            }
            pos = zb_skip_tag(html, pos);
        } else {
            pos = pos + 1;
        }
    }
    if (main_pos != 0) {
        return main_pos;
    }
    if (article_pos != 0) {
        return article_pos;
    }
    if (body_pos != 0) {
        return body_pos;
    }
    return 0;
}

int has_scheme(const uint8_t *url) {
    if (zb_starts_with(url, "http://") || zb_starts_with(url, "https://")) {
        return 1;
    }
    return 0;
}

int looks_like_host(const uint8_t *text) {
    uint32_t i;

    i = 0;
    while (text[i] != 0 && text[i] != 47 && text[i] != 32) {
        if (text[i] == 46) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

void zbrowser_clear_http_diag(void) {
    zbrowser_http_status_code = 0;
    zbrowser_http_body_size = 0;
    zbrowser_http_content_length = 0;
    zbrowser_http_error = 0;
    zbrowser_tls_error = 0;
    zbrowser_http_content_type[0] = 0;
}

void zbrowser_capture_http_diag(int size, struct NetHttpInfo *info) {
    uint32_t status_code;
    uint32_t body_size;
    uint32_t content_length;

    zbrowser_http_error = size;
    status_code = info->status_code;
    body_size = info->body_size;
    content_length = info->content_length;
    zbrowser_http_status_code = status_code;
    zbrowser_http_body_size = body_size;
    zbrowser_http_content_length = content_length;
    zbrowser_tls_error = info->tls_error;
    zbrowser_http_content_type[0] = 0;
    if (size >= 0) {
        zbrowser_http_body_size = size;
    }
}

int starts_with_at(const uint8_t *text, uint32_t start, const uint8_t *prefix) {
    uint32_t i;

    i = 0;
    while (prefix[i] != 0) {
        if (text[start + i] != prefix[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

void set_http_error_status(const uint8_t *scheme_name, int size, struct NetHttpInfo *info) {
    if (size == -1) {
        copy_text(zbrowser_status, 96, "bad request");
    } else if (size == -2) {
        copy_text(zbrowser_status, 96, "bad url");
    } else if (size == -3) {
        copy_text(zbrowser_status, 96, "arp lookup failed");
    } else if (size == -4) {
        copy_text(zbrowser_status, 96, "tls send failed");
        if (zbrowser_tls_error != 0) {
            append_text_limited(zbrowser_status, 96, " ");
            append_uint_limited(zbrowser_status, 96, zbrowser_tls_error);
        } else {
            append_text_limited(zbrowser_status, 96, " err ");
            append_int_limited(zbrowser_status, 96, size);
        }
    } else if (size == -7) {
        copy_text(zbrowser_status, 96, "no network route");
    } else if (size == -9) {
        copy_text(zbrowser_status, 96, "https unavailable");
    } else if (size == -14) {
        copy_text(zbrowser_status, 96, "network busy");
    } else if (size == -8) {
        copy_text(zbrowser_status, 96, "dns lookup failed");
    } else if (size == -5) {
        copy_text(zbrowser_status, 96, "tcp connect failed");
    } else if (size == -6) {
        copy_text(zbrowser_status, 96, "http receive timed out");
    } else if (size == -10) {
        copy_text(zbrowser_status, 96, "tls handshake failed");
        if (zbrowser_tls_error != 0) {
            append_text_limited(zbrowser_status, 96, " tls ");
            append_uint_limited(zbrowser_status, 96, zbrowser_tls_error);
        }
    } else if (size == -11) {
        copy_text(zbrowser_status, 96, "network out of memory");
    } else if (size == -12) {
        copy_text(zbrowser_status, 96, "rtc time unavailable");
    } else if (size == -13) {
        copy_text(zbrowser_status, 96, "redirect unsupported");
    } else if (size == -15) {
        copy_text(zbrowser_status, 96, "content decode failed");
    } else if (info->status_code >= 400) {
        copy_text(zbrowser_status, 96, "http status error");
    } else {
        copy_text(zbrowser_status, 96, scheme_name);
        append_text_limited(zbrowser_status, 96, " failed");
    }
}

int http_get_page_with_retry(const uint8_t *url,
                             uint8_t *buffer,
                             uint32_t capacity,
                             struct NetHttpInfo *info) {
    int size;

    size = os_http_get_ex(url, buffer, capacity, info);
    if (zb_starts_with(url, "https://") != 0 &&
        (size == -4 || size == -6 || size == -10 || size == -14)) {
        copy_text(zbrowser_status, 96, "retrying https");
        size = os_http_get_ex(url, buffer, capacity, info);
    }
    return size;
}

int append_text_to_document(uint8_t *document, int size, const uint8_t *text) {
    uint32_t i;

    i = 0;
    while (text[i] != 0 && (uint32_t)(size + 1) < ZBROWSER_HTTP_CAPACITY) {
        document[size] = text[i];
        size = size + 1;
        i = i + 1;
    }
    document[size] = 0;
    return size;
}

int append_buffer_to_document(uint8_t *document, int size, const uint8_t *text, int text_size) {
    int i;

    i = 0;
    while (i < text_size && (uint32_t)(size + 1) < ZBROWSER_HTTP_CAPACITY) {
        document[size] = text[i];
        size = size + 1;
        i = i + 1;
    }
    document[size] = 0;
    return size;
}

int inline_external_stylesheets(uint8_t *html, int size) {
    uint8_t *css_buffer;
    struct NetHttpInfo info;
    uint32_t pos;
    uint32_t original_size;
    uint32_t count;
    int css_size;

    if (zbrowser_css_buffer_addr == 0 || size <= 0) {
        return size;
    }
    css_buffer = (uint8_t *)zbrowser_css_buffer_addr;
    html[size] = 0;
    original_size = (uint32_t)size;
    pos = 0;
    count = 0;
    while (pos < original_size && html[pos] != 0 && count < 8) {
        if (html[pos] == 60 &&
            zb_tag_name_is(html, pos, "link") != 0 &&
            zb_is_closing_tag(html, pos) == 0 &&
            zb_attr_value(html, pos, "rel", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
            text_contains_ci(zbrowser_attr, "stylesheet") != 0 &&
            zb_attr_value(html, pos, "href", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
            make_absolute_url(zbrowser_url, zbrowser_attr, zbrowser_css_url, ZBROWSER_URL_CAPACITY);
            if (zbrowser_css_url[0] != 0) {
                copy_text(zbrowser_status, 96, "fetching css");
                css_size = http_get_page_with_retry(zbrowser_css_url, css_buffer, ZBROWSER_CSS_CAPACITY - 1, &info);
                if (css_size > 0) {
                    css_buffer[css_size] = 0;
                    size = append_text_to_document(html, size, "\n<style>\n");
                    size = append_buffer_to_document(html, size, css_buffer, css_size);
                    size = append_text_to_document(html, size, "\n</style>\n");
                }
                count = count + 1;
            }
            pos = zb_skip_tag(html, pos);
        } else {
            pos = pos + 1;
        }
    }
    return size;
}

uint32_t js_skip_spaces(const uint8_t *text, uint32_t pos, uint32_t end) {
    while (pos < end &&
           (text[pos] == 32 || text[pos] == 9 || text[pos] == 10 || text[pos] == 13)) {
        pos = pos + 1;
    }
    return pos;
}

int js_token_at(const uint8_t *text, uint32_t pos, uint32_t end, const uint8_t *token) {
    uint32_t i;

    i = 0;
    while (token[i] != 0) {
        if (pos + i >= end || text[pos + i] != token[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

int js_copy_string_literal(const uint8_t *script,
                           uint32_t pos,
                           uint32_t end,
                           uint8_t *out,
                           uint32_t capacity,
                           uint32_t *after) {
    uint8_t quote;
    uint8_t ch;

    if (capacity == 0 || pos >= end) {
        return 0;
    }
    out[0] = 0;
    quote = script[pos];
    if (quote != 34 && quote != 39) {
        return 0;
    }
    pos = pos + 1;
    while (pos < end && script[pos] != 0 && script[pos] != quote) {
        ch = script[pos];
        if (ch == 92 && pos + 1 < end) {
            pos = pos + 1;
            ch = script[pos];
            if (ch == 110 || ch == 114 || ch == 116) {
                ch = 32;
            }
        }
        append_char_limited(out, capacity, ch);
        pos = pos + 1;
    }
    if (pos >= end || script[pos] != quote) {
        return 0;
    }
    *after = pos + 1;
    return 1;
}

int js_append_document_text(uint8_t *document, int size, const uint8_t *text) {
    if ((uint32_t)(size + 32) >= ZBROWSER_HTTP_CAPACITY) {
        zbrowser_doc_truncated = 1;
        return size;
    }
    size = append_text_to_document(document, size, "\n");
    size = append_text_to_document(document, size, text);
    size = append_text_to_document(document, size, "\n");
    zbrowser_js_writes = zbrowser_js_writes + 1;
    return size;
}

int zbrowser_execute_inline_script(uint8_t *document, int size, uint32_t script_start, uint32_t script_end) {
    uint32_t pos;
    uint32_t after;
    uint32_t wrote;

    pos = script_start;
    wrote = 0;
    while (pos < script_end && document[pos] != 0) {
        if (js_token_at(document, pos, script_end, "document.write") != 0) {
            pos = pos + 14;
            pos = js_skip_spaces(document, pos, script_end);
            if (pos < script_end && document[pos] == 40) {
                pos = js_skip_spaces(document, pos + 1, script_end);
                if (js_copy_string_literal(document,
                                           pos,
                                           script_end,
                                           zbrowser_js_literal,
                                           ZBROWSER_JS_LITERAL_CAPACITY,
                                           &after) != 0) {
                    size = js_append_document_text(document, size, zbrowser_js_literal);
                    wrote = 1;
                    pos = after;
                    continue;
                }
            }
        } else if (js_token_at(document, pos, script_end, "document.writeln") != 0) {
            pos = pos + 16;
            pos = js_skip_spaces(document, pos, script_end);
            if (pos < script_end && document[pos] == 40) {
                pos = js_skip_spaces(document, pos + 1, script_end);
                if (js_copy_string_literal(document,
                                           pos,
                                           script_end,
                                           zbrowser_js_literal,
                                           ZBROWSER_JS_LITERAL_CAPACITY,
                                           &after) != 0) {
                    size = js_append_document_text(document, size, zbrowser_js_literal);
                    wrote = 1;
                    pos = after;
                    continue;
                }
            }
        } else if (js_token_at(document, pos, script_end, "document.body.innerHTML") != 0) {
            pos = pos + 23;
            pos = js_skip_spaces(document, pos, script_end);
            if (pos < script_end && document[pos] == 61) {
                pos = js_skip_spaces(document, pos + 1, script_end);
                if (js_copy_string_literal(document,
                                           pos,
                                           script_end,
                                           zbrowser_js_literal,
                                           ZBROWSER_JS_LITERAL_CAPACITY,
                                           &after) != 0) {
                    size = js_append_document_text(document, size, zbrowser_js_literal);
                    wrote = 1;
                    pos = after;
                    continue;
                }
            }
        } else if (js_token_at(document, pos, script_end, "document.title") != 0) {
            pos = pos + 14;
            pos = js_skip_spaces(document, pos, script_end);
            if (pos < script_end && document[pos] == 61) {
                pos = js_skip_spaces(document, pos + 1, script_end);
                if (js_copy_string_literal(document,
                                           pos,
                                           script_end,
                                           zbrowser_js_literal,
                                           ZBROWSER_JS_LITERAL_CAPACITY,
                                           &after) != 0) {
                    copy_text(zbrowser_status, 96, "js title ");
                    append_text_limited(zbrowser_status, 96, zbrowser_js_literal);
                    pos = after;
                    continue;
                }
            }
        }
        pos = pos + 1;
    }
    if (wrote != 0) {
        zbrowser_js_executed = zbrowser_js_executed + 1;
    }
    return size;
}

int zbrowser_process_inline_scripts(uint8_t *document, int size) {
    uint32_t pos;
    uint32_t original_size;
    uint32_t script_start;
    uint32_t script_end;

    if (size <= 0) {
        return size;
    }
    document[size] = 0;
    original_size = (uint32_t)size;
    pos = 0;
    while (pos < original_size && document[pos] != 0) {
        if (document[pos] == 60 &&
            zb_tag_name_is(document, pos, "script") != 0 &&
            zb_is_closing_tag(document, pos) == 0) {
            script_start = zb_skip_tag(document, pos);
            script_end = script_start;
            while (script_end < original_size &&
                   document[script_end] != 0 &&
                   !(document[script_end] == 60 &&
                     zb_is_closing_tag(document, script_end) != 0 &&
                     zb_tag_name_is(document, script_end, "script") != 0)) {
                script_end = script_end + 1;
            }
            size = zbrowser_execute_inline_script(document, size, script_start, script_end);
            pos = script_end;
        } else {
            pos = pos + 1;
        }
    }
    document[size] = 0;
    return size;
}

int link_stylesheet_media_ok(const uint8_t *html, uint32_t pos) {
    if (zb_attr_value(html, pos, "media", zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) == 0 ||
        zbrowser_css_property[0] == 0) {
        return 1;
    }
    if (text_contains_ci(zbrowser_css_property, "print") != 0 &&
        text_contains_ci(zbrowser_css_property, "screen") == 0 &&
        text_contains_ci(zbrowser_css_property, "all") == 0) {
        return 0;
    }
    return 1;
}

int next_external_stylesheet_url(const uint8_t *html,
                                 uint32_t start,
                                 uint8_t *out,
                                 uint32_t capacity,
                                 uint32_t *after) {
    uint32_t pos;

    if (capacity == 0) {
        return 0;
    }
    out[0] = 0;
    pos = start;
    while (html[pos] != 0) {
        if (html[pos] == 60 &&
            zb_tag_name_is(html, pos, "link") != 0 &&
            zb_is_closing_tag(html, pos) == 0 &&
            zb_attr_value(html, pos, "rel", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
            text_contains_ci(zbrowser_attr, "stylesheet") != 0 &&
            text_contains_ci(zbrowser_attr, "alternate") == 0 &&
            link_stylesheet_media_ok(html, pos) != 0 &&
            zb_attr_value(html, pos, "href", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
            make_absolute_url(zbrowser_url, zbrowser_attr, out, capacity);
            if (after != (uint32_t *)0) {
                *after = zb_skip_tag(html, pos);
            }
            if (out[0] != 0) {
                return 1;
            }
            return 0;
        }
        pos = pos + 1;
    }
    return 0;
}

int first_external_stylesheet_url(const uint8_t *html, uint8_t *out, uint32_t capacity) {
    uint32_t after;

    after = 0;
    return next_external_stylesheet_url(html, 0, out, capacity, &after);
}

void prepare_external_css_queue(const uint8_t *html) {
    zbrowser_css_scan_pos = 0;
    zbrowser_css_links_loaded = 0;
    zbrowser_css_url[0] = 0;
    if (next_external_stylesheet_url(html,
                                     0,
                                     zbrowser_css_url,
                                     ZBROWSER_URL_CAPACITY,
                                     &zbrowser_css_scan_pos) != 0) {
        zbrowser_css_load_done = 0;
    } else {
        zbrowser_css_load_done = 1;
    }
}

int is_ignored_href(const uint8_t *href) {
    if (href[0] == 0 || href[0] == 35) {
        return 1;
    }
    if (zb_starts_with(href, "javascript:") || zb_starts_with(href, "mailto:")) {
        return 1;
    }
    return 0;
}

uint8_t hex_digit(uint32_t value) {
    if (value < 10) {
        return (uint8_t)(48 + value);
    }
    return (uint8_t)(65 + value - 10);
}

void url_append_encoded(uint8_t *out, uint32_t capacity, const uint8_t *text) {
    uint32_t i;
    uint8_t ch;

    i = 0;
    while (text[i] != 0) {
        ch = text[i];
        if (ch == 32) {
            append_char_limited(out, capacity, 43);
        } else if ((ch >= 48 && ch <= 57) ||
                   (ch >= 65 && ch <= 90) ||
                   (ch >= 97 && ch <= 122) ||
                   ch == 45 ||
                   ch == 46 ||
                   ch == 95 ||
                   ch == 126) {
            append_char_limited(out, capacity, ch);
        } else {
            append_char_limited(out, capacity, 37);
            append_char_limited(out, capacity, hex_digit((uint32_t)(ch >> 4)));
            append_char_limited(out, capacity, hex_digit((uint32_t)(ch & 15)));
        }
        i = i + 1;
    }
}

void append_url_ref_from(uint8_t *out, uint32_t capacity, const uint8_t *text, uint32_t start) {
    uint32_t i;
    uint8_t ch;

    i = start;
    while (text[i] != 0) {
        ch = text[i];
        if (ch == 32) {
            append_text_limited(out, capacity, "%20");
        } else if (ch == 9 || ch == 10 || ch == 13) {
            append_text_limited(out, capacity, "%20");
        } else {
            append_char_limited(out, capacity, ch);
        }
        i = i + 1;
    }
}

void append_url_ref(uint8_t *out, uint32_t capacity, const uint8_t *text) {
    append_url_ref_from(out, capacity, text, 0);
}

void copy_url_ref(uint8_t *out, uint32_t capacity, const uint8_t *text) {
    if (capacity == 0) {
        return;
    }
    out[0] = 0;
    append_url_ref(out, capacity, text);
}

uint32_t url_query_or_fragment_start(const uint8_t *url) {
    uint32_t i;

    i = 0;
    while (url[i] != 0) {
        if (url[i] == 63 || url[i] == 35) {
            return i;
        }
        i = i + 1;
    }
    return i;
}

uint32_t url_fragment_start(const uint8_t *url) {
    uint32_t i;

    i = 0;
    while (url[i] != 0) {
        if (url[i] == 35) {
            return i;
        }
        i = i + 1;
    }
    return i;
}

void copy_url_prefix(uint8_t *out, uint32_t capacity, const uint8_t *text, uint32_t end) {
    uint32_t i;

    if (capacity == 0) {
        return;
    }
    i = 0;
    while (text[i] != 0 && i < end && i + 1 < capacity) {
        out[i] = text[i];
        i = i + 1;
    }
    out[i] = 0;
}

void pop_url_path_segment(uint8_t *url, uint32_t root_len) {
    uint32_t len;

    len = os_strlen(url);
    if (len == 0) {
        return;
    }
    if (len > root_len && url[len - 1] == 47) {
        len = len - 1;
    }
    while (len > root_len && url[len - 1] != 47) {
        len = len - 1;
    }
    url[len] = 0;
}

void make_search_url(const uint8_t *query, uint8_t *out, uint32_t capacity) {
    copy_text(out, capacity, "https://www.google.com/search?q=");
    url_append_encoded(out, capacity, query);
}

void make_absolute_url(const uint8_t *base, const uint8_t *href, uint8_t *out, uint32_t capacity) {
    uint32_t i;
    uint32_t scheme_len;
    uint32_t base_end;
    uint32_t origin_end;
    uint32_t prefix_end;
    uint32_t rel_start;

    if (capacity == 0) {
        return;
    }
    out[0] = 0;
    if (href[0] == 0) {
        return;
    }
    if (has_scheme(href) != 0) {
        copy_url_ref(out, capacity, href);
        return;
    }
    if (zb_starts_with(href, "//")) {
        if (zb_starts_with(base, "https://")) {
            copy_text(out, capacity, "https:");
        } else {
            copy_text(out, capacity, "http:");
        }
        append_url_ref(out, capacity, href);
        return;
    }

    scheme_len = 0;
    if (zb_starts_with(base, "https://")) {
        scheme_len = 8;
    } else if (zb_starts_with(base, "http://")) {
        scheme_len = 7;
    } else {
        copy_text(out, capacity, href);
        return;
    }

    base_end = url_query_or_fragment_start(base);
    origin_end = scheme_len;
    while (base[origin_end] != 0 &&
           origin_end < base_end &&
           base[origin_end] != 47) {
        origin_end = origin_end + 1;
    }

    if (href[0] == 35) {
        copy_url_prefix(out, capacity, base, url_fragment_start(base));
        append_url_ref(out, capacity, href);
        return;
    }
    if (href[0] == 63) {
        copy_url_prefix(out, capacity, base, base_end);
        append_url_ref(out, capacity, href);
        return;
    }
    if (href[0] == 47) {
        copy_url_prefix(out, capacity, base, origin_end);
        append_url_ref(out, capacity, href);
        return;
    }

    prefix_end = origin_end;
    if (base_end > origin_end) {
        prefix_end = origin_end;
        i = origin_end;
        while (i < base_end) {
            if (base[i] == 47) {
                prefix_end = i + 1;
            }
            i = i + 1;
        }
        if (base[base_end - 1] == 47) {
            prefix_end = base_end;
        }
    }

    copy_url_prefix(out, capacity, base, prefix_end);
    if (out[0] != 0 && out[os_strlen(out) - 1] != 47) {
        append_char_limited(out, capacity, 47);
    }

    rel_start = 0;
    while (href[rel_start] != 0) {
        if (href[rel_start] == 46 && href[rel_start + 1] == 47) {
            rel_start = rel_start + 2;
            continue;
        }
        if (href[rel_start] == 46 &&
            href[rel_start + 1] == 46 &&
            href[rel_start + 2] == 47) {
            pop_url_path_segment(out, origin_end);
            if (out[0] != 0 && out[os_strlen(out) - 1] != 47) {
                append_char_limited(out, capacity, 47);
            }
            rel_start = rel_start + 3;
            continue;
        }
        if (href[rel_start] == 46 && href[rel_start + 1] == 0) {
            return;
        }
        if (href[rel_start] == 46 &&
            href[rel_start + 1] == 46 &&
            href[rel_start + 2] == 0) {
            pop_url_path_segment(out, origin_end);
            if (out[0] != 0 && out[os_strlen(out) - 1] != 47) {
                append_char_limited(out, capacity, 47);
            }
            return;
        }
        break;
    }

    append_url_ref_from(out, capacity, href, rel_start);
}

void trim_text_end(uint8_t *text) {
    uint32_t len;

    len = os_strlen(text);
    while (len > 0 &&
           (text[len - 1] == 9 ||
            text[len - 1] == 10 ||
            text[len - 1] == 13 ||
            text[len - 1] == 32)) {
        len = len - 1;
        text[len] = 0;
    }
}

void append_url_char(uint8_t ch) {
    uint32_t len;

    len = os_strlen(zbrowser_url);
    if (len + 1 >= ZBROWSER_URL_CAPACITY) {
        return;
    }
    zbrowser_url[len] = ch;
    zbrowser_url[len + 1] = 0;
}

void backspace_url(void) {
    uint32_t len;

    len = os_strlen(zbrowser_url);
    if (len == 0) {
        return;
    }
    zbrowser_url[len - 1] = 0;
}

uint32_t article_x(void) {
    uint32_t w;
    uint32_t base;
    uint32_t full;
    uint32_t col;

    w = gfx_width();
    if (w > 900) {
        base = 28;
    } else if (w > 420) {
        base = 16;
    } else if (w > 180) {
        base = 10;
    } else {
        base = 6;
    }
    if (w <= 720 ||
        (zbrowser_layout_region != ZBROWSER_REGION_LEFT &&
         zbrowser_layout_region != ZBROWSER_REGION_RIGHT)) {
        return base;
    }
    full = w;
    if (w > base + base) {
        full = w - base - base;
    }
    if (full > 16) {
        col = (full - 16) / 2;
    } else {
        col = full / 2;
    }
    if (zbrowser_layout_region == ZBROWSER_REGION_RIGHT) {
        return base + col + 16;
    }
    return base;
}

uint32_t article_w(void) {
    uint32_t w;
    uint32_t x;
    uint32_t base;
    uint32_t full;

    w = gfx_width();
    x = article_x();
    if (w > 900) {
        base = 28;
    } else if (w > 420) {
        base = 16;
    } else if (w > 180) {
        base = 10;
    } else {
        base = 6;
    }
    if (w > 720 &&
        (zbrowser_layout_region == ZBROWSER_REGION_LEFT ||
         zbrowser_layout_region == ZBROWSER_REGION_RIGHT)) {
        full = w;
        if (w > base + base) {
            full = w - base - base;
        }
        if (full > 16) {
            return (full - 16) / 2;
        }
        return full / 2;
    }
    if (w > x + x) {
        return w - x - x;
    }
    return w;
}

uint32_t default_flow_content_x(void) {
    return article_x() + 10;
}

uint32_t default_flow_content_w(void) {
    uint32_t w;

    w = article_w();
    if (w > 20) {
        return w - 20;
    }
    return w;
}

uint32_t default_flow_box_x(void) {
    return article_x() + 4;
}

uint32_t default_flow_box_w(void) {
    uint32_t w;

    w = article_w();
    if (w > 8) {
        return w - 8;
    }
    return w;
}

uint32_t flow_content_x(void) {
    if (zbrowser_flow_w_px != 0) {
        return zbrowser_flow_x_px;
    }
    return default_flow_content_x();
}

uint32_t flow_content_w(void) {
    if (zbrowser_flow_w_px != 0) {
        return zbrowser_flow_w_px;
    }
    return default_flow_content_w();
}

uint32_t flow_box_x(void) {
    if (zbrowser_flow_box_w_px != 0) {
        return zbrowser_flow_box_x_px;
    }
    return default_flow_box_x();
}

uint32_t flow_box_w(void) {
    if (zbrowser_flow_box_w_px != 0) {
        return zbrowser_flow_box_w_px;
    }
    return default_flow_box_w();
}

void clear_flow_box(void) {
    zbrowser_flow_x_px = 0;
    zbrowser_flow_w_px = 0;
    zbrowser_flow_box_x_px = 0;
    zbrowser_flow_box_w_px = 0;
    zbrowser_flow_box_flags = 0;
    zbrowser_flow_box_border = 0;
}

uint32_t clamp_flow_width(uint32_t width, uint32_t max_width) {
    if (max_width == 0) {
        return 0;
    }
    if (width == 0 || width > max_width) {
        width = max_width;
    }
    if (width < 16 && max_width >= 16) {
        width = 16;
    }
    return width;
}

void draw_flow_decoration_at(uint32_t x,
                             uint32_t w,
                             uint32_t y,
                             uint32_t h,
                             uint32_t bg,
                             uint32_t flags) {
    uint32_t bg_bits;
    uint32_t border_bits;
    uint32_t right_x;

    if (w == 0 || h == 0) {
        return;
    }
    bg_bits = flags & ZBROWSER_FLOW_BOX_BG;
    border_bits = flags & ZBROWSER_FLOW_BOX_BORDER;
    if (bg_bits != 0 &&
        color_is_page_background(bg) == 0) {
        gfx_fill_rect(x, y, w, h, bg);
    }
    if (border_bits != 0) {
        gfx_fill_rect(x, y, 1, h, zbrowser_flow_draw_border);
        if (w > 1) {
            right_x = x + w - 1;
            gfx_fill_rect(right_x, y, 1, h, zbrowser_flow_draw_border);
        }
    }
}

void draw_current_flow_decoration(uint32_t y, uint32_t h, uint32_t bg) {
    uint32_t flags;
    uint32_t bg_bits;

    flags = zbrowser_flow_box_flags;
    if (zbrowser_bg_band_active != 0) {
        bg_bits = flags & ZBROWSER_FLOW_BOX_BG;
        if (bg_bits == 0) {
            flags = flags + ZBROWSER_FLOW_BOX_BG;
        }
    }
    zbrowser_flow_draw_border = zbrowser_flow_box_border;
    draw_flow_decoration_at(flow_box_x(),
                            flow_box_w(),
                            y,
                            h,
                            bg,
                            flags);
}

void draw_article_sidebar_hint(void) {
    return;
}

void draw_shell(void) {
    uint32_t w;
    uint32_t h;
    uint32_t ax;
    uint32_t aw;
    uint32_t address_bg;
    uint32_t address_w;
    uint32_t caret_x;

    w = gfx_width();
    h = gfx_height();
    ax = article_x();
    aw = article_w();
    address_bg = 0xf8f9fa;
    if (zbrowser_editing != 0) {
        address_bg = 0xeaf3ff;
    }
    if (zbrowser_scroll_light_redraw == 0 || zbrowser_page_bg_has_img != 0 || zbrowser_page_bg_color != 0xffffff) {
        gfx_fill_rect(0, 0, w, h, zbrowser_page_bg_color);
    }
    gfx_fill_rect(0, 0, w, 42, 0xffffff);
    gfx_fill_rect(0, 40, w, 1, 0xa2a9b1);
    draw_article_sidebar_hint();
    if (h > 64 && aw > 0) {
        if (zbrowser_page_bg_has_img != 0 || zbrowser_page_bg_color != 0xffffff) {
            gfx_fill_rect(ax, 42, aw, h - 62, zbrowser_page_bg_color);
        } else {
            gfx_fill_rect(ax, 42, aw, h - 62, 0xffffff);
        }
    }
    draw_text_at_pixel(8, 8, "Z Browser", 0x202122, 0xffffff);
    address_w = 32;
    if (w > 108) {
        address_w = w - 104;
    }
    gfx_fill_rect(88, 6, address_w, 24, address_bg);
    gfx_draw_rect(88, 6, address_w, 24, 0xa2a9b1);
    draw_text_at_pixel(96, 13, zbrowser_url, 0x202122, address_bg);
    draw_text_at_pixel(8, 28, "browser v1.3.0", 0x54595d, 0xffffff);
    if (zbrowser_editing != 0) {
        caret_x = 100;
        if (w > 20) {
            caret_x = w - 20;
        }
        draw_text_at_pixel(caret_x, 13, "_", 0x3366cc, address_bg);
    }
    if (h > 18) {
        gfx_fill_rect(0, h - 20, w, 20, 0xeaecf0);
        draw_text_at_pixel(8, h - 18, zbrowser_status, 0x54595d, 0xeaecf0);
    }
}

void draw_chrome_only(void) {
    uint32_t w;
    uint32_t h;
    uint32_t address_bg;
    uint32_t address_w;
    uint32_t caret_x;

    w = gfx_width();
    h = gfx_height();
    address_bg = 0xf8f9fa;
    if (zbrowser_editing != 0) {
        address_bg = 0xeaf3ff;
    }
    gfx_fill_rect(0, 0, w, 42, 0xffffff);
    gfx_fill_rect(0, 40, w, 1, 0xa2a9b1);
    draw_text_at_pixel(8, 8, "Z Browser", 0x202122, 0xffffff);
    address_w = 32;
    if (w > 108) {
        address_w = w - 104;
    }
    gfx_fill_rect(88, 6, address_w, 24, address_bg);
    gfx_draw_rect(88, 6, address_w, 24, 0xa2a9b1);
    draw_text_at_pixel(96, 13, zbrowser_url, 0x202122, address_bg);
    draw_text_at_pixel(8, 28, "browser v1.3.0", 0x54595d, 0xffffff);
    if (zbrowser_editing != 0) {
        caret_x = 100;
        if (w > 20) {
            caret_x = w - 20;
        }
        draw_text_at_pixel(caret_x, 13, "_", 0x3366cc, address_bg);
    }
    if (h > 18) {
        gfx_fill_rect(0, h - 20, w, 20, 0xeaecf0);
        draw_text_at_pixel(8, h - 18, zbrowser_status, 0x54595d, 0xeaecf0);
    }
}

uint32_t zbrowser_render_line_limit(void) {
    uint32_t visible;
    uint32_t h;

    if (zbrowser_scroll_band_render != 0) {
        return zbrowser_scroll_band_max_line + 2;
    }

    h = gfx_height();
    visible = 32;
    if (h > zbrowser_y + 24) {
        visible = (h - zbrowser_y - 24) / 12;
    }
    if (visible < 16) {
        visible = 16;
    }
    return zbrowser_scroll + visible + 64;
}

void reset_render_checkpoints(void) {
    zbrowser_render_checkpoint_count = 0;
}

void remember_render_checkpoint(uint32_t pos) {
    uint32_t index;

    if (zbrowser_line_no == 0) {
        return;
    }
    if (zbrowser_line_len != 0) {
        return;
    }
    if (zbrowser_line_no % ZBROWSER_RENDER_CHECKPOINT_STRIDE != 0) {
        return;
    }
    index = zbrowser_line_no / ZBROWSER_RENDER_CHECKPOINT_STRIDE;
    if (index >= ZBROWSER_RENDER_CHECKPOINTS) {
        return;
    }
    if (index < zbrowser_render_checkpoint_count &&
        zbrowser_render_checkpoint_pos[index] == pos) {
        return;
    }
    zbrowser_render_checkpoint_lines[index] = zbrowser_line_no;
    zbrowser_render_checkpoint_pos[index] = pos;
    zbrowser_render_checkpoint_fg[index] = zbrowser_text_fg;
    zbrowser_render_checkpoint_bg[index] = zbrowser_text_bg;
    zbrowser_render_checkpoint_bg_band[index] = zbrowser_bg_band_active;
    zbrowser_render_checkpoint_align[index] = zbrowser_text_align;
    zbrowser_render_checkpoint_indent[index] = zbrowser_content_indent_cols;
    zbrowser_render_checkpoint_stride[index] = zbrowser_line_stride;
    zbrowser_render_checkpoint_font_scale[index] = zbrowser_font_scale;
    zbrowser_render_checkpoint_transform[index] = zbrowser_text_transform;
    zbrowser_render_checkpoint_white_space[index] = zbrowser_white_space;
    zbrowser_render_checkpoint_bottom_space[index] = zbrowser_css_bottom_space;
    zbrowser_render_checkpoint_block_flow[index] = zbrowser_css_scope_block_flow;
    zbrowser_render_checkpoint_list_depth[index] = zbrowser_list_depth;
    zbrowser_render_checkpoint_flow_x[index] = zbrowser_flow_x_px;
    zbrowser_render_checkpoint_flow_w[index] = zbrowser_flow_w_px;
    zbrowser_render_checkpoint_flow_box_x[index] = zbrowser_flow_box_x_px;
    zbrowser_render_checkpoint_flow_box_w[index] = zbrowser_flow_box_w_px;
    zbrowser_render_checkpoint_flow_box_flags[index] = zbrowser_flow_box_flags;
    zbrowser_render_checkpoint_flow_box_border[index] = zbrowser_flow_box_border;
    if (index + 1 > zbrowser_render_checkpoint_count) {
        zbrowser_render_checkpoint_count = index + 1;
    }
}

int restore_render_checkpoint(uint32_t *pos) {
    uint32_t target;
    uint32_t index;

    if (pos == (uint32_t *)0 || zbrowser_scroll < ZBROWSER_RENDER_CHECKPOINT_STRIDE * 2) {
        return 0;
    }
    target = zbrowser_scroll - ZBROWSER_RENDER_CHECKPOINT_STRIDE;
    if (zbrowser_scroll_band_render != 0 &&
        zbrowser_scroll_band_min_line > ZBROWSER_RENDER_CHECKPOINT_STRIDE) {
        target = zbrowser_scroll_band_min_line - ZBROWSER_RENDER_CHECKPOINT_STRIDE;
    }
    index = target / ZBROWSER_RENDER_CHECKPOINT_STRIDE;
    while (index > 0) {
        if (index < zbrowser_render_checkpoint_count &&
            zbrowser_render_checkpoint_pos[index] != 0 &&
            zbrowser_render_checkpoint_lines[index] <= target) {
            *pos = zbrowser_render_checkpoint_pos[index];
            zbrowser_line_no = zbrowser_render_checkpoint_lines[index];
            zbrowser_text_fg = zbrowser_render_checkpoint_fg[index];
            zbrowser_text_bg = zbrowser_render_checkpoint_bg[index];
            zbrowser_bg_band_active = zbrowser_render_checkpoint_bg_band[index];
            zbrowser_text_align = zbrowser_render_checkpoint_align[index];
            zbrowser_content_indent_cols = zbrowser_render_checkpoint_indent[index];
            zbrowser_line_stride = zbrowser_render_checkpoint_stride[index];
            zbrowser_font_scale = zbrowser_render_checkpoint_font_scale[index];
            zbrowser_text_transform = zbrowser_render_checkpoint_transform[index];
            zbrowser_white_space = zbrowser_render_checkpoint_white_space[index];
            zbrowser_css_bottom_space = zbrowser_render_checkpoint_bottom_space[index];
            zbrowser_css_scope_block_flow = zbrowser_render_checkpoint_block_flow[index];
            zbrowser_list_depth = zbrowser_render_checkpoint_list_depth[index];
            zbrowser_flow_x_px = zbrowser_render_checkpoint_flow_x[index];
            zbrowser_flow_w_px = zbrowser_render_checkpoint_flow_w[index];
            zbrowser_flow_box_x_px = zbrowser_render_checkpoint_flow_box_x[index];
            zbrowser_flow_box_w_px = zbrowser_render_checkpoint_flow_box_w[index];
            zbrowser_flow_box_flags = zbrowser_render_checkpoint_flow_box_flags[index];
            zbrowser_flow_box_border = zbrowser_render_checkpoint_flow_box_border[index];
            zbrowser_style_stack_depth = 0;
            zbrowser_dom_stack_depth = 0;
            zbrowser_table_depth = 0;
            zbrowser_table_row_active = 0;
            zbrowser_table_cell_open = 0;
            return 1;
        }
        index = index - 1;
    }
    return 0;
}

int zbrowser_should_draw_line(uint32_t line) {
    if (zbrowser_scroll_band_render == 0) {
        return 1;
    }
    if (line < zbrowser_scroll_band_min_line || line > zbrowser_scroll_band_max_line) {
        return 0;
    }
    return 1;
}

uint32_t zbrowser_clamped_font_scale(uint32_t scale) {
    if (scale < 1) {
        return 1;
    }
    if (scale > 3) {
        return 3;
    }
    return scale;
}

uint32_t zbrowser_char_width_for_scale(uint32_t scale) {
    return 8 * zbrowser_clamped_font_scale(scale);
}

uint32_t zbrowser_line_height_for_scale(uint32_t scale) {
    return 12 * zbrowser_clamped_font_scale(scale);
}

uint32_t zbrowser_char_width(void) {
    return zbrowser_char_width_for_scale(zbrowser_font_scale);
}

uint32_t zbrowser_line_height(void) {
    return zbrowser_line_height_for_scale(zbrowser_font_scale);
}

uint32_t zbrowser_line_max_cols(void) {
    uint32_t aw;
    uint32_t max_cols;
    uint32_t char_w;

    aw = flow_content_w();
    char_w = zbrowser_char_width();
    if (char_w == 0) {
        char_w = 8;
    }
    max_cols = 18;
    if (aw > 8) {
        max_cols = aw / char_w;
    }
    if (max_cols >= ZBROWSER_LINE_CAPACITY) {
        max_cols = ZBROWSER_LINE_CAPACITY - 1;
    }
    if (max_cols < 4) {
        max_cols = 4;
    }
    return max_cols;
}

void draw_line_text_runs(uint32_t x, uint32_t y) {
    uint32_t start;
    uint32_t end;
    uint32_t i;
    uint32_t fg;
    uint32_t bg;
    uint32_t scale;
    uint32_t char_w;

    bg = text_bg_for_draw();
    scale = zbrowser_clamped_font_scale(zbrowser_font_scale);
    char_w = zbrowser_char_width_for_scale(scale);
    if (line_has_table_box(zbrowser_line_no) != 0) {
        bg = 0xffffffff;
    }
    start = 0;
    while (start < zbrowser_line_len) {
        fg = zbrowser_line_fg[start];
        end = start + 1;
        while (end < zbrowser_line_len && zbrowser_line_fg[end] == fg) {
            end = end + 1;
        }
        i = 0;
        while (start + i < end && i + 1 < ZBROWSER_LINE_CAPACITY) {
            zbrowser_line_segment[i] = zbrowser_line[start + i];
            i = i + 1;
        }
        zbrowser_line_segment[i] = 0;
        if (scale <= 1) {
            draw_text_at_pixel(x + start * char_w, y, zbrowser_line_segment, fg, bg);
        } else {
            draw_text_scaled_at_pixel(x + start * char_w, y, zbrowser_line_segment, fg, bg, scale);
        }
        start = end;
    }
}

int line_has_inline_control(uint32_t line) {
    uint32_t i;

    i = 0;
    while (i < zbrowser_inline_control_count) {
        if (zbrowser_inline_control_lines[i] == line) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

int line_has_link_record(uint32_t line) {
    uint32_t i;

    i = 0;
    while (i < zbrowser_link_count) {
        if (line >= zbrowser_link_lines[i] &&
            line <= zbrowser_link_end_lines[i]) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

uint8_t *line_cache_text_slot(uint32_t line) {
    return (uint8_t *)zbrowser_line_cache_addr + line * ZBROWSER_LINE_CACHE_COLS;
}

uint32_t *line_cache_fg_slot(uint32_t line) {
    return (uint32_t *)zbrowser_line_cache_fg_addr + line * ZBROWSER_LINE_CACHE_COLS;
}

int line_cache_can_store(uint32_t line, uint32_t had_inline) {
    if (zbrowser_line_cache_addr == 0 ||
        zbrowser_line_cache_fg_addr == 0 ||
        line >= ZBROWSER_LINE_CACHE_LINES ||
        zbrowser_line_len + 1 >= ZBROWSER_LINE_CACHE_COLS ||
        had_inline != 0 ||
        line_has_table_box(line) != 0) {
        return 0;
    }
    return 1;
}

void remember_line_cache(uint32_t line, uint32_t x, uint32_t had_inline) {
    uint8_t *slot;
    uint32_t *fg_slot;
    uint32_t i;

    if (line_cache_can_store(line, had_inline) == 0) {
        return;
    }

    slot = line_cache_text_slot(line);
    fg_slot = line_cache_fg_slot(line);
    i = 0;
    while (i < zbrowser_line_len) {
        slot[i] = zbrowser_line[i];
        fg_slot[i] = zbrowser_line_fg[i];
        i = i + 1;
    }
    slot[i] = 0;
    zbrowser_line_cache_valid[line] = 1;
    zbrowser_line_cache_len[line] = zbrowser_line_len;
    zbrowser_line_cache_x[line] = x;
    zbrowser_line_cache_scale[line] = zbrowser_clamped_font_scale(zbrowser_font_scale);
    if (zbrowser_line_len == 0) {
        zbrowser_line_cache_fg[line] = zbrowser_text_fg;
    } else {
        zbrowser_line_cache_fg[line] = zbrowser_line_fg[0];
    }
    zbrowser_line_cache_bg[line] = text_bg_for_draw();
    zbrowser_line_cache_bg_band[line] = zbrowser_bg_band_active;
    zbrowser_line_cache_box_x[line] = flow_box_x();
    zbrowser_line_cache_box_w[line] = flow_box_w();
    zbrowser_line_cache_box_flags[line] = zbrowser_flow_box_flags;
    zbrowser_line_cache_box_border[line] = zbrowser_flow_box_border;
}

void remember_blank_line_cache(uint32_t line) {
    uint8_t *slot;

    if (zbrowser_line_cache_addr == 0 ||
        zbrowser_line_cache_fg_addr == 0 ||
        line >= ZBROWSER_LINE_CACHE_LINES) {
        return;
    }
    slot = line_cache_text_slot(line);
    slot[0] = 0;
    zbrowser_line_cache_valid[line] = 1;
    zbrowser_line_cache_len[line] = 0;
    zbrowser_line_cache_x[line] = flow_content_x();
    zbrowser_line_cache_scale[line] = zbrowser_clamped_font_scale(zbrowser_font_scale);
    zbrowser_line_cache_fg[line] = zbrowser_text_fg;
    zbrowser_line_cache_bg[line] = text_bg_for_draw();
    zbrowser_line_cache_bg_band[line] = zbrowser_bg_band_active;
    zbrowser_line_cache_box_x[line] = flow_box_x();
    zbrowser_line_cache_box_w[line] = flow_box_w();
    zbrowser_line_cache_box_flags[line] = zbrowser_flow_box_flags;
    zbrowser_line_cache_box_border[line] = zbrowser_flow_box_border;
}

void set_link_rect_exact(uint32_t index,
                         uint32_t x,
                         uint32_t y,
                         uint32_t width,
                         uint32_t height) {
    if (index >= zbrowser_link_count || width == 0 || height == 0) {
        return;
    }
    zbrowser_link_x[index] = x;
    zbrowser_link_y[index] = y;
    zbrowser_link_w[index] = width;
    zbrowser_link_h[index] = height;
}

void draw_cached_line_links(uint32_t line, uint32_t x, uint32_t y, uint32_t len, uint32_t scale) {
    uint32_t i;
    uint32_t seg_start;
    uint32_t seg_end;
    uint32_t char_w;
    uint32_t line_h;

    char_w = zbrowser_char_width_for_scale(scale);
    line_h = zbrowser_line_height_for_scale(scale);
    i = 0;
    while (i < zbrowser_link_count) {
        if (line >= zbrowser_link_lines[i] &&
            line <= zbrowser_link_end_lines[i]) {
            seg_start = 0;
            seg_end = len;
            if (line == zbrowser_link_lines[i]) {
                seg_start = zbrowser_link_start_cols[i];
            }
            if (line == zbrowser_link_end_lines[i]) {
                seg_end = zbrowser_link_end_cols[i];
            }
            if (seg_end > len) {
                seg_end = len;
            }
            if (seg_end > seg_start) {
                set_link_rect_exact(i,
                                    x + seg_start * char_w,
                                    y,
                                    (seg_end - seg_start) * char_w,
                                    line_h);
                gfx_fill_rect(x + seg_start * char_w,
                              y + line_h - 2,
                              (seg_end - seg_start) * char_w,
                              1,
                              zbrowser_link_text);
            }
        }
        i = i + 1;
    }
}

int draw_cached_line(uint32_t line) {
    uint8_t *slot;
    uint32_t *fg_slot;
    uint32_t draw_y;
    uint32_t start;
    uint32_t end;
    uint32_t i;
    uint32_t fg;
    uint32_t len;
    uint32_t scale;
    uint32_t char_w;
    uint32_t line_h;
    uint32_t box_flags;
    uint32_t box_bg_bits;

    if (line < zbrowser_scroll) {
        return 1;
    }
    if (line >= ZBROWSER_LINE_CACHE_LINES ||
        zbrowser_line_cache_addr == 0 ||
        zbrowser_line_cache_fg_addr == 0 ||
        zbrowser_line_cache_valid[line] == 0) {
        return 0;
    }
    scale = zbrowser_clamped_font_scale(zbrowser_line_cache_scale[line]);
    char_w = zbrowser_char_width_for_scale(scale);
    line_h = zbrowser_line_height_for_scale(scale);
    draw_y = zbrowser_y + (line - zbrowser_scroll) * 12;
    if (draw_y + line_h >= gfx_height()) {
        return 1;
    }
    len = zbrowser_line_cache_len[line];
    box_flags = zbrowser_line_cache_box_flags[line];
    box_bg_bits = box_flags & ZBROWSER_FLOW_BOX_BG;
    if (zbrowser_line_cache_bg_band[line] != 0 &&
        box_bg_bits == 0) {
        box_flags = box_flags + ZBROWSER_FLOW_BOX_BG;
    }
    if (len == 0) {
        if (box_flags != 0) {
            zbrowser_flow_draw_border = zbrowser_line_cache_box_border[line];
            draw_flow_decoration_at(zbrowser_line_cache_box_x[line],
                                    zbrowser_line_cache_box_w[line],
                                    draw_y,
                                    line_h,
                                    zbrowser_line_cache_bg[line],
                                    box_flags);
        }
        return 1;
    }

    if (box_flags != 0) {
        zbrowser_flow_draw_border = zbrowser_line_cache_box_border[line];
        draw_flow_decoration_at(zbrowser_line_cache_box_x[line],
                                zbrowser_line_cache_box_w[line],
                                draw_y,
                                line_h,
                                zbrowser_line_cache_bg[line],
                                box_flags);
    }
    slot = line_cache_text_slot(line);
    fg_slot = line_cache_fg_slot(line);
    start = 0;
    while (start < len) {
        fg = fg_slot[start];
        end = start + 1;
        while (end < len && fg_slot[end] == fg) {
            end = end + 1;
        }
        i = 0;
        while (start + i < end && i + 1 < ZBROWSER_LINE_CACHE_COLS) {
            zbrowser_line_segment[i] = slot[start + i];
            i = i + 1;
        }
        zbrowser_line_segment[i] = 0;
        if (scale <= 1) {
            draw_text_at_pixel(zbrowser_line_cache_x[line] + start * char_w,
                               draw_y,
                               zbrowser_line_segment,
                               fg,
                               zbrowser_line_cache_bg[line]);
        } else {
            draw_text_scaled_at_pixel(zbrowser_line_cache_x[line] + start * char_w,
                                      draw_y,
                                      zbrowser_line_segment,
                                      fg,
                                      zbrowser_line_cache_bg[line],
                                      scale);
        }
        start = end;
    }
    if (line_has_link_record(line) != 0) {
        draw_cached_line_links(line, zbrowser_line_cache_x[line], draw_y, len, scale);
    }
    return 1;
}

void draw_table_boxes_on_line(uint32_t line,
                              uint32_t line_x,
                              uint32_t line_y,
                              uint32_t phase) {
    uint32_t i;
    uint32_t box_x;
    uint32_t box_w;
    uint32_t box_h;

    box_h = 12;
    if (line_has_inline_control(line) != 0) {
        box_h = 20;
    }
    i = 0;
    while (i < zbrowser_table_box_count) {
        if (zbrowser_table_box_lines[i] == line) {
            box_x = line_x + zbrowser_table_box_cols[i] * 8;
            box_w = zbrowser_tbl_box_width_cols[i] * 8;
            if (box_w > 0) {
                if (phase == 0 &&
                    (zbrowser_table_box_flags[i] == ZBROWSER_TABLE_BOX_BG ||
                     zbrowser_table_box_flags[i] == ZBROWSER_TABLE_BOX_BG + ZBROWSER_TABLE_BOX_BORDER)) {
                    gfx_fill_rect(box_x, line_y, box_w, box_h, zbrowser_table_box_bg[i]);
                }
                if (phase != 0 &&
                    (zbrowser_table_box_flags[i] == ZBROWSER_TABLE_BOX_BORDER ||
                     zbrowser_table_box_flags[i] == ZBROWSER_TABLE_BOX_BG + ZBROWSER_TABLE_BOX_BORDER)) {
                    gfx_draw_rect(box_x, line_y, box_w, box_h, zbrowser_table_box_border[i]);
                }
            }
        }
        i = i + 1;
    }
}

void draw_inline_control_record(uint32_t index, uint32_t line_x, uint32_t line_y) {
    uint32_t type;
    uint32_t ref;
    uint32_t box_x;
    uint32_t box_y;
    uint32_t box_w;
    uint32_t box_h;
    uint32_t fill;
    uint8_t *label;
    uint8_t *value;

    if (index >= zbrowser_inline_control_count) {
        return;
    }
    type = zbrowser_inline_control_type[index];
    ref = zbrowser_inline_control_ref[index];
    box_x = line_x + zbrowser_inline_control_cols[index] * 8;
    box_y = line_y;
    box_w = zbrowser_inline_control_w[index];
    box_h = zbrowser_inline_control_h[index];

    if (type == ZBROWSER_INLINE_CONTROL_INPUT) {
        if (ref >= zbrowser_input_count) {
            return;
        }
        fill = 0xffffff;
        if (zbrowser_focused_input == ref) {
            fill = 0xeaf3ff;
        }
        gfx_fill_rect(box_x, box_y, box_w, box_h, fill);
        gfx_draw_rect(box_x, box_y, box_w, box_h, 0xa2a9b1);
        value = input_value_slot(ref);
        draw_text_at_pixel(box_x + 8, box_y + 6, value, 0x202122, fill);
        if (zbrowser_focused_input == ref) {
            draw_text_at_pixel(box_x + box_w - 16, box_y + 6, "_", 0x3366cc, fill);
        }
        zbrowser_input_x[ref] = box_x;
        zbrowser_input_y[ref] = box_y;
        zbrowser_input_w[ref] = box_w;
        zbrowser_input_h[ref] = box_h;
        return;
    }

    if (type == ZBROWSER_INLINE_CONTROL_BUTTON) {
        label = inline_control_label_slot(index);
        gfx_fill_rect(box_x, box_y, box_w, box_h, 0xeaecf0);
        gfx_draw_rect(box_x, box_y, box_w, box_h, 0xa2a9b1);
        draw_text_at_pixel(box_x + 10, box_y + 6, label, 0x202122, 0xeaecf0);
        if (zbrowser_submit_count < ZBROWSER_MAX_INPUTS) {
            zbrowser_submit_x[zbrowser_submit_count] = box_x;
            zbrowser_submit_y[zbrowser_submit_count] = box_y;
            zbrowser_submit_w[zbrowser_submit_count] = box_w;
            zbrowser_submit_h[zbrowser_submit_count] = box_h;
            zbrowser_submit_count = zbrowser_submit_count + 1;
        }
        return;
    }

    if (type == ZBROWSER_INLINE_CONTROL_SELECT) {
        label = inline_control_label_slot(index);
        gfx_fill_rect(box_x, box_y, box_w, box_h, 0xf8f9fa);
        gfx_draw_rect(box_x, box_y, box_w, box_h, 0xa2a9b1);
        draw_text_at_pixel(box_x + 8, box_y + 6, label, 0x202122, 0xf8f9fa);
        if (box_w > 32) {
            draw_text_at_pixel(box_x + box_w - 20, box_y + 6, "v", 0x3366cc, 0xf8f9fa);
        }
    }
}

void draw_inline_controls_on_line(uint32_t line, uint32_t line_x, uint32_t line_y) {
    uint32_t i;

    i = 0;
    while (i < zbrowser_inline_control_count) {
        if (zbrowser_inline_control_lines[i] == line) {
            draw_inline_control_record(i, line_x, line_y);
        }
        i = i + 1;
    }
}

void flush_line(void) {
    uint32_t h;
    uint32_t draw_y;
    uint32_t text_w;
    uint32_t x;
    uint32_t i;
    uint32_t seg_start;
    uint32_t seg_end;
    uint32_t had_inline;
    uint32_t char_w;
    uint32_t line_h;

    h = gfx_height();
    if (zbrowser_line_len == 0) {
        return;
    }
    had_inline = line_has_inline_control(zbrowser_line_no);
    zbrowser_line[zbrowser_line_len] = 0;
    char_w = zbrowser_char_width();
    line_h = zbrowser_line_height();
    x = flow_content_x();
    text_w = zbrowser_line_len * char_w;
    if (zbrowser_text_align == 1 && flow_content_w() > text_w) {
        x = flow_content_x() + (flow_content_w() - text_w) / 2;
    } else if (zbrowser_text_align == 2 && flow_content_w() > text_w) {
        x = flow_content_x() + flow_content_w() - text_w;
    }
    remember_line_cache(zbrowser_line_no, x, had_inline);
    if (zbrowser_line_no >= zbrowser_scroll && zbrowser_should_draw_line(zbrowser_line_no) != 0) {
        draw_y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
        if (draw_y + line_h < h) {
            if (zbrowser_bg_band_active != 0) {
                draw_line_background_band(draw_y, line_h, text_bg_for_draw());
            }
            draw_table_boxes_on_line(zbrowser_line_no, x, draw_y, 0);
            draw_line_text_runs(x, draw_y);
            i = 0;
            while (i < zbrowser_link_count) {
                if (zbrowser_line_no >= zbrowser_link_lines[i] &&
                    zbrowser_line_no <= zbrowser_link_end_lines[i]) {
                    seg_start = 0;
                    seg_end = zbrowser_line_len;
                    if (zbrowser_line_no == zbrowser_link_lines[i]) {
                        seg_start = zbrowser_link_start_cols[i];
                    }
                    if (zbrowser_line_no == zbrowser_link_end_lines[i]) {
                        seg_end = zbrowser_link_end_cols[i];
                    }
                    if (seg_end > seg_start) {
                        set_link_rect(i,
                                      x + seg_start * char_w,
                                      draw_y,
                                      (seg_end - seg_start) * char_w,
                                      line_h);
                        gfx_fill_rect(x + seg_start * char_w,
                                      draw_y + line_h - 2,
                                      (seg_end - seg_start) * char_w,
                                      1,
                                      zbrowser_link_text);
                    }
                }
                i = i + 1;
            }
            draw_inline_controls_on_line(zbrowser_line_no, x, draw_y);
            draw_table_boxes_on_line(zbrowser_line_no, x, draw_y, 1);
        }
    }
    zbrowser_line_len = 0;
    zbrowser_line[0] = 0;
    zbrowser_line_fg[0] = zbrowser_text_fg;
    zbrowser_last_space = 0;
    if (had_inline != 0) {
        zbrowser_line_no = zbrowser_line_no + 2;
    } else if (zbrowser_line_stride > 1) {
        zbrowser_line_no = zbrowser_line_no + zbrowser_line_stride;
    } else {
        zbrowser_line_no = zbrowser_line_no + 1;
    }
}

void save_region_line(void) {
    if (zbrowser_layout_region == ZBROWSER_REGION_LEFT) {
        zbrowser_left_line_no = zbrowser_line_no;
        return;
    }
    if (zbrowser_layout_region == ZBROWSER_REGION_RIGHT) {
        zbrowser_right_line_no = zbrowser_line_no;
        return;
    }
    zbrowser_article_line_no = zbrowser_line_no;
}

void load_region_line(void) {
    if (zbrowser_layout_region == ZBROWSER_REGION_LEFT) {
        if (zbrowser_column_mode != 0) {
            if (zbrowser_left_line_no < zbrowser_column_start_line) {
                zbrowser_left_line_no = zbrowser_column_start_line;
            }
        } else if (zbrowser_left_line_no < zbrowser_article_line_no) {
            zbrowser_left_line_no = zbrowser_article_line_no;
        }
        zbrowser_line_no = zbrowser_left_line_no;
        return;
    }
    if (zbrowser_layout_region == ZBROWSER_REGION_RIGHT) {
        if (zbrowser_column_mode != 0) {
            if (zbrowser_right_line_no < zbrowser_column_start_line) {
                zbrowser_right_line_no = zbrowser_column_start_line;
            }
        } else if (zbrowser_right_line_no < zbrowser_article_line_no) {
            zbrowser_right_line_no = zbrowser_article_line_no;
        }
        zbrowser_line_no = zbrowser_right_line_no;
        return;
    }
    zbrowser_line_no = zbrowser_article_line_no;
}

void sync_article_line_to_regions(void) {
    if (zbrowser_article_line_no < zbrowser_left_line_no) {
        zbrowser_article_line_no = zbrowser_left_line_no;
    }
    if (zbrowser_article_line_no < zbrowser_right_line_no) {
        zbrowser_article_line_no = zbrowser_right_line_no;
    }
}

void set_region(uint32_t region) {
    if (zbrowser_layout_region == region) {
        return;
    }
    flush_line();
    save_region_line();
    if (region == ZBROWSER_REGION_ARTICLE) {
        sync_article_line_to_regions();
    }
    zbrowser_layout_region = region;
    load_region_line();
    zbrowser_last_space = 0;
}

int tag_is_column_container(const uint8_t *html, uint32_t pos) {
    if (gfx_width() <= 720) {
        return 0;
    }
    if (tag_id_contains(html, pos, "spalten") != 0 ||
        tag_class_contains(html, pos, "columns") != 0 ||
        tag_class_contains(html, pos, "column-layout") != 0) {
        return 1;
    }
    if (load_web_style(html, pos) != 0 &&
        web_style_has_flag(WEB_STYLE_FLAG_DISPLAY_FLEX) != 0 &&
        tag_is_site_chrome(html, pos) == 0) {
        return 1;
    }
    return 0;
}

int tag_is_left_column(const uint8_t *html, uint32_t pos) {
    if (tag_id_contains(html, pos, "links") != 0 ||
        tag_id_contains(html, pos, "left") != 0 ||
        tag_class_contains(html, pos, "column-left") != 0 ||
        tag_class_contains(html, pos, "left-column") != 0 ||
        tag_class_contains(html, pos, "mp-left") != 0) {
        return 1;
    }
    if (style_property_has(html, pos, "float", "left") != 0) {
        return 1;
    }
    if (load_web_style(html, pos) != 0 &&
        zbrowser_web_style_float == WEB_STYLE_FLOAT_LEFT) {
        return 1;
    }
    return 0;
}

int tag_is_right_column(const uint8_t *html, uint32_t pos) {
    if (tag_id_contains(html, pos, "rechts") != 0 ||
        tag_id_contains(html, pos, "right") != 0 ||
        tag_class_contains(html, pos, "column-right") != 0 ||
        tag_class_contains(html, pos, "right-column") != 0 ||
        tag_class_contains(html, pos, "mp-right") != 0) {
        return 1;
    }
    if (style_property_has(html, pos, "float", "right") != 0) {
        return 1;
    }
    if (load_web_style(html, pos) != 0 &&
        zbrowser_web_style_float == WEB_STYLE_FLOAT_RIGHT) {
        return 1;
    }
    return 0;
}

void apply_layout(const uint8_t *html, uint32_t pos) {
    if (tag_is_column_container(html, pos) != 0) {
        flush_line();
        zbrowser_column_mode = 1;
        zbrowser_column_start_line = zbrowser_line_no;
        zbrowser_left_line_no = zbrowser_column_start_line;
        zbrowser_right_line_no = zbrowser_column_start_line;
        return;
    }
    if (gfx_width() > 720) {
        if (zbrowser_column_mode != 0 && tag_is_left_column(html, pos) != 0) {
            set_region(ZBROWSER_REGION_LEFT);
            return;
        }
        if (zbrowser_column_mode != 0 && tag_is_right_column(html, pos) != 0) {
            set_region(ZBROWSER_REGION_RIGHT);
            return;
        }
        if (zbrowser_column_mode == 0 && tag_is_right(html, pos) != 0) {
            set_region(ZBROWSER_REGION_RIGHT);
            return;
        }
    }
}

void reset_layout(const uint8_t *html, uint32_t pos) {
    return;
}

uint32_t register_link(const uint8_t *href) {
    uint8_t *slot;
    uint32_t index;

    if (zbrowser_links_addr == 0 || zbrowser_link_count >= ZBROWSER_MAX_LINKS) {
        return 9999;
    }
    if (is_ignored_href(href) != 0) {
        return 9999;
    }
    index = zbrowser_link_count;
    slot = (uint8_t *)zbrowser_links_addr + index * ZBROWSER_LINK_CAPACITY;
    make_absolute_url(zbrowser_url, href, slot, ZBROWSER_LINK_CAPACITY);
    if (slot[0] == 0) {
        return 9999;
    }
    zbrowser_link_lines[index] = zbrowser_line_no;
    zbrowser_link_end_lines[index] = zbrowser_line_no;
    zbrowser_link_start_cols[index] = zbrowser_line_len;
    zbrowser_link_end_cols[index] = zbrowser_line_len;
    zbrowser_link_x[index] = 0;
    zbrowser_link_y[index] = 0;
    zbrowser_link_w[index] = 0;
    zbrowser_link_h[index] = 0;
    zbrowser_link_count = zbrowser_link_count + 1;
    return index;
}

void set_link_rect(uint32_t index,
                   uint32_t x,
                   uint32_t y,
                   uint32_t width,
                   uint32_t height) {
    uint32_t left;
    uint32_t top;
    uint32_t right;
    uint32_t bottom;
    uint32_t old_right;
    uint32_t old_bottom;

    if (index >= zbrowser_link_count) {
        return;
    }
    if (width == 0 || height == 0) {
        return;
    }
    if (zbrowser_link_w[index] == 0 || zbrowser_link_h[index] == 0) {
        zbrowser_link_x[index] = x;
        zbrowser_link_y[index] = y;
        zbrowser_link_w[index] = width;
        zbrowser_link_h[index] = height;
        return;
    }

    left = zbrowser_link_x[index];
    top = zbrowser_link_y[index];
    right = x + width;
    bottom = y + height;
    old_right = zbrowser_link_x[index] + zbrowser_link_w[index];
    old_bottom = zbrowser_link_y[index] + zbrowser_link_h[index];

    if (x < left) {
        left = x;
    }
    if (y < top) {
        top = y;
    }
    if (old_right > right) {
        right = old_right;
    }
    if (old_bottom > bottom) {
        bottom = old_bottom;
    }

    zbrowser_link_x[index] = left;
    zbrowser_link_y[index] = top;
    zbrowser_link_w[index] = right - left;
    zbrowser_link_h[index] = bottom - top;
}

uint32_t register_input(const uint8_t *name, const uint8_t *value) {
    uint8_t *slot_name;
    uint8_t *slot_value;
    uint32_t index;

    if (zbrowser_input_count >= ZBROWSER_MAX_INPUTS) {
        return 9999;
    }
    index = zbrowser_input_count;
    slot_name = input_name_slot(index);
    slot_value = input_value_slot(index);
    copy_text(slot_name, ZBROWSER_INPUT_NAME_CAPACITY, name);
    if (!(zbrowser_focused_input == index && slot_value[0] != 0)) {
        copy_text(slot_value, ZBROWSER_INPUT_VALUE_CAPACITY, value);
    }
    zbrowser_input_lines[index] = zbrowser_line_no;
    zbrowser_input_x[index] = 0;
    zbrowser_input_y[index] = 0;
    zbrowser_input_w[index] = 0;
    zbrowser_input_h[index] = 0;
    zbrowser_input_count = zbrowser_input_count + 1;
    return index;
}

void emit_input_index(uint32_t index) {
    uint32_t digit;

    emit_text("[input ");
    if (index >= 10) {
        digit = 48 + (index / 10);
        emit_char((uint8_t)digit);
    }
    digit = 48 + (index % 10);
    emit_char((uint8_t)digit);
    emit_text(": ");
}

uint32_t control_x_for_width(uint32_t box_w) {
    uint32_t ax;
    uint32_t aw;

    ax = flow_content_x();
    aw = flow_content_w();
    if (aw <= box_w + 16) {
        return ax + 8;
    }
    if (zbrowser_text_align == 1) {
        return ax + ((aw - box_w) / 2);
    }
    if (zbrowser_text_align == 2) {
        return ax + aw - box_w - 8;
    }
    return ax + 8;
}

uint32_t input_control_width_for_tag(const uint8_t *html, uint32_t pos) {
    uint32_t width;
    uint32_t chars;
    uint32_t styled;
    uint32_t max_w;

    width = 180;
    if (zb_attr_value(html, pos, "size", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
        chars = css_length_value_px(zbrowser_attr, 0, 0);
        if (chars != 0) {
            if (chars < 4) {
                chars = 4;
            }
            if (chars > 80) {
                chars = 80;
            }
            width = chars * 8 + 24;
        }
    }
    styled = image_style_length(html, pos, "width", flow_content_w());
    if (styled != 0) {
        width = styled;
    }
    if (width > 460) {
        width = 460;
    }
    max_w = 96;
    if (flow_content_w() > 8) {
        max_w = flow_content_w();
    }
    if (width > max_w) {
        width = max_w;
    }
    if (width < 64) {
        width = 64;
    }
    return width;
}

uint32_t button_control_width_for_label(const uint8_t *label) {
    uint32_t width;
    uint32_t max_w;

    width = os_strlen(label) * 8 + 28;
    if (width < 72) {
        width = 72;
    }
    if (width > 240) {
        width = 240;
    }
    max_w = 96;
    if (flow_content_w() > 8) {
        max_w = flow_content_w();
    }
    if (width > max_w) {
        width = max_w;
    }
    return width;
}

uint32_t select_control_width_for_label(const uint8_t *label) {
    uint32_t width;
    uint32_t max_w;

    width = os_strlen(label) * 8 + 44;
    if (width < 120) {
        width = 120;
    }
    if (width > 320) {
        width = 320;
    }
    max_w = 96;
    if (flow_content_w() > 8) {
        max_w = flow_content_w();
    }
    if (width > max_w) {
        width = max_w;
    }
    return width;
}

void append_inline_space(void) {
    if (zbrowser_line_len + 1 >= ZBROWSER_LINE_CAPACITY) {
        return;
    }
    zbrowser_line[zbrowser_line_len] = 32;
    zbrowser_line_fg[zbrowser_line_len] = zbrowser_text_fg;
    zbrowser_line_len = zbrowser_line_len + 1;
}

uint32_t table_cols_from_px(uint32_t px, uint32_t max_cols) {
    uint32_t cols;

    if (px == 0) {
        return 0;
    }
    cols = (px + 7) / 8;
    if (cols == 0) {
        cols = 1;
    }
    if (cols > max_cols) {
        cols = max_cols;
    }
    return cols;
}

uint32_t table_attr_cols(const uint8_t *html,
                         uint32_t pos,
                         const uint8_t *attr,
                         uint32_t fallback,
                         uint32_t max_cols) {
    uint32_t px;
    uint32_t cols;

    if (zb_attr_value(html, pos, attr, zbrowser_attr, ZBROWSER_ATTR_CAPACITY) == 0) {
        return fallback;
    }
    px = css_length_value_px(zbrowser_attr, 0, 0);
    cols = table_cols_from_px(px, max_cols);
    return cols;
}

uint32_t table_cell_padding_cols_for_tag(const uint8_t *html,
                                         uint32_t pos,
                                         uint32_t fallback) {
    uint32_t px;
    uint32_t cols;

    if (style_length_px_prop(html, pos, "padding-left", flow_content_w(), &px) != 0 ||
        style_length_px_prop(html, pos, "padding", flow_content_w(), &px) != 0) {
        cols = table_cols_from_px(px, 4);
        return cols;
    }
    return fallback;
}

int table_style_has_visible_border(const uint8_t *html, uint32_t pos) {
    uint32_t px;

    if (load_web_style(html, pos) != 0) {
        if ((web_style_has_flag(WEB_STYLE_FLAG_HAS_BORDER) != 0 && zbrowser_web_border_l != 0) ||
            (web_style_has_flag(WEB_STYLE_FLAG_HAS_BORDER) != 0 && zbrowser_web_border_r != 0) ||
            (web_style_has_flag(WEB_STYLE_FLAG_HAS_BORDER) != 0 && zbrowser_web_border_t != 0) ||
            (web_style_has_flag(WEB_STYLE_FLAG_HAS_BORDER) != 0 && zbrowser_web_border_b != 0)) {
            return 1;
        }
    }
    if (zb_attr_value(html, pos, "border", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
        if (zbrowser_attr[0] == 0) {
            return 1;
        }
        px = css_length_value_px(zbrowser_attr, 0, 0);
        if (px != 0) {
            return 1;
        }
    }
    if (style_property_has(html, pos, "border", "solid") != 0 ||
        style_property_has(html, pos, "border", "1px") != 0 ||
        style_property_has(html, pos, "border", "#") != 0) {
        return 1;
    }
    return 0;
}

uint32_t table_border_color_for_tag(const uint8_t *html,
                                    uint32_t pos,
                                    uint32_t fallback) {
    uint32_t color;

    if (load_web_style(html, pos) != 0 &&
        web_style_has_flag(WEB_STYLE_FLAG_BORDER_COLOR) != 0) {
        return zbrowser_web_border_color;
    }
    if (style_property_value(html, pos, "border-color", zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_color_value(zbrowser_css_property, &color) != 0) {
        return color;
    }
    return fallback;
}

void register_table_box(uint32_t line,
                        uint32_t col,
                        uint32_t width_cols,
                        uint32_t bg,
                        uint32_t border,
                        uint32_t flags) {
    uint32_t index;

    if (zbrowser_table_box_count >= ZBROWSER_MAX_TABLE_BOXES) {
        return;
    }
    if (width_cols == 0) {
        return;
    }
    if (flags == 0) {
        return;
    }
    index = zbrowser_table_box_count;
    zbrowser_table_box_lines[index] = line;
    zbrowser_table_box_cols[index] = col;
    zbrowser_tbl_box_width_cols[index] = width_cols;
    zbrowser_table_box_bg[index] = bg;
    zbrowser_table_box_border[index] = border;
    zbrowser_table_box_flags[index] = flags;
    zbrowser_table_box_count = index + 1;
}

void shift_line_records_right(uint32_t start, uint32_t end, uint32_t shift) {
    uint32_t i;

    i = 0;
    while (i < zbrowser_link_count) {
        if (zbrowser_link_lines[i] == zbrowser_line_no &&
            zbrowser_link_start_cols[i] >= start &&
            zbrowser_link_start_cols[i] < end) {
            zbrowser_link_start_cols[i] = zbrowser_link_start_cols[i] + shift;
        }
        if (zbrowser_link_end_lines[i] == zbrowser_line_no &&
            zbrowser_link_end_cols[i] >= start &&
            zbrowser_link_end_cols[i] <= end) {
            zbrowser_link_end_cols[i] = zbrowser_link_end_cols[i] + shift;
        }
        i = i + 1;
    }

    i = 0;
    while (i < zbrowser_inline_control_count) {
        if (zbrowser_inline_control_lines[i] == zbrowser_line_no &&
            zbrowser_inline_control_cols[i] >= start &&
            zbrowser_inline_control_cols[i] < end) {
            zbrowser_inline_control_cols[i] = zbrowser_inline_control_cols[i] + shift;
        }
        i = i + 1;
    }
}

void shift_line_range_right(uint32_t start, uint32_t end, uint32_t shift) {
    uint32_t i;
    uint32_t clear;

    if (shift == 0 || end <= start) {
        return;
    }
    if (end + shift >= ZBROWSER_LINE_CAPACITY) {
        shift = ZBROWSER_LINE_CAPACITY - end - 1;
    }
    if (shift == 0) {
        return;
    }
    i = end;
    while (i > start) {
        i = i - 1;
        zbrowser_line[i + shift] = zbrowser_line[i];
        zbrowser_line_fg[i + shift] = zbrowser_line_fg[i];
    }
    clear = 0;
    while (clear < shift) {
        zbrowser_line[start + clear] = 32;
        zbrowser_line_fg[start + clear] = zbrowser_text_fg;
        clear = clear + 1;
    }
    shift_line_records_right(start, end, shift);
    if (zbrowser_line_len < end + shift) {
        zbrowser_line_len = end + shift;
    }
}

int emit_inline_control(uint32_t type,
                        uint32_t ref,
                        const uint8_t *label,
                        uint32_t width,
                        uint32_t height) {
    uint32_t max_cols;
    uint32_t cols;
    uint32_t gap;
    uint32_t index;
    uint32_t i;

    if (zbrowser_inline_control_count >= ZBROWSER_MAX_INLINE_CONTROLS) {
        return 0;
    }
    if (width < 16) {
        width = 16;
    }
    cols = (width + 7) / 8;
    if (cols < 2) {
        cols = 2;
    }
    max_cols = zbrowser_line_max_cols();
    if (cols + 1 >= max_cols) {
        cols = max_cols - 2;
        width = cols * 8;
    }
    gap = 0;
    if (zbrowser_line_len != 0) {
        gap = 1;
    }
    if (zbrowser_line_len + gap + cols >= max_cols) {
        flush_line();
        gap = 0;
    }
    if (gap != 0) {
        append_inline_space();
    }

    index = zbrowser_inline_control_count;
    zbrowser_inline_control_lines[index] = zbrowser_line_no;
    zbrowser_inline_control_cols[index] = zbrowser_line_len;
    zbrowser_inline_control_w[index] = width;
    zbrowser_inline_control_h[index] = height;
    zbrowser_inline_control_type[index] = type;
    zbrowser_inline_control_ref[index] = ref;
    copy_text(inline_control_label_slot(index), ZBROWSER_INLINE_LABEL_CAPACITY, label);
    zbrowser_inline_control_count = index + 1;

    i = 0;
    while (i < cols && zbrowser_line_len + 1 < ZBROWSER_LINE_CAPACITY) {
        append_inline_space();
        i = i + 1;
    }
    zbrowser_last_space = 0;
    return 1;
}

void draw_inline_input_control(const uint8_t *html,
                               uint32_t pos,
                               uint32_t index,
                               const uint8_t *value) {
    uint32_t width;

    width = input_control_width_for_tag(html, pos);
    if (emit_inline_control(ZBROWSER_INLINE_CONTROL_INPUT, index, "", width, 20) == 0) {
        draw_input_control(index, value);
        return;
    }
    zbrowser_input_lines[index] = zbrowser_line_no;
}

void draw_inline_button_control(const uint8_t *label) {
    uint32_t width;

    width = button_control_width_for_label(label);
    if (emit_inline_control(ZBROWSER_INLINE_CONTROL_BUTTON, 9999, label, width, 20) == 0) {
        draw_button_control(label);
    }
}

void draw_inline_select_control(const uint8_t *label) {
    uint32_t width;

    width = select_control_width_for_label(label);
    if (emit_inline_control(ZBROWSER_INLINE_CONTROL_SELECT, 9999, label, width, 20) == 0) {
        draw_select_control(label);
    }
}

uint32_t table_cell_target_cols_for_tag(const uint8_t *html, uint32_t pos) {
    uint32_t px;
    uint32_t cols;
    uint32_t colspan;
    uint32_t max_cols;
    uint32_t min_cols;

    cols = 16;
    if (zb_tag_name_is(html, pos, "th")) {
        cols = 18;
    }
    if (zbrowser_tbl_fixed_cell_cols != 0) {
        cols = zbrowser_tbl_fixed_cell_cols;
    }
    px = image_style_length(html, pos, "width", flow_content_w());
    if (px != 0) {
        cols = (px + 7) / 8;
    }
    if (zb_attr_value(html, pos, "colspan", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
        colspan = css_length_value_px(zbrowser_attr, 0, 1);
        if (colspan > 1 && colspan < ZBROWSER_TABLE_MAX_COLS) {
            cols = cols * colspan;
        }
    }
    min_cols = zbrowser_tbl_cell_pad_cols * 2 + 4;
    if (cols < min_cols) {
        cols = min_cols;
    }
    max_cols = zbrowser_line_max_cols();
    if (cols > max_cols - 2) {
        cols = max_cols - 2;
    }
    if (cols < 4) {
        cols = 4;
    }
    return cols;
}

void finish_table_cell(uint32_t add_gap) {
    uint32_t target;
    uint32_t max_cols;
    uint32_t inner_end;
    uint32_t content_start;
    uint32_t content_end;
    uint32_t shift;
    uint32_t gap;

    if (zbrowser_table_cell_open == 0) {
        return;
    }
    if (zbrowser_line_no == zbrowser_table_cell_line) {
        target = zbrowser_tbl_box_start_col + zbrowser_tbl_target_cols;
        max_cols = zbrowser_line_max_cols();
        if (target > max_cols - 1) {
            target = max_cols - 1;
        }
        inner_end = target;
        if (inner_end > zbrowser_tbl_cell_pad_cols) {
            inner_end = inner_end - zbrowser_tbl_cell_pad_cols;
        }
        content_start = zbrowser_tbl_cell_start_col;
        content_end = zbrowser_line_len;
        while (content_end > content_start && zbrowser_line[content_end - 1] == 32) {
            content_end = content_end - 1;
        }
        if (content_end > content_start && content_end <= inner_end) {
            shift = 0;
            if (zbrowser_tbl_cell_align == WEB_STYLE_ALIGN_RIGHT) {
                shift = inner_end - content_end;
            } else if (zbrowser_tbl_cell_align == WEB_STYLE_ALIGN_CENTER) {
                shift = (inner_end - content_end) / 2;
            }
            if (shift != 0) {
                shift_line_range_right(content_start, content_end, shift);
            }
        }
        while (zbrowser_line_len < target && zbrowser_line_len + 1 < ZBROWSER_LINE_CAPACITY) {
            append_inline_space();
        }
        if (add_gap != 0) {
            gap = 0;
            while (gap < zbrowser_tbl_cell_gap_cols &&
                   zbrowser_line_len + 1 < ZBROWSER_LINE_CAPACITY) {
                append_inline_space();
                gap = gap + 1;
            }
        }
    }
    zbrowser_table_cell_open = 0;
}

void start_table_cell(const uint8_t *html, uint32_t pos) {
    uint32_t pad;
    uint32_t bg;
    uint32_t border;
    uint32_t flags;

    if (zbrowser_table_depth == 0) {
        emit_text("  ");
        return;
    }
    if (zbrowser_table_row_active == 0) {
        zbrowser_table_row_active = 1;
        zbrowser_table_col = 0;
    }
    if (zbrowser_table_cell_open != 0) {
        finish_table_cell(1);
    } else if (zbrowser_table_col != 0 && zbrowser_line_len + 1 < ZBROWSER_LINE_CAPACITY) {
        append_inline_space();
    }
    zbrowser_table_cell_open = 1;
    zbrowser_table_cell_line = zbrowser_line_no;
    zbrowser_tbl_box_start_col = zbrowser_line_len;
    zbrowser_tbl_cell_pad_cols = table_cell_padding_cols_for_tag(html, pos, zbrowser_tbl_default_pad_cols);
    zbrowser_tbl_target_cols = table_cell_target_cols_for_tag(html, pos);
    zbrowser_tbl_cell_align = style_text_align(html, pos, zbrowser_text_align);
    if (zb_tag_name_is(html, pos, "th") && zbrowser_tbl_cell_align == WEB_STYLE_ALIGN_LEFT) {
        zbrowser_tbl_cell_align = WEB_STYLE_ALIGN_CENTER;
    }
    bg = style_background_color(html, pos, 0xffffffff);
    if (bg == 0xffffffff) {
        bg = zbrowser_table_bg_color;
    }
    if (bg == 0xffffffff && zb_tag_name_is(html, pos, "th")) {
        bg = 0xeaecf0;
    }
    border = table_border_color_for_tag(html, pos, zbrowser_table_border_color);
    flags = 0;
    if (bg != 0xffffffff) {
        flags = flags + ZBROWSER_TABLE_BOX_BG;
    }
    if (zbrowser_table_has_border != 0 ||
        table_style_has_visible_border(html, pos) != 0) {
        flags = flags + ZBROWSER_TABLE_BOX_BORDER;
    }
    register_table_box(zbrowser_table_cell_line,
                       zbrowser_tbl_box_start_col,
                       zbrowser_tbl_target_cols,
                       bg,
                       border,
                       flags);
    pad = 0;
    while (pad < zbrowser_tbl_cell_pad_cols &&
           zbrowser_line_len + 1 < ZBROWSER_LINE_CAPACITY) {
        append_inline_space();
        pad = pad + 1;
    }
    zbrowser_tbl_cell_start_col = zbrowser_line_len;
    zbrowser_table_col = zbrowser_table_col + 1;
}

void start_table_row(void) {
    if (zbrowser_table_depth == 0) {
        return;
    }
    finish_table_cell(0);
    flush_line();
    zbrowser_table_row_active = 1;
    zbrowser_table_col = 0;
    zbrowser_table_cell_open = 0;
}

void finish_table_row(void) {
    if (zbrowser_table_depth == 0) {
        return;
    }
    finish_table_cell(0);
    flush_line();
    zbrowser_table_row_active = 0;
    zbrowser_table_col = 0;
}

void start_table_layout(const uint8_t *html, uint32_t pos) {
    uint32_t color;

    finish_table_cell(0);
    flush_line();
    if (zbrowser_table_depth < 8) {
        zbrowser_table_depth = zbrowser_table_depth + 1;
    }
    zbrowser_table_row_active = 0;
    zbrowser_table_col = 0;
    zbrowser_table_cell_open = 0;
    zbrowser_tbl_box_start_col = 0;
    zbrowser_tbl_cell_start_col = 0;
    zbrowser_tbl_target_cols = 0;
    zbrowser_tbl_cell_align = WEB_STYLE_ALIGN_LEFT;
    zbrowser_tbl_cell_pad_cols = 0;
    zbrowser_tbl_default_pad_cols = 0;
    zbrowser_tbl_cell_gap_cols = 1;
    zbrowser_tbl_fixed_cell_cols = 0;
    zbrowser_table_has_border = table_style_has_visible_border(html, pos);
    zbrowser_table_border_color = table_border_color_for_tag(html, pos, 0xa2a9b1);
    zbrowser_table_bg_color = style_background_color(html, pos, 0xffffffff);
    zbrowser_tbl_default_pad_cols = table_attr_cols(html, pos, "cellpadding", zbrowser_tbl_default_pad_cols, 4);
    zbrowser_tbl_cell_pad_cols = zbrowser_tbl_default_pad_cols;
    zbrowser_tbl_cell_gap_cols = table_attr_cols(html, pos, "cellspacing", zbrowser_tbl_cell_gap_cols, 4);
    if (style_length_px_prop(html, pos, "border-spacing", flow_content_w(), &color) != 0) {
        zbrowser_tbl_cell_gap_cols = table_cols_from_px(color, 4);
    }
    if (load_web_style(html, pos) != 0) {
        if (zbrowser_web_border_collapse == WEB_STYLE_BORDER_COLLAPSE) {
            zbrowser_tbl_cell_gap_cols = 0;
            zbrowser_table_has_border = 1;
        } else if (zbrowser_web_border_spacing_h != 0) {
            zbrowser_tbl_cell_gap_cols = table_cols_from_px(zbrowser_web_border_spacing_h, 4);
        }
        if (zbrowser_web_table_layout == WEB_STYLE_TABLE_LAYOUT_FIXED &&
            zbrowser_web_style_width != 0) {
            zbrowser_tbl_fixed_cell_cols = table_cols_from_px(zbrowser_web_style_width / 4, zbrowser_line_max_cols());
        }
    }
}

void finish_table_layout(void) {
    finish_table_cell(0);
    flush_line();
    if (zbrowser_table_depth > 0) {
        zbrowser_table_depth = zbrowser_table_depth - 1;
    }
    zbrowser_table_row_active = 0;
    zbrowser_table_col = 0;
    zbrowser_table_cell_open = 0;
    if (zbrowser_table_depth == 0) {
        zbrowser_table_cell_line = 0;
        zbrowser_tbl_box_start_col = 0;
        zbrowser_tbl_cell_start_col = 0;
        zbrowser_tbl_target_cols = 0;
        zbrowser_tbl_cell_align = WEB_STYLE_ALIGN_LEFT;
        zbrowser_tbl_cell_pad_cols = 0;
        zbrowser_tbl_default_pad_cols = 0;
        zbrowser_tbl_cell_gap_cols = 1;
        zbrowser_tbl_fixed_cell_cols = 0;
        zbrowser_table_has_border = 0;
        zbrowser_table_border_color = 0xa2a9b1;
        zbrowser_table_bg_color = 0xffffffff;
    }
}

void draw_input_control(uint32_t index, const uint8_t *value) {
    uint32_t h;
    uint32_t w;
    uint32_t draw_y;
    uint32_t box_w;
    uint32_t box_x;
    uint32_t fill;

    h = gfx_height();
    w = gfx_width();
    if (zbrowser_line_no < zbrowser_scroll) {
        zbrowser_line_no = zbrowser_line_no + 2;
        return;
    }

    draw_y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
    if (draw_y + 22 >= h - 18) {
        zbrowser_line_no = zbrowser_line_no + 2;
        return;
    }

    box_w = 128;
    if (flow_content_w() > 8) {
        box_w = flow_content_w();
    }
    if (box_w > 360) {
        box_w = 360;
    }
    box_x = control_x_for_width(box_w);
    zbrowser_input_lines[index] = zbrowser_line_no;

    fill = 0xffffff;
    if (zbrowser_focused_input == index) {
        fill = 0xeaf3ff;
    }
    gfx_fill_rect(box_x, draw_y, box_w, 20, fill);
    gfx_draw_rect(box_x, draw_y, box_w, 20, 0xa2a9b1);
    draw_text_at_pixel(box_x + 8, draw_y + 6, value, 0x202122, fill);
    if (zbrowser_focused_input == index) {
        draw_text_at_pixel(box_x + box_w - 16, draw_y + 6, "_", 0x3366cc, fill);
    }
    zbrowser_input_x[index] = box_x;
    zbrowser_input_y[index] = draw_y;
    zbrowser_input_w[index] = box_w;
    zbrowser_input_h[index] = 20;
    zbrowser_line_no = zbrowser_line_no + 2;
}

void draw_button_control(const uint8_t *label) {
    uint32_t h;
    uint32_t w;
    uint32_t draw_y;
    uint32_t box_w;
    uint32_t box_x;

    flush_line();
    h = gfx_height();
    w = gfx_width();
    if (zbrowser_line_no < zbrowser_scroll) {
        zbrowser_line_no = zbrowser_line_no + 2;
        return;
    }

    draw_y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
    if (draw_y + 22 >= h - 18) {
        zbrowser_line_no = zbrowser_line_no + 2;
        return;
    }

    box_w = 96;
    if (os_strlen(label) * 8 + 28 > box_w) {
        box_w = os_strlen(label) * 8 + 28;
    }
    if (flow_content_w() > 8 && box_w > flow_content_w()) {
        box_w = flow_content_w();
    }
    box_x = control_x_for_width(box_w);
    gfx_fill_rect(box_x, draw_y, box_w, 20, 0xeaecf0);
    gfx_draw_rect(box_x, draw_y, box_w, 20, 0xa2a9b1);
    draw_text_at_pixel(box_x + 10, draw_y + 6, label, 0x202122, 0xeaecf0);
    if (zbrowser_submit_count < ZBROWSER_MAX_INPUTS) {
        zbrowser_submit_x[zbrowser_submit_count] = box_x;
        zbrowser_submit_y[zbrowser_submit_count] = draw_y;
        zbrowser_submit_w[zbrowser_submit_count] = box_w;
        zbrowser_submit_h[zbrowser_submit_count] = 20;
        zbrowser_submit_count = zbrowser_submit_count + 1;
    }
    zbrowser_line_no = zbrowser_line_no + 2;
}

void draw_select_control(const uint8_t *label) {
    uint32_t h;
    uint32_t w;
    uint32_t draw_y;
    uint32_t box_w;
    uint32_t box_x;

    flush_line();
    h = gfx_height();
    w = gfx_width();
    if (zbrowser_line_no < zbrowser_scroll) {
        zbrowser_line_no = zbrowser_line_no + 2;
        return;
    }

    draw_y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
    if (draw_y + 22 >= h - 18) {
        zbrowser_line_no = zbrowser_line_no + 2;
        return;
    }

    box_w = 160;
    if (flow_content_w() > 8) {
        box_w = flow_content_w();
    }
    if (box_w > 320) {
        box_w = 320;
    }
    box_x = control_x_for_width(box_w);
    gfx_fill_rect(box_x, draw_y, box_w, 20, 0xf8f9fa);
    gfx_draw_rect(box_x, draw_y, box_w, 20, 0xa2a9b1);
    draw_text_at_pixel(box_x + 8, draw_y + 6, label, 0x202122, 0xf8f9fa);
    if (box_w > 32) {
        draw_text_at_pixel(box_x + box_w - 20, draw_y + 6, "v", 0x3366cc, 0xf8f9fa);
    }
    zbrowser_line_no = zbrowser_line_no + 2;
}

void copy_plain_until_close_tag(const uint8_t *html,
                                uint32_t start,
                                const uint8_t *tag,
                                uint8_t *dst,
                                uint32_t capacity) {
    uint32_t pos;
    uint32_t advance;
    uint8_t ch;

    pos = start;
    dst[0] = 0;
    while (html[pos] != 0) {
        if (html[pos] == 60) {
            if (zb_is_closing_tag(html, pos) != 0 && zb_tag_name_is(html, pos, tag) != 0) {
                return;
            }
            pos = zb_skip_tag(html, pos);
        } else if (html[pos] == 38) {
            ch = zb_entity_char(html, pos, &advance);
            append_char_limited(dst, capacity, ch);
            pos = pos + advance;
        } else {
            append_char_limited(dst, capacity, html[pos]);
            pos = pos + 1;
        }
    }
}

int copy_first_option_label(const uint8_t *html, uint32_t start, uint8_t *dst, uint32_t capacity) {
    uint32_t pos;

    pos = start;
    dst[0] = 0;
    while (html[pos] != 0) {
        if (html[pos] == 60) {
            if (zb_is_closing_tag(html, pos) != 0 && zb_tag_name_is(html, pos, "select") != 0) {
                return 0;
            }
            if (zb_is_closing_tag(html, pos) == 0 && zb_tag_name_is(html, pos, "option") != 0) {
                copy_plain_until_close_tag(html, zb_skip_tag(html, pos), "option", dst, capacity);
                return 1;
            }
            pos = zb_skip_tag(html, pos);
        } else {
            pos = pos + 1;
        }
    }
    return 0;
}

void draw_image_placeholder(const uint8_t *src, const uint8_t *label) {
    uint32_t h;
    uint32_t draw_y;
    uint32_t link_index;

    flush_line();
    h = gfx_height();
    if (zbrowser_line_no < zbrowser_scroll) {
        zbrowser_line_no = zbrowser_line_no + 1;
        return;
    }
    draw_y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
    if (draw_y + 12 >= h - 18) {
        zbrowser_line_no = zbrowser_line_no + 1;
        return;
    }

    link_index = register_link(src);
    if (link_index != 9999) {
        draw_text_at_pixel(flow_content_x(), draw_y, label, zbrowser_link_text, text_bg_for_draw());
    } else {
        draw_text_at_pixel(flow_content_x(), draw_y, label, 0x54595d, text_bg_for_draw());
    }
    zbrowser_line_no = zbrowser_line_no + 1;
}

void draw_style_block_start(const uint8_t *html, uint32_t pos) {
    uint32_t border;
    uint32_t border_visible;
    uint32_t box_h;
    uint32_t box_w;
    uint32_t box_x;
    uint32_t bg;
    uint32_t h;
    uint32_t has_bg;
    uint32_t y;

    bg = style_background_color(html, pos, 0xffffffff);
    has_bg = 0;
    if (bg != 0xffffffff && color_is_page_background(bg) == 0) {
        has_bg = 1;
    }
    border = 0xa2a9b1;
    border_visible = 0;
    if (load_web_style(html, pos) != 0) {
        if ((web_style_has_flag(WEB_STYLE_FLAG_HAS_BORDER) != 0 && zbrowser_web_border_l != 0) ||
            (web_style_has_flag(WEB_STYLE_FLAG_HAS_BORDER) != 0 && zbrowser_web_border_r != 0) ||
            (web_style_has_flag(WEB_STYLE_FLAG_HAS_BORDER) != 0 && zbrowser_web_border_t != 0) ||
            (web_style_has_flag(WEB_STYLE_FLAG_HAS_BORDER) != 0 && zbrowser_web_border_b != 0)) {
            border_visible = 1;
            if (web_style_has_flag(WEB_STYLE_FLAG_BORDER_COLOR) != 0) {
                border = zbrowser_web_border_color;
            }
        }
    }
    if (border_visible == 0 && has_bg == 0) {
        return;
    }
    flush_line();
    h = gfx_height();
    if (flow_box_w() <= 4) {
        return;
    }
    box_x = flow_box_x();
    box_w = flow_box_w();
    box_h = 18;
    if (load_web_style(html, pos) != 0) {
        box_h = 12 + zbrowser_web_padding_t + zbrowser_web_padding_b;
        if (web_style_has_flag(WEB_STYLE_FLAG_HAS_HEIGHT) != 0 &&
            zbrowser_web_style_height > box_h) {
            box_h = zbrowser_web_style_height;
        }
        if (web_style_has_flag(WEB_STYLE_FLAG_HAS_MIN_HEIGHT) != 0 &&
            zbrowser_web_style_min_height > box_h) {
            box_h = zbrowser_web_style_min_height;
        }
    }
    if (box_h < 18) {
        box_h = 18;
    }
    if (box_h > 96) {
        box_h = 96;
    }
    if (zbrowser_line_no >= zbrowser_scroll) {
        y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
        if (y + box_h < h - 18) {
            if (has_bg != 0) {
                gfx_fill_rect(box_x, y, box_w, box_h, bg);
            }
            if (border_visible != 0) {
                gfx_draw_rect(box_x, y, box_w, box_h, border);
            }
        }
    }
}

int tag_may_draw_style_block(const uint8_t *html, uint32_t pos) {
    if (zb_tag_name_is(html, pos, "div") ||
        zb_tag_name_is(html, pos, "section") ||
        zb_tag_name_is(html, pos, "article") ||
        zb_tag_name_is(html, pos, "header") ||
        zb_tag_name_is(html, pos, "footer") ||
        zb_tag_name_is(html, pos, "main") ||
        zb_tag_name_is(html, pos, "aside") ||
        zb_tag_name_is(html, pos, "nav") ||
        zb_tag_name_is(html, pos, "form") ||
        zb_tag_name_is(html, pos, "figure") ||
        zb_tag_name_is(html, pos, "figcaption") ||
        zb_tag_name_is(html, pos, "blockquote") ||
        zb_tag_name_is(html, pos, "pre") ||
        zb_tag_name_is(html, pos, "p") ||
        zb_tag_name_is(html, pos, "ul") ||
        zb_tag_name_is(html, pos, "ol") ||
        zb_tag_name_is(html, pos, "li") ||
        zb_tag_name_is(html, pos, "dl") ||
        zb_tag_name_is(html, pos, "dt") ||
        zb_tag_name_is(html, pos, "dd")) {
        return 1;
    }
    if (load_web_style(html, pos) != 0 &&
        (zbrowser_web_style_display == WEB_STYLE_DISPLAY_BLOCK ||
         zbrowser_web_style_display == WEB_STYLE_DISPLAY_FLEX ||
         zbrowser_web_style_display == WEB_STYLE_DISPLAY_LIST_ITEM)) {
        return 1;
    }
    return 0;
}

void draw_semantic_block_start(const uint8_t *html, uint32_t pos) {
    uint32_t bg;
    uint32_t border;
    uint32_t h;
    uint32_t panel_h;
    uint32_t y;
    uint32_t w;

    bg = 0;
    border = 0;
    panel_h = 18;
    if (tag_class_contains(html, pos, "infobox") ||
        tag_class_contains(html, pos, "sidebar")) {
        bg = 0xf8f9fa;
        border = 0xa2a9b1;
        panel_h = 36;
    } else if (tag_class_contains(html, pos, "infobox-title") ||
               tag_class_contains(html, pos, "infobox-above")) {
        bg = 0xeaecf0;
        border = 0xa2a9b1;
        panel_h = 24;
    } else if (tag_class_contains(html, pos, "hatnote") ||
               tag_class_contains(html, pos, "shortdescription")) {
        bg = 0xf8f9fa;
        border = 0xc8ccd1;
        panel_h = 24;
    } else if (tag_class_contains(html, pos, "ambox") ||
               tag_class_contains(html, pos, "notice") ||
               tag_class_contains(html, pos, "warning")) {
        bg = 0xfff3cd;
        border = 0xc8ccd1;
        panel_h = 30;
    } else if (tag_class_contains(html, pos, "toc")) {
        bg = 0xf8f9fa;
        border = 0xa2a9b1;
        panel_h = 30;
    } else if (tag_class_contains(html, pos, "navbox")) {
        bg = 0xeaecf0;
        border = 0xa2a9b1;
        panel_h = 24;
    } else if (tag_class_contains(html, pos, "thumb") ||
               tag_class_contains(html, pos, "gallery")) {
        bg = 0xf8f9fa;
        border = 0xc8ccd1;
        panel_h = 30;
    } else if (tag_is_site_chrome(html, pos) != 0) {
        bg = 0xf8f9fa;
        border = 0xeaecf0;
        panel_h = 24;
    }
    if (bg == 0) {
        return;
    }
    flush_line();
    h = gfx_height();
    w = gfx_width();
    if (zbrowser_line_no >= zbrowser_scroll) {
        y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
        if (y + panel_h < h - 18 && w > 24 && flow_box_w() > 12) {
            gfx_fill_rect(flow_box_x(), y, flow_box_w(), panel_h, bg);
            gfx_draw_rect(flow_box_x(), y, flow_box_w(), panel_h, border);
        }
    }
}

