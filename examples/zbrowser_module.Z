    uint32_t bg;
    uint32_t h;
    uint32_t y;
    uint32_t w;

    bg = style_background_color(html, pos, 0xffffff);
    if (bg == 0xffffff) {
        return;
    }
    flush_line();
    h = gfx_height();
    w = gfx_width();
    if (zbrowser_line_no >= zbrowser_scroll) {
        y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
        if (y + 18 < h - 18) {
            gfx_fill_rect(article_x() + 4, y, article_w() - 8, 18, bg);
            gfx_draw_rect(article_x() + 4, y, article_w() - 8, 18, 0xa2a9b1);
        }
    }
    zbrowser_line_no = zbrowser_line_no + 1;
}

void draw_semantic_block_start(const uint8_t *html, uint32_t pos) {
    uint32_t bg;
    uint32_t border;
    uint32_t h;
    uint32_t panel_h;
    uint32_t y;
    uint32_t w;

    bg = 0;
    border = 0;
    panel_h = 18;
    if (tag_class_contains(html, pos, "infobox") ||
        tag_class_contains(html, pos, "sidebar")) {
        bg = 0xf8f9fa;
        border = 0xa2a9b1;
        panel_h = 36;
    } else if (tag_class_contains(html, pos, "infobox-title") ||
               tag_class_contains(html, pos, "infobox-above")) {
        bg = 0xeaecf0;
        border = 0xa2a9b1;
        panel_h = 24;
    } else if (tag_class_contains(html, pos, "hatnote") ||
               tag_class_contains(html, pos, "shortdescription")) {
        bg = 0xf8f9fa;
        border = 0xc8ccd1;
        panel_h = 24;
    } else if (tag_class_contains(html, pos, "ambox") ||
               tag_class_contains(html, pos, "notice") ||
               tag_class_contains(html, pos, "warning")) {
        bg = 0xfff3cd;
        border = 0xc8ccd1;
        panel_h = 30;
    } else if (tag_class_contains(html, pos, "toc")) {
        bg = 0xf8f9fa;
        border = 0xa2a9b1;
        panel_h = 30;
    } else if (tag_class_contains(html, pos, "navbox")) {
        bg = 0xeaecf0;
        border = 0xa2a9b1;
        panel_h = 24;
    } else if (tag_class_contains(html, pos, "thumb") ||
               tag_class_contains(html, pos, "gallery")) {
        bg = 0xf8f9fa;
        border = 0xc8ccd1;
        panel_h = 30;
    } else if (tag_is_site_chrome(html, pos) != 0) {
        bg = 0xf8f9fa;
        border = 0xeaecf0;
        panel_h = 24;
    }
    if (bg == 0) {
        return;
    }
    flush_line();
    h = gfx_height();
    w = gfx_width();
    if (zbrowser_line_no >= zbrowser_scroll) {
        y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
        if (y + panel_h < h - 18 && w > 24 && article_w() > 24) {
            gfx_fill_rect(article_x() + 6, y, article_w() - 12, panel_h, bg);
            gfx_draw_rect(article_x() + 6, y, article_w() - 12, panel_h, border);
        }
    }
    if (panel_h <= 18) {
        zbrowser_line_no = zbrowser_line_no + 2;
    } else if (panel_h <= 24) {
        zbrowser_line_no = zbrowser_line_no + 2;
    } else if (panel_h <= 30) {
        zbrowser_line_no = zbrowser_line_no + 3;
    } else {
        zbrowser_line_no = zbrowser_line_no + 3;
    }
}

