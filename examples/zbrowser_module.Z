    if (zbrowser_line_cache_fg_addr != 0) {
        kfree((uint8_t *)zbrowser_line_cache_fg_addr);
        zbrowser_line_cache_fg_addr = 0;
    }
    print("zbrowser buffer alloc failed");
    return 0;
}
zbrowser_enabled = 1;
print("zbrowser module loaded");
return 0;
