copy_text(zbrowser_url, ZBROWSER_URL_CAPACITY, "");
copy_text(zbrowser_status, 96, "ready");
if (zbrowser_doc_buffer_addr == 0 || zbrowser_css_buffer_addr == 0 ||
    zbrowser_css_sel_addr == 0 || zbrowser_css_decl_addr == 0 ||
    zbrowser_image_buffer_addr == 0 || zbrowser_links_addr == 0 ||
    zbrowser_line_cache_addr == 0 || zbrowser_line_cache_fg_addr == 0) {
    copy_text(zbrowser_status, 96, "buffer alloc failed");
    if (zbrowser_doc_buffer_addr != 0) {
        kfree((uint8_t *)zbrowser_doc_buffer_addr);
        zbrowser_doc_buffer_addr = 0;
