        if (y + 18 < h - 18 && w > 24 && flow_box_w() > 16) {
            gfx_fill_rect(flow_box_x() + 4, y, flow_box_w() - 8, 17, 0xffffff);
            gfx_fill_rect(flow_box_x() + 4, y + 15, flow_box_w() - 8, 1, line_color);
        }
    }
}

void draw_rule_line(uint32_t color) {
