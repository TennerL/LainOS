    if (zbrowser_line_no >= zbrowser_scroll) {
        y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
        if (y + 24 < h - 18 && gfx_width() > 28 && flow_box_w() > 20) {
            gfx_fill_rect(flow_box_x() + 4, y, 4, 24, 0x3366cc);
            gfx_fill_rect(flow_box_x() + 8, y, flow_box_w() - 12, 24, 0xf8f9fa);
