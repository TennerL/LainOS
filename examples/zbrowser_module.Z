uint32_t style_text_align(const uint8_t *html, uint32_t pos, uint32_t fallback) {
    if (load_web_style(html, pos) != 0 &&
        web_style_has_flag(WEB_STYLE_FLAG_HAS_TEXT_ALIGN) != 0) {
        return zbrowser_web_style_text_align;
    }
    if (zb_attr_value(html, pos, "align", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
        if (text_contains_ci(zbrowser_attr, "center") != 0) {
            return 1;
        }
        if (text_contains_ci(zbrowser_attr, "right") != 0) {
            return 2;
        }
    }
    if (zb_attr_value(html, pos, "style", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
        if (css_property_contains(zbrowser_attr, "text-align", "center") != 0) {
            return 1;
        }
        if (css_property_contains(zbrowser_attr, "text-align", "right") != 0) {
            return 2;
        }
    }
    if (stylesheet_property_for_tag(html, pos, "text-align", zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0) {
        if (text_contains_ci(zbrowser_css_property, "center") != 0) {
            return 1;
        }
        if (text_contains_ci(zbrowser_css_property, "right") != 0) {
            return 2;
        }
    }
    return fallback;
}

int style_property_value(const uint8_t *html,
                         uint32_t pos,
                         const uint8_t *property,
                         uint8_t *out,
                         uint32_t capacity) {
    if (capacity == 0) {
        return 0;
    }
    out[0] = 0;
    if (zb_attr_value(html, pos, "style", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_text_property_value(zbrowser_attr, property, out, capacity) != 0) {
        return 1;
    }
    if (stylesheet_property_for_tag(html, pos, property, out, capacity) != 0) {
        return 1;
    }
    return 0;
}

int style_property_has(const uint8_t *html,
                       uint32_t pos,
                       const uint8_t *property,
                       const uint8_t *needle) {
    if (style_property_value(html, pos, property, zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0 &&
        text_contains_ci(zbrowser_css_property, needle) != 0) {
        return 1;
    }
    return 0;
}

uint32_t css_length_value_px(const uint8_t *value, uint32_t base, uint32_t fallback) {
    uint32_t pos;
    uint32_t number;
    uint32_t saw_digit;

    pos = 0;
    while (value[pos] == 32 || value[pos] == 9 || value[pos] == 10 || value[pos] == 13) {
        pos = pos + 1;
    }
    number = 0;
    saw_digit = 0;
    while (value[pos] >= 48 && value[pos] <= 57) {
        saw_digit = 1;
        if (number < 100000) {
            number = number * 10 + (uint32_t)(value[pos] - 48);
        }
        pos = pos + 1;
    }
    if (saw_digit == 0) {
        return fallback;
    }
    while (value[pos] == 32 || value[pos] == 9 || value[pos] == 10 || value[pos] == 13) {
        pos = pos + 1;
    }
    if (value[pos] == 37) {
        return (uint32_t)(((uint64_t)base * number) / 100);
    }
    return number;
}

int css_length_px_parse(const uint8_t *value, uint32_t base, uint32_t *out_value) {
    uint32_t pos;
    uint32_t number;
    uint32_t saw_digit;

    pos = 0;
    while (value[pos] == 32 || value[pos] == 9 || value[pos] == 10 || value[pos] == 13) {
        pos = pos + 1;
    }
    number = 0;
    saw_digit = 0;
    while (value[pos] >= 48 && value[pos] <= 57) {
        saw_digit = 1;
        if (number < 100000) {
            number = number * 10 + (uint32_t)(value[pos] - 48);
        }
        pos = pos + 1;
    }
    if (saw_digit == 0) {
        return 0;
    }
    while (value[pos] == 32 || value[pos] == 9 || value[pos] == 10 || value[pos] == 13) {
        pos = pos + 1;
    }
    if (value[pos] == 37) {
        *out_value = (uint32_t)(((uint64_t)base * number) / 100);
        return 1;
    }
    *out_value = number;
    return 1;
}

int style_length_px_prop(const uint8_t *html,
                         uint32_t pos,
                         const uint8_t *property,
                         uint32_t base,
                         uint32_t *out_value) {
    if (style_property_value(html, pos, property, zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_length_px_parse(zbrowser_css_property, base, out_value) != 0) {
        return 1;
    }
    return 0;
}

uint32_t image_style_length(const uint8_t *html,
                            uint32_t pos,
                            const uint8_t *property,
                            uint32_t base) {
    uint32_t value;

    if (load_web_style(html, pos) != 0) {
        if (text_equal(property, "width") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_WIDTH) != 0) {
            return zbrowser_web_style_width;
        }
        if (text_equal(property, "height") != 0 &&
            web_style_has_flag(WEB_STYLE_FLAG_HAS_HEIGHT) != 0) {
            return zbrowser_web_style_height;
        }
    }
    if (zb_attr_value(html, pos, property, zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
        value = css_length_value_px(zbrowser_attr, base, 0);
        if (value != 0) {
            return value;
        }
    }
    if (zb_attr_value(html, pos, "style", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        css_text_property_value(zbrowser_attr, property, zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0) {
        value = css_length_value_px(zbrowser_css_property, base, 0);
        if (value != 0) {
            return value;
        }
    }
    if (stylesheet_property_for_tag(html, pos, property, zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0) {
        value = css_length_value_px(zbrowser_css_property, base, 0);
        if (value != 0) {
            return value;
        }
    }
    return 0;
}

void reset_css_position_box(void) {
    zbrowser_box_positioned = 0;
    zbrowser_box_from_anchor = 0;
    zbrowser_box_has_left = 0;
    zbrowser_box_left_px = 0;
    zbrowser_box_has_right = 0;
    zbrowser_box_right_px = 0;
    zbrowser_box_has_top = 0;
    zbrowser_box_top_px = 0;
    zbrowser_box_has_bottom = 0;
    zbrowser_box_bottom_px = 0;
    zbrowser_box_center_x = 0;
}

int tag_may_start_css_box(const uint8_t *html, uint32_t pos) {
    if (zb_tag_name_is(html, pos, "div") ||
        zb_tag_name_is(html, pos, "section") ||
        zb_tag_name_is(html, pos, "article") ||
        zb_tag_name_is(html, pos, "header") ||
        zb_tag_name_is(html, pos, "footer") ||
        zb_tag_name_is(html, pos, "aside") ||
        zb_tag_name_is(html, pos, "main") ||
        zb_tag_name_is(html, pos, "form") ||
        zb_tag_name_is(html, pos, "p") ||
        zb_tag_name_is(html, pos, "span") ||
        zb_tag_name_is(html, pos, "a")) {
        return 1;
    }
    return 0;
}

void apply_css_position_box(const uint8_t *html, uint32_t pos) {
    uint32_t value;

    if (tag_may_start_css_box(html, pos) == 0) {
        return;
    }
    if (load_web_style(html, pos) != 0 &&
        web_style_has_flag(WEB_STYLE_FLAG_HAS_POSITION) != 0 &&
        (zbrowser_web_style_position == WEB_STYLE_POS_ABSOLUTE ||
         zbrowser_web_style_position == WEB_STYLE_POS_FIXED)) {
        reset_css_position_box();
        zbrowser_box_positioned = 1;
        if (zb_tag_name_is(html, pos, "a") != 0) {
            zbrowser_box_from_anchor = 1;
        }
        if (web_style_has_flag(WEB_STYLE_FLAG_HAS_LEFT) != 0) {
            zbrowser_box_has_left = 1;
            zbrowser_box_left_px = zbrowser_web_style_left;
        }
        if (web_style_has_flag(WEB_STYLE_FLAG_HAS_RIGHT) != 0) {
            zbrowser_box_has_right = 1;
            zbrowser_box_right_px = zbrowser_web_style_right;
        }
        if (web_style_has_flag(WEB_STYLE_FLAG_HAS_TOP) != 0) {
            zbrowser_box_has_top = 1;
            zbrowser_box_top_px = zbrowser_web_style_top;
        }
        if (web_style_has_flag(WEB_STYLE_FLAG_HAS_BOTTOM) != 0) {
            zbrowser_box_has_bottom = 1;
            zbrowser_box_bottom_px = zbrowser_web_style_bottom;
        }
        if (web_style_has_flag(WEB_STYLE_FLAG_CENTER_X) != 0 ||
            (web_style_has_flag(WEB_STYLE_FLAG_HAS_LEFT) != 0 &&
             zbrowser_web_style_left > gfx_width() / 3 &&
             zbrowser_web_style_left < (gfx_width() * 2) / 3)) {
            zbrowser_box_center_x = 1;
        }
        return;
    }
    if (style_property_has(html, pos, "position", "absolute") == 0 &&
        style_property_has(html, pos, "position", "fixed") == 0) {
        return;
    }

    reset_css_position_box();
    zbrowser_box_positioned = 1;
    if (zb_tag_name_is(html, pos, "a") != 0) {
        zbrowser_box_from_anchor = 1;
    }
    if (style_length_px_prop(html, pos, "left", gfx_width(), &value) != 0) {
        zbrowser_box_has_left = 1;
        zbrowser_box_left_px = value;
    }
    if (style_length_px_prop(html, pos, "right", gfx_width(), &value) != 0) {
        zbrowser_box_has_right = 1;
        zbrowser_box_right_px = value;
    }
    if (style_length_px_prop(html, pos, "top", gfx_height(), &value) != 0) {
        zbrowser_box_has_top = 1;
        zbrowser_box_top_px = value;
    }
    if (style_length_px_prop(html, pos, "bottom", gfx_height(), &value) != 0) {
        zbrowser_box_has_bottom = 1;
        zbrowser_box_bottom_px = value;
    }
    if ((zbrowser_box_has_left != 0 && zbrowser_box_left_px > gfx_width() / 3 &&
         zbrowser_box_left_px < (gfx_width() * 2) / 3 &&
         style_property_has(html, pos, "transform", "translatex") != 0 &&
         style_property_has(html, pos, "transform", "-50") != 0) ||
        style_property_has(html, pos, "justify-content", "center") != 0) {
        zbrowser_box_center_x = 1;
    }
}

void close_css_position_box(const uint8_t *html, uint32_t pos) {
    if (zbrowser_box_positioned == 0) {
        return;
    }
    if (zbrowser_box_from_anchor != 0 && zb_tag_name_is(html, pos, "a") != 0) {
        reset_css_position_box();
        return;
    }
    if (zb_tag_name_is(html, pos, "div") ||
        zb_tag_name_is(html, pos, "section") ||
        zb_tag_name_is(html, pos, "article") ||
        zb_tag_name_is(html, pos, "header") ||
        zb_tag_name_is(html, pos, "footer") ||
        zb_tag_name_is(html, pos, "aside") ||
        zb_tag_name_is(html, pos, "main") ||
        zb_tag_name_is(html, pos, "form")) {
        reset_css_position_box();
    }
}

int image_should_center(const uint8_t *html, uint32_t pos) {
    if (load_web_style(html, pos) != 0 &&
        (web_style_has_flag(WEB_STYLE_FLAG_MARGIN_AUTO_X) != 0 ||
         web_style_has_flag(WEB_STYLE_FLAG_CENTER_X) != 0)) {
        return 1;
    }
    if (style_property_has(html, pos, "margin", "auto") != 0 ||
        style_property_has(html, pos, "margin-left", "auto") != 0 ||
        style_property_has(html, pos, "margin-right", "auto") != 0) {
        return 1;
    }
    return 0;
}

int tag_is_page_root(const uint8_t *html, uint32_t pos) {
    if (zb_tag_name_is(html, pos, "html") ||
        zb_tag_name_is(html, pos, "body")) {
        return 1;
    }
    return 0;
}

void reset_page_style(void) {
    zbrowser_page_bg_color = 0xffffff;
    zbrowser_page_text_fg = 0x202122;
    zbrowser_page_link_fg = 0x3366cc;
    zbrowser_page_text_align = 0;
    zbrowser_page_bg_has_img = 0;
    zbrowser_page_bg_url[0] = 0;
}

void prepare_page_style(const uint8_t *html) {
    uint32_t pos;
    uint32_t saw_body;
    uint32_t color;

    reset_page_style();
    pos = 0;
    saw_body = 0;
    while (html[pos] != 0) {
        if (html[pos] == 60 &&
            zb_is_closing_tag(html, pos) == 0 &&
            tag_is_page_root(html, pos) != 0) {
            zbrowser_page_text_fg = style_text_color(html, pos, zbrowser_page_text_fg);
            zbrowser_page_bg_color = style_background_color(html, pos, zbrowser_page_bg_color);
            zbrowser_page_text_align = style_text_align(html, pos, zbrowser_page_text_align);
            if (zb_tag_name_is(html, pos, "body")) {
                if (zb_attr_value(html, pos, "text", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
                    css_color_value(zbrowser_attr, &color) != 0) {
                    zbrowser_page_text_fg = color;
                }
                if (zb_attr_value(html, pos, "link", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
                    css_color_value(zbrowser_attr, &color) != 0) {
                    zbrowser_page_link_fg = color;
                }
            }
            if (style_background_image_url(html, pos, zbrowser_style_image_url, ZBROWSER_URL_CAPACITY) != 0 &&
                should_try_inline_image(zbrowser_style_image_url) != 0) {
                make_absolute_url(zbrowser_url, zbrowser_style_image_url, zbrowser_page_bg_url, ZBROWSER_URL_CAPACITY);
                if (zbrowser_page_bg_url[0] != 0) {
                    zbrowser_page_bg_has_img = 1;
                }
            }
            if (zb_tag_name_is(html, pos, "body")) {
                saw_body = 1;
            }
            if (saw_body != 0) {
                break;
            }
        }
        pos = pos + 1;
    }
    if (zbrowser_page_bg_has_img != 0 &&
        zbrowser_page_bg_color == 0xffffff &&
        zbrowser_page_text_fg == 0xffffff) {
        zbrowser_page_bg_color = 0x000000;
    }
}

uint32_t text_bg_for_draw(void) {
    if (zbrowser_page_bg_has_img != 0 &&
        zbrowser_text_bg == zbrowser_page_bg_color) {
        return 0xffffffff;
    }
    return zbrowser_text_bg;
}

void push_text_style(void) {
    uint32_t depth;

    depth = zbrowser_style_stack_depth;
    if (depth >= ZBROWSER_STYLE_STACK_MAX) {
        return;
    }
    zbrowser_style_stack_fg[depth] = zbrowser_text_fg;
    zbrowser_style_stack_bg[depth] = zbrowser_text_bg;
    zbrowser_style_stack_align[depth] = zbrowser_text_align;
    zbrowser_style_stack_depth = depth + 1;
}

void pop_text_style(void) {
    uint32_t depth;

    if (zbrowser_style_stack_depth == 0) {
        zbrowser_text_fg = zbrowser_page_text_fg;
        zbrowser_text_bg = zbrowser_page_bg_color;
        zbrowser_text_align = zbrowser_page_text_align;
        return;
    }
    depth = zbrowser_style_stack_depth - 1;
    zbrowser_style_stack_depth = depth;
    zbrowser_text_fg = zbrowser_style_stack_fg[depth];
    zbrowser_text_bg = zbrowser_style_stack_bg[depth];
    zbrowser_text_align = zbrowser_style_stack_align[depth];
}

int tag_is_site_chrome(const uint8_t *html, uint32_t pos) {
    if (zb_tag_name_is(html, pos, "nav") ||
        zb_tag_name_is(html, pos, "header") ||
        zb_tag_name_is(html, pos, "footer") ||
        zb_tag_name_is(html, pos, "aside")) {
        return 1;
    }
    if (tag_class_contains(html, pos, "site-header") ||
        tag_class_contains(html, pos, "site-footer") ||
        tag_class_contains(html, pos, "navbar") ||
        tag_class_contains(html, pos, "navigation") ||
        tag_id_contains(html, pos, "footer")) {
        return 1;
    }
    return 0;
}

int tag_is_right(const uint8_t *html, uint32_t pos) {
    if (tag_class_contains(html, pos, "infobox") ||
        tag_class_contains(html, pos, "sidebar") ||
        tag_class_contains(html, pos, "thumb") ||
        tag_class_contains(html, pos, "gallery")) {
        return 1;
    }
    return 0;
}

void apply_semantic_tag_style(const uint8_t *html, uint32_t pos) {
    if (zb_tag_name_is(html, pos, "center")) {
        zbrowser_text_align = 1;
        return;
    }
    if (zb_tag_name_is(html, pos, "a")) {
        if (style_has_text_color(html, pos) == 0) {
            zbrowser_text_fg = zbrowser_link_text;
        }
        return;
    }
    if (zb_tag_name_is(html, pos, "b") ||
        zb_tag_name_is(html, pos, "strong")) {
        zbrowser_text_fg = 0x000000;
        return;
    }
    if (zb_tag_name_is(html, pos, "i") ||
        zb_tag_name_is(html, pos, "em")) {
        zbrowser_text_fg = 0x54595d;
        return;
    }
    if (zb_tag_name_is(html, pos, "small")) {
        zbrowser_text_fg = 0x9aa7b2;
        return;
    }
    if (zb_tag_name_is(html, pos, "mark") ||
        tag_class_contains(html, pos, "highlight")) {
        zbrowser_text_fg = 0x202122;
        zbrowser_text_bg = 0xfff3cd;
        return;
    }
    if (zb_tag_name_is(html, pos, "code") ||
        zb_tag_name_is(html, pos, "pre")) {
        zbrowser_text_fg = 0x202122;
        zbrowser_text_bg = 0xf8f9fa;
        return;
    }
    if (zb_tag_name_is(html, pos, "blockquote") ||
        tag_class_contains(html, pos, "quotebox")) {
        zbrowser_text_fg = 0x202122;
        zbrowser_text_bg = 0xf8f9fa;
        return;
    }
    if (zb_tag_name_is(html, pos, "th")) {
        zbrowser_text_fg = 0x202122;
        zbrowser_text_bg = 0xeaecf0;
        return;
    }
    if (zb_attr_value(html, pos, "style", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
        if (css_property_contains(zbrowser_attr, "font-weight", "bold") != 0 ||
            css_property_contains(zbrowser_attr, "font-weight", "700") != 0) {
            zbrowser_text_fg = 0x000000;
        }
        if (css_property_contains(zbrowser_attr, "font-style", "italic") != 0) {
            zbrowser_text_fg = 0x54595d;
        }
    }
    if (tag_class_contains(html, pos, "hatnote") ||
        tag_class_contains(html, pos, "shortdescription") ||
        tag_class_contains(html, pos, "metadata")) {
        zbrowser_text_fg = 0x54595d;
        zbrowser_text_bg = 0xf8f9fa;
        return;
    }
    if (tag_class_contains(html, pos, "ambox") ||
        tag_class_contains(html, pos, "notice") ||
        tag_class_contains(html, pos, "warning")) {
        zbrowser_text_fg = 0x202122;
        zbrowser_text_bg = 0xfff3cd;
        return;
    }
    if (tag_class_contains(html, pos, "infobox-title") ||
        tag_class_contains(html, pos, "infobox-above")) {
        zbrowser_text_fg = 0x202122;
        zbrowser_text_bg = 0xeaecf0;
        zbrowser_text_align = 1;
        return;
    }
    if (tag_class_contains(html, pos, "infobox-caption") ||
        tag_class_contains(html, pos, "thumbcaption")) {
        zbrowser_text_fg = 0x54595d;
        zbrowser_text_bg = 0xf8f9fa;
        zbrowser_text_align = 1;
        return;
    }
    if (tag_class_contains(html, pos, "infobox") ||
        tag_class_contains(html, pos, "toc") ||
        tag_class_contains(html, pos, "thumb") ||
        tag_class_contains(html, pos, "navbox") ||
        tag_class_contains(html, pos, "sidebar")) {
        zbrowser_text_fg = 0x202122;
        zbrowser_text_bg = 0xf8f9fa;
        return;
    }
    if (tag_is_site_chrome(html, pos) != 0) {
        zbrowser_text_fg = 0x54595d;
        zbrowser_text_bg = 0xf8f9fa;
    }
}

int tag_hidden_from_style(const uint8_t *html, uint32_t pos) {
    if (zb_attr_value(html, pos, "hidden", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
        return 1;
    }
    if (zb_attr_value(html, pos, "aria-hidden", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        text_contains_ci(zbrowser_attr, "true") != 0) {
        return 1;
    }
    if (load_web_style(html, pos) != 0 &&
        (web_style_has_flag(WEB_STYLE_FLAG_DISPLAY_NONE) != 0 ||
         web_style_has_flag(WEB_STYLE_FLAG_VIS_HIDDEN) != 0)) {
        return 1;
    }
    if (zb_attr_value(html, pos, "style", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
        (text_contains_ci(zbrowser_attr, "display:none") != 0 ||
         text_contains_ci(zbrowser_attr, "display: none") != 0 ||
         text_contains_ci(zbrowser_attr, "visibility:hidden") != 0 ||
         text_contains_ci(zbrowser_attr, "visibility: hidden") != 0)) {
        return 1;
    }
    if (stylesheet_property_for_tag(html, pos, "display", zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0 &&
        text_contains_ci(zbrowser_css_property, "none") != 0) {
        return 1;
    }
    if (stylesheet_property_for_tag(html, pos, "visibility", zbrowser_css_property, ZBROWSER_ATTR_CAPACITY) != 0 &&
        text_contains_ci(zbrowser_css_property, "hidden") != 0) {
        return 1;
    }
    return 0;
}

int tag_should_skip_content(const uint8_t *html, uint32_t pos) {
    if (html[pos] == 0) {
        return 0;
    }
    if (tag_class_contains(html, pos, "printfooter") ||
        tag_class_contains(html, pos, "metadata") ||
        tag_class_contains(html, pos, "noprint") ||
        tag_class_contains(html, pos, "visually-hidden") ||
        tag_class_contains(html, pos, "sr-only")) {
        return 1;
    }
    return 0;
}

int has_scheme(const uint8_t *url) {
    if (zb_starts_with(url, "http://") || zb_starts_with(url, "https://")) {
        return 1;
    }
    return 0;
}

int looks_like_host(const uint8_t *text) {
    uint32_t i;

    i = 0;
    while (text[i] != 0 && text[i] != 47 && text[i] != 32) {
        if (text[i] == 46) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

void zbrowser_clear_http_diag(void) {
    zbrowser_http_status_code = 0;
    zbrowser_http_body_size = 0;
    zbrowser_http_content_length = 0;
    zbrowser_http_error = 0;
    zbrowser_tls_error = 0;
    zbrowser_http_content_type[0] = 0;
}

void zbrowser_capture_http_diag(int size, struct NetHttpInfo *info) {
    uint32_t status_code;
    uint32_t body_size;
    uint32_t content_length;

    zbrowser_http_error = size;
    status_code = info->status_code;
    body_size = info->body_size;
    content_length = info->content_length;
    zbrowser_http_status_code = status_code;
    zbrowser_http_body_size = body_size;
    zbrowser_http_content_length = content_length;
    zbrowser_tls_error = info->tls_error;
    zbrowser_http_content_type[0] = 0;
    if (size >= 0) {
        zbrowser_http_body_size = size;
    }
}

int starts_with_at(const uint8_t *text, uint32_t start, const uint8_t *prefix) {
    uint32_t i;

    i = 0;
    while (prefix[i] != 0) {
        if (text[start + i] != prefix[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

void set_http_error_status(const uint8_t *scheme_name, int size, struct NetHttpInfo *info) {
    if (size == -1) {
        copy_text(zbrowser_status, 96, "bad request");
    } else if (size == -2) {
        copy_text(zbrowser_status, 96, "bad url");
    } else if (size == -3) {
        copy_text(zbrowser_status, 96, "arp lookup failed");
    } else if (size == -4) {
        copy_text(zbrowser_status, 96, "tls send failed");
        if (zbrowser_tls_error != 0) {
            append_text_limited(zbrowser_status, 96, " ");
            append_uint_limited(zbrowser_status, 96, zbrowser_tls_error);
        } else {
            append_text_limited(zbrowser_status, 96, " err ");
            append_int_limited(zbrowser_status, 96, size);
        }
    } else if (size == -7) {
        copy_text(zbrowser_status, 96, "no network route");
    } else if (size == -9) {
        copy_text(zbrowser_status, 96, "https unavailable");
    } else if (size == -14) {
        copy_text(zbrowser_status, 96, "network busy");
    } else if (size == -8) {
        copy_text(zbrowser_status, 96, "dns lookup failed");
    } else if (size == -5) {
        copy_text(zbrowser_status, 96, "tcp connect failed");
    } else if (size == -6) {
        copy_text(zbrowser_status, 96, "http receive timed out");
    } else if (size == -10) {
        copy_text(zbrowser_status, 96, "tls handshake failed");
        if (zbrowser_tls_error != 0) {
            append_text_limited(zbrowser_status, 96, " tls ");
            append_uint_limited(zbrowser_status, 96, zbrowser_tls_error);
        }
    } else if (size == -11) {
        copy_text(zbrowser_status, 96, "network out of memory");
    } else if (size == -12) {
        copy_text(zbrowser_status, 96, "rtc time unavailable");
    } else if (size == -13) {
        copy_text(zbrowser_status, 96, "redirect unsupported");
    } else if (size == -15) {
        copy_text(zbrowser_status, 96, "content decode failed");
    } else if (info->status_code >= 400) {
        copy_text(zbrowser_status, 96, "http status error");
    } else {
        copy_text(zbrowser_status, 96, scheme_name);
        append_text_limited(zbrowser_status, 96, " failed");
    }
}

int http_get_page_with_retry(const uint8_t *url,
                             uint8_t *buffer,
                             uint32_t capacity,
                             struct NetHttpInfo *info) {
    int size;

    size = os_http_get_ex(url, buffer, capacity, info);
    if (zb_starts_with(url, "https://") != 0 &&
        (size == -4 || size == -6 || size == -10 || size == -14)) {
        copy_text(zbrowser_status, 96, "retrying https");
        size = os_http_get_ex(url, buffer, capacity, info);
    }
    return size;
}

int append_text_to_document(uint8_t *document, int size, const uint8_t *text) {
    uint32_t i;

    i = 0;
    while (text[i] != 0 && (uint32_t)(size + 1) < ZBROWSER_HTTP_CAPACITY) {
        document[size] = text[i];
        size = size + 1;
        i = i + 1;
    }
    document[size] = 0;
    return size;
}

int append_buffer_to_document(uint8_t *document, int size, const uint8_t *text, int text_size) {
    int i;

    i = 0;
    while (i < text_size && (uint32_t)(size + 1) < ZBROWSER_HTTP_CAPACITY) {
        document[size] = text[i];
        size = size + 1;
        i = i + 1;
    }
    document[size] = 0;
    return size;
}

int inline_external_stylesheets(uint8_t *html, int size) {
    uint8_t *css_buffer;
    struct NetHttpInfo info;
    uint32_t pos;
    uint32_t original_size;
    uint32_t count;
    int css_size;

    if (zbrowser_css_buffer_addr == 0 || size <= 0) {
        return size;
    }
    css_buffer = (uint8_t *)zbrowser_css_buffer_addr;
    html[size] = 0;
    original_size = (uint32_t)size;
    pos = 0;
    count = 0;
    while (pos < original_size && html[pos] != 0 && count < 4) {
        if (html[pos] == 60 &&
            zb_tag_name_is(html, pos, "link") != 0 &&
            zb_is_closing_tag(html, pos) == 0 &&
            zb_attr_value(html, pos, "rel", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
            text_contains_ci(zbrowser_attr, "stylesheet") != 0 &&
            zb_attr_value(html, pos, "href", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
            make_absolute_url(zbrowser_url, zbrowser_attr, zbrowser_css_url, ZBROWSER_URL_CAPACITY);
            if (zbrowser_css_url[0] != 0) {
                copy_text(zbrowser_status, 96, "fetching css");
                css_size = http_get_page_with_retry(zbrowser_css_url, css_buffer, ZBROWSER_CSS_CAPACITY - 1, &info);
                if (css_size > 0) {
                    css_buffer[css_size] = 0;
                    size = append_text_to_document(html, size, "\n<style>\n");
                    size = append_buffer_to_document(html, size, css_buffer, css_size);
                    size = append_text_to_document(html, size, "\n</style>\n");
                }
                count = count + 1;
            }
            pos = zb_skip_tag(html, pos);
        } else {
            pos = pos + 1;
        }
    }
    return size;
}

int first_external_stylesheet_url(const uint8_t *html, uint8_t *out, uint32_t capacity) {
    uint32_t pos;

    if (capacity == 0) {
        return 0;
    }
    out[0] = 0;
    pos = 0;
    while (html[pos] != 0) {
        if (html[pos] == 60 &&
            zb_tag_name_is(html, pos, "link") != 0 &&
            zb_is_closing_tag(html, pos) == 0 &&
            zb_attr_value(html, pos, "rel", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0 &&
            text_contains_ci(zbrowser_attr, "stylesheet") != 0 &&
            zb_attr_value(html, pos, "href", zbrowser_attr, ZBROWSER_ATTR_CAPACITY) != 0) {
            make_absolute_url(zbrowser_url, zbrowser_attr, out, capacity);
            if (out[0] != 0) {
                return 1;
            }
            return 0;
        }
        pos = pos + 1;
    }
    return 0;
}

int is_ignored_href(const uint8_t *href) {
    if (href[0] == 0 || href[0] == 35) {
        return 1;
    }
    if (zb_starts_with(href, "javascript:") || zb_starts_with(href, "mailto:")) {
        return 1;
    }
    return 0;
}

uint8_t hex_digit(uint32_t value) {
    if (value < 10) {
        return (uint8_t)(48 + value);
    }
    return (uint8_t)(65 + value - 10);
}

void url_append_encoded(uint8_t *out, uint32_t capacity, const uint8_t *text) {
    uint32_t i;
    uint8_t ch;

    i = 0;
    while (text[i] != 0) {
        ch = text[i];
        if (ch == 32) {
            append_char_limited(out, capacity, 43);
        } else if ((ch >= 48 && ch <= 57) ||
                   (ch >= 65 && ch <= 90) ||
                   (ch >= 97 && ch <= 122) ||
                   ch == 45 ||
                   ch == 46 ||
                   ch == 95 ||
                   ch == 126) {
            append_char_limited(out, capacity, ch);
        } else {
            append_char_limited(out, capacity, 37);
            append_char_limited(out, capacity, hex_digit((uint32_t)(ch >> 4)));
            append_char_limited(out, capacity, hex_digit((uint32_t)(ch & 15)));
        }
        i = i + 1;
    }
}

void append_url_ref_from(uint8_t *out, uint32_t capacity, const uint8_t *text, uint32_t start) {
    uint32_t i;
    uint8_t ch;

    i = start;
    while (text[i] != 0) {
        ch = text[i];
        if (ch == 32) {
            append_text_limited(out, capacity, "%20");
        } else if (ch == 9 || ch == 10 || ch == 13) {
            append_text_limited(out, capacity, "%20");
        } else {
            append_char_limited(out, capacity, ch);
        }
        i = i + 1;
    }
}

void append_url_ref(uint8_t *out, uint32_t capacity, const uint8_t *text) {
    append_url_ref_from(out, capacity, text, 0);
}

void copy_url_ref(uint8_t *out, uint32_t capacity, const uint8_t *text) {
    if (capacity == 0) {
        return;
    }
    out[0] = 0;
    append_url_ref(out, capacity, text);
}

void make_search_url(const uint8_t *query, uint8_t *out, uint32_t capacity) {
    copy_text(out, capacity, "https://www.google.com/search?q=");
    url_append_encoded(out, capacity, query);
}

void make_absolute_url(const uint8_t *base, const uint8_t *href, uint8_t *out, uint32_t capacity) {
    uint32_t i;
    uint32_t last_slash;
    uint32_t scheme_len;

    if (capacity == 0) {
        return;
    }
    out[0] = 0;
    if (href[0] == 0) {
        return;
    }
    if (has_scheme(href) != 0) {
        copy_url_ref(out, capacity, href);
        return;
    }
    if (zb_starts_with(href, "//")) {
        if (zb_starts_with(base, "https://")) {
            copy_text(out, capacity, "https:");
        } else {
            copy_text(out, capacity, "http:");
        }
        append_url_ref(out, capacity, href);
        return;
    }

    scheme_len = 0;
    if (zb_starts_with(base, "https://")) {
        scheme_len = 8;
    } else if (zb_starts_with(base, "http://")) {
        scheme_len = 7;
    } else {
        copy_text(out, capacity, href);
        return;
    }

    i = scheme_len;
    while (base[i] != 0 && base[i] != 47) {
        i = i + 1;
    }

    if (href[0] == 47) {
        last_slash = i;
    } else {
        last_slash = i;
        while (base[i] != 0) {
            if (base[i] == 47) {
                last_slash = i + 1;
            }
            i = i + 1;
        }
    }

    i = 0;
    while (base[i] != 0 && i < last_slash && i + 1 < capacity) {
        out[i] = base[i];
        i = i + 1;
    }
    out[i] = 0;
    if (href[0] == 47) {
        append_url_ref(out, capacity, href);
    } else {
        if (last_slash == scheme_len || base[last_slash - 1] != 47) {
            append_char_limited(out, capacity, 47);
        }
        if (href[0] == 46 && href[1] == 47) {
            append_url_ref_from(out, capacity, href, 2);
        } else {
            append_url_ref(out, capacity, href);
        }
    }
}

void trim_text_end(uint8_t *text) {
    uint32_t len;

    len = os_strlen(text);
    while (len > 0 &&
           (text[len - 1] == 9 ||
            text[len - 1] == 10 ||
            text[len - 1] == 13 ||
            text[len - 1] == 32)) {
        len = len - 1;
        text[len] = 0;
    }
}

void append_url_char(uint8_t ch) {
    uint32_t len;

    len = os_strlen(zbrowser_url);
    if (len + 1 >= ZBROWSER_URL_CAPACITY) {
        return;
    }
    zbrowser_url[len] = ch;
    zbrowser_url[len + 1] = 0;
}

void backspace_url(void) {
    uint32_t len;

    len = os_strlen(zbrowser_url);
    if (len == 0) {
        return;
    }
    zbrowser_url[len - 1] = 0;
}

uint32_t article_x(void) {
    uint32_t w;

    w = gfx_width();
    if (w > 900) {
        return 28;
    }
    if (w > 420) {
        return 16;
    }
    if (w > 180) {
        return 10;
    }
    return 6;
}

uint32_t article_w(void) {
    uint32_t w;
    uint32_t x;

    w = gfx_width();
    x = article_x();
    if (w > x + x) {
        return w - x - x;
    }
    return w;
}

void draw_article_sidebar_hint(void) {
    return;
}

void draw_shell(void) {
    uint32_t w;
    uint32_t h;
    uint32_t ax;
    uint32_t aw;
    uint32_t address_bg;
    uint32_t address_w;
    uint32_t caret_x;

    w = gfx_width();
    h = gfx_height();
    ax = article_x();
    aw = article_w();
    address_bg = 0xf8f9fa;
    if (zbrowser_editing != 0) {
        address_bg = 0xeaf3ff;
    }
    gfx_fill_rect(0, 0, w, h, zbrowser_page_bg_color);
    gfx_fill_rect(0, 0, w, 42, 0xffffff);
    gfx_fill_rect(0, 40, w, 1, 0xa2a9b1);
    draw_article_sidebar_hint();
    if (h > 64 && aw > 0) {
        if (zbrowser_page_bg_has_img != 0 || zbrowser_page_bg_color != 0xffffff) {
            gfx_fill_rect(ax, 42, aw, h - 62, zbrowser_page_bg_color);
        } else {
            gfx_fill_rect(ax, 42, aw, h - 62, 0xffffff);
        }
    }
    draw_text_at_pixel(8, 8, "Z Browser", 0x202122, 0xffffff);
    address_w = 32;
    if (w > 108) {
        address_w = w - 104;
    }
    gfx_fill_rect(88, 6, address_w, 24, address_bg);
    gfx_draw_rect(88, 6, address_w, 24, 0xa2a9b1);
    draw_text_at_pixel(96, 13, zbrowser_url, 0x202122, address_bg);
    draw_text_at_pixel(8, 28, "browser v1.2.0", 0x54595d, 0xffffff);
    if (zbrowser_editing != 0) {
        caret_x = 100;
        if (w > 20) {
            caret_x = w - 20;
        }
        draw_text_at_pixel(caret_x, 13, "_", 0x3366cc, address_bg);
    }
    if (h > 18) {
        gfx_fill_rect(0, h - 20, w, 20, 0xeaecf0);
        draw_text_at_pixel(8, h - 18, zbrowser_status, 0x54595d, 0xeaecf0);
    }
}

void draw_chrome_only(void) {
    uint32_t w;
    uint32_t h;
    uint32_t address_bg;
    uint32_t address_w;
    uint32_t caret_x;

    w = gfx_width();
    h = gfx_height();
    address_bg = 0xf8f9fa;
    if (zbrowser_editing != 0) {
        address_bg = 0xeaf3ff;
    }
    gfx_fill_rect(0, 0, w, 42, 0xffffff);
    gfx_fill_rect(0, 40, w, 1, 0xa2a9b1);
    draw_text_at_pixel(8, 8, "Z Browser", 0x202122, 0xffffff);
    address_w = 32;
    if (w > 108) {
        address_w = w - 104;
    }
    gfx_fill_rect(88, 6, address_w, 24, address_bg);
    gfx_draw_rect(88, 6, address_w, 24, 0xa2a9b1);
    draw_text_at_pixel(96, 13, zbrowser_url, 0x202122, address_bg);
    draw_text_at_pixel(8, 28, "browser v1.2.0", 0x54595d, 0xffffff);
    if (zbrowser_editing != 0) {
        caret_x = 100;
        if (w > 20) {
            caret_x = w - 20;
        }
        draw_text_at_pixel(caret_x, 13, "_", 0x3366cc, address_bg);
    }
    if (h > 18) {
        gfx_fill_rect(0, h - 20, w, 20, 0xeaecf0);
        draw_text_at_pixel(8, h - 18, zbrowser_status, 0x54595d, 0xeaecf0);
    }
}

uint32_t zbrowser_render_line_limit(void) {
    uint32_t visible;
    uint32_t h;

    h = gfx_height();
    visible = 32;
    if (h > zbrowser_y + 24) {
        visible = (h - zbrowser_y - 24) / 12;
    }
    if (visible < 16) {
        visible = 16;
    }
    return zbrowser_scroll + visible + 24;
}

void draw_line_text_runs(uint32_t x, uint32_t y) {
    uint32_t start;
    uint32_t end;
    uint32_t i;
    uint32_t fg;

    start = 0;
    while (start < zbrowser_line_len) {
        fg = zbrowser_line_fg[start];
        end = start + 1;
        while (end < zbrowser_line_len && zbrowser_line_fg[end] == fg) {
            end = end + 1;
        }
        i = 0;
        while (start + i < end && i + 1 < ZBROWSER_LINE_CAPACITY) {
            zbrowser_line_segment[i] = zbrowser_line[start + i];
            i = i + 1;
        }
        zbrowser_line_segment[i] = 0;
        draw_text_at_pixel(x + start * 8, y, zbrowser_line_segment, fg, text_bg_for_draw());
        start = end;
    }
}

void flush_line(void) {
    uint32_t h;
    uint32_t w;
    uint32_t draw_y;
    uint32_t text_w;
    uint32_t x;
    uint32_t i;
    uint32_t seg_start;
    uint32_t seg_end;

    h = gfx_height();
    if (zbrowser_line_len == 0) {
        return;
    }
    zbrowser_line[zbrowser_line_len] = 0;
    if (zbrowser_line_no >= zbrowser_scroll) {
        draw_y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
        if (draw_y + 12 < h) {
            w = gfx_width();
            x = article_x() + 10;
            text_w = zbrowser_line_len * 8;
            if (zbrowser_text_align == 1 && article_w() > text_w + 20) {
                x = article_x() + (article_w() - text_w) / 2;
            } else if (zbrowser_text_align == 2 && article_w() > text_w + 20) {
                x = article_x() + article_w() - text_w - 10;
            }
            draw_line_text_runs(x, draw_y);
            i = 0;
            while (i < zbrowser_link_count) {
                if (zbrowser_line_no >= zbrowser_link_lines[i] &&
                    zbrowser_line_no <= zbrowser_link_end_lines[i]) {
                    seg_start = 0;
                    seg_end = zbrowser_line_len;
                    if (zbrowser_line_no == zbrowser_link_lines[i]) {
                        seg_start = zbrowser_link_start_cols[i];
                    }
                    if (zbrowser_line_no == zbrowser_link_end_lines[i]) {
                        seg_end = zbrowser_link_end_cols[i];
                    }
                    if (seg_end > seg_start) {
                        set_link_rect(i,
                                      x + seg_start * 8,
                                      draw_y,
                                      (seg_end - seg_start) * 8,
                                      12);
                    }
                }
                i = i + 1;
            }
        }
    }
    zbrowser_line_len = 0;
    zbrowser_line[0] = 0;
    zbrowser_line_fg[0] = zbrowser_text_fg;
    zbrowser_last_space = 0;
    zbrowser_line_no = zbrowser_line_no + 1;
}

void save_region_line(void) {
    if (zbrowser_layout_region == ZBROWSER_REGION_LEFT) {
        zbrowser_left_line_no = zbrowser_line_no;
        return;
    }
    if (zbrowser_layout_region == ZBROWSER_REGION_RIGHT) {
        zbrowser_right_line_no = zbrowser_line_no;
        return;
    }
    zbrowser_article_line_no = zbrowser_line_no;
}

void load_region_line(void) {
    if (zbrowser_layout_region == ZBROWSER_REGION_LEFT) {
        zbrowser_line_no = zbrowser_left_line_no;
        return;
    }
    if (zbrowser_layout_region == ZBROWSER_REGION_RIGHT) {
        zbrowser_line_no = zbrowser_right_line_no;
        return;
    }
    zbrowser_line_no = zbrowser_article_line_no;
}

void set_region(uint32_t region) {
    if (zbrowser_layout_region == region) {
        return;
    }
    flush_line();
    save_region_line();
    zbrowser_layout_region = region;
    load_region_line();
    zbrowser_last_space = 0;
}

void apply_layout(const uint8_t *html, uint32_t pos) {
    set_region(ZBROWSER_REGION_ARTICLE);
}

void reset_layout(const uint8_t *html, uint32_t pos) {
    if (zb_tag_name_is(html, pos, "nav") ||
        zb_tag_name_is(html, pos, "header") ||
        zb_tag_name_is(html, pos, "footer") ||
        zb_tag_name_is(html, pos, "aside") ||
        zb_tag_name_is(html, pos, "table") ||
        zb_tag_name_is(html, pos, "figure") ||
        zb_tag_name_is(html, pos, "main") ||
        zb_tag_name_is(html, pos, "article") ||
        zb_tag_name_is(html, pos, "div")) {
        set_region(ZBROWSER_REGION_ARTICLE);
    }
}

uint32_t register_link(const uint8_t *href) {
    uint8_t *slot;
    uint32_t index;

    if (zbrowser_links_addr == 0 || zbrowser_link_count >= ZBROWSER_MAX_LINKS) {
        return 9999;
    }
    if (is_ignored_href(href) != 0) {
        return 9999;
    }
    index = zbrowser_link_count;
    slot = (uint8_t *)zbrowser_links_addr + index * ZBROWSER_LINK_CAPACITY;
    make_absolute_url(zbrowser_url, href, slot, ZBROWSER_LINK_CAPACITY);
    if (slot[0] == 0) {
        return 9999;
    }
    zbrowser_link_lines[index] = zbrowser_line_no;
    zbrowser_link_end_lines[index] = zbrowser_line_no;
    zbrowser_link_start_cols[index] = zbrowser_line_len;
    zbrowser_link_end_cols[index] = zbrowser_line_len;
    zbrowser_link_x[index] = 0;
    zbrowser_link_y[index] = 0;
    zbrowser_link_w[index] = 0;
    zbrowser_link_h[index] = 0;
    zbrowser_link_count = zbrowser_link_count + 1;
    return index;
}

void set_link_rect(uint32_t index,
                   uint32_t x,
                   uint32_t y,
                   uint32_t width,
                   uint32_t height) {
    uint32_t left;
    uint32_t top;
    uint32_t right;
    uint32_t bottom;
    uint32_t old_right;
    uint32_t old_bottom;

    if (index >= zbrowser_link_count) {
        return;
    }
    if (width == 0 || height == 0) {
        return;
    }
    if (zbrowser_link_w[index] == 0 || zbrowser_link_h[index] == 0) {
        zbrowser_link_x[index] = x;
        zbrowser_link_y[index] = y;
        zbrowser_link_w[index] = width;
        zbrowser_link_h[index] = height;
        return;
    }

    left = zbrowser_link_x[index];
    top = zbrowser_link_y[index];
    right = x + width;
    bottom = y + height;
    old_right = zbrowser_link_x[index] + zbrowser_link_w[index];
    old_bottom = zbrowser_link_y[index] + zbrowser_link_h[index];

    if (x < left) {
        left = x;
    }
    if (y < top) {
        top = y;
    }
    if (old_right > right) {
        right = old_right;
    }
    if (old_bottom > bottom) {
        bottom = old_bottom;
    }

    zbrowser_link_x[index] = left;
    zbrowser_link_y[index] = top;
    zbrowser_link_w[index] = right - left;
    zbrowser_link_h[index] = bottom - top;
}

uint32_t register_input(const uint8_t *name, const uint8_t *value) {
    uint8_t *slot_name;
    uint8_t *slot_value;
    uint32_t index;

    if (zbrowser_input_count >= ZBROWSER_MAX_INPUTS) {
        return 9999;
    }
    index = zbrowser_input_count;
    slot_name = input_name_slot(index);
    slot_value = input_value_slot(index);
    copy_text(slot_name, ZBROWSER_INPUT_NAME_CAPACITY, name);
    if (!(zbrowser_focused_input == index && slot_value[0] != 0)) {
        copy_text(slot_value, ZBROWSER_INPUT_VALUE_CAPACITY, value);
    }
    zbrowser_input_lines[index] = zbrowser_line_no;
    zbrowser_input_count = zbrowser_input_count + 1;
    return index;
}

void emit_input_index(uint32_t index) {
    uint32_t digit;

    emit_text("[input ");
    if (index >= 10) {
        digit = 48 + (index / 10);
        emit_char((uint8_t)digit);
    }
    digit = 48 + (index % 10);
    emit_char((uint8_t)digit);
    emit_text(": ");
}

uint32_t control_x_for_width(uint32_t box_w) {
    uint32_t ax;
    uint32_t aw;

    ax = article_x();
    aw = article_w();
    if (aw <= box_w + 16) {
        return ax + 8;
    }
    if (zbrowser_text_align == 1) {
        return ax + ((aw - box_w) / 2);
    }
    if (zbrowser_text_align == 2) {
        return ax + aw - box_w - 8;
    }
    return ax + 8;
}

void draw_input_control(uint32_t index, const uint8_t *value) {
    uint32_t h;
    uint32_t w;
    uint32_t draw_y;
    uint32_t box_w;
    uint32_t box_x;
    uint32_t fill;

    h = gfx_height();
    w = gfx_width();
    if (zbrowser_line_no < zbrowser_scroll) {
        zbrowser_line_no = zbrowser_line_no + 2;
        return;
    }

    draw_y = zbrowser_y + (zbrowser_line_no - zbrowser_scroll) * 12;
    if (draw_y + 22 >= h - 18) {
        zbrowser_line_no = zbrowser_line_no + 2;
        return;
    }

    box_w = 128;
    if (article_w() > 32) {
        box_w = article_w() - 24;
    }
    if (box_w > 360) {
        box_w = 360;
    }
    box_x = control_x_for_width(box_w);

    fill = 0xffffff;
    if (zbrowser_focused_input == index) {
        fill = 0xeaf3ff;
    }
    gfx_fill_rect(box_x, draw_y, box_w, 20, fill);
    gfx_draw_rect(box_x, draw_y, box_w, 20, 0xa2a9b1);
    draw_text_at_pixel(box_x + 8, draw_y + 6, value, 0x202122, fill);
    if (zbrowser_focused_input == index) {
        draw_text_at_pixel(box_x + box_w - 16, draw_y + 6, "_", 0x3366cc, fill);
    }
    zbrowser_line_no = zbrowser_line_no + 2;
}

