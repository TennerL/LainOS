#pragma once

extern uint8_t *malloc(uint64_t size);
extern uint8_t *calloc(uint64_t count, uint64_t size);
extern uint8_t *realloc(uint8_t *ptr, uint64_t size);
extern void free(uint8_t *ptr);

extern uint8_t *memcpy(uint8_t *dst, const uint8_t *src, uint64_t len);
extern uint8_t *memset(uint8_t *dst, int value, uint64_t len);
extern uint8_t *memmove(uint8_t *dst, const uint8_t *src, uint64_t len);
extern int memcmp(const uint8_t *a, const uint8_t *b, uint64_t len);

extern uint64_t strlen(const uint8_t *s);
extern uint8_t *strcpy(uint8_t *dst, const uint8_t *src);
extern uint8_t *strncpy(uint8_t *dst, const uint8_t *src, uint64_t n);
extern uint8_t *strcat(uint8_t *dst, const uint8_t *src);
extern int strcmp(const uint8_t *a, const uint8_t *b);
extern int strncmp(const uint8_t *a, const uint8_t *b, uint64_t n);
extern uint8_t *strchr(const uint8_t *s, int ch);
extern uint8_t *strrchr(const uint8_t *s, int ch);
extern uint8_t *strstr(const uint8_t *haystack, const uint8_t *needle);
extern uint8_t *strdup(const uint8_t *s);
extern int *errno_location(void);
