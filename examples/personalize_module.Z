    registry_set("desktop.theme", "midnight");
    registry_set("desktop.bg.top", "0x101820");
    registry_set("desktop.bg.bottom", "0x05080d");
    registry_set("desktop.topbar", "0x090d12");
    registry_set("desktop.taskbar", "0x0c1118");
    registry_set("desktop.panel", "0x151d28");
    registry_set("desktop.panel.inner", "0x263241");
    registry_set("desktop.accent", "0x33aaff");
    registry_set("desktop.accent.soft", "0x4d728f");
    registry_set("desktop.text", "0xe8f1f7");
    registry_set("desktop.button", "0x2b5f8a");
    registry_set("desktop.task.active", "0x1f415c");
    registry_set("desktop.task.inactive", "0x182330");
}

void set_olive(void) {
    registry_set("desktop.theme", "olive");
    registry_set("desktop.bg.top", "0x1f2a20");
    registry_set("desktop.bg.bottom", "0x11170f");
    registry_set("desktop.topbar", "0x121810");
    registry_set("desktop.taskbar", "0x151b13");
    registry_set("desktop.panel", "0x20291c");
    registry_set("desktop.panel.inner", "0x384331");
    registry_set("desktop.accent", "0xb6c46a");
    registry_set("desktop.accent.soft", "0x71804a");
    registry_set("desktop.text", "0xf0efd8");
    registry_set("desktop.button", "0x546832");
    registry_set("desktop.task.active", "0x45552e");
    registry_set("desktop.task.inactive", "0x26301f");
