#define KEY_CHAR 1
#define KEY_ENTER 2
#define KEY_BACKSPACE 3
#define KEY_ESC 5
#define MOUSE_LEFT 1

extern uint32_t gfx_width(void);
extern uint32_t gfx_height(void);
extern void gfx_fill_rect(uint32_t x, uint32_t y, uint32_t width, uint32_t height, uint32_t color);
extern void gfx_draw_rect(uint32_t x, uint32_t y, uint32_t width, uint32_t height, uint32_t color);
extern void draw_text_at_pixel(uint32_t x, uint32_t y, const uint8_t *text, uint32_t fg, uint32_t bg);
extern int os_strlen(const uint8_t *text);
extern int registry_set(const uint8_t *key, const uint8_t *value);
extern const uint8_t *registry_get(const uint8_t *key);

global uint32_t personalize_enabled;
global uint32_t personalize_editing;
global uint8_t personalize_image_path[128];
global uint8_t personalize_status[80];

void copy_text(uint8_t *dst, uint32_t capacity, const uint8_t *src) {
    uint32_t i;

    i = 0;
    if (capacity == 0) {
        return;
    }
    while (src[i] != 0 && i + 1 < capacity) {
        dst[i] = src[i];
        i = i + 1;
    }
    dst[i] = 0;
}

void append_char(uint8_t *dst, uint32_t capacity, uint8_t ch) {
    int len;

    len = os_strlen(dst);
    if (len < 0 || len + 1 >= capacity) {
        return;
    }
    dst[len] = ch;
    dst[len + 1] = 0;
}

void backspace_text(uint8_t *dst) {
    int len;

    len = os_strlen(dst);
    if (len > 0) {
        dst[len - 1] = 0;
    }
}

void set_lain(void) {
    registry_set("desktop.theme", "lain");
    registry_set("desktop.bg.top", "0x35063e");
    registry_set("desktop.bg.bottom", "0x2b1d3d");
    registry_set("desktop.topbar", "0x100b18");
    registry_set("desktop.taskbar", "0x171020");
    registry_set("desktop.panel", "0x221a2d");
    registry_set("desktop.panel.inner", "0x3a2f49");
    registry_set("desktop.accent", "0xe05f4f");
    registry_set("desktop.accent.soft", "0xb98556");
    registry_set("desktop.text", "0xf6eadb");
    registry_set("desktop.button", "0x8f3f62");
    registry_set("desktop.task.active", "0x4b2347");
    registry_set("desktop.task.inactive", "0x2d2038");
}

