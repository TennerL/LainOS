enum {
    MOUSE_LEFT = 1,
    MOUSE_RIGHT = 2,
    OS_ENTRY_FILE = 1,
    OS_ENTRY_DIR = 2,
    FM_FILTER_ALL = 0,
    FM_FILTER_MODULES = 1,
    FM_FILTER_IMAGES = 2,
    FM_FILTER_SOURCE = 3,
    FM_TOP_H = 88,
    FM_SIDE_W = 156,
    FM_STATUS_H = 24,
    FM_ROW_H = 24,
    FM_LIST_TOP = 124,
};

